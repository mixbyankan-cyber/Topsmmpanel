  }
  function paintFavs() {
    const panel = document.getElementById('singleOrderPanel'); if (!panel) return;
    const slot0 = TSMU.orderTopSlot ? TSMU.orderTopSlot('wish') : null;
    const held = document.getElementById('tsmuFavHolder');
    if (slot0 && held && held.parentNode !== slot0) slot0.appendChild(held);
    const keys = Object.keys(TSMU.favs || {});
    let box = document.getElementById('tsmuFavBar');
    if (!keys.length) { if (box) box.remove(); return; }
    if (!box) {
      box = document.createElement('div'); box.id = 'tsmuFavBar';
      const t = document.createElement('div');
      t.style.cssText = 'font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--text-gray,#64748b);margin:0 0 6px';
      t.innerHTML = '<span>⭐ Wishlist</span>' +
        '<button type="button" style="margin-left:auto;background:none;border:0;font:inherit;font-size:10.5px;' +
        'font-weight:800;letter-spacing:.3px;text-transform:uppercase;color:var(--primary-color,#0ea5e9);cursor:pointer" ' +
        'onclick="TSMU.openWishlist&&TSMU.openWishlist()">View all →</button>';
      t.style.display = 'flex'; t.style.alignItems = 'center'; t.style.gap = '8px';
      const holder = document.createElement('div'); holder.id = 'tsmuFavHolder';
      holder.appendChild(t); holder.appendChild(box); box.className = 'tsmu-fav';
      /* fixed position: under the Social Network bar, above the search box */
