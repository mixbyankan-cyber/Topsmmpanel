      // ── Tricolor confetti burst (custom code — no external library) ─
      maybeConfetti() {
        if (!IDT.isEnabled()) return;
        const dash = document.getElementById('dashboardPage');
        if (!dash || !dash.classList.contains('active')) return;
        let today;
        try {
          today = new Date().toDateString();
          if (localStorage.getItem('idt_confetti_day') === today) return;
          localStorage.setItem('idt_confetti_day', today);
        } catch (e) {}
        IDT.fireConfetti(3600);
      },

      fireConfetti(durationMs) {
        if (document.getElementById('idConfettiCanvas')) return;
        const canvas = document.createElement('canvas');
        canvas.id = 'idConfettiCanvas';
        document.body.appendChild(canvas);
        const ctx = canvas.getContext('2d');
        const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
        resize();
        window.addEventListener('resize', resize);

        const colors = ['#FF9933', '#138808', '#06038D', '#FFD166', '#ff6b6b'];
        const parts = [];
        const N = Math.min(170, Math.max(70, Math.floor(window.innerWidth / 5)));
        for (let i = 0; i < N; i++) {
          parts.push({
            x: Math.random() * canvas.width,
            y: -20 - Math.random() * canvas.height * 0.35,
            w: 6 + Math.random() * 6,
            h: 8 + Math.random() * 8,
            vx: -1 + Math.random() * 2,
            vy: 2 + Math.random() * 3.2,
            rot: Math.random() * Math.PI,
            vr: -0.12 + Math.random() * 0.24,
            color: colors[(Math.random() * colors.length) | 0],
            sway: Math.random() * Math.PI * 2
          });
        }
        const start = Date.now();
        (function loop() {
          const elapsed = Date.now() - start;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          const fade = elapsed > durationMs ? Math.max(0, 1 - (elapsed - durationMs) / 800) : 1;
          parts.forEach(p => {
            p.sway += 0.05;
            p.x += p.vx + Math.sin(p.sway) * 0.7;
            p.y += p.vy;
            p.rot += p.vr;
            if (p.y > canvas.height + 30) { p.y = -20; p.x = Math.random() * canvas.width; }
            ctx.save();
            ctx.globalAlpha = fade;
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
            ctx.restore();
          });
          if (elapsed < durationMs + 850) {
            requestAnimationFrame(loop);
          } else {
            window.removeEventListener('resize', resize);
            canvas.remove();
          }
        })();
      },

      // Ashoka Chakra — proper 24-spoke wheel, generated once in code so
      // the HTML stays clean. Colored via CSS `color` (currentColor).
      chakraSVG(size) {
