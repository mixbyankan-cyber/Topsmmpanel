    // ══════════════════════════════════════════════════════
    // 🚫 DUPLICATE ORDER MODAL
    // ══════════════════════════════════════════════════════
    function showDuplicateOrderModal(existingOrder, newLink, serviceId) {
      // Remove any existing modal
      const existing = document.getElementById('dupOrderModal');
      if (existing) existing.remove();

      const statusColors = {
        pending:    { bg: '#fef3c7', color: '#d97706', icon: '⏳' },
        processing: { bg: '#dbeafe', color: '#2563eb', icon: '⚙️' },
        partial:    { bg: '#fce7f3', color: '#db2777', icon: '🔄' }
      };
      const sc = statusColors[existingOrder.status] || statusColors.pending;
      const orderDate = new Date(existingOrder.createdAt).toLocaleDateString('en-IN', {
        day: '2-digit', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
      });
