  `;
  const s = document.createElement('style'); s.id = 'tsmuStyles'; s.textContent = CSS;
  document.head.appendChild(s);

  /* ---------- page factory ---------- */
  TSMU.makePage = function (id, title, innerHTML, backTo) {
    if (document.getElementById(id)) return document.getElementById(id);
    const d = document.createElement('div');
    d.className = 'page'; d.id = id;
    d.innerHTML = '<div class="container">' +
      '<div style="display:flex;align-items:center;gap:10px;margin-bottom:15px">' +
      '<button class="tsmu-btn sec sm" onclick="navigateTo(\'' + (backTo || 'menuPage') + '\')">← Back</button>' +
      '<h2 class="section-title" style="margin:0;flex:1">' + title + '</h2></div>' + innerHTML + '</div>';
    const host = document.querySelector('.bottom-nav');
    host ? host.parentNode.insertBefore(d, host) : document.body.appendChild(d);
    return d;
  };

  TSMU.addMenuCard = function (opts) {
    const menu = document.querySelector('#menuPage .container'); if (!menu) return;
    if (document.getElementById('tsmumc_' + opts.id)) return;
    const card = document.createElement('div');
    card.className = 'order-form-card'; card.id = 'tsmumc_' + opts.id;
    card.style.cursor = 'pointer';
    card.setAttribute('onclick', opts.onclick);
    card.innerHTML = '<h3 style="color:' + (opts.color || 'var(--primary-color)') + '">' + opts.icon + ' ' + esc(opts.title) + '</h3>' +
      '<p class="info-text">' + esc(opts.desc) + '</p>';
    const logout = Array.prototype.find.call(menu.children, c => (c.getAttribute('onclick') || '').includes('logoutUser'));
    logout ? menu.insertBefore(card, logout) : menu.appendChild(card);
  };

  /* ---------- states ---------- */
  TSMU.loading = (el, m) => { const e = typeof el === 'string' ? document.getElementById(el) : el; if (e) e.innerHTML = '<div class="tsmu-load"><div class="tsmu-spin"></div>' + esc(m || 'Loading…') + '</div>'; };
  TSMU.empty = (el, i, m, sub) => { const e = typeof el === 'string' ? document.getElementById(el) : el; if (e) e.innerHTML = '<div class="tsmu-empty"><span class="e-i">' + (i || '📭') + '</span><div style="font-weight:700;color:var(--text-secondary)">' + esc(m || 'Nothing here yet') + '</div>' + (sub ? '<div style="margin-top:6px;font-size:12px">' + esc(sub) + '</div>' : '') + '</div>'; };
  TSMU.fail = function (el, err, retry) {
    const e = typeof el === 'string' ? document.getElementById(el) : el; if (!e) return;
    const msg = (err && (err.message || err.code)) || String(err || '');
    const friendly = /permission/i.test(msg) ? 'You do not have permission to see this right now.' :
      /network|offline|unavailable|failed to fetch/i.test(msg) ? 'Your internet connection dropped.' :
        /index/i.test(msg) ? 'The panel is still preparing this data.' : 'Something went wrong loading this section.';
    e.innerHTML = '<div class="tsmu-err"><span class="ei">⚠️</span><div class="et">' + esc(friendly) + '</div>' +
      '<div class="em">' + esc(msg.slice(0, 140)) + '</div>' +
      (retry ? '<button class="tsmu-btn" onclick="' + esc(retry) + '">🔄 Try Again</button>' : '') + '</div>';
  };
  TSMU.guard = (elId, retry, fn) => Promise.resolve().then(fn).catch(e => { console.error('[TSMU]', retry, e); TSMU.fail(elId, e, retry); });

  /* ---------- resilience: offline banner + connection watch ---------- */
  const off = document.createElement('div'); off.className = 'tsmu-off'; off.id = 'tsmuOffline';
  const put = () => { if (document.body && !document.getElementById('tsmuOffline')) document.body.appendChild(off); };
  put(); document.addEventListener('DOMContentLoaded', put);
  let down = false;
  function show(cls, txt, autoHide) {
    off.className = 'tsmu-off on' + (cls ? ' ' + cls : ''); off.textContent = txt;
    if (autoHide) setTimeout(() => off.classList.remove('on'), 2600);
  }
  window.addEventListener('offline', () => { down = true; show('', '📴 No internet connection — please reconnect'); });
  window.addEventListener('online', () => { show('back', '✅ Back online', true); });
  TSMU.watch = function () {
    try {
      DB().ref('.info/connected').on('value', s => {
        const up = s.val() === true;
        if (!up) { down = true; show('recon', '⏳ Reconnecting…'); }
        else if (down) { down = false; show('back', '✅ Connected', true); }
      });
    } catch (e) { }
  };

  /* ---------- global error boundary ---------- */
  TSMU.errors = [];
  window.addEventListener('error', e => {
    TSMU.errors.push({ m: e.message, at: Date.now() });
    if (TSMU.errors.length > 40) TSMU.errors.shift();
  });
  window.addEventListener('unhandledrejection', e => {
    const r = e.reason || {}, m = r.message || r.code || String(r);
    TSMU.errors.push({ m: m, at: Date.now() });
    if (/permission_denied/i.test(m)) TSMU.toast('This action was blocked. Please refresh and try again.', 'error');
    else if (/network|failed to fetch|unavailable/i.test(m)) TSMU.toast('Connection problem — please check your internet.', 'error');
  });

  /* ---------- settings cache ---------- */
  TSMU.loadSettings = function () {
    ['dripFeed'].forEach(k => DB().ref('settings/' + k).on('value', s => { TSMU.settings[k] = s.val() || {}; if (TSMU.onSettings) TSMU.onSettings(k); }, () => { }));
    DB().ref('admin_settings/referral').on('value', s => { TSMU.settings.referral = s.val() || {}; if (TSMU.onSettings) TSMU.onSettings('referral'); }, () => { });
  };

  /* modules register their DOM-mount function here; remountAll() is called
     repeatedly after login because the panel builds its UI progressively. */
  TSMU._mounts = [];
  TSMU.registerMount = fn => { if (TSMU._mounts.indexOf(fn) < 0) TSMU._mounts.push(fn); try { fn(); } catch (e) { } };
  TSMU.remountAll = () => TSMU._mounts.forEach(f => { try { f(); } catch (e) { console.warn('[TSMU mount]', e && e.message); } });

  TSMU.onReady = fn => TSMU.ready ? fn() : TSMU._q.push(fn);
  TSMU.boot = function () {
    if (TSMU.ready) return; TSMU.ready = true;
    TSMU.watch(); TSMU.loadSettings();
    TSMU._q.splice(0).forEach(f => { try { f(); } catch (e) { console.error('[TSMU boot]', e); } });
  };

  console.log('%c TSMU v' + TSMU.version + ' user core loaded ', 'background:#7c3aed;color:#fff;padding:2px 6px;border-radius:4px');
})();


/* ---------- 02-wallet-status-broadcast.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v26 USER · PART 2 — WALLET STATEMENT (Gap #5)  +  ACCOUNT STATUS (Gap #6)
                     + BROADCAST RECEIVER (Gap #8) + REFERRAL LIVE (Gap #1)
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const DB = () => TSMU.db();

  /* ═══════════ WALLET STATEMENT PAGE ═══════════ */
  const WALLET_HTML = `
  <div class="tsmu-stats" id="wlStats"></div>
  <div class="tsmu-chips" id="wlChips">
    <button class="tsmu-chip on" data-wf="all" onclick="TSMU.wlFilter('all')">All</button>
    <button class="tsmu-chip" data-wf="in" onclick="TSMU.wlFilter('in')">💚 Money In</button>
    <button class="tsmu-chip" data-wf="out" onclick="TSMU.wlFilter('out')">💸 Money Out</button>
    <button class="tsmu-chip" data-wf="referral" onclick="TSMU.wlFilter('referral')">🤝 Referral</button>
    <button class="tsmu-chip" data-wf="fund" onclick="TSMU.wlFilter('fund')">💰 Deposits</button>
    <button class="tsmu-chip" data-wf="order" onclick="TSMU.wlFilter('order')">🛒 Orders</button>
  </div>
  <div class="tsmu-row" style="margin-bottom:13px">
    <input class="tsmu-in" id="wlSearch" placeholder="🔍 Search note or reference…" oninput="TSMU.wlRender()">
    <button class="tsmu-btn sec" onclick="TSMU.wlLoad()">🔄</button>
  </div>
  <div class="tsmu-card" style="padding:8px 14px"><div id="wlList"></div></div>
  <button class="tsmu-btn sec" style="width:100%;margin-top:10px" onclick="TSMU.wlExport()">📥 Download Statement (CSV)</button>`;

  const TYPES = {
    order: ['🛒', 'Order Placed', -1], mass_order: ['📦', 'Mass Order', -1],
    order_refund: ['↩️', 'Order Refund', 1], fund: ['💰', 'Deposit Added', 1],
    fund_bonus: ['🎁', 'Deposit Bonus', 1], fund_reverse: ['⛔', 'Deposit Reversed', -1],
    referral: ['🤝', 'Referral Commission', 1], referral_reverse: ['↩️', 'Referral Reversed', -1],
    coupon: ['🏷️', 'Coupon Bonus', 1], admin_add: ['➕', 'Credit from Admin', 1],
    admin_sub: ['➖', 'Debit by Admin', -1], panel_order: ['🖥️', 'Panel Purchase', -1],
    adjust: ['⚖️', 'Adjustment', 0], signup_bonus: ['🎉', 'Signup Bonus', 1]
  };

  let LED = [], WF = 'all';

  TSMU.ensureWalletPage = function () { TSMU.makePage('walletPage', '💳 Wallet Statement', WALLET_HTML, 'menuPage'); };
  TSMU.openWallet = function () {
    TSMU.ensureWalletPage();
    if (window.navigateTo) navigateTo('walletPage');
    TSMU.wlLoad();
  };

  TSMU.wlLoad = function () {
    const uid = TSMU.uid(); if (!uid) return;
    TSMU.loading('wlList', 'Loading your statement…');
    TSMU.guard('wlList', 'TSMU.wlLoad()', () =>
      Promise.all([
        DB().ref('users/' + uid + '/ledger').orderByChild('at').limitToLast(500).once('value'),
        DB().ref('users/' + uid + '/balance').once('value')
      ]).then(([l, b]) => {
        LED = Object.entries(l.val() || {}).map(([id, v]) => Object.assign({ id: id }, v)).sort((a, b2) => b2.at - a.at);
        const bal = TSMU.num(b.val());
        let inSum = 0, outSum = 0, refSum = 0;
        LED.forEach(x => { const t = TYPES[x.type] || [null, null, 0]; if (t[2] > 0) inSum += TSMU.num(x.amount); else if (t[2] < 0) outSum += TSMU.num(x.amount); if (x.type === 'referral') refSum += TSMU.num(x.amount); });
        const st = (c, l2, v, s) => '<div class="tsmu-stat" style="--k:' + c + '"><div class="s-l">' + l2 + '</div><div class="s-v">' + v + '</div><div class="s-s">' + s + '</div></div>';
        const box = document.getElementById('wlStats');
        if (box) box.innerHTML =
          st('#0ea5e9', 'Current Balance', TSMU.money(bal), 'available to spend') +
          st('#10b981', 'Total Money In', TSMU.money(inSum), 'deposits, refunds, bonuses') +
          st('#ef4444', 'Total Money Out', TSMU.money(outSum), 'orders and debits') +
          st('#7c3aed', 'Referral Earned', TSMU.money(refSum), 'credited to this wallet');
        TSMU.wlRender();
      }));
  };

  TSMU.wlFilter = function (f) {
    WF = f;
    document.querySelectorAll('#wlChips .tsmu-chip').forEach(c => c.classList.toggle('on', c.dataset.wf === f));
    TSMU.wlRender();
  };

  TSMU.wlRender = function () {
    const box = document.getElementById('wlList'); if (!box) return;
    const q = ((document.getElementById('wlSearch') || {}).value || '').toLowerCase();
    const list = LED.filter(x => {
      const t = TYPES[x.type] || [null, null, 0];
      if (WF === 'in' && t[2] <= 0) return false;
      if (WF === 'out' && t[2] >= 0) return false;
      if (WF === 'referral' && x.type.indexOf('referral') !== 0) return false;
      if (WF === 'fund' && x.type.indexOf('fund') !== 0) return false;
      if (WF === 'order' && x.type.indexOf('order') !== 0 && x.type !== 'mass_order') return false;
      if (q && !((x.note || '') + ' ' + (x.ref || '')).toLowerCase().includes(q)) return false;
      return true;
    });
    if (!list.length) return TSMU.empty(box, '💳', 'No transactions here yet',
      LED.length ? 'Try a different filter.' : 'Your statement fills up automatically as you add funds and place orders.');
    box.innerHTML = list.map(x => {
      const t = TYPES[x.type] || ['•', x.type, 0];
      const cr = t[2] > 0;
      const bg = cr ? 'rgba(16,185,129,.13)' : t[2] < 0 ? 'rgba(239,68,68,.11)' : 'rgba(100,116,139,.11)';
      return '<div class="tsmu-led"><div class="l-i" style="background:' + bg + '">' + t[0] + '</div>' +
        '<div class="l-b"><div class="l-t">' + esc(t[1]) + '</div>' +
        (x.note ? '<div class="l-n">' + esc(x.note) + '</div>' : '') +
        '<div class="l-d">' + TSMU.dt(x.at) + (x.ref ? ' · #' + esc(x.ref) : '') + '</div></div>' +
        '<div class="l-a"><div class="l-v ' + (TSMU.num(x.amount) === 0 ? '' : cr ? 'tsmu-cr' : t[2] < 0 ? 'tsmu-db' : '') + '">' +
        (TSMU.num(x.amount) === 0 ? 'FREE' : (cr ? '+' : t[2] < 0 ? '−' : '') + TSMU.money(x.amount)) + '</div>' +
        (x.balanceAfter != null ? '<div class="l-r">bal ' + TSMU.money(x.balanceAfter) + '</div>' : '') + '</div></div>';
    }).join('');
  };

  TSMU.wlExport = function () {
    if (!LED.length) return TSMU.toast('Nothing to download yet', 'error');
    const q = v => { v = v == null ? '' : String(v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
    const rows = [['Date', 'Type', 'Description', 'Reference', 'Direction', 'Amount (INR)', 'Balance After']];
    LED.slice().reverse().forEach(x => { const t = TYPES[x.type] || ['', x.type, 0]; rows.push([TSMU.dt(x.at), t[1], x.note || '', x.ref || '', t[2] > 0 ? 'CREDIT' : t[2] < 0 ? 'DEBIT' : 'ADJUST', TSMU.num(x.amount), x.balanceAfter]); });
    const blob = new Blob(['\uFEFF' + rows.map(r => r.map(q).join(',')).join('\r\n')], { type: 'text/csv;charset=utf-8;' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
    a.download = 'wallet_statement.csv'; document.body.appendChild(a); a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
    TSMU.toast('✅ Statement downloaded', 'success');
  };

  /* client-side ledger writer used by order/coupon hooks */
  TSMU.writeLedger = function (entry) {
    const uid = TSMU.uid(); if (!uid || !entry || !entry.type) return Promise.resolve();
    try { return Promise.resolve(DB().ref('users/' + uid + '/ledger').push({
      type: entry.type, amount: Math.round(TSMU.num(entry.amount) * 10000) / 10000,
      balanceBefore: entry.balanceBefore == null ? null : TSMU.num(entry.balanceBefore),
      balanceAfter: entry.balanceAfter == null ? null : TSMU.num(entry.balanceAfter),
      note: String(entry.note || '').slice(0, 240), ref: entry.ref ? String(entry.ref).slice(0, 80) : null,
      at: Date.now(), by: 'user'
    })).catch(e => console.warn('[TSMU ledger]', e && e.message)); }
    catch (e) { console.warn('[TSMU ledger]', e && e.message); return Promise.resolve(); }
  };

  /* ═══════════ ACCOUNT STATUS ENFORCEMENT (ban / suspend) ═══════════ */
  let statusRef = null;
  TSMU.watchStatus = function () {
    const uid = TSMU.uid(); if (!uid) return;
    if (statusRef) { try { statusRef.off(); } catch (e) { } }
    statusRef = DB().ref('users/' + uid);
    statusRef.child('status').on('value', s => applyStatus(s.val() || 'active'), () => { });
  };
  TSMU.accountStatus = 'active';
  function applyStatus(st) {
    TSMU.accountStatus = st;
    const old = document.getElementById('tsmuLock');
    if (st === 'banned') {
      DB().ref('users/' + TSMU.uid() + '/statusReason').once('value').then(r => {
        if (document.getElementById('tsmuLock')) return;
        const d = document.createElement('div');
        d.className = 'tsmu-lock'; d.id = 'tsmuLock';
        d.innerHTML = '<div class="lc"><div class="li">⛔</div><h2>Account Blocked</h2>' +
          '<p>Your account has been blocked by the administrator and cannot be used.</p>' +
          (r.val() ? '<div class="lr"><b>Reason:</b> ' + esc(r.val()) + '</div>' : '') +
          '<p style="font-size:12.5px;opacity:.8">If you believe this is a mistake, contact support.</p>' +
          '<button class="tsmu-btn" style="margin-top:14px" onclick="try{openWhatsApp()}catch(e){}">💬 Contact Support</button> ' +
          '<button class="tsmu-btn sec" style="margin-top:14px" onclick="try{logoutUser()}catch(e){location.reload()}">Logout</button></div>';
        document.body.appendChild(d);
      });
      return;
    }
    if (old) old.remove();
    let b = document.getElementById('tsmuSuspendBar');
    if (st === 'suspended') {
      if (!b) {
        DB().ref('users/' + TSMU.uid() + '/statusReason').once('value').then(r => {
          if (document.getElementById('tsmuSuspendBar')) return;
          const bar = document.createElement('div');
          bar.id = 'tsmuSuspendBar';
          bar.style.cssText = 'position:fixed;top:0;left:0;right:0;background:#f59e0b;color:#fff;padding:9px 14px;font-size:12.5px;font-weight:700;text-align:center;z-index:99997;line-height:1.5';
          bar.innerHTML = '⏸️ Your account is suspended — ordering and deposits are paused.' + (r.val() ? '<br><span style="font-weight:500;opacity:.92">' + esc(r.val()) + '</span>' : '');
          document.body.appendChild(bar);
        });
      }
    } else if (b) b.remove();
  }
  /** returns true when the action is allowed */
  TSMU.allow = function (what) {
    if (TSMU.accountStatus === 'banned') { TSMU.toast('⛔ Your account is blocked.', 'error'); return false; }
    if (TSMU.accountStatus === 'suspended') {
      const blocked = ['order', 'fund', 'refill', 'ticket', 'api', 'panel'];
      if (blocked.indexOf(what) >= 0) { TSMU.toast('⏸️ Your account is suspended — ' + what + ' is not available. Contact support.', 'error'); return false; }
    }
    return true;
  };

  /* ═══════════ BROADCAST RECEIVER ═══════════ */
  const TONE = { info: ['#3b82f6', 'ℹ️'], offer: ['#8b5cf6', '🎁'], success: ['#10b981', '✅'], warning: ['#f59e0b', '⚠️'], critical: ['#ef4444', '🚨'] };
  const SEEN_KEY = 'tsmu_bc_seen';
  function seen() { try { return JSON.parse(localStorage.getItem(SEEN_KEY) || '[]'); } catch (e) { return []; } }
  function markSeen(id) { const s = seen(); if (s.indexOf(id) < 0) { s.push(id); localStorage.setItem(SEEN_KEY, JSON.stringify(s.slice(-60))); } }

  TSMU.watchBroadcasts = function () {
    let host = document.getElementById('tsmuBcHost');
    if (!host) { host = document.createElement('div'); host.className = 'tsmu-bc'; host.id = 'tsmuBcHost'; document.body.appendChild(host); }
    DB().ref('broadcasts').orderByChild('createdAt').limitToLast(8).on('value', snap => {
      const now = Date.now(), uid = TSMU.uid();
      const items = [];
      snap.forEach(c => { const v = c.val() || {}; items.push(Object.assign({ id: c.key }, v)); });
      host.innerHTML = '';
      items.sort((a, b) => b.createdAt - a.createdAt).forEach(b => {
        if (b.enabled === false) return;
        if (b.expiresAt && b.expiresAt < now) return;
        if (b.audience === 'specific' && (!b.uids || b.uids.indexOf(uid) < 0)) return;
        if (!b.sticky && seen().indexOf(b.id) >= 0) return;
        const [col, ic] = TONE[b.type] || TONE.info;
        const el = document.createElement('div');
        el.className = 'tsmu-bc-item';
        el.innerHTML = '<div class="tsmu-bc-h" style="background:' + col + '"><span style="font-size:18px">' + ic + '</span><b>' + esc(b.title) + '</b>' +
          (b.sticky ? '' : '<button class="tsmu-bc-x" data-x="' + esc(b.id) + '">×</button>') + '</div>' +
          '<div class="tsmu-bc-b">' + esc(b.message) + '</div>' +
          (b.link ? '<div class="tsmu-bc-a"><button style="background:' + col + '" data-go="' + esc(b.link) + '">' + esc(b.linkText || 'Open') + '</button></div>' : '');
        host.appendChild(el);
        const x = el.querySelector('[data-x]');
        if (x) x.onclick = () => { markSeen(b.id); el.remove(); };
        const g = el.querySelector('[data-go]');
        if (g) g.onclick = () => {
          markSeen(b.id);
          const t = g.dataset.go;
          if (/^https?:\/\//i.test(t)) window.open(t, '_blank', 'noopener');
          else if (window.navigateTo) navigateTo(t);
          el.remove();
        };
      });
    }, e => console.warn('[TSMU broadcast]', e.message));
  };

  /* ═══════════ REFERRAL — live admin rules ═══════════ */
  TSMU.applyReferralSettings = function () {
    const cfg = TSMU.settings.referral || {};
    const pct = TSMU.num(cfg.commission_percent, 5);
    document.querySelectorAll('#referralCommissionRate, #commissionRateDisplay, #howItWorksRate')
      .forEach(el => { el.textContent = pct + '%'; });
    if (TSMU.G('referralCommissionPercent') !== undefined) TSMU.S('referralCommissionPercent', pct);

    const page = document.getElementById('referralPage'); if (!page) return;
    const box = page.querySelector('.container'); if (!box) return;

    let note = document.getElementById('tsmuRefNote');
    if (!note) {
      note = document.createElement('div'); note.id = 'tsmuRefNote'; note.className = 'tsmu-note tsmu-n-ok';
      const first = box.children[1] || box.firstChild;
      box.insertBefore(note, first ? first.nextSibling : null);
    }
    const rules = [];
    rules.push('Commission: <b>' + pct + '%</b> per order · credited to your <b>wallet balance</b>.');
    if (cfg.credit_on_status) rules.push('Credited on order status: <b>' + esc(cfg.credit_on_status) + '</b>.');
    if (TSMU.num(cfg.min_order_amount) > 0) rules.push('Minimum order: <b>' + TSMU.money(cfg.min_order_amount) + '</b>.');
    if (TSMU.num(cfg.max_commission_per_order) > 0) rules.push('Cap: <b>' + TSMU.money(cfg.max_commission_per_order) + '</b> per order.');
    if (cfg.first_order_only) rules.push('First completed order only.');
    else if (cfg.lifetime !== false) rules.push('Lifetime — every order they place.');
    if (TSMU.num(cfg.signup_bonus_referrer) > 0) rules.push('Sign-up bonus for you: <b>' + TSMU.money(cfg.signup_bonus_referrer) + '</b>.');
    if (TSMU.num(cfg.signup_bonus_referee) > 0) rules.push('Sign-up bonus for your friend: <b>' + TSMU.money(cfg.signup_bonus_referee) + '</b>.');

    note.innerHTML = (cfg.banner_text ? '<div style="font-weight:700;margin-bottom:7px">' + esc(cfg.banner_text) + '</div>' : '') +
      '<ul style="margin:0;padding-left:18px;line-height:1.85">' + rules.map(r => '<li>' + r + '</li>').join('') + '</ul>' +
      '<div style="margin-top:9px;padding-top:8px;border-top:1px dashed rgba(0,0,0,.12);font-size:11.5px;opacity:.9">' +
      esc(cfg.terms_text || 'Wallet credit only — not withdrawable.') + '</div>';

    if (cfg.enabled === false) {
      note.className = 'tsmu-note tsmu-n-warn';
      note.innerHTML = '⏸️ <b>Referral program paused.</b> Commission already in your wallet stays available.';
    }
    // wallet-credit reminder next to the earnings figure
    const totalEl = document.getElementById('totalCommissionEarned');
    if (totalEl && !document.getElementById('tsmuRefWalletTag')) {
      const t = document.createElement('div');
      t.id = 'tsmuRefWalletTag';
      t.style.cssText = 'font-size:10.5px;color:var(--text-gray,#64748b);margin-top:4px;line-height:1.4';
      t.textContent = 'Already added to your wallet balance';
      totalEl.parentNode.appendChild(t);
    }
  };

  TSMU.onSettings = function (k) { if (k === 'referral') { try { TSMU.applyReferralSettings(); } catch (e) { } } };

  TSMU.onReady(function () {
    TSMU.registerMount(function () {
      TSMU.ensureWalletPage();
      TSMU.addMenuCard({ id: 'wallet', icon: '💳', title: 'Wallet Statement', desc: 'Every deposit, order, refund and referral credit in one place', color: '#0ea5e9', onclick: 'TSMU.openWallet()' });
      try { TSMU.applyReferralSettings(); } catch (e) { }
    });
    TSMU.watchBroadcasts();
    TSMU.watchStatus();
  });
})();


/* ---------- 03-coupon-drip-hooks.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v26 USER · PART 3 — COUPONS (Gap #7)  ·  DRIP-FEED / SCHEDULE (Gap #10)
                      · ORDER + FUND HOOKS · LEDGER WRITE-THROUGH
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const DB = () => TSMU.db();

  /* ═════════════════ COUPON ENGINE ═════════════════ */
  TSMU.coupon = { order: null, fund: null };

  /** Validate a coupon fully client-side against the admin rules. */
  TSMU.validateCoupon = function (code, context, amount, serviceId) {
    code = String(code || '').trim().toUpperCase();
    const uid = TSMU.uid();
    if (!code) return Promise.resolve({ ok: false, msg: 'Enter a coupon code' });
    if (!uid) return Promise.resolve({ ok: false, msg: 'Please login first' });
    return DB().ref('coupons/' + code).once('value').then(s => {
      const c = s.val();
      if (!c) return { ok: false, msg: '❌ This coupon code does not exist' };
      if (c.enabled === false) return { ok: false, msg: '⏸️ This coupon is not active' };
      const now = Date.now();
      if (c.startAt && now < c.startAt) return { ok: false, msg: '🕒 This coupon starts on ' + TSMU.day(c.startAt) };
      if (c.endAt && now > c.endAt) return { ok: false, msg: '⌛ This coupon expired on ' + TSMU.day(c.endAt) };
      if (c.appliesTo && c.appliesTo !== 'both' && c.appliesTo !== context)
        return { ok: false, msg: c.appliesTo === 'fund' ? '💰 This coupon only works on deposits' : '🛒 This coupon only works on orders' };
      if (TSMU.num(c.totalUses) > 0 && TSMU.num(c.usedCount) >= TSMU.num(c.totalUses))
        return { ok: false, msg: '🚫 This coupon has been fully used up' };
      if (TSMU.num(c.minAmount) > 0 && TSMU.num(amount) < TSMU.num(c.minAmount))
        return { ok: false, msg: '📉 Minimum ' + TSMU.money(c.minAmount) + ' required for this coupon' };
      if (c.serviceIds && c.serviceIds.length && serviceId && c.serviceIds.indexOf(serviceId) < 0)
        return { ok: false, msg: '🎯 This coupon is not valid for the selected service' };

      const checks = [DB().ref('coupon_redemptions/' + code + '/' + uid).once('value')];
      if (c.firstOrderOnly) checks.push(DB().ref('users/' + uid + '/orders').once('value'));
      return Promise.all(checks).then(res => {
        const mine = Object.keys(res[0].val() || {}).length;
        if (TSMU.num(c.perUserLimit) > 0 && mine >= TSMU.num(c.perUserLimit))
          return { ok: false, msg: '🙅 You have already used this coupon' + (c.perUserLimit > 1 ? ' ' + c.perUserLimit + ' times' : '') };
        if (c.firstOrderOnly && res[1]) {
          const done = Object.values(res[1].val() || {}).some(o => String(o.status).toLowerCase() === 'completed');
          if (done) return { ok: false, msg: '🆕 This coupon is only for your first order' };
        }
        let disc = c.type === 'percent' ? (TSMU.num(amount) * TSMU.num(c.value)) / 100 : TSMU.num(c.value);
        if (TSMU.num(c.maxDiscount) > 0 && disc > TSMU.num(c.maxDiscount)) disc = TSMU.num(c.maxDiscount);
        disc = Math.min(disc, TSMU.num(amount));
        disc = Math.round(disc * 100) / 100;
        if (!(disc > 0)) return { ok: false, msg: 'This coupon gives no discount on this amount' };
        return {
          ok: true, code: code, coupon: c, discount: disc,
          msg: c.type === 'percent'
            ? '✅ ' + c.value + '% off applied — you save ' + TSMU.money(disc)
            : '✅ ' + TSMU.money(disc) + ' off applied'
        };
      });
    }).catch(e => ({ ok: false, msg: 'Could not check this coupon: ' + e.message }));
  };

  TSMU.redeemCoupon = function (code, context, baseAmount, discount, ref) {
    const uid = TSMU.uid(); if (!uid || !code) return Promise.resolve();
    const up = {};
    const rid = DB().ref('coupon_redemptions/' + code + '/' + uid).push().key;
    up['coupon_redemptions/' + code + '/' + uid + '/' + rid] = {
      at: Date.now(), context: context, baseAmount: TSMU.num(baseAmount),
      discount: TSMU.num(discount), ref: ref || null,
      email: ((TSMU.G('currentUser') && TSMU.G('currentUser').email)) || null
    };
    return DB().ref().update(up)
      .then(() => DB().ref('coupons/' + code + '/usedCount').transaction(v => TSMU.num(v) + 1))
      .then(() => DB().ref('coupons/' + code + '/totalDiscountGiven').transaction(v => Math.round((TSMU.num(v) + TSMU.num(discount)) * 100) / 100))
      .catch(e => console.warn('[TSMU coupon]', e.message));
  };

  function couponBox(context) {
    return '<div class="tsmu-cp" id="tsmuCp_' + context + '">' +
      '<div class="tsmu-cp-t">🏷️ Have a coupon code?</div>' +
      '<div class="tsmu-row"><input class="tsmu-in" id="tsmuCpIn_' + context + '" placeholder="Enter code" style="text-transform:uppercase;font-weight:700;letter-spacing:1px">' +
      '<button class="tsmu-btn" id="tsmuCpBtn_' + context + '" onclick="TSMU.applyCouponUI(\'' + context + '\')">Apply</button></div>' +
      '<div id="tsmuCpMsg_' + context + '" style="font-size:12px;margin-top:8px;line-height:1.5"></div></div>';
  }

  TSMU.applyCouponUI = function (context) {
    const inp = document.getElementById('tsmuCpIn_' + context);
    const msg = document.getElementById('tsmuCpMsg_' + context);
    const wrap = document.getElementById('tsmuCp_' + context);
    const btn = document.getElementById('tsmuCpBtn_' + context);
    if (!inp) return;
    if (TSMU.coupon[context]) {   // remove
      TSMU.coupon[context] = null;
      inp.value = ''; inp.disabled = false;
      msg.innerHTML = ''; wrap.className = 'tsmu-cp'; btn.textContent = 'Apply';
      refreshTotals(context);
      return;
    }
    const amount = context === 'order' ? currentOrderBase() : currentFundBase();
    const svc = context === 'order' ? (document.getElementById('serviceSelect') || {}).value : null;
    btn.disabled = true; btn.textContent = '…';
    msg.innerHTML = '<span style="color:var(--text-gray)">Checking…</span>';
    TSMU.validateCoupon(inp.value, context, amount, svc).then(r => {
      btn.disabled = false;
      if (!r.ok) { wrap.className = 'tsmu-cp bad'; msg.innerHTML = '<span style="color:#dc2626;font-weight:600">' + esc(r.msg) + '</span>'; btn.textContent = 'Apply'; TSMU.coupon[context] = null; }
      else {
        TSMU.coupon[context] = r;
        wrap.className = 'tsmu-cp ok';
        msg.innerHTML = '<span style="color:#059669;font-weight:700">' + esc(r.msg) + '</span>';
        inp.disabled = true; btn.textContent = 'Remove';
      }
      refreshTotals(context);
    });
  };

  function currentOrderBase() {
    const el = document.getElementById('totalCharge');
    if (el) { const n = parseFloat(String(el.textContent).replace(/[^\d.]/g, '')); if (Number.isFinite(n)) return n; }
    try {
      const q = TSMU.num((document.getElementById('orderQuantity') || {}).value);
      const p = TSMU.G('selectedPackageData') || {};
      return (q / (TSMU.num(p.quantity, 1000))) * TSMU.num(p.pricePerK);
    } catch (e) { return 0; }
  }
  function currentFundBase() {
    const ids = ['fundAmount', 'dynamicFundAmount', 'amountInput'];
    for (const i of ids) { const e = document.getElementById(i); if (e && e.value) return TSMU.num(e.value); }
    const e2 = document.querySelector('#addFundPage input[type="number"]');
    return e2 ? TSMU.num(e2.value) : 0;
  }

  function refreshTotals(context) {
    if (context === 'order') {
      const c = TSMU.coupon.order, base = currentOrderBase();
      let line = document.getElementById('tsmuOrderDiscLine');
      const host = document.getElementById('totalCharge');
      if (!host) return;
      if (!line) {
        line = document.createElement('div'); line.id = 'tsmuOrderDiscLine';
        line.style.cssText = 'font-size:12.5px;font-weight:700;color:#10b981;margin-top:5px;line-height:1.5';
        host.parentNode.appendChild(line);
      }
      if (c && c.ok) {
        const d = c.coupon.type === 'percent' ? Math.min(base, Math.min(base * TSMU.num(c.coupon.value) / 100, TSMU.num(c.coupon.maxDiscount) > 0 ? TSMU.num(c.coupon.maxDiscount) : Infinity)) : Math.min(base, TSMU.num(c.coupon.value));
        c.discount = Math.round(d * 100) / 100;
        line.innerHTML = '🏷️ Coupon ' + esc(c.code) + ': −' + TSMU.money(c.discount) + '<br>' +
          '<span style="color:var(--text-primary);font-size:15px">You pay: ' + TSMU.money(Math.max(0, base - c.discount)) + '</span>';
      } else line.innerHTML = '';
    } else {
      const c = TSMU.coupon.fund, base = currentFundBase();
      let line = document.getElementById('tsmuFundDiscLine');
      const wrap = document.getElementById('tsmuCp_fund');
      if (!wrap) return;
      if (!line) { line = document.createElement('div'); line.id = 'tsmuFundDiscLine'; line.style.cssText = 'font-size:12.5px;font-weight:700;color:#10b981;margin-top:8px;line-height:1.5'; wrap.appendChild(line); }
      if (c && c.ok && base > 0) {
        const d = c.coupon.type === 'percent' ? Math.min(base * TSMU.num(c.coupon.value) / 100, TSMU.num(c.coupon.maxDiscount) > 0 ? TSMU.num(c.coupon.maxDiscount) : Infinity) : TSMU.num(c.coupon.value);
        c.discount = Math.round(d * 100) / 100;
        line.innerHTML = '🎁 Bonus credit on approval: <b>+' + TSMU.money(c.discount) + '</b><br>You will receive ' + TSMU.money(base + c.discount) + ' in your wallet.';
      } else line.innerHTML = '';
    }
  }
  TSMU.refreshCouponTotals = refreshTotals;

  /* ═════════════════ DRIP-FEED UI ═════════════════ */
  function dripBox() {
    return '<div class="tsmu-drip" id="tsmuDripBox">' +
      '<label style="display:flex;gap:10px;align-items:flex-start;cursor:pointer">' +
      '<input type="checkbox" id="tsmuDripOn" style="width:19px;height:19px;accent-color:var(--primary-color);margin-top:2px" onchange="TSMU.dripToggle()">' +
      '<span><span style="font-weight:800;font-size:13.5px;color:var(--text-primary)">💧 Drip-Feed this order</span>' +
      '<span style="display:block;font-size:11.5px;color:var(--text-gray);margin-top:2px;line-height:1.5" id="tsmuDripHelp">Deliver in timed batches.</span></span></label>' +
      '<div id="tsmuDripFields" style="display:none;margin-top:12px">' +
      '<div class="tsmu-g2">' +
      '<div><label style="font-size:11.5px;font-weight:700;color:var(--text-secondary);display:block;margin-bottom:4px">Number of runs</label>' +
      '<input type="number" class="tsmu-in" id="tsmuDripRuns" value="10" oninput="TSMU.dripPreview()"></div>' +
      '<div><label style="font-size:11.5px;font-weight:700;color:var(--text-secondary);display:block;margin-bottom:4px">Every (minutes)</label>' +
      '<input type="number" class="tsmu-in" id="tsmuDripInt" value="60" oninput="TSMU.dripPreview()"></div></div>' +
      '<div id="tsmuDripPreview" class="tsmu-note tsmu-n-info" style="margin:11px 0 0"></div></div>' +
      '<div id="tsmuSchedWrap" style="display:none;margin-top:12px;padding-top:11px;border-top:1px dashed var(--border-color)">' +
      '<label style="display:flex;gap:10px;align-items:flex-start;cursor:pointer">' +
      '<input type="checkbox" id="tsmuSchedOn" style="width:19px;height:19px;accent-color:var(--primary-color);margin-top:2px" onchange="TSMU.schedToggle()">' +
      '<span><span style="font-weight:800;font-size:13.5px;color:var(--text-primary)">🗓️ Schedule for later</span>' +
      '<span style="display:block;font-size:11.5px;color:var(--text-gray);margin-top:2px">Start this order at a specific date and time.</span></span></label>' +
      '<input type="datetime-local" class="tsmu-in" id="tsmuSchedAt" style="display:none;margin-top:9px"></div>' +
      '</div>';
  }

  TSMU.dripToggle = function () {
    const on = document.getElementById('tsmuDripOn').checked;
    document.getElementById('tsmuDripFields').style.display = on ? '' : 'none';
    document.getElementById('tsmuDripBox').classList.toggle('on', on || (document.getElementById('tsmuSchedOn') || {}).checked);
    TSMU.dripPreview();
  };
  TSMU.schedToggle = function () {
    const on = document.getElementById('tsmuSchedOn').checked;
    document.getElementById('tsmuSchedAt').style.display = on ? '' : 'none';
    document.getElementById('tsmuDripBox').classList.toggle('on', on || document.getElementById('tsmuDripOn').checked);
  };
  TSMU.dripPreview = function () {
    const cfg = TSMU.settings.dripFeed || {};
    const box = document.getElementById('tsmuDripPreview'); if (!box) return;
    let runs = TSMU.num((document.getElementById('tsmuDripRuns') || {}).value, 10);
    let iv = TSMU.num((document.getElementById('tsmuDripInt') || {}).value, 60);
    const minR = TSMU.num(cfg.minRuns, 2), maxR = TSMU.num(cfg.maxRuns, 100);
    const minI = TSMU.num(cfg.minInterval, 30), maxI = TSMU.num(cfg.maxInterval, 1440);
    const qty = TSMU.num((document.getElementById('orderQuantity') || {}).value);
    const problems = [];
    if (runs < minR || runs > maxR) problems.push('Runs must be between ' + minR + ' and ' + maxR + '.');
    if (iv < minI || iv > maxI) problems.push('Interval must be between ' + minI + ' and ' + maxI + ' minutes.');
    if (qty && runs > 0 && Math.floor(qty / runs) < 1) problems.push('Quantity is too small for ' + runs + ' runs.');
    const fee = TSMU.num(cfg.feePercent);
    if (problems.length) { box.className = 'tsmu-note tsmu-n-warn'; box.innerHTML = '⚠️ ' + problems.join('<br>⚠️ '); return; }
    const per = qty ? Math.floor(qty / runs) : 0;
    const hours = Math.round((runs * iv / 60) * 10) / 10;
    box.className = 'tsmu-note tsmu-n-info';
    box.innerHTML = '📦 <b>' + (per ? TSMU.int(per) : '—') + '</b> delivered every <b>' + iv + ' min</b>, ' + runs + ' times.<br>' +
      '⏱️ Completes in about <b>' + hours + ' hour(s)</b>.' +
      (fee > 0 ? '<br>💰 Drip-feed fee: <b>+' + fee + '%</b> on the order total.' : '');
  };

  TSMU.dripConfig = function () {
    const cfg = TSMU.settings.dripFeed || {};
    const on = (document.getElementById('tsmuDripOn') || {}).checked;
    const sOn = (document.getElementById('tsmuSchedOn') || {}).checked;
    const out = { drip: null, scheduleAt: null, fee: 0 };
    if (sOn) {
      const v = (document.getElementById('tsmuSchedAt') || {}).value;
      if (v) {
        const t = new Date(v).getTime();
        const maxA = TSMU.num(cfg.maxAheadDays, 30) * 864e5;
        if (t < Date.now() - 60000) return { error: 'The scheduled time is in the past.' };
        if (t > Date.now() + maxA) return { error: 'You can only schedule up to ' + TSMU.num(cfg.maxAheadDays, 30) + ' days ahead.' };
        out.scheduleAt = t;
      }
    }
    if (on) {
      const runs = TSMU.num(document.getElementById('tsmuDripRuns').value);
      const iv = TSMU.num(document.getElementById('tsmuDripInt').value);
      const qty = TSMU.num((document.getElementById('orderQuantity') || {}).value);
      if (runs < TSMU.num(cfg.minRuns, 2) || runs > TSMU.num(cfg.maxRuns, 100)) return { error: 'Invalid number of drip runs.' };
      if (iv < TSMU.num(cfg.minInterval, 30) || iv > TSMU.num(cfg.maxInterval, 1440)) return { error: 'Invalid drip interval.' };
      if (!qty || Math.floor(qty / runs) < 1) return { error: 'Quantity is too small to split into ' + runs + ' runs.' };
      out.drip = { runs: runs, intervalMinutes: iv, perRun: Math.floor(qty / runs), totalQuantity: qty };
      out.fee = TSMU.num(cfg.feePercent);
    }
    return out;
  };

  /* ═════════════════ MOUNT THE UI ═════════════════ */
  function mount() {
    // Coupon + drip on the New Order form
    const totalWrap = document.getElementById('totalCharge');
    const orderPanel = document.getElementById('singleOrderPanel');
    if (orderPanel && !document.getElementById('tsmuCp_order')) {
      const anchor = totalWrap ? (totalWrap.closest('.order-total') || totalWrap.parentNode) : null;
      const holder = document.createElement('div');
      holder.innerHTML = couponBox('order') + dripBox();
      const btn = document.getElementById('placeOrderBtn');
      if (btn && btn.parentNode) btn.parentNode.insertBefore(holder, btn);
      else if (anchor && anchor.parentNode) anchor.parentNode.insertBefore(holder, anchor.nextSibling);
      else orderPanel.appendChild(holder);
      applyDripVisibility();
      const q = document.getElementById('orderQuantity');
      if (q) q.addEventListener('input', () => { TSMU.dripPreview(); refreshTotals('order'); });
    }
    // Coupon on Add Funds
    const fundPage = document.getElementById('addFundPage');
    if (fundPage && !document.getElementById('tsmuCp_fund')) {
      const cont = fundPage.querySelector('.container');
      const hist = document.getElementById('fundHistory');
      const holder = document.createElement('div');
      holder.innerHTML = '<div class="tsmu-card">' + couponBox('fund') + '</div>';
      if (hist && hist.parentNode) hist.parentNode.insertBefore(holder, hist.closest('.order-form-card') || hist);
      else if (cont) cont.appendChild(holder);
      fundPage.querySelectorAll('input[type="number"]').forEach(i => i.addEventListener('input', () => refreshTotals('fund')));
    }
  }
  function applyDripVisibility() {
    const cfg = TSMU.settings.dripFeed || {};
    const box = document.getElementById('tsmuDripBox'); if (!box) return;
    box.style.display = (cfg.enabled || cfg.scheduleEnabled) ? '' : 'none';
    const lbl = box.querySelector('label'); if (lbl) lbl.style.display = cfg.enabled ? '' : 'none';
    const sw = document.getElementById('tsmuSchedWrap'); if (sw) sw.style.display = cfg.scheduleEnabled ? '' : 'none';
    const h = document.getElementById('tsmuDripHelp'); if (h && cfg.helpText) h.textContent = cfg.helpText;
    const r = document.getElementById('tsmuDripRuns'), iv = document.getElementById('tsmuDripInt');
    if (r) { r.min = TSMU.num(cfg.minRuns, 2); r.max = TSMU.num(cfg.maxRuns, 100); }
    if (iv) { iv.min = TSMU.num(cfg.minInterval, 30); iv.max = TSMU.num(cfg.maxInterval, 1440); }
  }
  const prevOnSettings = TSMU.onSettings;
  TSMU.onSettings = function (k) {
    if (prevOnSettings) try { prevOnSettings(k); } catch (e) { }
    if (k === 'dripFeed') applyDripVisibility();
  };

  /* ═════════════════ HOOKS INTO EXISTING FUNCTIONS ═════════════════ */
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };

  /* --- place order: status gate → coupon discount → drip → ledger --- */
  wrap('placeNewOrder', orig => async function () {
    if (!TSMU.allow('order')) return;

    const cfgDrip = TSMU.dripConfig();
    if (cfgDrip.error) { TSMU.toast('💧 ' + cfgDrip.error, 'error'); return; }

    const uid = TSMU.uid();
    const before = uid ? TSMU.num((await DB().ref('users/' + uid + '/balance').once('value')).val()) : null;
    const cp = TSMU.coupon.order;

    // Pre-credit the coupon discount so the panel's own atomic deduction
    // charges the discounted price — no changes needed inside placeNewOrder.
    let credited = 0;
    if (cp && cp.ok && cp.discount > 0 && uid) {
      credited = cp.discount;
      await DB().ref('users/' + uid + '/balance').transaction(b => Math.round((TSMU.num(b) + credited) * 10000) / 10000);
    }
    // Drip fee is charged the same way, in reverse.
    let feeAmt = 0;
    if (cfgDrip.drip && cfgDrip.fee > 0 && uid) {
      feeAmt = Math.round(currentOrderBase() * cfgDrip.fee) / 100;
      if (feeAmt > 0) await DB().ref('users/' + uid + '/balance').transaction(b => Math.round((TSMU.num(b) - feeAmt) * 10000) / 10000);
    }

    let lastKeyBefore = null;
    try {
      const s0 = await DB().ref('users/' + uid + '/orders').limitToLast(1).once('value');
      s0.forEach(c => { lastKeyBefore = c.key; });
    } catch (e) { }

    let result;
    try { result = await orig.apply(this, arguments); }
    catch (e) {
      if (credited) await DB().ref('users/' + uid + '/balance').transaction(b => TSMU.num(b) - credited);
      if (feeAmt) await DB().ref('users/' + uid + '/balance').transaction(b => TSMU.num(b) + feeAmt);
      throw e;
    }

    setTimeout(async () => {
      try {
        const after = TSMU.num((await DB().ref('users/' + uid + '/balance').once('value')).val());
        const spentNow = Math.round(((before + credited - feeAmt) - after) * 10000) / 10000;

        // find the newest order so we can tell "free order" apart from "order failed"
        const snap = await DB().ref('users/' + uid + '/orders').limitToLast(1).once('value');
        let oid = null, okey = null, o = null;
        snap.forEach(c => { okey = c.key; o = c.val() || {}; oid = o.orderId || c.key; });
        const placed = !!(okey && okey !== lastKeyBefore);

        if (!placed) {
          // order did not go through -> roll the coupon credit back
          if (credited) await DB().ref('users/' + uid + '/balance').transaction(b => TSMU.num(b) - credited);
          if (feeAmt) await DB().ref('users/' + uid + '/balance').transaction(b => TSMU.num(b) + feeAmt);
          return;
        }

        // FREE orders cost nothing but must still appear in the wallet statement
        await TSMU.writeLedger({
          type: 'order',
          amount: Math.max(0, spentNow),
          balanceBefore: before, balanceAfter: after,
          note: (o && o.serviceName ? o.serviceName + ' · ' + (o.packageName || '') : 'New order') +
            (spentNow <= 0 ? ' — FREE service (no charge)' : ''),
          ref: oid
        });

        if (credited && cp) {
          await TSMU.writeLedger({ type: 'coupon', amount: credited, balanceAfter: after, note: 'Coupon ' + cp.code + ' discount applied', ref: oid });
          await TSMU.redeemCoupon(cp.code, 'order', currentOrderBase(), credited, oid);
          TSMU.coupon.order = null;
          const w = document.getElementById('tsmuCp_order');
          if (w) { w.className = 'tsmu-cp'; document.getElementById('tsmuCpIn_order').value = ''; document.getElementById('tsmuCpIn_order').disabled = false; document.getElementById('tsmuCpBtn_order').textContent = 'Apply'; document.getElementById('tsmuCpMsg_order').innerHTML = ''; }
          const dl = document.getElementById('tsmuOrderDiscLine'); if (dl) dl.innerHTML = '';
        }

        if (cfgDrip.drip || cfgDrip.scheduleAt) {
          const rec = Object.assign({
            uid: uid, email: ((TSMU.G('currentUser') && TSMU.G('currentUser').email)) || null,
            orderId: oid, orderKey: okey,
            serviceName: (o && o.serviceName) || '', packageName: (o && o.packageName) || '',
            link: (o && o.link) || '',
            status: cfgDrip.scheduleAt ? 'scheduled' : 'running',
            completedRuns: 0, delivered: 0, createdAt: Date.now(),
            nextRunAt: cfgDrip.scheduleAt || Date.now() + (cfgDrip.drip ? cfgDrip.drip.intervalMinutes * 60000 : 0)
          }, cfgDrip.drip || { runs: 1, intervalMinutes: 0, perRun: TSMU.num(o && o.quantity), totalQuantity: TSMU.num(o && o.quantity) });
          await DB().ref('drip_orders').push(rec);
          if (okey) await DB().ref('users/' + uid + '/orders/' + okey).update({
            dripEnabled: !!cfgDrip.drip, dripRuns: cfgDrip.drip ? cfgDrip.drip.runs : null,
            dripInterval: cfgDrip.drip ? cfgDrip.drip.intervalMinutes : null,
            scheduledAt: cfgDrip.scheduleAt || null,
            status: cfgDrip.scheduleAt ? 'scheduled' : (o && o.status) || 'pending'
          });
          if (feeAmt) await TSMU.writeLedger({ type: 'admin_sub', amount: feeAmt, note: 'Drip-feed service fee (' + cfgDrip.fee + '%)', ref: oid });
          TSMU.toast(cfgDrip.scheduleAt ? '🗓️ Order scheduled for ' + TSMU.dt(cfgDrip.scheduleAt) : '💧 Drip-feed activated — ' + cfgDrip.drip.runs + ' runs', 'success');
          const d = document.getElementById('tsmuDripOn'); if (d) { d.checked = false; TSMU.dripToggle(); }
          const s2 = document.getElementById('tsmuSchedOn'); if (s2) { s2.checked = false; TSMU.schedToggle(); }
        }
      } catch (e) { console.warn('[TSMU order hook]', e); }
    }, 1400);

    return result;
  });

  /* --- fund request: status gate + coupon bonus attached --- */
  wrap('submitDynamicFundRequest', orig => async function () {
    if (!TSMU.allow('fund')) return;
    const cp = TSMU.coupon.fund;
    const out = await orig.apply(this, arguments);
    if (cp && cp.ok && cp.discount > 0) {
      setTimeout(async () => {
        try {
          const uid = TSMU.uid();
          const snap = await DB().ref('users/' + uid + '/fundRequests').limitToLast(1).once('value');
          let key = null, f = null;
          snap.forEach(c => { key = c.key; f = c.val() || {}; });
          if (!key) return;
          await DB().ref('users/' + uid + '/fundRequests/' + key).update({
            couponCode: cp.code, couponBonus: cp.discount, couponPending: true
          });
          await DB().ref('adminPanel/fundRequests/' + (f.requestId || key)).update({ couponCode: cp.code, couponBonus: cp.discount }).catch(() => { });
          await TSMU.redeemCoupon(cp.code, 'fund', currentFundBase(), cp.discount, f.requestId || key);
          TSMU.toast('🎁 Coupon ' + cp.code + ' attached — ' + TSMU.money(cp.discount) + ' bonus will be added when your deposit is approved.', 'success');
          TSMU.coupon.fund = null;
          const w = document.getElementById('tsmuCp_fund');
          if (w) { w.className = 'tsmu-cp'; const i = document.getElementById('tsmuCpIn_fund'); if (i) { i.value = ''; i.disabled = false; } const b = document.getElementById('tsmuCpBtn_fund'); if (b) b.textContent = 'Apply'; const m = document.getElementById('tsmuCpMsg_fund'); if (m) m.innerHTML = ''; }
          const l = document.getElementById('tsmuFundDiscLine'); if (l) l.innerHTML = '';
        } catch (e) { console.warn('[TSMU fund hook]', e); }
      }, 1500);
    }
    return out;
  });

  /* --- other gated actions --- */
  ['submitRefillRequest', 'submitNewTicket', 'submitTicketReply', 'submitPanelOrder', 'placeMassOrder', 'regenerateApiKey']
    .forEach(fn => wrap(fn, orig => function () {
      const what = fn.indexOf('Refill') >= 0 ? 'refill' : fn.indexOf('Ticket') >= 0 ? 'ticket' : fn.indexOf('Panel') >= 0 ? 'panel' : fn.indexOf('Api') >= 0 ? 'api' : 'order';
      if (!TSMU.allow(what)) return;
      return orig.apply(this, arguments);
    }));

  /* --- mass order ledger --- */
  wrap('placeMassOrder', orig => async function () {
    const uid = TSMU.uid();
    const before = uid ? TSMU.num((await DB().ref('users/' + uid + '/balance').once('value')).val()) : null;
    const out = await orig.apply(this, arguments);
    if (uid && before != null) setTimeout(async () => {
      try {
        const after = TSMU.num((await DB().ref('users/' + uid + '/balance').once('value')).val());
        const d = Math.round((before - after) * 10000) / 10000;
        if (d > 0) TSMU.writeLedger({ type: 'mass_order', amount: d, balanceBefore: before, balanceAfter: after, note: 'Mass order batch submitted' });
      } catch (e) { }
    }, 1500);
    return out;
  });

  /* --- keep the coupon total in sync with the panel's own recalculation --- */
  wrap('calculateTotal', orig => function () {
    const r = orig.apply(this, arguments);
    try { refreshTotals('order'); TSMU.dripPreview(); } catch (e) { }
    return r;
  });
  wrap('loadPackageDetails', orig => function () { const r = orig.apply(this, arguments); setTimeout(() => refreshTotals('order'), 60); return r; });
  wrap('resetOrderForm', orig => function () {
    const r = orig.apply(this, arguments);
    try {
      TSMU.coupon.order = null;
      const w = document.getElementById('tsmuCp_order');
      if (w) { w.className = 'tsmu-cp'; const i = document.getElementById('tsmuCpIn_order'); if (i) { i.value = ''; i.disabled = false; } const b = document.getElementById('tsmuCpBtn_order'); if (b) b.textContent = 'Apply'; const m = document.getElementById('tsmuCpMsg_order'); if (m) m.innerHTML = ''; }
      const l = document.getElementById('tsmuOrderDiscLine'); if (l) l.innerHTML = '';
    } catch (e) { }
    return r;
  });

  TSMU.onReady(function () {
    TSMU.registerMount(function () { mount(); applyDripVisibility(); });
  });
})();


/* ---------- 04-resilience-hooks.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v26 USER · PART 4 — RESILIENCE, PERFORMANCE & BOOT (Gap #11 + #12)
   • Retry-able loaders for every empty-screen risk
   • Skeleton + friendly error states on the main lists
   • Lazy festival FX so the first paint is fast
   • Signup referral bonus + order cost snapshot (feeds admin profit report)
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const DB = () => TSMU.db();
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };

  /* ── 1. Never leave a blank screen: wrap the risky loaders ── */
  const LOADERS = [
    ['loadUserOrders', 'ordersContainer', '📋', 'No orders yet', 'Your orders will appear here once you place one.'],
    ['loadFundHistory', 'fundHistory', '💰', 'No deposits yet', 'Your payment history will appear here.'],
    ['loadNotifications', 'notificationList', '🔔', 'No notifications', 'You are all caught up.'],
    ['loadUserTickets', 'ticketsHistoryContainer', '🎫', 'No tickets yet', 'Raise a ticket if you need help.'],
    ['renderServicesCatalog', 'servicesCatalogContainer', '📦', 'No services available', 'Please check back soon.'],
    ['displayRefillOrders', 'refillOrdersContainer', '🔄', 'Nothing to refill', 'Completed orders eligible for refill show up here.'],
    ['loadMyPanelOrders', 'myPanelOrdersContainer', '🖥️', 'No panel orders', 'Your panel purchases appear here.'],
    ['loadCommissionHistory', 'commissionHistoryList', '🤝', 'No commission yet', 'Invite friends to start earning wallet credit.']
  ];
  /** A loader must never leave a stale spinner on screen. We only show one when
      the box is genuinely empty, and we always give the panel's own renderer the
      last word before falling back to an empty state.                          */
  const RERENDER = {
    notificationList: 'renderNotifications',
    ordersContainer: 'displayOrders',
    refillOrdersContainer: 'displayRefillOrders',
    ticketsHistoryContainer: 'displayTicketsHistory',
    fundHistory: 'displayFundHistory',
    servicesCatalogContainer: 'renderServicesCatalog'
  };
  function meaningful(box) {
    if (!box) return true;
    const t = (box.textContent || '').trim();
    return t.length > 0 && !/^(loading|please wait)/i.test(t) && !/tsmu-load/.test(box.innerHTML);
  }
  LOADERS.forEach(([fn, boxId, icon, msg, sub]) => {
    wrap(fn, orig => function () {
      const box = document.getElementById(boxId);
      const showSpinner = box && !meaningful(box) && !box.dataset.tsmuTouched;
      if (showSpinner) { box.dataset.tsmuTouched = '1'; TSMU.loading(box, 'Loading…'); }
      let out;
      try { out = orig.apply(this, arguments); }
      catch (e) { TSMU.fail(boxId, e, fn + '()'); return; }
      const settle = () => {
        const b = document.getElementById(boxId);
        if (!b || meaningful(b)) return;
        const rr = RERENDER[boxId];                       // let the panel try again
        if (rr && typeof window[rr] === 'function') { try { window[rr](); } catch (e) { } }
        setTimeout(() => {
          const b2 = document.getElementById(boxId);
          if (!b2 || meaningful(b2)) return;
          if (!navigator.onLine) TSMU.fail(b2, new Error('You appear to be offline'), fn + '()');
          else TSMU.empty(b2, icon, msg, sub);
        }, 500);
      };
      setTimeout(settle, 2500);
      setTimeout(settle, 8000);
      if (out && typeof out.catch === 'function') out.catch(e => TSMU.fail(boxId, e, fn + '()'));
      return out;
    });
  });

  /* Opening the Notifications page from the menu must render the list, exactly
     like tapping the bell does. */
  wrap('navigateTo', orig => function (pageId) {
    const r = orig.apply(this, arguments);
    if (pageId === 'notificationPage') setTimeout(() => {
      try { if (window.renderNotifications) renderNotifications(); } catch (e) { }
    }, 120);
    return r;
  });

  /* ── 2. Cost snapshot on every new order (makes admin profit exact) ── */
  wrap('placeNewOrder', orig => async function () {
    let snap = null;
    try {
      const sid = (document.getElementById('serviceSelect') || {}).value;
      const pid = (document.getElementById('packageSelect') || {}).value;
      const qty = TSMU.num((document.getElementById('orderQuantity') || {}).value);
      if (sid && pid && qty) {
        const p = (await DB().ref('services/' + sid + '/packages/' + pid).once('value')).val() || {};
        const unit = Math.max(1, TSMU.num(p.quantity, 1000));
        let costK = TSMU.num(p.costPerK != null ? p.costPerK : p.costPrice, NaN);
        if (!Number.isFinite(costK) && Number.isFinite(TSMU.num(p.marginPercent, NaN))) {
          const m = TSMU.num(p.marginPercent);
          if (m > 0 && m < 100) costK = TSMU.num(p.pricePerK) * (1 - m / 100);
        }
        if (Number.isFinite(costK)) snap = Math.round(((qty / unit) * costK) * 10000) / 10000;
      }
    } catch (e) { }
    const out = await orig.apply(this, arguments);
    if (snap != null) setTimeout(async () => {
      try {
        const uid = TSMU.uid();
        const s = await DB().ref('users/' + uid + '/orders').limitToLast(1).once('value');
        let key = null; s.forEach(c => { key = c.key; });
        if (key) DB().ref('users/' + uid + '/orders/' + key + '/costSnapshot').set(snap).catch(() => { });
      } catch (e) { }
    }, 1600);
    return out;
  });

  /* ── 3. Referral signup bonus (from the new admin rules) ── */
  wrap('processSignupReferralCode', orig => async function () {
    const out = await orig.apply(this, arguments);
    try {
      const cfg = (await DB().ref('admin_settings/referral').once('value')).val() || {};
      if (cfg.enabled === false) return out;
      const uid = TSMU.uid(); if (!uid) return out;
      const me = (await DB().ref('users/' + uid).once('value')).val() || {};
      const rid = me.referrer_user_id;
      if (!rid) return out;
      const flag = 'users/' + uid + '/signupBonusPaid';
      const already = (await DB().ref(flag).once('value')).val();
      if (already) return out;
      await DB().ref(flag).set(Date.now());

      const bMe = TSMU.num(cfg.signup_bonus_referee), bThem = TSMU.num(cfg.signup_bonus_referrer);
      if (bMe > 0) {
        const r = await DB().ref('users/' + uid + '/balance').transaction(b => Math.round((TSMU.num(b) + bMe) * 10000) / 10000);
        await TSMU.writeLedger({ type: 'signup_bonus', amount: bMe, balanceAfter: TSMU.num(r.snapshot.val()), note: 'Welcome bonus for using a referral code' });
        TSMU.toast('🎉 ' + TSMU.money(bMe) + ' welcome bonus added to your wallet!', 'success');
      }
      if (bThem > 0) {
        const r2 = await DB().ref('users/' + rid + '/balance').transaction(b => Math.round((TSMU.num(b) + bThem) * 10000) / 10000);
        await DB().ref('users/' + rid + '/ledger').push({ type: 'referral', amount: bThem, balanceAfter: TSMU.num(r2.snapshot.val()), note: 'Signup bonus — someone joined with your referral code', at: Date.now(), by: 'system' }).catch(() => { });
        await DB().ref('notifications').push({ user_id: rid, type: 'success', title: '🎁 Referral Signup Bonus', message: TSMU.money(bThem) + ' added to your wallet balance because a new user joined with your code.', read: false, timestamp: Date.now() }).catch(() => { });
      }
    } catch (e) { console.warn('[TSMU signup bonus]', e); }
    return out;
  });

  /* ── 4. Referral page: keep the % and rules live ── */
  wrap('loadReferralSettings', orig => async function () {
    const out = await orig.apply(this, arguments);
    try { TSMU.applyReferralSettings(); } catch (e) { }
    return out;
  });
  wrap('loadReferralPage', orig => function () {
    const r = orig.apply(this, arguments);
    setTimeout(() => { try { TSMU.applyReferralSettings(); } catch (e) { } }, 400);
    return r;
  });

  /* ── 5. Drip / schedule badge inside the order list ── */
  wrap('displayOrders', orig => function () {
    const r = orig.apply(this, arguments);
    setTimeout(() => {
      const uid = TSMU.uid(); if (!uid) return;
      DB().ref('drip_orders').orderByChild('uid').equalTo(uid).limitToLast(60).once('value').then(s => {
        const map = {};
        s.forEach(c => { const v = c.val() || {}; if (v.orderId) map[String(v.orderId)] = v; });
        document.querySelectorAll('#ordersContainer [data-order-id], #ordersContainer tr').forEach(row => {
          const txt = row.textContent || '';
          for (const id in map) {
            if (txt.indexOf(id) >= 0 && !row.querySelector('.tsmu-driptag')) {
              const d = map[id];
              const tag = document.createElement('span');
              tag.className = 'tsmu-tag ' + (d.status === 'completed' ? 't-green' : d.status === 'scheduled' ? 't-blue' : 't-violet') + ' tsmu-driptag';
              tag.style.marginLeft = '6px';
              tag.textContent = d.status === 'scheduled' ? '🗓 ' + TSMU.day(d.nextRunAt) : '💧 ' + TSMU.num(d.completedRuns) + '/' + TSMU.num(d.runs);
              tag.title = 'Drip-feed: ' + TSMU.int(d.delivered) + ' of ' + TSMU.int(d.totalQuantity) + ' delivered';
              const cell = row.querySelector('td') || row;
              cell.appendChild(tag);
              break;
            }
          }
        });
      }).catch(() => { });
    }, 700);
    return r;
  });

  /* ── 6. Performance: only run the festival canvas when it is actually needed ── */
  try {
    const io = 'requestIdleCallback' in window ? window.requestIdleCallback : cb => setTimeout(cb, 1500);
    io(() => {
      // pause heavy canvas FX when the tab is hidden — saves battery & CPU on mobile
      document.addEventListener('visibilitychange', () => {
        const c = document.querySelector('canvas[id*="fct"], canvas[id*="fx"], #fctCanvas');
        if (c) c.style.visibility = document.hidden ? 'hidden' : '';
      });
    });
  } catch (e) { }

  /* ── 6b. SESSION DIAGNOSTICS ──
     A silent bounce back to the landing page is impossible to debug, so we
     record why the session ended and tell the user in plain English.        */
  function installSessionGuard() {
    const a = TSMU.authObj(); if (!a || a.__tsmuGuard) return;
    a.__tsmuGuard = true;
    const realSignOut = a.signOut.bind(a);
    a.signOut = function () {
      const intentional = !!TSMU._userLoggingOut;
      const why = intentional ? 'you pressed Logout'
        : (window.__tsmuBlockReason ? 'your account was disabled by the administrator'
          : 'the session was ended by the panel');
      const stack = (new Error().stack || '').split('\n').slice(1, 4).join(' | ');
      try { sessionStorage.setItem('tsmu_last_signout', JSON.stringify({ why: why, intentional: intentional, at: Date.now(), stack: stack })); } catch (e) { }
      console.warn('%c[Session] signOut - ' + why, 'color:#f59e0b;font-weight:bold', stack);
      return realSignOut();
    };
    let hadUser = false;
    a.onAuthStateChanged(function (u) {
      if (u) { hadUser = true; try { sessionStorage.removeItem('tsmu_last_signout'); } catch (e) { } return; }
      if (!hadUser) return;                       // never logged in - normal
      hadUser = false;
      let info = null;
      try { info = JSON.parse(sessionStorage.getItem('tsmu_last_signout') || 'null'); } catch (e) { }
      if (info && info.intentional) return;       // the user asked for it
      setTimeout(() => showSessionNotice(info), 400);
    });
  }
  function showSessionNotice(info) {
    if (document.getElementById('tsmuSessionNotice')) return;
    const host = document.querySelector('#authPage .container') || document.querySelector('#authPage') || document.body;
    const box = document.createElement('div');
    box.id = 'tsmuSessionNotice';
    box.className = 'tsmu-note tsmu-n-warn';
    box.style.cssText += ';margin:12px auto;max-width:460px;text-align:left';
    const reason = (info && info.why) || 'your session ended unexpectedly';
    box.innerHTML = '<b>You were signed out</b> because ' + esc(reason) + '.' +
      '<br><span style="font-size:11.5px;opacity:.9">Please sign in again. If this keeps happening, check your internet connection ' +
      'or contact support.</span>' +
      '<div style="margin-top:9px"><button class="tsmu-btn sm sec" onclick="this.closest(\'#tsmuSessionNotice\').remove()">Dismiss</button></div>';
    host.insertBefore(box, host.firstChild);
  }
  wrap('logoutUser', o => function () { TSMU._userLoggingOut = true; return o.apply(this, arguments); });

  /* ── 7. Boot ── */
  let bootTries = 0;
  function start() {
    const ready = (function () { try { return !!(TSMU.db() && TSMU.authObj()); } catch (e) { return false; } })();
    if (!ready) { if (++bootTries < 150) return setTimeout(start, 120); console.warn('[TSMU] booting without a database handle'); }
    TSMU.boot();
    installSessionGuard();
    const a = TSMU.authObj();
    if (a && a.onAuthStateChanged) {
      a.onAuthStateChanged(u => {
        if (!u) return;
        setTimeout(() => {
          try { TSMU.watchStatus(); } catch (e) { }
          try { TSMU.applyReferralSettings(); } catch (e) { }
          try { TSMU.remountAll(); } catch (e) { }
        }, 700);
      });
    }
    // the panel builds most of its UI after login, so keep re-mounting for a while
    let n = 0;
    const t = setInterval(() => { try { TSMU.remountAll(); } catch (e) { } if (++n > 20) clearInterval(t); }, 1000);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();

  console.log('%c TSMU user hooks installed ', 'background:#10b981;color:#fff;padding:2px 6px;border-radius:4px');
})();


/* ---------- 05-service-live-bridge.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v27 USER · PART 5 — SERVICE MANAGEMENT LIVE BRIDGE
   Fixes found by the admin↔user cross-audit:
     🔴 loadPackages() used .once()  → package dropdown was NOT live
     🔴 loadPackages() ignored `order` → admin drag&drop ordering was lost
     🟠 service.icon was never rendered (dead admin field)
     🟠 no warning if the selected package got disabled/deleted mid-order
     🟠 refill wait time was hard-coded 24h — now admin controlled
     🟠 admin_contact had no admin editor — now live with real fallbacks
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const DB = () => TSMU.db();
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };

  TSMU.svc = { showIcon: false, livePackages: true, guardDisabled: true };
  TSMU.refillRules = { waitHours: 24, windowDays: 0, maxPerOrder: 0 };

  /* ═══════ 1. LIVE, ORDER-SORTED PACKAGE DROPDOWN ═══════
     Design notes (these were the source of three real bugs):
       * The panel rebuilds <select id="serviceSelect"> from scratch whenever the
         services node changes. We restore the value that was there a moment
         before - and ONLY inside that rebuild, never from a stale cache.
       * resetOrderForm() deliberately clears the form. Nothing may resurrect the
         old selection afterwards, or the package list stops re-rendering.
       * "This package is no longer available" must fire only when the package
         truly vanished from the SAME service - never when the user switched
         service themselves.                                                     */
  let pkgRef = null, pkgServiceId = null, lastIds = [], suppressWarn = false;
  TSMU.pick = { sid: '', pid: '' };

  function syncPick() {                       // mirror the DOM, never invent
    const s1 = document.getElementById('serviceSelect'), p1 = document.getElementById('packageSelect');
    TSMU.pick.sid = s1 ? s1.value : '';
    TSMU.pick.pid = p1 ? p1.value : '';
  }
  TSMU.clearPick = function () { TSMU.pick = { sid: '', pid: '' }; pkgServiceId = null; lastIds = []; detachPkg(); };

  function sortPkgs(obj) {
    return Object.entries(obj || {})
      .map(([id, p]) => Object.assign({ id: id }, p, {
        _o: Number.isFinite(Number(p && p.order)) ? Number(p.order) : 999999,
        _c: Number(p && p.createdAt) || 0
      }))
      .sort((a, b) => (a._o - b._o) || (a._c - b._c) || a.id.localeCompare(b.id));
  }
  function detachPkg() { if (pkgRef) { try { pkgRef.off('value'); } catch (e) { } pkgRef = null; } }
  function placeholder() {
    try { return textOr(newOrderControl.packagePlaceholder, NEW_ORDER_DEFAULTS.packagePlaceholder); }
    catch (e) { return 'Select a package'; }
  }
  /** true when the package <select> holds nothing but the placeholder */
  function pkgBoxEmpty(box) {
    return !box || box.options.length === 0 ||
      (box.options.length === 1 && !box.options[0].value);
  }

  function livePackages(force) {
    const sel = document.getElementById('serviceSelect');
    const box = document.getElementById('packageSelect');
    if (!sel || !box) return;
    const serviceId = sel.value;

    if (!serviceId) {                                   // nothing chosen - clear and stop
      if (pkgServiceId !== null) { detachPkg(); pkgServiceId = null; lastIds = []; }
      if (!pkgBoxEmpty(box)) box.innerHTML = '<option value="">' + esc(placeholder()) + '</option>';
      return;
    }
    // already listening to this service AND the list is on screen -> nothing to do
    if (!force && serviceId === pkgServiceId && pkgRef && !pkgBoxEmpty(box)) return;

    const switching = serviceId !== pkgServiceId;
    if (switching) { suppressWarn = true; lastIds = []; setTimeout(() => { suppressWarn = false; }, 1200); }

    detachPkg();
    pkgServiceId = serviceId;
    pkgRef = DB().ref('services/' + serviceId + '/packages');
    pkgRef.on('value', snap => {
      const b = document.getElementById('packageSelect');
      const s2 = document.getElementById('serviceSelect');
      if (!b || !s2 || s2.value !== serviceId) return;   // the user moved on
      const keep = b.value;
      const list = sortPkgs(snap.val()).filter(p => p.enabled !== false);
      const ids = list.map(p => p.id);

      b.innerHTML = list.length
        ? '<option value="">' + esc(placeholder()) + '</option>' +
          list.map(p => '<option value="' + esc(p.id) + '">' + esc(p.name || p.id) + '</option>').join('')
        : '<option value="">' + esc('No packages available for this service') + '</option>';

      if (keep && ids.indexOf(keep) >= 0) {
        b.value = keep;                                  // survives an admin edit
      } else if (keep && !suppressWarn && lastIds.indexOf(keep) >= 0 && TSMU.svc.guardDisabled) {
        // it really did disappear from THIS service while the user had it open
        b.value = '';
        warnPackageGone();
        hideOrderDetails();
      } else {
        b.value = '';
      }
      lastIds = ids;
      syncPick();
    }, e => console.warn('[TSMU packages]', e.message));
  }
  TSMU.refreshPackages = () => livePackages(true);

  function hideOrderDetails() {
    ['priceDisplay', 'descriptionGroup', 'avgTimeGroup'].forEach(id => { const e = document.getElementById(id); if (e) e.style.display = 'none'; });
    const t = document.getElementById('totalCharge'); if (t) t.textContent = TSMU.money(0);
    TSMU.S('selectedPackageData', {});
  }

  function warnPackageGone() {
    let w = document.getElementById('tsmuPkgWarn');
    if (!w) {
      w = document.createElement('div'); w.id = 'tsmuPkgWarn'; w.className = 'tsmu-note tsmu-n-warn';
      const box = document.getElementById('packageSelect');
      if (box && box.parentNode) box.parentNode.appendChild(w); else return;
    }
    w.style.display = 'block';
    w.innerHTML = '&#9888;&#65039; <b>That package is no longer available.</b> The administrator just disabled or removed it. ' +
      'Please choose another package - nothing was charged.';
    try { playSound('error'); } catch (e) { }
    try { showToast('That package is no longer available. Please choose another one.', 'error'); } catch (e) { }
    clearTimeout(warnPackageGone._t);
    warnPackageGone._t = setTimeout(() => { const x = document.getElementById('tsmuPkgWarn'); if (x) x.style.display = 'none'; }, 9000);
  }
  function clearWarn() { const w = document.getElementById('tsmuPkgWarn'); if (w) w.style.display = 'none'; }

  /* watch the package the user currently has open - catch a live disable */
  wrap('loadPackageDetails', orig => function () {
    clearWarn();
    const r = orig.apply(this, arguments);
    syncPick();
    setTimeout(() => {
      const p = TSMU.pkg();
      if (TSMU.svc.guardDisabled && p && p.enabled === false) { warnPackageGone(); hideOrderDetails(); }
    }, 250);
    return r;
  });

  /* the panel's own loader is replaced by the live one */
  wrap('loadPackages', orig => function () {
    if (!TSMU.svc.livePackages) return orig.apply(this, arguments);
    clearWarn();
    try { livePackages(true); } catch (e) { console.warn('[TSMU livePackages]', e); return orig.apply(this, arguments); }
  });

  /* every path that changes the service must refresh the list */
  ['selectCustomService', 'orderNowFromCatalog'].forEach(fn =>
    wrap(fn, orig => function () {
      const r = orig.apply(this, arguments);
      clearWarn();
      setTimeout(() => { try { livePackages(true); } catch (e) { } syncPick(); }, 60);
      return r;
    }));
  wrap('selectPackageFromSearch', orig => function () {
    const r = orig.apply(this, arguments);
    clearWarn();
    setTimeout(() => { try { livePackages(true); } catch (e) { } syncPick(); }, 120);
    return r;
  });

  /* a deliberate reset must leave the form genuinely empty and re-armed */
  wrap('resetOrderForm', orig => function () {
    const r = orig.apply(this, arguments);
    TSMU.clearPick();
    clearWarn();
    setTimeout(() => { try { livePackages(true); } catch (e) { } }, 60);
    return r;
  });

  /* the panel rebuilds the service <select>; put back exactly what was there */
  wrap('displayServices', orig => function () {
    const s1 = document.getElementById('serviceSelect');
    const before = s1 ? s1.value : '';
    const r = orig.apply(this, arguments);
    const s2 = document.getElementById('serviceSelect');
    if (s2 && before && s2.value !== before &&
        Array.prototype.some.call(s2.options, o => o.value === before)) {
      s2.value = before;
      try { if (window.updateServiceDropdownDisplay) updateServiceDropdownDisplay(); } catch (e) { }
      setTimeout(() => { try { livePackages(); } catch (e) { } }, 40);
    }
    setTimeout(() => { paintIcons(); syncPick(); }, 40);
    return r;
  });

  /* ═══════ 2. SERVICE ICON (dead admin field → now rendered) ═══════ */
  function paintIcons() {
    if (!TSMU.svc.showIcon) {
      document.querySelectorAll('.tsmu-svc-icon').forEach(e => e.remove());
      return;
    }
    const map = {};
    (TSMU.G('allServices') || []).forEach(s => { if (s && s.icon) map[s.id] = s.icon; });

    // custom dropdown options
    document.querySelectorAll('#customServiceOptions .custom-service-option').forEach(el => {
      const v = el.dataset.value; if (!v || !map[v] || el.querySelector('.tsmu-svc-icon')) return;
      const i = document.createElement('span');
      i.className = 'tsmu-svc-icon'; i.textContent = map[v];
      i.style.cssText = 'margin-right:6px;font-size:15px;line-height:1';
      const label = el.querySelector('span'); (label || el).insertBefore ? el.insertBefore(i, el.firstChild) : el.appendChild(i);
    });
    // selected display
    const disp = document.getElementById('customServiceSelectedDisplay');
    const sel = document.getElementById('serviceSelect');
    if (disp && sel && map[sel.value] && !disp.querySelector('.tsmu-svc-icon')) {
      const i = document.createElement('span');
      i.className = 'tsmu-svc-icon'; i.textContent = map[sel.value];
      i.style.cssText = 'margin-right:6px;font-size:15px;line-height:1';
      disp.insertBefore(i, disp.firstChild);
    }
    // services catalog headers
    document.querySelectorAll('.catalog-service-card .catalog-service-header h3').forEach(h => {
      if (h.querySelector('.tsmu-svc-icon')) return;
      const name = (h.textContent || '').trim();
      const svc = (TSMU.G('allServices') || []).find(s => (s.name || '').trim() === name);
      if (!svc || !svc.icon) return;
      const i = document.createElement('span');
      i.className = 'tsmu-svc-icon'; i.textContent = svc.icon;
      i.style.cssText = 'margin-right:7px;font-size:17px';
      h.insertBefore(i, h.firstChild);
    });
  }
  wrap('displayServices', orig => function () { const r = orig.apply(this, arguments); setTimeout(paintIcons, 60); return r; });
  wrap('renderServicesCatalog', orig => function () { const r = orig.apply(this, arguments); setTimeout(paintIcons, 60); return r; });
  wrap('updateServiceDropdownDisplay', orig => function () { const r = orig.apply(this, arguments); setTimeout(paintIcons, 40); return r; });

  /* ═══════ 3. ADMIN-CONTROLLED REFILL RULES (was hard-coded 24h) ═══════ */
  wrap('getRefillEligibility', orig => function (order) {
    const waitMs = Math.max(0, TSMU.num(TSMU.refillRules.waitHours, 24)) * 3600000;
    const completedAt = TSMU.num(order && order.completedAt);
    const elapsed = Date.now() - completedAt;
    const remainingMs = Math.max(0, waitMs - elapsed);
    const windowDays = TSMU.num(TSMU.refillRules.windowDays);
    const expired = windowDays > 0 && completedAt > 0 && (Date.now() - completedAt) > windowDays * 864e5;
    const maxN = TSMU.num(TSMU.refillRules.maxPerOrder);
    const used = TSMU.num(order && (order.refillCount || (order.refillStatus ? 1 : 0)));
    const exhausted = maxN > 0 && used >= maxN;
    return { waitOver: remainingMs <= 0 && !expired && !exhausted, remainingMs: remainingMs, expired: expired, exhausted: exhausted };
  });
  wrap('handleRefillClick', orig => function (orderId) {
    const order = (TSMU.orders() || []).find(o => o.id === orderId);
    if (order) {
      const e = getRefillEligibility(order);
      if (e.expired) return TSMU.toast('⌛ The refill window for this order has closed (' + TSMU.refillRules.windowDays + ' days).', 'error');
      if (e.exhausted) return TSMU.toast('🚫 This order has already used all ' + TSMU.refillRules.maxPerOrder + ' allowed refill(s).', 'error');
    }
    return orig.apply(this, arguments);
  });

  /* ═══════ 4. ADMIN CONTACT — real fallbacks, always live ═══════ */
  function watchContact() {
    DB().ref('admin_contact').on('value', s => {
      const c = s.val() || {};
      const set = (id, v) => { const e = document.getElementById(id); if (e && v) e.textContent = v; };
      set('adminContactEmail', c.email);
      set('adminContactWhatsapp', c.whatsapp);
      set('adminContactTelegram', c.telegram);
    }, e => console.warn('[TSMU contact]', e.message));
  }

  /* ═══════ 5. LIVE SETTINGS SUBSCRIPTIONS ═══════ */
  function watchAll() {
    DB().ref('settings/serviceDisplay').on('value', s => {
      TSMU.svc = Object.assign({ showIcon: false, livePackages: true, guardDisabled: true }, s.val() || {});
      paintIcons();
      if (TSMU.svc.livePackages) { try { livePackages(true); } catch (e) { } }
    }, () => { });

    DB().ref('settings/refill').on('value', s => {
      TSMU.refillRules = Object.assign({ waitHours: 24, windowDays: 0, maxPerOrder: 0 }, s.val() || {});
      try { if (window.loadUserOrders && document.getElementById('refillPage')) displayRefillOrders(TSMU.orders() || []); } catch (e) { }
    }, () => { });

    watchContact();

    // services tree changes → repaint the custom dropdown & catalog icons
    DB().ref('services').on('child_changed', () => setTimeout(paintIcons, 120), () => { });
  }

  /* ═══════ 6. SAFETY: re-verify package right before submitting ═══════ */
  wrap('placeNewOrder', orig => async function () {
    if (TSMU.svc.guardDisabled) {
      const sid = (document.getElementById('serviceSelect') || {}).value;
      const pid = (document.getElementById('packageSelect') || {}).value;
      if (sid && pid) {
        try {
          const [svc, pkg] = await Promise.all([
            DB().ref('services/' + sid).once('value'),
            DB().ref('services/' + sid + '/packages/' + pid).once('value')
          ]);
          const sv = svc.val(), pk = pkg.val();
          if (!sv || sv.enabled === false) { warnPackageGone(); TSMU.toast('⚠️ This service was just disabled by the admin.', 'error'); return; }
          if (!pk || pk.enabled === false) { warnPackageGone(); return; }
        } catch (e) { /* network hiccup — let the panel's own server-side check handle it */ }
      }
    }
    return orig.apply(this, arguments);
  });

  TSMU.onReady(function () {
    watchAll();
    TSMU.registerMount(function () { try { livePackages(); } catch (e) { } paintIcons(); });
    // re-attach if the user navigates away and back
    document.addEventListener('visibilitychange', () => { if (!document.hidden) setTimeout(() => { try { livePackages(); } catch (e) { } }, 300); });
    // the service <select> can also be changed directly by the browser UI
    const ss = document.getElementById('serviceSelect');
    if (ss && !ss._tsmuWired) { ss._tsmuWired = 1; ss.addEventListener('change', () => { clearWarn(); setTimeout(() => livePackages(true), 30); }); }
  });

  console.log('%c TSMU v27 service live-bridge loaded ', 'background:#0ea5e9;color:#fff;padding:2px 6px;border-radius:4px');
})();


/* ---------- 06-pricing-limits-discount.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v28 USER · PART 6 — PRICING ENGINE
   1. FREE services          — a rate of exactly 0.0000 is valid everywhere
   2. 4-decimal rates        — 0.0000 precision on every price the user sees
   3. Reseller discounts     — per-user, per-service, per-package
   4. Service usage limits   — N orders per account (lifetime / daily / monthly)
   All user-facing text in this file is ENGLISH ONLY.
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const DB = () => TSMU.db();
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };

  TSMU.discount = { enabled: false };
  TSMU.usage = {};
  TSMU.pkgMeta = {};          // "sid__pid" -> {usageLimit, limitPeriod, name}

  /* ─────────────── number formatting ─────────────── */
  const R4 = v => Math.round((Number(v) || 0) * 10000) / 10000;
  TSMU.r4 = R4;

  /** Rate string, always 4 decimals, "FREE" when zero. */
  TSMU.rateText = function (rawRate, serviceId, packageId) {
    const eff = TSMU.effectiveRate(rawRate, serviceId, packageId);
    if (eff <= 0) return 'FREE';
    const base = Number(rawRate) || 0;
    const cur = (function () { try { return fmt(eff, 4); } catch (e) { return '₹' + eff.toFixed(4); } })();
    if (eff < base - 0.00001) {
      const was = (function () { try { return fmt(base, 4); } catch (e) { return '₹' + base.toFixed(4); } })();
      return '<span style="text-decoration:line-through;opacity:.55;font-weight:500">' + was + '</span> ' +
        '<span style="color:#10b981;font-weight:800">' + cur + '</span>';
    }
    return cur;
  };

  /** Plain (no HTML) rate string — for <option> labels and alerts. */
  TSMU.ratePlain = function (rawRate, serviceId, packageId) {
    const eff = TSMU.effectiveRate(rawRate, serviceId, packageId);
    if (eff <= 0) return 'FREE';
    try { return fmt(eff, 4); } catch (e) { return '₹' + eff.toFixed(4); }
  };

  /** Zero shown as a real amount (0.0000) — never the word FREE. */
  TSMU.zeroText = function () {
    try { return formatCurrency(0, 4); } catch (e) { return '₹0.0000'; }
  };
  /**
   * Order total string.
   *  - no quantity yet            -> ₹0.0000   (an empty form is not "free")
   *  - package rate is really 0   -> FREE      (admin set the package free)
   *  - anything else              -> the calculated amount
   */
  TSMU.totalText = function (total, opts) {
    opts = opts || {};
    const t = R4(total);
    if (t <= 0) {
      if (opts.freePackage && opts.hasQty) return 'FREE';
      return TSMU.zeroText();
    }
    const dec = (Math.abs(t * 100 - Math.round(t * 100)) > 1e-9) ? 4 : 2;
    try { return formatCurrency(t, dec); } catch (e) { return '₹' + t.toFixed(dec); }
  };

  /* ─────────────── reseller discount ─────────────── */
  /**
   * Resolution order (most specific wins):
   *   packages[sid__pid]  >  services[sid]  >  global
   * Each level: { type:'percent'|'flat', value:Number }
   */
  TSMU.discountFor = function (serviceId, packageId) {
    const d = TSMU.discount || {};
    if (!d.enabled) return null;
    if (d.expiresAt && Date.now() > Number(d.expiresAt)) return null;
    const key = serviceId + '__' + packageId;
    const pick = (d.packages && d.packages[key]) || (d.services && d.services[serviceId]) ||
      (TSMU.num(d.value) > 0 ? { type: d.type || 'percent', value: d.value } : null);
    if (!pick) return null;
    const v = TSMU.num(pick.value);
    if (!(v > 0)) return null;
    return { type: pick.type || 'percent', value: v, label: pick.label || d.label || '' };
  };

  TSMU.effectiveRate = function (rawRate, serviceId, packageId) {
    let r = Number(rawRate) || 0;
    if (r <= 0) return 0;
    const d = TSMU.discountFor(serviceId, packageId);
    if (!d) return R4(r);
    r = d.type === 'flat' ? r - d.value : r * (1 - d.value / 100);
    const floor = TSMU.num((TSMU.discount || {}).minRate);
    if (floor > 0 && r < floor) r = floor;
    return R4(Math.max(0, r));
  };

  /** Called from inside placeNewOrder (source patch) to charge the discounted price. */
  TSMU.applyDiscountToCost = function (cost, serviceId, packageId, livePrice, quantity, unit) {
    const rate = TSMU.effectiveRate(livePrice, serviceId, packageId);
    const c = R4((TSMU.num(quantity) / Math.max(1, TSMU.num(unit, 1000))) * rate);
    return Number.isFinite(c) && c >= 0 ? c : cost;
  };

  function discountBadge() {
    const d = TSMU.discount || {};
    if (!d.enabled) return null;
    if (d.expiresAt && Date.now() > Number(d.expiresAt)) return null;
    const parts = [];
    if (TSMU.num(d.value) > 0) parts.push(d.type === 'flat' ? TSMU.money(d.value) + ' off per 1K' : TSMU.num(d.value) + '% off everything');
    const ns = d.services ? Object.keys(d.services).length : 0;
    const np = d.packages ? Object.keys(d.packages).length : 0;
    if (ns) parts.push(ns + ' service' + (ns > 1 ? 's' : '') + ' with a special rate');
    if (np) parts.push(np + ' package' + (np > 1 ? 's' : '') + ' with a special rate');
    if (!parts.length) return null;
    return { tier: d.tier || 'Reseller', text: parts.join(' · '), expires: d.expiresAt };
  }

  function paintDiscountBanner() {
    const b = discountBadge();
    const host = document.querySelector('#singleOrderPanel') || document.querySelector('#dashboardPage .container');
    if (!host) return;
    let el = document.getElementById('tsmuDiscBanner');
    if (!b) { if (el) el.remove(); return; }
    const slotNow = TSMU.orderTopSlot ? TSMU.orderTopSlot('wish') : null;
    if (el && slotNow && el.parentNode !== slotNow) slotNow.appendChild(el);
    if (!el) {
      el = document.createElement('div');
      el.id = 'tsmuDiscBanner';
      el.style.cssText = 'margin:0 0 10px;padding:8px 11px;border-radius:11px;background:linear-gradient(135deg,rgba(16,185,129,.13),rgba(14,165,233,.11));border:1px solid rgba(16,185,129,.35);display:flex;gap:9px;align-items:center';
      const slot = TSMU.orderTopSlot ? TSMU.orderTopSlot('wish') : null;   // inside the New Order card, never above its heading
      if (slot) slot.appendChild(el); else host.insertBefore(el, host.firstChild);
    }
    el.innerHTML =
      '<span style="font-size:19px;line-height:1">💎</span>' +
      '<div style="flex:1;min-width:0">' +
      '<div style="font-weight:800;font-size:12px;color:var(--text-primary,#0f172a)">' + esc(b.tier) + '</div>' +
      '<div style="font-size:11px;color:var(--text-secondary,#475569);margin-top:1px;line-height:1.45">' + esc(b.text) +
      (b.expires ? ' · valid until ' + TSMU.day(b.expires) : '') + '</div></div>';
  }

  /* ─────────────── service usage limits ─────────────── */
  function periodKey(period) {
    const d = new Date();
    if (period === 'daily') return 'd' + d.getFullYear() + String(d.getMonth() + 1).padStart(2, '0') + String(d.getDate()).padStart(2, '0');
    if (period === 'weekly') { const t = new Date(d); t.setDate(d.getDate() - d.getDay()); return 'w' + t.getFullYear() + String(t.getMonth() + 1).padStart(2, '0') + String(t.getDate()).padStart(2, '0'); }
    if (period === 'monthly') return 'm' + d.getFullYear() + String(d.getMonth() + 1).padStart(2, '0');
    return 'life';
  }
  const PERIOD_TEXT = { life: 'in total', daily: 'today', weekly: 'this week', monthly: 'this month' };

  TSMU.usagePath = function (sid, pid, period) {
    return 'users/' + TSMU.uid() + '/serviceUsage/' + sid + '__' + pid + '/' + periodKey(period);
  };

  TSMU.limitInfo = function (sid, pid) {
    const m = TSMU.pkgMeta[sid + '__' + pid] || {};
    const limit = TSMU.num(m.usageLimit);
    return { limit: limit, period: m.limitPeriod || 'life', unlimited: !(limit > 0) };
  };

  /** Read-only check used to paint the UI. */
  TSMU.readUsage = function (sid, pid) {
    const info = TSMU.limitInfo(sid, pid);
    if (info.unlimited || !TSMU.uid()) return Promise.resolve({ used: 0, info: info });
    return DB().ref(TSMU.usagePath(sid, pid, info.period)).once('value')
      .then(s => ({ used: TSMU.num(s.val()), info: info }))
      .catch(() => ({ used: 0, info: info }));
  };

  /** Atomic claim — increments only if the user is still under the limit. */
  TSMU.claimUsage = function (sid, pid) {
    const info = TSMU.limitInfo(sid, pid);
    if (info.unlimited || !TSMU.uid()) return Promise.resolve({ ok: true, unlimited: true });
    let blocked = false;
    return DB().ref(TSMU.usagePath(sid, pid, info.period)).transaction(v => {
      const n = TSMU.num(v);
      if (n >= info.limit) { blocked = true; return; }
      return n + 1;
    }).then(res => {
      if (!res.committed || blocked) return { ok: false, info: info, used: info.limit };
      return { ok: true, info: info, used: TSMU.num(res.snapshot.val()) };
    }).catch(() => ({ ok: true, softFail: true }));
  };

  TSMU.releaseUsage = function (sid, pid) {
    const info = TSMU.limitInfo(sid, pid);
    if (info.unlimited || !TSMU.uid()) return Promise.resolve();
    return DB().ref(TSMU.usagePath(sid, pid, info.period))
      .transaction(v => Math.max(0, TSMU.num(v) - 1)).catch(() => { });
  };

  function limitReachedPopup(info, pkgName) {
    const when = PERIOD_TEXT[info.period] || 'in total';
    const resetLine = info.period === 'life'
      ? 'This is a one-time limit for your account and does not reset.'
      : 'Your limit resets automatically at the start of the next ' +
      (info.period === 'daily' ? 'day' : info.period === 'weekly' ? 'week' : 'month') + '.';
    const html =
      '<div style="text-align:center">' +
      '<div style="font-size:52px;line-height:1;margin-bottom:12px">🚫</div>' +
      '<h3 style="font-size:18px;font-weight:800;color:#dc2626;margin-bottom:9px">Usage Limit Reached</h3>' +
      '<p style="font-size:13.5px;line-height:1.7;color:var(--text-secondary,#475569);margin-bottom:12px">' +
      'You have already used <b>' + esc(pkgName || 'this service') + '</b> the maximum of <b>' +
      info.limit + ' time' + (info.limit > 1 ? 's' : '') + '</b> ' + when + '.</p>' +
      '<div style="background:rgba(245,158,11,.1);border-left:4px solid #f59e0b;border-radius:10px;padding:11px 13px;font-size:12.5px;line-height:1.6;color:var(--text-secondary,#475569);text-align:left;margin-bottom:14px">' +
      resetLine + '<br>You can still order any other service normally.</div>' +
      '<button class="tsmu-btn" style="width:100%" onclick="TSMU.closeLimitPopup()">Got it</button>' +
      '<button class="tsmu-btn sec" style="width:100%;margin-top:8px" onclick="TSMU.closeLimitPopup();navigateTo(\'servicesPage\')">Browse other services</button>' +
      '</div>';
    let m = document.getElementById('tsmuLimitMask');
    if (!m) {
      m = document.createElement('div');
      m.id = 'tsmuLimitMask';
      m.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,.62);backdrop-filter:blur(3px);z-index:99992;display:flex;align-items:center;justify-content:center;padding:18px';
      m.onclick = e => { if (e.target === m) TSMU.closeLimitPopup(); };
      document.body.appendChild(m);
    }
    m.innerHTML = '<div style="background:var(--card-bg,#fff);border-radius:18px;max-width:400px;width:100%;padding:22px;box-shadow:0 22px 60px rgba(0,0,0,.32)">' + html + '</div>';
    m.style.display = 'flex';
    try { playSound('error'); } catch (e) { }
  }
  TSMU.closeLimitPopup = function () { const m = document.getElementById('tsmuLimitMask'); if (m) m.style.display = 'none'; };

  /* ─────────────── limit / free / discount hints on the order form ─────────────── */
  function paintPackageHints() {
    const sid = (document.getElementById('serviceSelect') || {}).value;
    const pid = (document.getElementById('packageSelect') || {}).value;
    let box = document.getElementById('tsmuPkgHints');
    const anchor = document.getElementById('priceDisplay') || document.getElementById('packageSelect');
    if (!anchor) return;
    if (!box) {
      box = document.createElement('div');
      box.id = 'tsmuPkgHints';
      box.style.cssText = 'display:flex;flex-wrap:wrap;gap:7px;margin:9px 0 0';
      anchor.parentNode.insertBefore(box, anchor.nextSibling);
    }
    const token = (paintPackageHints._t = (paintPackageHints._t || 0) + 1);
    box.innerHTML = '';
    if (!sid || !pid) { box.style.display = 'none'; return; }

    const pkg = TSMU.G('selectedPackageData') || {};
    const raw = TSMU.num(pkg.pricePerK);
    const eff = TSMU.effectiveRate(raw, sid, pid);
    const chip = (bg, col, text, title) =>
      '<span title="' + esc(title || '') + '" style="display:inline-flex;align-items:center;gap:5px;padding:5px 11px;border-radius:99px;font-size:11.5px;font-weight:800;background:' + bg + ';color:' + col + '">' + text + '</span>';

    if (eff <= 0) box.innerHTML += chip('rgba(16,185,129,.15)', '#059669', '🎁 FREE SERVICE', 'This package costs nothing.');
    const d = TSMU.discountFor(sid, pid);
    if (d && eff > 0) {
      const off = d.type === 'flat' ? TSMU.money(d.value) + ' off / 1K' : d.value + '% OFF';
      box.innerHTML += chip('rgba(14,165,233,.14)', '#0369a1', '💎 ' + off, 'Reseller discount applied to your account.');
    }

    const info = TSMU.limitInfo(sid, pid);
    if (!info.unlimited) {
      TSMU.readUsage(sid, pid).then(r => {
        if (token !== paintPackageHints._t) return;      // a newer render started
        const left = Math.max(0, r.info.limit - r.used);
        const when = PERIOD_TEXT[r.info.period] || 'in total';
        const c = left <= 0 ? ['rgba(239,68,68,.13)', '#dc2626', '🚫 Limit reached (' + r.info.limit + ' ' + when + ')']
          : left === 1 ? ['rgba(245,158,11,.15)', '#b45309', '⚠️ 1 order left ' + when]
            : ['rgba(139,92,246,.14)', '#6d28d9', '🎯 ' + left + ' of ' + r.info.limit + ' orders left ' + when];
        if (document.getElementById('tsmuPkgHints') === box && !box.querySelector('[data-limitchip]')) {
          box.insertAdjacentHTML('beforeend', chip(c[0], c[1], c[2], 'You may order this package ' + r.info.limit + ' time(s) ' + when + '.').replace('<span ', '<span data-limitchip="1" '));
          box.style.display = 'flex';
        }
      });
    }
    if (!box.innerHTML) box.style.display = 'none'; else box.style.display = 'flex';
  }
  TSMU.paintPackageHints = paintPackageHints;

  /* ─────────────── live data ─────────────── */
  let discWatchUid = null;
  function watchDiscount() {
    const uid = TSMU.uid(); if (!uid || uid === discWatchUid) return;
    discWatchUid = uid;
    DB().ref('users/' + uid + '/discount').on('value', s => {
      TSMU.discount = s.val() || { enabled: false };
      paintDiscountBanner();
      repaintPrices();
    }, () => { });
  }

  function watchPackages() {
    DB().ref('services').on('value', s => {
      const meta = {};
      s.forEach(sv => {
        const v = sv.val() || {};
        Object.entries(v.packages || {}).forEach(([pid, p]) => {
          meta[sv.key + '__' + pid] = {
            usageLimit: TSMU.num(p.usageLimit),
            limitPeriod: p.limitPeriod || 'life',
            name: p.name || pid,
            serviceName: v.name || sv.key,
            pricePerK: TSMU.num(p.pricePerK),
            quantity: TSMU.num(p.quantity, 1000),
            badge: p.badge || '', badgeText: p.badgeText || '',
            min: TSMU.num(p.min), max: TSMU.num(p.max), qtyStep: TSMU.num(p.qtyStep)
          };
        });
      });
      TSMU.pkgMeta = meta;
      repaintPrices();
    }, () => { });
  }

  function repaintPrices() {
    try { if (window.calculateTotal) calculateTotal(); } catch (e) { }
    try {
      const sid = (document.getElementById('serviceSelect') || {}).value;
      const pid = (document.getElementById('packageSelect') || {}).value;
      const el = document.getElementById('packagePrice');
      if (el && sid && pid && TSMU.G('selectedPackageData'))
        el.innerHTML = TSMU.rateText(TSMU.num(selectedPackageData.pricePerK), sid, pid);
    } catch (e) { }
    try { if (window.renderServicesCatalog) renderServicesCatalog(((document.getElementById('catalogSearchBox') || {}).value || '').trim()); } catch (e) { }
    paintPackageHints();
    paintDiscountBanner();
  }
  TSMU.repaintPrices = repaintPrices;

  /* ─────────────── hooks ─────────────── */
  wrap('calculateTotal', orig => function () {
    if (!TSMU.G('selectedPackageData')) return orig.apply(this, arguments);
    const sid = (document.getElementById('serviceSelect') || {}).value;
    const pid = (document.getElementById('packageSelect') || {}).value;
    const qtyRaw = String(((document.getElementById('orderQuantity') || {}).value) || '').replace(/[,\s_]/g, '');
    const qty = TSMU.num(qtyRaw);
    const unit = Math.max(1, TSMU.num(selectedPackageData.quantity, 1000));
    const rate = TSMU.effectiveRate(TSMU.num(selectedPackageData.pricePerK), sid, pid);
    const total = R4((qty / unit) * rate);
    const el = document.getElementById('totalCharge');
    if (el) {
      el.innerHTML = TSMU.totalText(total, { hasQty: qtyRaw !== '' && qty > 0, freePackage: rate <= 0 });
      const raw = R4((qty / unit) * TSMU.num(selectedPackageData.pricePerK));
      let save = document.getElementById('tsmuSaveLine');
      if (raw > total + 0.00001) {
        if (!save) { save = document.createElement('div'); save.id = 'tsmuSaveLine'; save.style.cssText = 'font-size:12px;font-weight:700;color:#10b981;margin-top:4px'; el.parentNode.appendChild(save); }
        save.textContent = 'You save ' + TSMU.money(raw - total) + ' with your reseller discount';
      } else if (save) save.remove();
    }
    return true;
  });

  wrap('loadPackageDetails', orig => function () {
    const r = orig.apply(this, arguments);
    setTimeout(() => { repaintPrices(); paintPackageHints(); }, 220);
    return r;
  });
  wrap('selectPackageFromSearch', orig => function () { const r = orig.apply(this, arguments); setTimeout(paintPackageHints, 320); return r; });
  wrap('loadPackages', orig => function () { const r = orig.apply(this, arguments); setTimeout(paintPackageHints, 320); return r; });

  /* search results + mass-order builder should also show the real (discounted) rate */
  wrap('searchPackages', orig => function () {
    const r = orig.apply(this, arguments);
    setTimeout(() => {
      document.querySelectorAll('#packageSearchDropdown [data-service-id][data-package-id]').forEach(el => {
        const sid = el.dataset.serviceId, pid = el.dataset.packageId;
        const m = TSMU.pkgMeta[sid + '__' + pid]; if (!m) return;
        const p = el.querySelector('.search-package-price, .package-price');
        if (p) p.innerHTML = TSMU.rateText(m.pricePerK, sid, pid) + ' / ' + m.quantity;
      });
    }, 60);
    return r;
  });

  /* the real gate: claim a usage slot before the order, release it if it failed */
  wrap('placeNewOrder', orig => async function () {
    const sid = (document.getElementById('serviceSelect') || {}).value;
    const pid = (document.getElementById('packageSelect') || {}).value;
    let claimed = false;

    if (sid && pid) {
      const info = TSMU.limitInfo(sid, pid);
      if (!info.unlimited) {
        const c = await TSMU.claimUsage(sid, pid);
        if (!c.ok) {
          const m = TSMU.pkgMeta[sid + '__' + pid] || {};
          limitReachedPopup(info, (m.serviceName ? m.serviceName + ' - ' : '') + (m.name || 'this package'));
          return;
        }
        claimed = !c.unlimited && !c.softFail;
      }
    }

    let before = null;
    try { before = (await DB().ref('users/' + TSMU.uid() + '/orders').limitToLast(1).once('value')).numChildren ? null : null; } catch (e) { }
    let lastKeyBefore = null;
    try {
      const s = await DB().ref('users/' + TSMU.uid() + '/orders').limitToLast(1).once('value');
      s.forEach(c => { lastKeyBefore = c.key; });
    } catch (e) { }

    let out;
    try { out = await orig.apply(this, arguments); }
    catch (e) { if (claimed) await TSMU.releaseUsage(sid, pid); throw e; }

    // verify the order really landed; if not, give the usage slot back
    setTimeout(async () => {
      try {
        let lastKeyAfter = null, lastOrder = null;
        const s = await DB().ref('users/' + TSMU.uid() + '/orders').limitToLast(1).once('value');
        s.forEach(c => { lastKeyAfter = c.key; lastOrder = c.val(); });
        const placed = lastKeyAfter && lastKeyAfter !== lastKeyBefore;
        if (!placed) { if (claimed) await TSMU.releaseUsage(sid, pid); }
        else if (lastOrder) {
          // stamp discount details onto the order for full transparency
          const rawRate = TSMU.num(lastOrder.pricePerK);
          const d = TSMU.discountFor(sid, pid);
          const patch = {};
          if (d) {
            const listRate = TSMU.num(TSMU.pkgMeta[sid + '__' + pid] && TSMU.pkgMeta[sid + '__' + pid].pricePerK, rawRate);
            patch.listPricePerK = listRate;
            patch.discountType = d.type;
            patch.discountValue = d.value;
            patch.discountLabel = d.label || (TSMU.discount || {}).tier || 'Reseller';
            const unit = Math.max(1, TSMU.num(lastOrder.pricingQuantity, 1000));
            patch.discountAmount = R4(((TSMU.num(lastOrder.quantity) / unit) * listRate) - TSMU.num(lastOrder.amount));
          }
          if (TSMU.num(lastOrder.amount) <= 0) patch.freeOrder = true;
          if (!TSMU.limitInfo(sid, pid).unlimited) patch.usageCounted = true;
          if (Object.keys(patch).length) DB().ref('users/' + TSMU.uid() + '/orders/' + lastKeyAfter).update(patch).catch(() => { });
        }
        paintPackageHints();
      } catch (e) { }
    }, 1700);

    return out;
  });

  /* free orders should not say "insufficient balance" anywhere */
  wrap('showToast', orig => function (msg, type) {
    if (typeof msg === 'string' && /insufficient balance/i.test(msg)) {
      const t = document.getElementById('totalCharge');
      if (t && /free/i.test(t.textContent || '')) return;   // free order — never a balance problem
    }
    return orig.apply(this, arguments);
  });

  TSMU.onReady(function () {
    watchPackages();
    watchDiscount();
    if (window.auth) auth.onAuthStateChanged(u => { if (u) setTimeout(watchDiscount, 700); });
    TSMU.registerMount(function () {
      watchDiscount(); paintDiscountBanner(); repaintPrices(); paintPackageHints();
      const q = document.getElementById('orderQuantity');
      if (q && !q._tsmuHint) { q._tsmuHint = 1; q.addEventListener('input', () => setTimeout(paintPackageHints, 30)); }
    });
  });

  console.log('%c TSMU v28 pricing engine (free + 4dp + discount + limits) ', 'background:#7c3aed;color:#fff;padding:2px 6px;border-radius:4px');
})();


