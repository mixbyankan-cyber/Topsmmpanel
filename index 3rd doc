    if (!Object.keys(W.items).length) {
      TSMU.empty(box, '⭐', 'Your wishlist is empty',
        'Tap the ⭐ save button on any package — in New Order, in the Services catalog or in the search results — and it will appear here.');
      return;
    }
    if (!list.length) { TSMU.empty(box, '🔍', 'No saved package matches your search'); return; }

    if (W.sort === 'network') {
      const groups = {};
      list.forEach(r => { const g = r.service || 'Other'; (groups[g] = groups[g] || []).push(r); });
      box.innerHTML = Object.keys(groups).sort().map(g =>
        '<div class="tsmu-wl-grp">' + esc(g) + ' · ' + groups[g].length + '</div>' +
        groups[g].map(cardHTML).join('')).join('');
    } else {
      box.innerHTML = list.map(cardHTML).join('');
    }
  }

  /** Order Now — service, package, minimum quantity, ready to submit. */
  TSMU.wishOrder = async function (k) {
    const r = W.items[k]; if (!r) return;
    const a = available(k);
    if (!a.ok) return TSMU.toast(a.why, 'error');
    try { if (TSMU.pfClearForService) TSMU.pfClearForService(r.sid); } catch (e) { }
    try { navigateTo('dashboardPage'); } catch (e) { }
    try { if (window.switchOrderMode) switchOrderMode('single'); } catch (e) { }

    const wait = TSMU.waitFor || ((t) => Promise.resolve(t()));
    const hasOpt = (id, v) => { const e = document.getElementById(id); return !!e && Array.prototype.some.call(e.options, o => o.value === v); };

    const okSvc = await wait(() => hasOpt('serviceSelect', r.sid) || !!(TSMU.G('allServices') || []).find(x => x.id === r.sid), 9000);
    if (!okSvc) return TSMU.toast('That service is no longer available.', 'error');
    /* one safe entry point: native select + VISIBLE custom dropdown + packages */
    if (!TSMU.setService(r.sid)) return TSMU.toast('That service is no longer available.', 'error');

