    ═══════════════════════════════════════ */
    @media (min-width: 769px) and (max-width: 1024px) {
      .container { padding: 20px 24px; }
      .dashboard-grid { grid-template-columns: repeat(3, 1fr); }
      .qr-image-large { max-width: min(100%, 520px) !important; }
