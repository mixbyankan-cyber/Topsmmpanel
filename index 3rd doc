        console.warn('Navigation target not found:', pageId);
        return false;
      }
      const maintenanceKey=maintenanceFeatureForPage(pageId);
      if(maintenanceKey&&!isFeatureAllowed(maintenanceKey))return showMaintenanceWarning(MAINTENANCE_FEATURE_LABELS[maintenanceKey]);
      if (window.currentPage === 'buyPanelPage' && pageId !== 'buyPanelPage' && typeof detachPanelSearchListener === 'function') {
        detachPanelSearchListener();
      }
      hideAllPages();
      targetPage.classList.add('active');
      
      const navItems = document.querySelectorAll('.nav-item');
      navItems.forEach(item => item.classList.remove('active'));
      
      if (pageId === 'dashboardPage') {
        navItems[0].classList.add('active');
      } else if (pageId === 'ordersPage') {
        navItems[1].classList.add('active');
