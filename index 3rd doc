    /* ═══════════════════════════════════════
       🖥️ LARGE DESKTOP — 1280px+
    ═══════════════════════════════════════ */
    @media (min-width: 1280px) {
      .container { max-width: 1100px; padding: 28px 40px; }
      .landing-container { max-width: 1100px; }
      .landing-brand-name { font-size: 42px; }
      .landing-tagline { font-size: 22px; }
      .landing-logo { height: calc(var(--logoHL,112px) * 1.12); }
    }

    /* ═══════════════════════════════════════
       ✅ SAFE AREA — iOS notch / home bar
    ═══════════════════════════════════════ */
    @supports (padding: env(safe-area-inset-bottom)) {
      .bottom-nav {
        padding-bottom: calc(8px + env(safe-area-inset-bottom));
      }
      body {
        padding-bottom: calc(70px + env(safe-area-inset-bottom));
      }
    }

    /* ═══════════════════════════════════════
       🔄 PREVENT HORIZONTAL SCROLL
    ═══════════════════════════════════════ */
    body, .page, .container {
      overflow-x: hidden;
      max-width: 100vw;
    }
    .page { width: 100%; }

    /* ════════════════════════════════════════════════════════════════
       🇮🇳 INDEPENDENCE DAY FESTIVE THEME (IDT)
       Everything below ONLY applies when <body> has the class
       .independence-theme (toggled live by Admin Panel → Settings).
       The base design is untouched — remove the class and the site
       instantly looks exactly like before.
       Palette: Saffron #FF9933 | White | Green #138808 | Chakra #06038D
       ════════════════════════════════════════════════════════════════ */

    /* ── 1️⃣ Tricolor top scrolling banner ─────────────────────────── */
    body.independence-theme .top-scrolling-banner {
      background: linear-gradient(90deg,
        #FF9933 0%, #fecb9a 18%, #ffffff 50%, #c9edd2 82%, #138808 100%);
      box-shadow: 0 2px 14px rgba(6, 3, 141, 0.25);
    }
    body.independence-theme .top-scrolling-banner .banner-content {
      color: #0b1f52;
      font-weight: 800;
      text-shadow: 0 1px 0 rgba(255, 255, 255, 0.65);
    }

    /* ── 2️⃣ Header: tricolor ribbon ──────────────────────────────── */
    body.independence-theme .header::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -1px;
      height: 4px;
      background: linear-gradient(90deg,
        #FF9933 0% 33%, #ffffff 33% 66%, #138808 66% 100%);
      box-shadow: 0 2px 6px rgba(255, 153, 51, 0.45);
    }
    .id-chakra-svg {
      display: block;
      animation: idChakraSpin 9s linear infinite;
      filter: drop-shadow(0 1px 2px rgba(6, 3, 141, 0.35));
    }
    @keyframes idChakraSpin {
      from { transform: rotate(0deg); }
