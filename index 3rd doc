    setTimeout(() => { qtyChips(); qtyFeedback(); }, 40);
    return r;
  });

  /* ═════════ 2. BADGES ═════════ */
  const BADGE_COLORS = { hot: '#ef4444', new: '#0ea5e9', offer: '#8b5cf6', sale: '#f59e0b', best: '#10b981', fast: '#06b6d4', limited: '#db2777' };
