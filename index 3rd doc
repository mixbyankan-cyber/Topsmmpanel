    // Mask Email Address (show first 2 and last 2 characters, hide middle)
    function maskEmail(email) {
      if (!email) return 'N/A';
      
      const [localPart, domain] = email.split('@');
      if (!domain) return email;
      
      if (localPart.length <= 4) {
        // If email is too short, just show first and last char
        return localPart[0] + '*****' + localPart[localPart.length - 1] + '@' + domain;
      }
      
      // Show first 2 and last 2 characters
      const first = localPart.substring(0, 2);
      const last = localPart.substring(localPart.length - 2);
      const middle = '*'.repeat(Math.min(localPart.length - 4, 5)); // Max 5 stars
      
      return first + middle + last + '@' + domain;
    }

