          alert(`
🎉 Panel Order Placed Successfully!

📋 Order ID: ${orderId}
🌐 Domain: ${domainName}
📦 Plan: ${planText}
💰 Amount Paid: ${fmt(planPrice)}
📅 Date: ${orderDate}

💳 Wallet Update:
   Previous Balance: ${fmt(currentBalance)}
