      font-size: 16px;
      font-weight: 800;
      color: #047857;
    }
    .order-success-subtitle {
      font-size: 12px;
      color: #059669;
      font-weight: 600;
      margin-top: 2px;
    }
    .order-success-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
    }
    .order-success-item {
      background: rgba(255,255,255,0.6);
      border: 1px solid rgba(16,185,129,0.25);
      border-radius: 10px;
      padding: 10px 12px;
    }
    .order-success-item-label {
      font-size: 10px;
      color: #059669;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 4px;
    }
    .order-success-item-value {
      font-size: 13px;
      color: #064e3b;
      font-weight: 700;
      word-break: break-all;
    }
    .order-success-actions {
      display: flex;
      gap: 10px;
      margin-top: 16px;
      flex-wrap: wrap;
    }
    .order-success-actions button {
      flex: 1;
      min-width: 130px;
      padding: 11px 14px;
      border: none;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.25s;
    }
    .order-success-btn-primary {
      background: var(--gradient-primary);
      color: white;
    }
    .order-success-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(14,165,233,0.35); }
    .order-success-btn-secondary {
      background: rgba(255,255,255,0.8);
      color: #047857;
      border: 1px solid rgba(16,185,129,0.4) !important;
    }
    .order-success-btn-secondary:hover { background: #ffffff; }

    @media (max-width: 480px) {
      .currency-selector-btn { padding: 5px 8px; font-size: 11px; }
      .currency-dropdown-list { right: -10px; min-width: 170px; }
    }

    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }

    /* Landing Header */
    .landing-header {
      background: var(--white);
      padding: 40px 20px;
      text-align: center;
      border-bottom: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
    }

    .landing-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .landing-logo-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .landing-logo {
      width: auto;
      height: var(--logoHL, 112px);
      max-width: calc(var(--logoHL, 112px) * 2.6);
      border-radius: 0;
      border: none;
      box-shadow: none;
      background: transparent;
      object-fit: contain;
      filter: drop-shadow(0 10px 22px rgba(49,46,129,.35));
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .landing-brand {
      text-align: center;
    }

    .landing-brand-name {
      position: relative;
      font-size: 46px;
      font-weight: 900;
      letter-spacing: 1.5px;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: linear-gradient(180deg, #ffffff 0%, #fef9c3 18%, #fcd34d 38%, #a5b4fc 66%, #6366f1 88%, #4338ca 100%);
      background-size: 100% 240%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: brandSheen 7s ease-in-out infinite;
      margin-bottom: 12px;
      white-space: nowrap;
    }

    .landing-brand-name::before {
      content: attr(data-text);
      position: absolute;
      left: 0; top: 0;
      z-index: -1;
      color: transparent;
      -webkit-text-fill-color: transparent;
      text-shadow:
        0 2px 0 #3730a3, 0 4px 0 #312e81, 0 6px 0 #2a2766, 0 8px 0 #211d4e,
        0 10px 4px rgba(2,6,23,.32), 0 18px 30px rgba(49,46,129,.45);
    }

    .landing-brand-name::after {
      content: attr(data-text);
      position: absolute;
      left: 0; top: 0;
      z-index: 1;
      background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,.95) 47%, transparent 60%);
      background-size: 260% 100%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: brandSweep 5.2s ease-in-out infinite;
      pointer-events: none;
    }

    .landing-tagline {
      font-size: 15px;
      color: #6366f1;
      font-weight: 800;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 3px;
      opacity: .9;
    }

    .landing-description {
      font-size: 16px;
      color: var(--text-gray);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Auth Container */
    .auth-container {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(90vh - 42px);
      padding: 30px 20px;
    }

    .auth-card {
      background: var(--white);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 40px;
      max-width: 450px;
      width: 100%;
      box-shadow: var(--shadow-lg);
    }

    .auth-heading {
      font-size: 32px;
      font-weight: bold;
      text-align: center;
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 10px;
    }

    .auth-subtext {
      text-align: center;
      color: var(--text-gray);
      font-size: 14px;
      margin-bottom: 30px;
    }

    .auth-tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 30px;
    }

    .auth-tab {
      flex: 1;
      padding: 12px;
      background: transparent;
      border: 2px solid var(--primary-color);
      border-radius: 10px;
      color: var(--primary-color);
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    .auth-tab.active {
      background: var(--gradient-primary);
      color: white;
    }

    .input-group {
      margin-bottom: 20px;
    }

    .input-label {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .input-wrapper {
      position: relative;
    }

    .input-icon {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 18px;
    }

    .input-field, .select-field {
      width: 100%;
      padding: 12px 15px;
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      color: var(--text-primary);
      font-size: 14px;
      transition: 0.3s;
    }

    .auth-card .input-field {
      padding-left: 45px;
    }

    .input-field:focus, .select-field:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
    }

    .select-field {
      cursor: pointer;
    }

    .select-field option {
      background: var(--white);
      color: var(--text-primary);
    }

    .info-text {
      font-size: 12px;
      color: var(--text-gray);
      margin-top: 5px;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .forgot-password-link {
      color: var(--primary-light);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      transition: 0.3s;
      display: inline-block;
    }

    .forgot-password-link:hover {
      color: var(--primary-color);
      text-decoration: underline;
    }

    .btn-primary {
      width: 100%;
      padding: 14px;
      background: var(--gradient-primary);
      border: none;
      border-radius: 10px;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    }

    .btn-google {
      width: 100%;
      padding: 14px;
      background: white;
      border: 2px solid var(--primary-color);
      border-radius: 10px;
      color: #333;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
      margin-top: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .btn-google:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .btn-google:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .btn-google:disabled:hover {
      transform: none;
      box-shadow: none;
    }

    .auth-link {
      text-align: center;
      margin-top: 20px;
      font-size: 13px;
      color: var(--text-gray);
    }

    .auth-link a {
      color: var(--primary-light);
      text-decoration: none;
      font-weight: bold;
    }

    /* Forgot Password Form */
    .forgot-password-header {
      margin-bottom: 20px;
    }

    .btn-back-auth, .btn-back {
      padding: 10px 20px;
      background: rgba(99, 102, 241, 0.1);
      border: 2px solid var(--primary-color);
      border-radius: 10px;
      color: var(--primary-color);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.3s;
    }

    .btn-back-auth:hover, .btn-back:hover {
      background: var(--gradient-primary);
      color: white;
      transform: translateX(-3px);
    }

    .forgot-password-info {
      text-align: center;
      margin-bottom: 30px;
      padding: 25px;
      background: rgba(99, 102, 241, 0.1);
      border-radius: 16px;
      border: 1px solid var(--border-color);
    }

    .forgot-icon {
      font-size: 64px;
      margin-bottom: 15px;
      animation: lock-shake 2s infinite;
    }

    @keyframes lock-shake {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(-10deg); }
      75% { transform: rotate(10deg); }
    }

    .forgot-password-info h3 {
      font-size: 20px;
      color: var(--primary-color);
      margin-bottom: 10px;
      font-weight: bold;
    }

    .forgot-password-info p {
      font-size: 14px;
      color: var(--text-gray);
      line-height: 1.6;
      margin: 0;
    }

    /* Landing Sections */
    .landing-section {
      padding: 60px 20px;
      background: var(--white);
    }

    .landing-section-alt {
      background: var(--lighter-bg);
    }

    .section-main-title {
      font-size: 32px;
      font-weight: bold;
      color: var(--primary-color);
      text-align: center;
      margin-bottom: 15px;
    }

    .section-main-subtitle {
      font-size: 16px;
      color: var(--text-gray);
      text-align: center;
      max-width: 700px;
      margin: 0 auto 50px auto;
      line-height: 1.6;
    }

    /* Advantages Grid */
    .advantages-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
      margin-top: 40px;
    }

    .advantage-card {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 30px;
      text-align: center;
      transition: 0.3s;
      cursor: pointer;
    }

    .advantage-card:hover {
      transform: translateY(-8px);
      border-color: var(--primary-color);
      box-shadow: var(--shadow-xl);
    }

    .advantage-icon {
      font-size: 48px;
      margin-bottom: 20px;
      animation: bounce 2s infinite;
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .advantage-title {
      font-size: 18px;
      font-weight: bold;
      color: var(--text-primary);
      margin-bottom: 12px;
    }

    .advantage-text {
      font-size: 14px;
      color: var(--text-gray);
      line-height: 1.6;
    }

    /* Steps Grid */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 30px;
      margin-top: 40px;
    }

    .step-card {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 30px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
      transition: 0.3s;
    }

    .step-card:hover {
      border-color: var(--primary-color);
      box-shadow: var(--shadow-md);
      transform: translateY(-5px);
    }

    .step-number {
      width: 60px;
      height: 60px;
      background: var(--gradient-primary);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: bold;
      color: white;
      flex-shrink: 0;
      box-shadow: var(--shadow-md);
    }

    .step-content {
      flex: 1;
    }

    .step-title {
      font-size: 18px;
      font-weight: bold;
      color: var(--text-primary);
      margin-bottom: 10px;
    }

    .step-text {
      font-size: 14px;
      color: var(--text-gray);
      line-height: 1.6;
    }

    /* Reviews Grid */
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
      margin-top: 40px;
    }

    .review-card {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 25px;
      transition: 0.3s;
    }

    .review-card:hover {
      border-color: var(--primary-color);
      box-shadow: var(--shadow-md);
      transform: translateY(-5px);
    }

    .review-stars {
      font-size: 20px;
      margin-bottom: 15px;
    }

    .review-text {
      font-size: 14px;
      color: var(--text-primary);
      line-height: 1.8;
      margin-bottom: 20px;
      font-style: italic;
    }

    .review-author {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-top: 15px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .author-avatar {
      width: 50px;
      height: 50px;
      background: var(--gradient-primary);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      flex-shrink: 0;
    }

    .author-name {
      font-size: 15px;
      font-weight: bold;
      color: var(--primary-color);
    }

    .author-role {
      font-size: 12px;
      color: var(--text-gray);
    }

    /* FAQ Container */
    .faq-container {
      max-width: 800px;
      margin: 40px auto 0 auto;
    }

    .faq-item {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      margin-bottom: 15px;
      overflow: hidden;
      transition: 0.3s;
    }

    .faq-item:hover {
      border-color: var(--primary-color);
    }

    .faq-question {
      padding: 20px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      user-select: none;
    }

    .faq-question:hover {
      background: rgba(99, 102, 241, 0.05);
    }

    .faq-toggle {
      font-size: 24px;
      color: var(--primary-color);
      font-weight: bold;
      transition: 0.3s;
    }

    .faq-item.active .faq-toggle {
      transform: rotate(45deg);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }

    .faq-item.active .faq-answer {
      max-height: 500px;
      transition: max-height 0.5s ease-in;
    }

    .faq-answer p {
      padding: 0 25px 20px 25px;
      font-size: 14px;
      color: var(--text-gray);
      line-height: 1.8;
      margin: 0;
    }

    /* Landing Footer */
    .landing-footer {
      background: var(--lighter-bg);
      padding: 30px 20px;
      text-align: center;
      border-top: 1px solid var(--border-color);
    }

    .footer-text {
      font-size: 14px;
      color: var(--text-gray);
      margin-bottom: 8px;
    }

    .footer-brand {
      font-size: 18px;
      font-weight: bold;
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Dashboard Page */
    .welcome-card {
      background: var(--white);
      border: 2px solid var(--primary-color);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
      text-align: center;
    }

    .welcome-title {
      font-size: 20px;
      font-weight: bold;
      color: var(--primary-color);
      margin-bottom: 15px;
    }

    .welcome-buttons {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-action {
      padding: 12px 24px;
      background: var(--gradient-primary);
      border: none;
      border-radius: 10px;
      color: white;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    .btn-action:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    }

    .btn-action.secondary {
      background: linear-gradient(135deg, #10b981, #059669);
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat-card {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 20px;
      transition: 0.3s;
    }

    .stat-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: var(--primary-color);
    }

    .card-heading {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-gray);
      margin-bottom: 10px;
    }

    .stat-value {
      font-size: 28px;
      font-weight: bold;
      color: var(--primary-color);
    }

    .section-title {
      font-size: 22px;
      font-weight: bold;
      color: var(--primary-color);
      margin: 30px 0 15px 0;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--primary-color);
    }

    .order-form-card {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 25px;
      margin-bottom: 20px;
    }

    .price-display {
      background: rgba(99, 102, 241, 0.1);
      padding: 12px;
      border-radius: 8px;
      margin: 10px 0;
      border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .price-text {
      font-size: 14px;
      color: var(--primary-light);
      font-weight: 600;
    }

    .total-charge {
      background: rgba(0, 230, 118, 0.15);
      padding: 15px;
      border-radius: 10px;
      text-align: center;
      margin: 20px 0;
      border: 2px solid rgba(0, 230, 118, 0.3);
    }

    .total-label {
      font-size: 14px;
      color: var(--text-gray);
      margin-bottom: 5px;
    }

    .total-amount {
      font-size: 28px;
      font-weight: bold;
      color: var(--success);
    }

    .news-card {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
    }

    .news-content {
      color: var(--text-primary);
      font-size: 14px;
      line-height: 1.8;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .video-thumbnail {
      width: 100%;
      border-radius: 12px;
      cursor: pointer;
      transition: 0.3s;
      border: 2px solid var(--primary-color);
    }

    .video-thumbnail:hover {
      transform: scale(1.02);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    }

    /* Orders Page */
    .order-search-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 14px;
      padding: 12px 16px;
      margin-bottom: 16px;
      transition: 0.2s;
    }

    .order-search-bar:focus-within {
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(14,165,233,0.12);
    }

    .order-search-icon {
      font-size: 16px;
      flex-shrink: 0;
      opacity: 0.6;
    }

    .order-search-input {
      flex: 1;
      border: none;
      outline: none;
      background: transparent;
      font-size: 14px;
      color: var(--text-primary);
      min-width: 0;
    }

    .order-search-input::placeholder {
      color: var(--text-light);
    }

    .order-search-clear {
      border: none;
      background: var(--light-bg);
      color: var(--text-gray);
      width: 26px;
      height: 26px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 12px;
      flex-shrink: 0;
      transition: 0.2s;
    }

    .order-search-clear:hover {
      background: var(--error-light);
      color: var(--error);
    }

    .order-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      flex-wrap: nowrap;
      background: var(--white);
      padding: 12px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .order-tabs::-webkit-scrollbar {
      display: none;
    }

    .order-tab {
      padding: 10px 20px;
      background: var(--light-bg);
      border: 2px solid var(--border-color);
      border-radius: 10px;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.25s;
      flex: 0 0 auto;
      white-space: nowrap;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

