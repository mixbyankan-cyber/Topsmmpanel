    // Submit panel order
    async function submitPanelOrder(event) {
      event.preventDefault();
      
      if (!currentUser) {
        showToast('❌ Please login first', 'error');
        return;
      }
      if (!ensureFeatureAllowed('buyPanel', 'Buy SMM Panel')) return;

      const domainName = document.getElementById('domainName').value.trim();
      const adminEmail = document.getElementById('adminEmail').value.trim();
      const whatsappNumber = document.getElementById('whatsappNumber').value.trim();
      const planSelect = document.getElementById('planSelect');
      const selectedPlan = planSelect.value;
      const selectedOption = planSelect.options[planSelect.selectedIndex];
      const planPrice = parseFloat(selectedOption.getAttribute('data-price'));
      const planText = selectedOption.text;

      // Validation
      if (!domainName || !adminEmail || !whatsappNumber || !selectedPlan) {
        showToast('❌ Please fill all required fields', 'error');
        playReactionSound('error');
        return;
      }

      // Check wallet balance
      const userBalanceSnapshot = await database.ref(`users/${currentUser.uid}/balance`).once('value');
      const currentBalance = parseFloat(userBalanceSnapshot.val() || 0);

      if (currentBalance < planPrice) {
        showToast(`❌ Insufficient balance! You need ${fmt(planPrice)} but have ${fmt(currentBalance)}`, 'error');
        playReactionSound('error');
        
        // Ask if user wants to add funds
        if (confirm(`Your wallet balance is insufficient.\n\nRequired: ${fmt(planPrice)}\nCurrent Balance: ${fmt(currentBalance)}\nShortfall: ${fmt(planPrice - currentBalance)}\n\nWould you like to add funds now?`)) {
          navigateTo('addFundPage');
        }
        return;
      }

      // Confirm order with wallet deduction
      const confirmMessage = `
📦 Confirm Your Panel Order

🌐 Domain: ${domainName}
📧 Email: ${adminEmail}
📱 WhatsApp: ${whatsappNumber}
📦 Plan: ${planText}
💰 Price: ${fmt(planPrice)}

💳 Current Wallet Balance: ${fmt(currentBalance)}
💸 After Order: ${fmt(currentBalance - planPrice)}

⚠️ Amount will be deducted from your wallet.

Submit this order?`;

      if (!confirm(confirmMessage)) {
        return;
      }

      // Show loading
      const submitBtn = event.target.querySelector('button[type="submit"]');
      const originalBtnText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>⏳</span> Processing Order...';

      try {
        // Generate order ID
        const orderId = 'PANEL_' + Date.now();
        const orderDate = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });

        // 💰 ATOMIC BALANCE DEDUCTION — transaction() re-checks the live balance
        // at write time (not the value read when the form first opened) and
        // aborts cleanly if it's no longer sufficient, instead of a plain
        // read-then-write that could race with another tab/device.
        let insufficientBalance = false;
        const panelBalanceTx = await database.ref(`users/${currentUser.uid}/balance`).transaction(bal => {
          const b = bal || 0;
          insufficientBalance = b < planPrice;
          if (insufficientBalance) return; // undefined return = abort transaction
          return b - planPrice;
        });

        if (!panelBalanceTx.committed) {
          showToast(insufficientBalance ? '❌ Insufficient balance! Please add funds.' : '❌ Could not place order, please try again.', 'error');
          playReactionSound('error');
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnText;
          return;
        }

        const newBalance = panelBalanceTx.snapshot.val();

        // Prepare order data — use the resolved email (form field / robust resolver)
        // as the source of truth, since currentUser.email can be blank in edge cases.
        const resolvedUserEmail = adminEmail || getBestUserEmail(currentUser, null);
        const orderData = {
          orderId: orderId,
          userId: currentUser.uid,
          userEmail: resolvedUserEmail,
          userName: currentUser.displayName || resolvedUserEmail,
          domainName: domainName,
          adminEmail: adminEmail,
          whatsappNumber: whatsappNumber,
          plan: selectedPlan,
          planText: planText,
          price: planPrice,
          status: 'pending',
          orderDate: orderDate,
          timestamp: Date.now(),
          paidAmount: planPrice,
          previousBalance: currentBalance,
          newBalance: newBalance,
          paymentMethod: 'wallet',
          createdAt: firebase.database.ServerValue.TIMESTAMP
        };

        // ⚡ SPEED: reserve push-keys locally, then write EVERYTHING (order,
        // balance deduction, transaction record, admin notification, user
        // notification) in a SINGLE multi-path update() — one network round
        // trip instead of 5 sequential ones.
        const transactionRef = database.ref(`users/${currentUser.uid}/transactions`).push();
        const adminNotifRef = database.ref('admin_notifications').push();
        const userNotifRef = database.ref('notifications').push();

        try {
        await database.ref().update({
          [`panel_orders/${orderId}`]: orderData,
          [`users/${currentUser.uid}/transactions/${transactionRef.key}`]: {
            type: 'panel_purchase',
            orderId: orderId,
            amount: -planPrice,
            description: `Panel Order - ${planText}`,
            previousBalance: currentBalance,
            newBalance: newBalance,
            timestamp: Date.now(),
            date: orderDate
          },
          [`admin_notifications/${adminNotifRef.key}`]: {
            type: 'new_panel_order',
            orderId: orderId,
            userId: currentUser.uid,
            userEmail: resolvedUserEmail,
            domainName: domainName,
            plan: planText,
            amount: planPrice,
            message: `New panel order from ${resolvedUserEmail} - ${planText}`,
            timestamp: Date.now(),
            read: false
          },
          [`notifications/${userNotifRef.key}`]: {
            user_id: currentUser.uid,
            type: 'order',
            title: '🎉 Panel Order Placed Successfully!',
            message: `Your panel order for "${domainName}" has been placed. Order ID: ${orderId}. We'll send login details within 2 hours.`,
            meta: { order_id: orderId, panel_order: true, icon: '🎉' },
            created_at: Date.now(),
            is_read: false
          }
        });
        } catch (writeErr) {
          // Balance was deducted but the rest of the write failed — refund
          // immediately so the user never silently loses money.
          await database.ref(`users/${currentUser.uid}/balance`).transaction(b => (b || 0) + planPrice);
          throw writeErr;
        }

        // Play success sound
        playSuccessSound();

        // Clear form
        document.getElementById('panelOrderForm').reset();
        document.getElementById('adminEmail').value = resolvedUserEmail;
        document.getElementById('selectedPlanPrice').style.display = 'none';

        // Balance display updates automatically via the live users/{uid} listener (loadUserData)

        // Success message
        showToast('🎉 Panel order placed successfully! ' + fmt(planPrice) + ' deducted from wallet.', 'success');

        // Auto-load order in tracking section
        setTimeout(() => {
          document.getElementById('orderSearchInput').value = orderId;
          searchPanelOrder();
          
          // Scroll to tracking section
          document.querySelector('.order-status-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 1000);

        // Show detailed success alert
