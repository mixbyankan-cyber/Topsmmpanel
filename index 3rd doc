    let apiPageInitialized = false;
    let currentApiKey = null;

    // Generate a secure-looking random API key (uid-independent, unguessable)
    function generateApiKeyString() {
      const chars = 'abcdef0123456789';
      let key = '';
      for (let i = 0; i < 40; i++) {
        key += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return key;
    }

    // Build the default API endpoint from the site's own live domain
    // (e.g. https://yourdomain.com/api) — used until Admin sets a custom
    // endpoint. This always matches wherever the panel is actually hosted.
    function getDefaultApiEndpoint() {
      return window.location.origin + '/api';
    }

    function initApiPage() {
      if (!currentUser) return;

      // Endpoint URL is configured once by Admin (Admin Panel → API Settings)
      // and is the same for every user — just their `key` differs.
      sessionOn(database.ref('settings/apiSettings'), 'value', snap => {
        const settings = snap.val() || {};
        const endpoint = settings.endpointUrl || '';
        const disabledNotice = document.getElementById('apiDisabledNotice');

        if (disabledNotice) {
          const apiBlockedByMaint = maintenanceConfig.enabled && maintenanceConfig.features.api === false;
          disabledNotice.style.display = (settings.enabled !== true || apiBlockedByMaint) ? 'flex' : 'none';
          const apiNoticeText=disabledNotice.querySelector('div');
          if (apiBlockedByMaint && apiNoticeText) apiNoticeText.textContent = '🛠️ The Reseller API is temporarily unavailable due to scheduled maintenance. Please try again later.';
        }
        const regenBtn = document.querySelector('button[onclick^="regenerateApiKey"]');
        if (regenBtn) regenBtn.disabled = settings.enabled !== true || (maintenanceConfig.enabled && maintenanceConfig.features.api === false);

        // Use the site's own live domain to build the endpoint URL when Admin
        // hasn't set a custom one yet — so it always looks like a normal,
        // fully working API address for this exact panel.
        const displayEndpoint = endpoint || getDefaultApiEndpoint();

        const endpointEl = document.getElementById('apiEndpointDisplay');
        if (endpointEl) endpointEl.textContent = displayEndpoint;

        const endpointDoc = document.getElementById('apiDocEndpoint1');
        if (endpointDoc) endpointDoc.textContent = displayEndpoint;

        // Re-render code samples whenever the key or endpoint becomes available
        renderApiCodeSamples(displayEndpoint, currentApiKey);
      });

      // Load (or create) this user's API key
      loadOrCreateApiKey(currentUser.uid);

      // Live API usage stats (orders placed via API + spend)
      loadApiStats(currentUser.uid);

      // Recent API call log
      loadApiActivityLog(currentUser.uid);

      apiPageInitialized = true;
    }

    // Look up the user's existing key, or create one on first visit
    async function loadOrCreateApiKey(uid) {
      const keyDisplay = document.getElementById('apiKeyDisplay');
      try {
        const snap = await database.ref(`users/${uid}/apiKey`).once('value');
        let key = snap.val();

        if (!key) {
          key = generateApiKeyString();
          await database.ref(`users/${uid}/apiKey`).set(key);
          // Index key -> uid so the Cloud Function can look up the owner in O(1)
          await database.ref(`api_key_index/${key}`).set(uid);
        }

        currentApiKey = key;
        if (keyDisplay) keyDisplay.textContent = key;

        // Now that the key is known, refresh the code samples with it filled in
        const endpointSnap = await database.ref('settings/apiSettings/endpointUrl').once('value');
        renderApiCodeSamples(endpointSnap.val() || getDefaultApiEndpoint(), key);
      } catch (e) {
        console.error('Error loading API key:', e);
        if (keyDisplay) keyDisplay.textContent = 'Error loading key';
      }
    }

    // Copy the API key to clipboard
    function copyApiKey() {
      if (!currentApiKey) return;
      navigator.clipboard.writeText(currentApiKey).then(() => {
        showToast('✅ API key copied to clipboard!', 'success');
      }).catch(() => {
        fallbackCopyText(currentApiKey);
        showToast('✅ API key copied!', 'success');
      });
    }

    // Regenerate the key — old key stops working immediately (index entry removed)
    async function regenerateApiKey() {
      if (!currentUser) return;
      if (!ensureFeatureAllowed('api', 'API Key Regeneration')) return;
      if (!confirm('Regenerate your API key? Your OLD key will stop working immediately — update it in any panel/bot connected to you.')) {
        return;
      }

      try {
        // Remove the old key's index entry first (invalidate immediately)
        if (currentApiKey) {
          await database.ref(`api_key_index/${currentApiKey}`).remove();
        }

        const newKey = generateApiKeyString();
        await database.ref(`users/${currentUser.uid}/apiKey`).set(newKey);
        await database.ref(`api_key_index/${newKey}`).set(currentUser.uid);

        currentApiKey = newKey;
        document.getElementById('apiKeyDisplay').textContent = newKey;

        const endpointSnap = await database.ref('settings/apiSettings/endpointUrl').once('value');
        renderApiCodeSamples(endpointSnap.val() || getDefaultApiEndpoint(), newKey);

        playSound('success');
        showToast('🔄 API key regenerated successfully!', 'success');
      } catch (e) {
        console.error('Error regenerating API key:', e);
        showToast('Failed to regenerate API key!', 'error');
      }
    }

    // Live stats: count + sum of orders tagged source:'api', and today's API call count
    function loadApiStats(uid) {
      sessionOn(database.ref(`users/${uid}/orders`), 'value', snap => {
        const orders = snap.val() || {};
        const apiOrders = Object.values(orders).filter(o => o.source === 'api');
        const totalSpent = apiOrders.reduce((sum, o) => sum + (o.amount || 0), 0);

        const countEl = document.getElementById('apiStatTotalOrders');
        const spentEl = document.getElementById('apiStatTotalSpent');
        if (countEl) countEl.textContent = apiOrders.length;
        if (spentEl) spentEl.textContent = fmt(totalSpent);
      });

      sessionOn(database.ref(`api_logs/${uid}`), 'value', snap => {
        const logs = snap.val() || {};
        const dayAgo = Date.now() - 24 * 60 * 60 * 1000;
        const recentCount = Object.values(logs).filter(l => (l.timestamp || 0) >= dayAgo).length;
        const callsEl = document.getElementById('apiStatCallsToday');
        if (callsEl) callsEl.textContent = recentCount;
      });
    }

    // Recent API activity feed (last 15 calls, newest first)
    function loadApiActivityLog(uid) {
      sessionOn(database.ref(`api_logs/${uid}`).limitToLast(15), 'value', snap => {
        const logs = snap.val() || {};
        const container = document.getElementById('apiActivityLog');
        if (!container) return;

        const entries = Object.values(logs).sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));

        if (entries.length === 0) {
          container.innerHTML = `
            <div class="empty-state">
              <div class="empty-icon">🔌</div>
              <div class="empty-text">No API calls yet</div>
              <div class="empty-subtext">Once you connect a panel/bot using your API key, activity will show up here</div>
            </div>
          `;
          return;
        }

        container.innerHTML = entries.map(log => `
          <div class="order-card" style="padding: 12px 14px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <strong style="color: ${log.success ? 'var(--success)' : 'var(--error)'};">
                ${log.success ? '✅' : '❌'} ${(log.action || 'unknown').toUpperCase()}
              </strong>
              <span style="font-size: 11px; color: var(--text-gray);">${new Date(log.timestamp).toLocaleString('en-IN', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' })}</span>
            </div>
            ${log.message ? `<div style="font-size:12px; color:var(--text-gray); margin-top:4px;">${log.message}</div>` : ''}
          </div>
        `).join('');
      });
    }

