      // 1s refresh — flip-clock units + popup countdown chip
      updateClock(now) {
        const phase = IDT.phase;
        let target = null;
        if (phase === 'coming') target = IDT.liveAt();
        else if (phase === 'ending') target = IDT.hardEndAt();

        const hero = document.getElementById('fctHero');
        const parts = (ms) => {
          ms = Math.max(0, ms);
          const d = Math.floor(ms / 86400000); ms -= d * 86400000;
          const h = Math.floor(ms / 3600000);  ms -= h * 3600000;
          const m = Math.floor(ms / 60000);    ms -= m * 60000;
          const s = Math.floor(ms / 1000);
          return {
            d: String(d).padStart(2, '0'), h: String(h).padStart(2, '0'),
            m: String(m).padStart(2, '0'), s: String(s).padStart(2, '0')
          };
        };

        if (target && hero && hero.style.display !== 'none') {
          const t = parts(target - now);
          [['fcD', t.d], ['fcH', t.h], ['fcM', t.m], ['fcS', t.s]].forEach(([id, v]) => {
            const card = document.getElementById(id);
            if (card) IDT.flipCard(card, v);
          });
        }

        const pc = document.getElementById('fctPopCount');
        const overlay = document.getElementById('idPopupOverlay');
        if (pc && overlay && overlay.style.display === 'flex' && IDT._popCountTo) {
          const t = parts(IDT._popCountTo - now);
          pc.textContent = (IDT._popCountLabel || '⏳') + '   ' + t.d + 'd : ' + t.h + 'h : ' + t.m + 'm : ' + t.s + 's';
        }
      },

      // Split-flap 3D flip for one digit-card (Web Animations API)
      flipCard(card, newVal) {
        const cur = card.dataset.value || '';
        if (cur === newVal) return;
        if (!cur) { // first paint — no animation
          card.querySelector('.fc-top span').textContent = newVal;
          card.querySelector('.fc-bottom span').textContent = newVal;
          card.dataset.value = newVal;
          return;
        }
        if (card.dataset.flipping === '1') { card.dataset.pending = newVal; return; }
        card.dataset.flipping = '1';
        const topHalf = card.querySelector('.fc-top span');
        const botHalf = card.querySelector('.fc-bottom span');
        const leafTop = card.querySelector('.fc-leaf-top');
        const leafBot = card.querySelector('.fc-leaf-bottom');
        // Older WebViews may not expose the Web Animations API. In that
        // case update the countdown immediately instead of throwing.
        if (!leafTop || !leafBot || typeof leafTop.animate !== 'function' || typeof leafBot.animate !== 'function') {
          topHalf.textContent = newVal;
          botHalf.textContent = newVal;
          card.dataset.value = newVal;
          card.dataset.flipping = '0';
          return;
        }
        leafTop.querySelector('span').textContent = cur;
        leafBot.querySelector('span').textContent = newVal;
        leafTop.style.visibility = 'visible';
        leafBot.style.visibility = 'visible';
        const a1 = leafTop.animate(
          [{ transform: 'rotateX(0deg)' }, { transform: 'rotateX(-90deg)' }],
          { duration: 220, easing: 'ease-in', fill: 'forwards' }
        );
        a1.onfinish = () => {
          topHalf.textContent = newVal;
          leafTop.style.visibility = 'hidden';
          const a2 = leafBot.animate(
            [{ transform: 'rotateX(90deg)' }, { transform: 'rotateX(0deg)' }],
            { duration: 220, easing: 'ease-out', fill: 'forwards' }
          );
          a2.onfinish = () => {
            botHalf.textContent = newVal;
            leafBot.style.visibility = 'hidden';
            [leafTop, leafBot].forEach(lf => {
              lf.getAnimations().forEach(a => a.cancel());
              lf.style.transform = '';
            });
            card.dataset.value = newVal;
            card.dataset.flipping = '0';
            if (card.dataset.pending) {
              const p = card.dataset.pending;
              card.dataset.pending = '';
              IDT.flipCard(card, p);
            }
          };
        };
      },

      // Subtle 3D tilt (desktop pointer only) — buttery-smooth via CSS transition
      attachTilt(el, max = 5) {
        if (!el || el.dataset.tiltBound) return;
        el.dataset.tiltBound = '1';
        if (!(window.matchMedia && window.matchMedia('(pointer: fine)').matches)) return;
        el.addEventListener('mousemove', (ev) => {
          const r = el.getBoundingClientRect();
          const px = (ev.clientX - r.left) / r.width - 0.5;
          const py = (ev.clientY - r.top) / r.height - 0.5;
          el.style.transform = 'perspective(900px) rotateY(' + (px * max).toFixed(2) + 'deg) rotateX(' + (-py * max).toFixed(2) + 'deg)';
        });
        el.addEventListener('mouseleave', () => { el.style.transform = ''; });
      },

      // 🌈 Tricolor wipe — covers the screen for a heartbeat at phase switch
      wipe(cb) {
        const w = document.getElementById('fctWipe');
        if (!w) { cb(); return; }
        const bars = w.querySelectorAll('span');
        if (!bars.length || typeof bars[0].animate !== 'function') { cb(); return; }
        w.classList.add('fct-wipe-on');
        bars.forEach((b, i) => b.animate(
          [{ transform: 'translateX(-110%)' }, { transform: 'translateX(0%)' }],
          { duration: 420, delay: i * 90, easing: 'cubic-bezier(.7,0,.3,1)', fill: 'forwards' }
        ));
        setTimeout(() => {
          try { cb(); } catch (err) {}
          bars.forEach((b, i) => b.animate(
            [{ transform: 'translateX(0%)' }, { transform: 'translateX(110%)' }],
            { duration: 420, delay: i * 90, easing: 'cubic-bezier(.7,0,.3,1)', fill: 'forwards' }
          ));
          setTimeout(() => {
            w.classList.remove('fct-wipe-on');
            bars.forEach(b => b.getAnimations().forEach(a => a.cancel()));
          }, 900);
        }, 800);
      },

