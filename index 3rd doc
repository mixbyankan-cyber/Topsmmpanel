    background:#ef4444;color:#fff;animation:tsmuPulse 1.6s infinite}
  @keyframes tsmuPulse{0%,100%{opacity:1}50%{opacity:.45}}
  .tsmu-tl{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:0 0 14px;padding:11px 13px;
    border-radius:12px;background:var(--border-light,#f8fafc);border:1px solid var(--border-color,#e2e8f0)}
  .tsmu-tl .st{display:flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;color:var(--text-gray,#94a3b8)}
  .tsmu-tl .st.done{color:#10b981}.tsmu-tl .st.now{color:var(--primary-color,#0ea5e9)}
  .tsmu-tl .dot{width:9px;height:9px;border-radius:50%;background:currentColor;display:inline-block}
  .tsmu-tl .arw{color:var(--text-light,#cbd5e1);font-size:11px}
  .tsmu-rate{margin-top:12px;padding:14px;border-radius:13px;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.3);text-align:center}
  .tsmu-rate .stars{font-size:30px;letter-spacing:5px;cursor:pointer;user-select:none;margin:8px 0}
  .tsmu-rate .stars span{transition:.12s}.tsmu-rate .stars span:hover{transform:scale(1.18)}
  `;
  const st = document.createElement('style'); st.textContent = CSS; document.head.appendChild(st);

  const PRIORITIES = [
    { id: 'low', label: 'Low', color: '#64748b', hint: 'General question, no rush' },
    { id: 'normal', label: 'Normal', color: '#0ea5e9', hint: 'Standard request' },
    { id: 'high', label: 'High', color: '#f59e0b', hint: 'Order is stuck or delayed' },
    { id: 'urgent', label: 'Urgent', color: '#ef4444', hint: 'Money or account problem' }
  ];
  TSMU.TICKET_PRIORITIES = PRIORITIES;
  TSMU.tkCfg = {};
  let chosenPriority = 'normal';

  function cfg(k, d) { const v = (TSMU.tkCfg || {})[k]; return v === undefined || v === null || v === '' ? d : v; }
  function slaText() {
    const h = TSMU.num(cfg('responseHours', 6));
    return h >= 24 ? Math.round(h / 24) + ' business day(s)' : h + ' hour(s)';
  }

  /* ═══════ 1. FORM UPGRADES: priority + proof link + SLA note ═══════ */
  function mountForm() {
    const submit = document.getElementById('ticketSubmitBtn');
    if (!submit || document.getElementById('tsmuTkExtras')) return;
    const box = document.createElement('div');
    box.id = 'tsmuTkExtras';
    box.innerHTML =
      '<div id="tsmuTkPriWrap" class="input-group" style="margin-bottom:12px">' +
      '<label class="input-label">Priority</label>' +
      '<div class="tsmu-tk-pri" id="tsmuTkPri"></div>' +
      '<div class="info-text" id="tsmuTkPriHint" style="margin-top:5px"></div></div>' +
      '<div id="tsmuTkProofWrap" class="input-group" style="margin-bottom:12px">' +
      '<label class="input-label">Screenshot or proof link <span style="font-weight:400;opacity:.7">(optional)</span></label>' +
      '<input class="tsmu-in" id="tsmuTkProof" placeholder="Paste an image link, for example from Google Drive or Imgur">' +
      '</div>' +
      '<div class="tsmu-tk-sla" id="tsmuTkSla"></div>';
    submit.parentNode.insertBefore(box, submit);
    paintPriority();
    paintSla();
  }
  function paintPriority() {
    const host = document.getElementById('tsmuTkPri'); if (!host) return;
    const wrap2 = document.getElementById('tsmuTkPriWrap');
    if (wrap2) wrap2.style.display = cfg('priorityEnabled', true) === false ? 'none' : '';
    host.innerHTML = PRIORITIES.map(p =>
      '<button type="button" data-pri="' + p.id + '" class="' + (p.id === chosenPriority ? 'on' : '') + '"' +
      (p.id === chosenPriority ? ' style="background:' + p.color + '"' : '') + '>' + esc(p.label) + '</button>').join('');
    host.querySelectorAll('button').forEach(b => b.onclick = () => { chosenPriority = b.dataset.pri; paintPriority(); });
    const h = document.getElementById('tsmuTkPriHint');
    const cur = PRIORITIES.find(p => p.id === chosenPriority);
    if (h && cur) h.textContent = cur.hint;
  }
  function paintSla() {
    const e = document.getElementById('tsmuTkSla'); if (!e) return;
    const pw = document.getElementById('tsmuTkProofWrap');
    if (pw) pw.style.display = cfg('proofEnabled', true) === false ? 'none' : '';
    e.innerHTML = '&#128337; <b>Our support team usually replies within ' + esc(slaText()) + '.</b><br>' +
      'You will get a notification here and by email as soon as we answer. ' +
      'You can keep using the panel while you wait.';
  }

  /* ═══════ 2. SUBMIT: capture the extras + professional confirmation ═══════ */
  wrap('submitNewTicket', orig => async function () {
    const before = await countTickets();
    const out = await orig.apply(this, arguments);
    setTimeout(async () => {
      try {
        const t = await newestTicket();
        if (!t || (await countTickets()) <= before) return;      // submit failed - the panel already said so
        const patch = {
          priority: cfg('priorityEnabled', true) === false ? 'normal' : chosenPriority,
          proofLink: (document.getElementById('tsmuTkProof') || {}).value || null,
          userHasUnread: false,
          slaHours: TSMU.num(cfg('responseHours', 6)),
          dueAt: Date.now() + TSMU.num(cfg('responseHours', 6)) * 3600000
        };
        await DB().ref('tickets/' + t.id).update(patch).catch(() => { });
        // Persist the automatic acknowledgement schedule. This survives page navigation
        // and is claimed transactionally so the same automatic message cannot be sent twice.
        const ack = cfg('ackMessage', '');
        const ackOn = cfg('ackEnabled', true) !== false;
        if (ackOn && ack !== false && String(ack || '').trim() !== 'off') {
          const text = String(ack || '').trim() ||
            ('Ticket received. Our team will reply within ' + slaText() + '.');
          const delayMs = Math.max(0, TSMU.num(cfg('ackDelaySec', 0)) * 1000);
          await DB().ref('tickets/' + t.id).update({
            ackPending: true,
            ackDueAt: Date.now() + delayMs,
            ackText: text,
            ackDelaySec: Math.round(delayMs / 1000)
          }).catch(() => { });
          if (TSMU.ensureTicketAck) TSMU.ensureTicketAck(t.id);
        }
        const proof = (document.getElementById('tsmuTkProof') || {});
        if (proof.value) proof.value = '';
        const usedPriority = patch.priority;
        chosenPriority = 'normal'; paintPriority();
        showSubmitted(Object.assign({}, t, patch, { priority: usedPriority }));
      } catch (e) { console.warn('[TSMU ticket]', e); }
    }, 900);
    return out;
  });

  function countTickets() {
    const uid = TSMU.uid(); if (!uid) return Promise.resolve(0);
    return DB().ref('tickets').orderByChild('userId').equalTo(uid).once('value')
      .then(s => s.numChildren())
      .catch(() => 0);
  }
  function newestTicket() {
    const uid = TSMU.uid(); if (!uid) return Promise.resolve(null);
    return DB().ref('tickets').orderByChild('userId').equalTo(uid).once('value').then(s => {
      let best = null;
      s.forEach(c => { const v = c.val() || {}; if (v.userId === uid && (!best || TSMU.num(v.createdAt) > TSMU.num(best.createdAt))) best = Object.assign({ id: c.key }, v); });
      return best;
    }).catch(() => null);
  }

  function showSubmitted(t) {
    const pri = PRIORITIES.find(p => p.id === t.priority) || PRIORITIES[1];
    let m = document.getElementById('tsmuTkDone');
    if (!m) {
      m = document.createElement('div'); m.id = 'tsmuTkDone';
      m.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,.62);backdrop-filter:blur(3px);z-index:99992;display:flex;align-items:center;justify-content:center;padding:18px';
      m.onclick = e => { if (e.target === m) m.style.display = 'none'; };
      document.body.appendChild(m);
    }
    m.innerHTML = '<div style="background:var(--card-bg,#fff);border-radius:18px;max-width:410px;width:100%;padding:24px;box-shadow:0 22px 60px rgba(0,0,0,.32)">' +
      '<div style="text-align:center"><div style="font-size:52px;line-height:1;margin-bottom:10px">&#127915;</div>' +
      '<h3 style="font-size:19px;font-weight:800;color:#059669;margin-bottom:6px">Ticket Submitted</h3>' +
      '<div style="font-family:monospace;font-size:15px;font-weight:800;color:var(--text-primary,#0f172a);margin-bottom:4px">#' + esc(t.ticketNumber || t.id) + '</div>' +
      '<span class="tsmu-tk-badge" style="background:' + pri.color + '">' + esc(pri.label) + ' PRIORITY</span></div>' +
      '<div style="margin-top:16px;padding:13px;border-radius:11px;background:var(--border-light,#f8fafc);font-size:12.8px;line-height:1.75;color:var(--text-secondary,#475569)">' +
      '<b>What happens next</b><br>' +
      '1. Our team reviews your ticket.<br>' +
      '2. You get a reply within <b>' + esc(slaText()) + '</b>.<br>' +
      '3. You will be notified here and by email.<br>' +
      '4. Reply in the same ticket until it is solved.</div>' +
      '<div style="display:flex;gap:8px;margin-top:16px">' +
      '<button class="tsmu-btn sec" style="flex:1" onclick="document.getElementById(\'tsmuTkDone\').style.display=\'none\'">Create Another</button>' +
      '<button class="tsmu-btn" style="flex:1" onclick="document.getElementById(\'tsmuTkDone\').style.display=\'none\';openTicketConversation(\'' + esc(t.id) + '\')">View Ticket</button>' +
      '</div></div>';
    m.style.display = 'flex';
    try { playSound('success'); } catch (e) { }
  }

  /* ═══════ 3. TICKET LIST: priority + unread badge ═══════ */
  wrap('displayTicketsHistory', orig => function (tickets) {
    const r = orig.apply(this, arguments);
    setTimeout(() => {
      const list = Array.isArray(tickets) ? tickets : [];
      const host = document.getElementById('ticketsHistoryContainer'); if (!host) return;
      const rows = host.querySelectorAll('tbody tr, .ticket-history-card, .ticket-item');
      Array.prototype.forEach.call(rows, row => {
        row.querySelectorAll('.tsmu-tk-badge, .tsmu-tk-new').forEach(x => x.remove());  // always refresh
        const txt = row.textContent || '';
        const t = list.find(x => { const n = String(x.ticketNumber || x.id || ''); return n && txt.indexOf(n) >= 0; });
        if (!t) return;
        const p = PRIORITIES.find(x => x.id === t.priority);
        let html = '';
        if (p && p.id !== 'normal') html += '<span class="tsmu-tk-badge" style="background:' + p.color + '">' + esc(p.label) + '</span>';
        if (t.userHasUnread) html += '<span class="tsmu-tk-new">NEW REPLY</span>';
        if (!html) return;
        const cell = row.querySelector('td') || row;
        cell.insertAdjacentHTML('beforeend', ' ' + html);
      });
      updateUnreadBadge(list);
    }, 260);
    return r;
  });

  function updateUnreadBadge(list) {
    const n = (list || []).filter(t => t.userHasUnread).length;
    const b = document.getElementById('menuTicketBadge');
    if (b) { b.textContent = n; b.style.display = n ? 'inline-block' : 'none'; }
  }

  /* ═══════ 4. CONVERSATION: status timeline + mark read + rating ═══════ */
  wrap('renderTicketConvoHeader', orig => function (t) {
    const r = orig.apply(this, arguments);
    try {
      const host = document.getElementById('ticketConvoHeader');
      if (host && t && !document.getElementById('tsmuTkTimeline')) {
        const status = String(t.status || 'open').toLowerCase();
        const step = (label, state) => '<span class="st ' + state + '"><i class="dot"></i>' + label + '</span>';
        const answered = status === 'answered' || status === 'closed';
        const closed = status === 'closed';
        const p = PRIORITIES.find(x => x.id === t.priority);
        const el = document.createElement('div');
        el.className = 'tsmu-tl'; el.id = 'tsmuTkTimeline';
        el.innerHTML = step('Submitted', 'done') + '<span class="arw">&rarr;</span>' +
          step('Answered', answered ? 'done' : 'now') + '<span class="arw">&rarr;</span>' +
          step('Closed', closed ? 'done' : '') +
          (p && p.id !== 'normal' ? '<span class="tsmu-tk-badge" style="background:' + p.color + ';margin-left:auto">' + esc(p.label) + '</span>' : '') +
          (!answered && t.dueAt ? '<span style="margin-left:auto;font-size:11px;color:var(--text-gray)">Reply expected by ' + TSMU.dt(t.dueAt) + '</span>' : '');
        host.parentNode.insertBefore(el, host.nextSibling);
      }
      if (t && t.id) DB().ref('tickets/' + t.id + '/userHasUnread').set(false).catch(() => { });
      if (t && String(t.status).toLowerCase() === 'closed') maybeRate(t);
      if (t && t.proofLink) showProof(t.proofLink);
    } catch (e) { }
    return r;
  });

  function showProof(link) {
    if (document.getElementById('tsmuTkProofView')) return;
    const host = document.getElementById('ticketConvoThread'); if (!host) return;
    const d = document.createElement('div');
    d.id = 'tsmuTkProofView'; d.className = 'tsmu-note tsmu-n-info';
    d.innerHTML = '&#128206; Attached proof: <a href="' + esc(link) + '" target="_blank" rel="noopener" style="color:#0ea5e9;word-break:break-all">' + esc(link) + '</a>';
    host.parentNode.insertBefore(d, host);
  }

  function maybeRate(t) {
    if (t.rating || document.getElementById('tsmuTkRate')) return;
    const host = document.getElementById('ticketConvoReplyArea') || document.getElementById('ticketConvoThread');
    if (!host) return;
    const d = document.createElement('div');
    d.className = 'tsmu-rate'; d.id = 'tsmuTkRate';
    d.innerHTML = '<div style="font-weight:800;font-size:13.5px;color:var(--text-primary,#0f172a)">How was our support?</div>' +
      '<div class="stars" id="tsmuTkStars">' + [1, 2, 3, 4, 5].map(i => '<span data-s="' + i + '">&#9734;</span>').join('') + '</div>' +
      '<div style="font-size:11.5px;color:var(--text-gray,#64748b)">Your feedback helps us improve.</div>';
    host.parentNode.insertBefore(d, host);
    const stars = d.querySelectorAll('#tsmuTkStars span');
    stars.forEach(sp => {
      sp.onmouseenter = () => stars.forEach((x, i) => x.innerHTML = i < Number(sp.dataset.s) ? '&#9733;' : '&#9734;');
      sp.onclick = () => {
        const v = Number(sp.dataset.s);
        DB().ref('tickets/' + t.id).update({ rating: v, ratedAt: Date.now() }).catch(() => { });
        d.innerHTML = '<div style="font-weight:800;color:#059669;font-size:13.5px">Thank you for rating us ' + v + '/5</div>';
      };
    });
  }

  /* the user replied -> the admin should see it as unread, and vice versa */
  wrap('submitTicketReply', orig => async function () {
    const out = await orig.apply(this, arguments);
    try {
      const id = TSMU.G('currentTicketId') || TSMU.G('activeTicketId');
      if (id) DB().ref('tickets/' + id).update({ adminHasUnread: true, userHasUnread: false, status: 'open', updatedAt: Date.now() }).catch(() => { });
    } catch (e) { }
    return out;
  });

  /* ═══════ 5. live settings + mount ═══════ */
  TSMU.onReady(function () {
    DB().ref('settings/ticketSystem').on('value', s => {
      TSMU.tkCfg = s.val() || {};
      paintPriority(); paintSla();
    }, () => { });
    TSMU.registerMount(function () { mountForm(); });
    // keep the menu badge honest even before the page is opened
    const uid = TSMU.uid();
    if (uid) DB().ref('tickets').orderByChild('userId').equalTo(uid).on('value', s => {
      const mine = []; s.forEach(c => { const v = c.val() || {}; if (v.userId === uid) mine.push(v); });
      updateUnreadBadge(mine);
    }, () => { });
  });

  console.log('%c TSMU v34 support desk loaded ', 'background:#db2777;color:#fff;padding:2px 6px;border-radius:4px');
})();


/* ---------- 10-platforms.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v35 USER · PART 10 — SOCIAL NETWORK (PLATFORM) BAR
   Professional SMM-panel style "Select a Social Network" selector.
     • Fully admin controlled  (DB: platforms/*, settings/platformBar)
     • Icon per platform: built-in brand SVG logo, emoji or image URL
     • Filters the New Order service dropdown, the Services catalog and
       the package search results
     • Live: any admin change appears instantly, no refresh needed
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const DB = () => TSMU.db();
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };

  const DEF_CFG = {
    enabled: true, onOrder: true, onCatalog: true, autoDetect: true,
    title: 'Select a Social Network', allLabel: 'All Services',
    showAll: true, showCounts: true, hideEmpty: true, filterSearch: true,
    remember: true
  };

  const PF = TSMU.PF = {
    list: [],            // enabled platforms, sorted
    all: [],             // every platform (even disabled) for lookups
    byId: {},
    cfg: Object.assign({}, DEF_CFG),
    active: '',          // '' = All Services
    counts: {}
  };

  /* ─────────────── styles ─────────────── */
  const CSS = `
  .tsmu-pf{margin:0 0 10px}
  .tsmu-pf-t{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;
    color:var(--text-gray,#64748b);margin:0 0 6px;display:flex;align-items:center;gap:6px}
  .tsmu-pf-t .tsmu-pf-clear{margin-left:auto;font-size:9.5px;font-weight:800;color:var(--primary-color,#0ea5e9);
    background:none;border:0;cursor:pointer;font-family:inherit;letter-spacing:.3px;text-transform:uppercase;padding:0}
  .tsmu-pf-scroll{display:flex;gap:7px;overflow-x:auto;padding:2px 1px 6px;-webkit-overflow-scrolling:touch;scroll-behavior:smooth}
  .tsmu-pf-scroll::-webkit-scrollbar{height:3px}
  .tsmu-pf-scroll::-webkit-scrollbar-thumb{background:var(--border-color,#e2e8f0);border-radius:9px}
  .tsmu-pf-chip{flex:0 0 auto;width:60px;padding:7px 3px 6px;border-radius:11px;cursor:pointer;
    border:1.5px solid var(--border-color,#e2e8f0);background:var(--card-bg,#fff);text-align:center;
    transition:transform .13s,border-color .13s,box-shadow .13s;position:relative;font-family:inherit}
  .tsmu-pf-chip:hover{transform:translateY(-1px);box-shadow:0 3px 9px rgba(15,23,42,.08)}
  .tsmu-pf-chip:active{transform:scale(.96)}
  .tsmu-pf-chip .pf-ic{display:flex;align-items:center;justify-content:center;height:24px;margin-bottom:3px}
  .tsmu-pf-chip .pf-ic img{width:22px;height:22px;border-radius:7px;object-fit:cover;display:block}
  .tsmu-pf-chip .pf-ic .svc-logo-badge{width:22px;height:22px}
  .tsmu-pf-chip .pf-ic span{font-size:17px;line-height:1}
  .tsmu-pf-chip .pf-nm{font-size:9px;font-weight:800;color:var(--text-primary,#0f172a);line-height:1.2;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .tsmu-pf-chip .pf-ct{font-size:8px;font-weight:700;color:var(--text-gray,#64748b);margin-top:1px;letter-spacing:.1px}
  .tsmu-pf-chip.on{border-color:var(--pfc,#0ea5e9);border-width:2px;padding:6.5px 2.5px 5.5px}
  .tsmu-pf-chip.on .pf-nm{color:var(--pfc,#0ea5e9)}
  .tsmu-pf-chip.on::after{content:'';position:absolute;left:50%;bottom:-1px;transform:translateX(-50%);
    width:18px;height:2.5px;border-radius:3px;background:var(--pfc,#0ea5e9)}
  .tsmu-pf-none{padding:13px;border-radius:12px;background:var(--border-light,#f8fafc);
    font-size:12.5px;color:var(--text-gray,#64748b);text-align:center}
  @media(max-width:400px){.tsmu-pf-chip{width:54px}.tsmu-pf-chip .pf-nm{font-size:8.5px}}
  `;
  const st = document.createElement('style'); st.id = 'tsmuPlatformStyles'; st.textContent = CSS;
  document.head.appendChild(st);

  /* ─────────────── keyword fallback (used only when autoDetect is on) ─────────────── */
  const AUTO = {
    instagram: ['instagram', 'insta', ' ig ', 'reels'],
    facebook: ['facebook', ' fb ', 'fb '],
    youtube: ['youtube', 'yt ', 'shorts'],
    telegram: ['telegram', ' tg '],
    telegram_premium: ['telegram premium'],
    whatsapp: ['whatsapp', 'wa '],
    tiktok: ['tiktok', 'tik tok'],
    twitter: ['twitter'],
    x_services: [' x ', 'x services'],
    linkedin: ['linkedin'],
    spotify: ['spotify'],
    snapchat: ['snapchat', 'snap '],
    discord: ['discord'],
    pinterest: ['pinterest'],
    reddit: ['reddit'],
    threads: ['threads'],
    likee: ['likee'],
    website: ['website', 'traffic', 'seo'],
    google: ['google', 'gmb', 'maps'],
    apple: ['apple', 'itunes', 'app store'],
    crypto: ['crypto', 'bitcoin', 'coin'],
    mobile_app: ['app install', 'mobile app', 'play store']
  };

  /** Which platform does this service belong to? */
  PF.of = function (svc) {
    if (!svc) return '';
    const manual = String(svc.platform || '').trim();
    if (manual && PF.byId[manual]) return manual;
    if (manual === '__none__') return '';
    if (!PF.cfg.autoDetect) return '';
    const logo = String(svc.logo || '').trim().toLowerCase();
    if (logo && logo !== 'none') {
      const hit = PF.all.find(p => String(p.logo || '').toLowerCase() === logo);
      if (hit) return hit.id;
    }
    const name = ' ' + String(svc.name || '').toLowerCase() + ' ';
    for (let i = 0; i < PF.all.length; i++) {
      const p = PF.all[i];
      const words = String(p.keywords || '').split(',').map(w => w.trim().toLowerCase()).filter(Boolean);
      const auto = AUTO[String(p.logo || '').toLowerCase()] || AUTO[String(p.name || '').toLowerCase()] || [];
      const all = words.concat(auto);
      for (let k = 0; k < all.length; k++) if (all[k] && name.indexOf(all[k]) >= 0) return p.id;
    }
    return '';
  };

  PF.matches = function (svc) {
    if (!PF.active) return true;
    if (PF.active === '__unassigned__') return !PF.of(svc);
    return PF.of(svc) === PF.active;
  };

  function services() { return (TSMU.G('allServices') || []).filter(s => s && s.enabled !== false); }

  function recount() {
    const c = {}; let un = 0;
    services().forEach(s => { const p = PF.of(s); if (p) c[p] = (c[p] || 0) + 1; else un++; });
    c.__unassigned__ = un;
    PF.counts = c;
  }

  PF.icon = function (p) {
    if (!p) return '<span>🌐</span>';
    if (p.img) return '<img src="' + esc(p.img) + '" alt="' + esc(p.name || '') + '" loading="lazy">';
    if (p.emoji) return '<span>' + esc(p.emoji) + '</span>';
    const logo = String(p.logo || '').trim().toLowerCase();
    if (logo && logo !== 'none' && window.getServiceLogoHTML) {
      const h = window.getServiceLogoHTML(logo);
      if (h) return h;
    }
    return '<span>🌐</span>';
  };

  /* ─────────────── rendering ─────────────── */
  function chipHTML(id, name, icon, color, count) {
    return '<button type="button" class="tsmu-pf-chip' + (PF.active === id ? ' on' : '') + '" ' +
      'style="--pfc:' + esc(color || '#0ea5e9') + '" data-pf="' + esc(id) + '" ' +
      'onclick="TSMU.PF.select(\'' + esc(id).replace(/'/g, "\\'") + '\')" title="' + esc(name) + '">' +
      '<span class="pf-ic">' + icon + '</span>' +
      '<span class="pf-nm">' + esc(name) + '</span>' +
      (PF.cfg.showCounts && count != null ? '<span class="pf-ct">' + count + '</span>' : '') +
      '</button>';
  }

  function barHTML() {
    recount();
    const total = services().length;
    let chips = '';
    if (PF.cfg.showAll !== false)
      chips += chipHTML('', PF.cfg.allLabel || 'All Services', '<span>🗂️</span>', '#0ea5e9', total);

    PF.list.forEach(p => {
      const n = PF.counts[p.id] || 0;
      if (PF.cfg.hideEmpty !== false && n === 0 && PF.active !== p.id) return;
      chips += chipHTML(p.id, p.name || 'Platform', PF.icon(p), p.color, n);
    });

    if (PF.cfg.showUnassigned && (PF.counts.__unassigned__ || 0) > 0)
      chips += chipHTML('__unassigned__', 'Others', '<span>📦</span>', '#64748b', PF.counts.__unassigned__);

    if (!chips) return '';
    return '<div class="tsmu-pf-t"><span>' + esc(PF.cfg.title || DEF_CFG.title) + '</span>' +
      (PF.active ? '<button type="button" class="tsmu-pf-clear" onclick="TSMU.PF.select(\'\')">✖ Clear filter</button>' : '') +
      '</div><div class="tsmu-pf-scroll">' + chips + '</div>';
  }

  function mountBar(hostId, anchorFn, show) {
    let bar = document.getElementById(hostId);
    if (!PF.cfg.enabled || !show || !PF.list.length) { if (bar) bar.remove(); return; }
    if (!bar) {
      const anchor = anchorFn();
      if (!anchor) return;
      bar = document.createElement('div');
      bar.className = 'tsmu-pf'; bar.id = hostId;
      if (anchor.dataset && anchor.dataset.slot === '1') anchor.appendChild(bar);
      else if (anchor.parentNode) anchor.parentNode.insertBefore(bar, anchor);
      else return;
    }
    const html = barHTML();
    if (!html) { bar.remove(); return; }
    if (bar._html !== html) { bar._html = html; bar.innerHTML = html; }
  }

  PF.paint = function () {
    mountBar('tsmuPfBarOrder',
      () => {
        /* fixed position: directly under the "New Order" heading, above the
           wishlist strip and above the search box */
        const slot = TSMU.orderTopSlot ? TSMU.orderTopSlot('pf') : null;
        if (slot) { slot.dataset.slot = '1'; return slot; }
        const s = document.getElementById('customServiceDropdown');
        return s ? (s.closest('.input-group') || s) : null;
      },
      PF.cfg.onOrder !== false);

    mountBar('tsmuPfBarCatalog',
      () => {
        const p = document.getElementById('servicesCatalogContainer');
        if (!p) return null;
        const search = p.parentNode.querySelector('.order-search-bar');
        return search || p;
      },
      PF.cfg.onCatalog !== false);
  };

  /* ─────────────── selection ─────────────── */
  PF.select = function (id) {
    id = String(id == null ? '' : id);
    /* tapping the chip that is already active is a no-op: a filter must never
       reset by accident. "All Services" and the ✖ Clear filter button clear it. */
    if (PF.active === id) { PF.paint(); return; }
    PF.active = id;
    try { if (PF.cfg.remember !== false) sessionStorage.setItem('tsmuPlatform', id); } catch (e) { }

    // if the currently selected service is not in this platform, release it
    const sel = document.getElementById('serviceSelect');
    if (sel && sel.value) {
      const svc = services().find(s => s.id === sel.value);
      if (svc && !PF.matches(svc)) {
        sel.value = '';
        try { if (window.updateServiceDropdownDisplay) updateServiceDropdownDisplay('', placeholderText(), ''); } catch (e) { }
        try { if (TSMU.clearPick) TSMU.clearPick(); } catch (e) { }
        try { if (window.loadPackages) loadPackages(); } catch (e) { }
      }
    }
    refreshLists();
    PF.paint();
    const p = PF.byId[id];
    if (id === '__unassigned__') TSMU.toast('Showing other services', 'success');
    else if (p) TSMU.toast('Showing ' + (p.name || 'platform') + ' services', 'success');
  };

  function placeholderText() {
    try { return textOr(newOrderControl.servicePlaceholder, NEW_ORDER_DEFAULTS.servicePlaceholder); }
    catch (e) { return '-- Select Service --'; }
  }

  function refreshLists() {
    try { if (window.displayServices) displayServices(TSMU.G('allServices') || []); } catch (e) { }
    try {
      if (window.renderServicesCatalog) {
        const box = document.getElementById('catalogSearchBox');
        renderServicesCatalog(box ? box.value.trim() : '');
      }
    } catch (e) { }
    try { if (window.searchPackages && (document.getElementById('packageSearchInput') || {}).value) searchPackages(); } catch (e) { }
  }
  PF.refresh = refreshLists;

  /* ─────────────── filtering hooks ─────────────── */
  /* 1. New Order service dropdown — filter the array the panel renders */
  wrap('displayServices', orig => function (list) {
    if (!PF.cfg.enabled || !PF.active) return orig.apply(this, arguments);
    const filtered = (list || []).filter(s => PF.matches(s));
    const r = orig.call(this, filtered);
    setTimeout(PF.paint, 30);
    return r;
  });

  /* 2. Services catalog — it reads the global, so swap the global for one call */
  wrap('renderServicesCatalog', orig => function () {
    if (!PF.cfg.enabled || !PF.active) { const r0 = orig.apply(this, arguments); setTimeout(PF.paint, 30); return r0; }
    const full = TSMU.G('allServices') || [];
    TSMU.S('allServices', full.filter(s => PF.matches(s)));
    let r;
    try { r = orig.apply(this, arguments); } finally { TSMU.S('allServices', full); }
    const cont = document.getElementById('servicesCatalogContainer');
    if (cont && /No Services Found/i.test(cont.innerHTML)) {
      const p = PF.byId[PF.active];
      cont.innerHTML = '<div class="tsmu-pf-none">No services are listed under <b>' +
        esc(p ? (p.name || 'this network') : 'this network') + '</b> right now.<br>' +
        '<button class="tsmu-btn sec sm" style="margin-top:9px" onclick="TSMU.PF.select(\'\')">Show all services</button></div>';
    }
    setTimeout(PF.paint, 30);
    return r;
  });

  /* 3. Package search results honour the active network too */
  wrap('searchPackages', orig => function () {
    if (!PF.cfg.enabled || !PF.active || PF.cfg.filterSearch === false) return orig.apply(this, arguments);
    const full = TSMU.G('allPackagesForSearch') || [];
    const svcMap = {};
    services().forEach(s => { svcMap[s.id] = PF.matches(s); });
    TSMU.S('allPackagesForSearch', full.filter(p => svcMap[p.serviceId]));
    try { return orig.apply(this, arguments); } finally { TSMU.S('allPackagesForSearch', full); }
  });

  /* 4. A service chosen from search / catalog / re-order must never stay hidden */
  ['selectPackageFromSearch', 'orderNowFromCatalog'].forEach(fn =>
    wrap(fn, orig => function (serviceId) {
      if (PF.active && serviceId) {
        const svc = services().find(s => s.id === serviceId);
        if (svc && !PF.matches(svc)) { PF.active = ''; try { sessionStorage.setItem('tsmuPlatform', ''); } catch (e) { } refreshLists(); PF.paint(); }
      }
      return orig.apply(this, arguments);
    }));
  TSMU.pfClearForService = function (serviceId) {
    if (!PF.active || !serviceId) return;
    const svc = services().find(s => s.id === serviceId);
    if (svc && !PF.matches(svc)) { PF.active = ''; refreshLists(); PF.paint(); }
  };

  /* ─────────────── live data ─────────────── */
  function sortList(obj) {
    return Object.entries(obj || {})
      .filter(([, v]) => v && typeof v === 'object')
      .map(([id, v]) => Object.assign({ id: id }, v, { _o: Number.isFinite(Number(v.order)) ? Number(v.order) : 999999 }))
      .sort((a, b) => (a._o - b._o) || String(a.name || '').localeCompare(String(b.name || '')));
  }

  function watch() {
    DB().ref('platforms').on('value', s => {
      PF.all = sortList(s.val());
      PF.byId = {}; PF.all.forEach(p => { PF.byId[p.id] = p; });
      PF.list = PF.all.filter(p => p.enabled !== false);
      if (PF.active && PF.active !== '__unassigned__' && !PF.byId[PF.active]) PF.active = '';
      refreshLists(); PF.paint();
    }, e => console.warn('[TSMU platforms]', e.message));

    DB().ref('settings/platformBar').on('value', s => {
      PF.cfg = Object.assign({}, DEF_CFG, s.val() || {});
      if (!PF.cfg.enabled) { PF.active = ''; refreshLists(); }
      PF.paint();
    }, () => { });
  }

  TSMU.onReady(function () {
    try {
      const saved = sessionStorage.getItem('tsmuPlatform');
      if (saved) PF.active = saved;
    } catch (e) { }
    watch();
    TSMU.registerMount(function () { PF.paint(); });
    setTimeout(PF.paint, 900);
    setTimeout(PF.paint, 2500);
