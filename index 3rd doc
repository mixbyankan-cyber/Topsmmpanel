    // Apply Referral Code (One-time use)
    async function applyReferralCode() {
      if (!currentUser) {
        showToast('Please login first', 'error');
        return;
      }
      if (!ensureFeatureAllowed('referral', 'Referral Code')) return;

      if (hasUsedReferralCode) {
        showToast('You have already used a referral code!', 'error');
        return;
      }

      const codeInput = document.getElementById('referralCodeInput');
      const code = codeInput.value.trim().toUpperCase();

      if (!code) {
        playSound('error');
        showToast('Please enter a referral code', 'error');
        return;
      }

      // Prevent self-referral
      if (code === currentUserReferralCode) {
        playSound('error');
        showToast('❌ You cannot use your own referral code!', 'error');
        return;
      }

      try {
        // Find the referrer by code (flat index — no full users scan needed)
        const idxSnap = await database.ref('referral_code_index/' + code).once('value');
        const rec = idxSnap.val();
        const referrerUserId = (rec && rec.uid) ? rec.uid : null;

        if (!referrerUserId) {
          playSound('error');
          showToast('❌ Invalid referral code!', 'error');
          return;
        }

        // Prevent self-referral (double check)
        if (referrerUserId === currentUser.uid) {
          playSound('error');
          showToast('❌ You cannot use your own referral code!', 'error');
          return;
        }

        // Create referral usage record
        const newUsageRef = database.ref('referral_usages').push();
        await newUsageRef.set({
          referee_user_id: currentUser.uid,
          used_code: code,
          referrer_user_id: referrerUserId,
          used_at: Date.now(),
          is_valid: true
        });

        // Update user's used_referral flag
        await database.ref(`users/${currentUser.uid}`).update({
          used_referral: true,
          used_referral_code: code,
          referrer_user_id: referrerUserId
        });

        // Send notifications
        createNotification(
          currentUser.uid,
          '✅ Referral Code Applied!',
          `You're now using referral code ${code}. Your referrer will earn commission on your orders!`,
          'referral',
          { code: code, icon: '✅' }
