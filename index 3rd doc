    // ══════════════════════════════════════════════════════════════════
    // 🔢 SHORT NUMERIC ORDER ID GENERATOR
    // Generates a professional-looking 6-digit order ID (e.g. "195645")
    // instead of a long Firebase push-key. Uniqueness is guaranteed by
    // reserving the ID in a global index (order_id_index/{id}) before use —
    // Admin Panel and notifications all reference this same short ID.
    // ══════════════════════════════════════════════════════════════════
    function secureRandomSixDigits() {
      if (window.crypto && window.crypto.getRandomValues) {
        const x = new Uint32Array(1); window.crypto.getRandomValues(x);
        return String(100000 + (x[0] % 900000));
      }
      return String(100000 + Math.floor(Math.random() * 900000));
    }

    async function reserveUniqueNumericId(indexNode, purpose) {
      // One scalar counter in the permanent Control Firebase guarantees IDs
      // never collide across any active/read-only data project. It starts at
      // 1,000,000 so it cannot collide with historical 6-digit random IDs.
      const result = await callFreeBackend('allocateGlobalId', { purpose });
      if (!result.id) throw new Error('Global ID allocation failed.');
      return String(result.id);
    }

    function generateUniqueOrderId() {
      return reserveUniqueNumericId('order_id_index', 'order');
    }
    function generateUniqueFundRequestId() {
      return reserveUniqueNumericId('fund_id_index', 'fund');
    }

    // ══════════════════════════════════════════════════════════════════
    // 🔢 UNIFIED ID DISPLAY HELPER
    // NEW orders/fund-requests carry a short `orderNumber`/`requestNumber`
    // (e.g. "195645") and are shown as-is.
    // OLDER records made before this feature don't have that field, so they
    // keep showing exactly like before: "#" + first 8 chars of the Firebase
    // key, uppercased (e.g. "#OPBZ86F1") — nothing changes for old history.
    // ══════════════════════════════════════════════════════════════════
    function formatShortId(item, numberField) {
      if (item[numberField]) return item[numberField];
      return '#' + (item.id || '').substring(0, 8).toUpperCase();
    }

    // ══════════════════════════════════════════════════════════════════
    // 🎫 SUPPORT TICKET SYSTEM
    // Firebase schema:
    //   tickets/{ticketId}: ticketNumber, userId, userName, userEmail,
    //     subject ('order'|'payment'|'account'|'other'), orderIds ([]),
    //     requestType (string, only for subject='order'),
    //     paymentMethod (string, only for subject='payment'),
    //     status ('open'|'answered'|'closed'), createdAt, updatedAt,
    //     lastMessageAt, lastMessageBy ('user'|'admin'),
    //     userHasUnread (bool), adminHasUnread (bool)
    //   tickets/{ticketId}/messages/{msgId}: sender ('user'|'admin'),
    //     senderName, message (HTML string from the rich editor), createdAt
    //   ticket_id_index/{6digit}: { ticketId } — uniqueness index
    //   settings/ticketSystem/enabled (bool) — global on/off switch
    //   settings/ticketRequestTypes/{id}: { label, sortOrder }
    //   settings/ticketFaq/{id}: { question, answer, sortOrder }
    // ══════════════════════════════════════════════════════════════════

    const DEFAULT_TICKET_SUBJECTS = [
      { key: 'order', label: '📦 Order', behavior: 'order' },
      { key: 'payment', label: '💰 Payment', behavior: 'payment' },
      { key: 'account', label: '👤 Account', behavior: 'plain' },
      { key: 'other', label: '❓ Other', behavior: 'plain' }
    ];

    const DEFAULT_TICKET_REQUEST_TYPES = [
      'Refill', 'Cancel', 'Speed Up', 'Restart', 'Not Started',
      'Remove Auto Refill', 'Mark as Completed without Done', 'Other'
    ];

    let ticketSubjectsCache = DEFAULT_TICKET_SUBJECTS; // live-loaded from settings/ticketSubjects (Admin-managed)
    let ticketRequestTypesCache = [];
    let selectedTicketSubject = null;
    let selectedTicketRequestType = null;
    let selectedTicketOrderIds = []; // array of displayed short order IDs
    let allMyTicketsArray = [];
    let currentTicketFilter = 'all';
    let currentTicketSearchTerm = '';
    let ticketConvoListeners = { header: null, messages: null };
    let currentOpenTicketId = null;

    // ── Load Admin-configured Subjects (with default seed) — fully
    // add/edit/delete controllable from Admin Panel → Ticket Settings.
    function loadTicketSubjects() {
      database.ref('settings/ticketSubjectsSeeded').once('value').catch(e=>{console.warn('ticketSubjectsSeeded read blocked:',e.message);return null;}).then(seededSnap => { if(!seededSnap) return;
        if (!seededSnap.exists()) {
          const seedUpdates = {};
          DEFAULT_TICKET_SUBJECTS.forEach((s, i) => {
            const key = database.ref('settings/ticketSubjects').push().key;
            seedUpdates[`settings/ticketSubjects/${key}`] = { ...s, sortOrder: i };
          });
          seedUpdates['settings/ticketSubjectsSeeded'] = true;
          database.ref().update(seedUpdates).catch(() => {});
        }
      });

      sessionOn(database.ref('settings/ticketSubjects'), 'value', snap => {
        const data = snap.val() || {};
        const items = Object.values(data).sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0));
        ticketSubjectsCache = items.length > 0 ? items : DEFAULT_TICKET_SUBJECTS;
        renderTicketSubjectButtons();
      });
    }

    function getTicketSubjectLabel(key) {
      const found = ticketSubjectsCache.find(s => s.key === key);
      return found ? found.label : key;
    }

    // Returns the Admin-configured "behavior" for a subject key
    // ('order' | 'payment' | 'plain') — falls back sensibly for the
    // original default keys even if the cache hasn't loaded yet.
    function getTicketSubjectBehavior(key) {
      const found = ticketSubjectsCache.find(s => s.key === key);
      if (found) return found.behavior || 'plain';
      if (key === 'order') return 'order';
      if (key === 'payment') return 'payment';
      return 'plain';
    }

    // ── Render the Subject / Request pill-button groups ──
    function renderTicketSubjectButtons() {
      const container = document.getElementById('ticketSubjectGroup');
      if (!container) return;
      container.innerHTML = ticketSubjectsCache.map(s => `
        <div class="ticket-option-btn ${selectedTicketSubject === s.key ? 'active' : ''}" onclick="selectTicketSubject('${s.key}')">
          <div class="ticket-option-radio"></div>
          ${s.label}
        </div>
      `).join('');
    }

    function renderTicketRequestButtons() {
      const container = document.getElementById('ticketRequestGroup');
      if (!container) return;
      container.innerHTML = ticketRequestTypesCache.map(r => `
        <div class="ticket-option-btn ${selectedTicketRequestType === r ? 'active' : ''}" onclick="selectTicketRequestType('${r.replace(/'/g, "\\'")}')">
          <div class="ticket-option-radio"></div>
          ${r}
        </div>
      `).join('');
    }

    function selectTicketSubject(subjectId) {
      selectedTicketSubject = subjectId;
      renderTicketSubjectButtons();

      const orderFields = document.getElementById('ticketOrderFields');
      const paymentFields = document.getElementById('ticketPaymentFields');

      // Look up the Admin-configured "behavior" for this subject (not just
      // the key) so custom subjects created in Admin Panel still correctly
      // show the Order ID picker / Payment Method dropdown as intended.
      const subjectDef = ticketSubjectsCache.find(s => s.key === subjectId);
      const behavior = subjectDef ? (subjectDef.behavior || 'plain') : (subjectId === 'order' ? 'order' : subjectId === 'payment' ? 'payment' : 'plain');

      if (behavior === 'order') {
        orderFields.style.display = 'block';
        paymentFields.style.display = 'none';
        renderTicketRequestButtons();
      } else if (behavior === 'payment') {
        orderFields.style.display = 'none';
        paymentFields.style.display = 'block';
        loadTicketPaymentMethodOptions();
      } else {
        orderFields.style.display = 'none';
        paymentFields.style.display = 'none';
      }
      updateTicketMessageOptionalUI();
    }

    function selectTicketRequestType(type) {
      selectedTicketRequestType = type;
      renderTicketRequestButtons();
      updateTicketMessageOptionalUI();
    }

    // ✅ Live-updates the Message field's "(Optional)" label + helper text
    // — Message becomes optional ONLY when Subject = Order AND at least one
    // Order ID has been added, since Request Type + Order ID(s) alone
    // already give Admin everything needed to act on the ticket.
    function updateTicketMessageOptionalUI() {
      const isOptional = getTicketSubjectBehavior(selectedTicketSubject) === 'order' && selectedTicketOrderIds.length > 0;
      const tag = document.getElementById('ticketMessageOptionalTag');
      const helpText = document.getElementById('ticketMessageHelpText');
      if (tag) tag.style.display = isOptional ? 'inline' : 'none';
      if (helpText) helpText.style.display = isOptional ? 'block' : 'none';
    }

    // ── Order ID picker: supports BOTH manually typing any Order ID(s)
    // (own orders don't have to be pre-existing in the loaded history —
    // useful for orders placed via API, or if the list hasn't loaded yet)
    // AND browsing/picking from the user's own Order History. ──
    function toggleTicketOrderIdDropdown() {
      const dropdown = document.getElementById('ticketOrderIdDropdown');
      if (!dropdown) return;
      const isOpen = dropdown.classList.contains('open');
      if (isOpen) {
        dropdown.classList.remove('open');
        return;
      }
      renderTicketOrderIdOptions();
      dropdown.classList.add('open');

      // Close when clicking outside
      setTimeout(() => {
        document.addEventListener('click', closeTicketOrderIdDropdownOnOutsideClick);
      }, 0);
    }

    function closeTicketOrderIdDropdownOnOutsideClick(e) {
      const picker = document.querySelector('.ticket-orderid-picker');
      if (picker && !picker.contains(e.target)) {
        const dropdown = document.getElementById('ticketOrderIdDropdown');
        if (dropdown) dropdown.classList.remove('open');
        document.removeEventListener('click', closeTicketOrderIdDropdownOnOutsideClick);
      }
    }

    function renderTicketOrderIdOptions() {
      const dropdown = document.getElementById('ticketOrderIdDropdown');
      if (!dropdown) return;
      const orders = window._lastOrdersArray || [];

      if (orders.length === 0) {
        dropdown.innerHTML = `<div style="padding:16px; text-align:center; color:var(--text-gray); font-size:13px;">You have no orders yet — you can still type an Order ID manually above.</div>`;
        return;
      }

      dropdown.innerHTML = orders.map(o => {
        const shortId = formatShortId(o, 'orderNumber');
        const isSelected = selectedTicketOrderIds.includes(shortId);
        return `
          <div class="ticket-orderid-option ${isSelected ? 'selected' : ''}" onclick="toggleTicketOrderIdSelection('${shortId}', event)">
            <span class="tid-id">${shortId}</span>
            <span class="tid-meta">${(o.serviceName || '')} • ${(o.link || '').substring(0, 30)}</span>
            <span>${isSelected ? '✅' : ''}</span>
          </div>
        `;
      }).join('');
    }

    function toggleTicketOrderIdSelection(shortId, event) {
      if (event) event.stopPropagation();
      addTicketOrderId(shortId); // will toggle off if already present
    }

    // Adds a single Order ID to the selected list (used by BOTH manual
    // typing and the browse dropdown) — de-duplicates and re-renders chips.
    function addTicketOrderId(rawId) {
      const id = (rawId || '').trim();
      if (!id) return;
      const idx = selectedTicketOrderIds.indexOf(id);
      if (idx === -1) {
        selectedTicketOrderIds.push(id);
      } else {
        selectedTicketOrderIds.splice(idx, 1); // toggle off if clicked again from the dropdown
      }
      renderTicketOrderIdChips();
      renderTicketOrderIdOptions();
      updateTicketMessageOptionalUI();
    }

    function removeTicketOrderIdChip(shortId, event) {
      if (event) event.stopPropagation();
      selectedTicketOrderIds = selectedTicketOrderIds.filter(id => id !== shortId);
      renderTicketOrderIdChips();
      updateTicketMessageOptionalUI();
    }

    // Live-typing handler — commits a chip automatically as soon as the
    // user types a comma (so "12345,12346,12347" works exactly like the
    // reference SMM panel's "separate them using comma" instruction).
    function handleTicketOrderIdInput(event) {
      const input = event.target;
      if (input.value.includes(',')) {
        const parts = input.value.split(',');
        const lastPart = parts.pop(); // keep whatever's after the last comma as the still-being-typed value
        parts.forEach(p => addTicketOrderId(p));
        input.value = lastPart;
      }
    }

    // Enter key also commits the currently-typed Order ID as a chip.
    function handleTicketOrderIdKeydown(event) {
      if (event.key === 'Enter') {
        event.preventDefault();
        commitTicketOrderIdTyped();
      }
    }

    // Commits whatever is currently typed (called on Enter or when the
    // input loses focus) so a typed ID is never lost/forgotten.
    function commitTicketOrderIdTyped() {
      const input = document.getElementById('ticketOrderIdTypeInput');
      if (!input) return;
      const value = input.value.trim();
      if (value) {
        addTicketOrderId(value);
        input.value = '';
      }
    }

    function renderTicketOrderIdChips() {
      const container = document.getElementById('ticketOrderIdChips');
      if (!container) return;

      const chipsHtml = selectedTicketOrderIds.map(id => `
        <span class="ticket-orderid-chip">
          ${id}
          <span class="chip-remove" onclick="removeTicketOrderIdChip('${id}', event)">✖</span>
        </span>
      `).join('');

      const placeholderHtml = selectedTicketOrderIds.length === 0
        ? `<span class="ticket-orderid-chtopsmm-placeholder" id="ticketOrderIdPlaceholder">Type an Order ID and press Enter/comma...</span>`
        : '';

      // Always keep the live typing <input> present (re-created here since
      // the whole container is re-rendered) so the user can keep adding
      // more IDs after removing/adding a chip.
      container.innerHTML = placeholderHtml + chipsHtml +
        `<input type="text" class="ticket-orderid-input" id="ticketOrderIdTypeInput" placeholder="" oninput="handleTicketOrderIdInput(event)" onkeydown="handleTicketOrderIdKeydown(event)" onblur="commitTicketOrderIdTyped()">`;
    }

    // ── Payment Method dropdown for Subject = Payment ──
    function loadTicketPaymentMethodOptions() {
