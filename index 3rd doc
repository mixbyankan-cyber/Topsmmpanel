    .btn-apply-code:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .referral-code-used-banner {
      background: linear-gradient(135deg, var(--success-light), var(--success));
      color: var(--success);
      padding: 15px;
      border-radius: 12px;
      text-align: center;
      font-weight: 600;
      margin-bottom: 20px;
      border: 2px solid var(--success);
    }

    .referral-earnings-card {
      background: var(--white);
      border-radius: 16px;
      padding: 25px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-md);
    }

    .referral-earnings-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--dark-text);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .earnings-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid var(--border-light);
    }

    .earnings-item:last-child {
      border-bottom: none;
    }

    .earnings-label {
      font-size: 14px;
      color: var(--text-secondary);
    }

    .earnings-value {
      font-size: 16px;
      font-weight: bold;
      color: var(--success);
    }

    .referral-info-card {
      background: linear-gradient(135deg, #fff7ed, #fed7aa);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
      border: 2px solid var(--warning);
    }

    .referral-info-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--dark-text);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .referral-info-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .referral-info-list li {
      font-size: 13px;
      color: var(--text-primary);
      margin-bottom: 8px;
      padding-left: 20px;
      position: relative;
      line-height: 1.6;
