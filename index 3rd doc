    // Load User Notifications — Real-time push on every new notification
    function loadNotifications() {
      if (!currentUser) return;

      const notificationsRef = database.ref('notifications')
        .orderByChild('user_id')
        .equalTo(currentUser.uid);

      // Exact previous query/callback cleanup (important during account switch)
      if (notificationListener && notificationQuery) {
        try { notificationQuery.off('child_added', notificationListener); } catch (e) {}
      }
      notificationQuery = notificationsRef;
      isFirstNotificationLoad = true;
      knownNotificationIds.clear();

      // ── A: Initial full load ──
      notificationsRef.once('value', async (snapshot) => {
        userNotifications = [];
        knownNotificationIds.clear();

        snapshot.forEach((child) => {
          const n = { id: child.key, ...child.val() };
          userNotifications.push(n);
          knownNotificationIds.add(child.key); // mark as already known
        });

        const archivedNotifications = await loadArchiveHistory('notifications');
        archivedNotifications.forEach(n => userNotifications.push({
          ...n, is_read: true, _archived: true,
          title: `📚 ${n.title || 'Archived notification'}`
        }));
        userNotifications.sort((a, b) => (b.created_at || 0) - (a.created_at || 0));
        updateNotificationBadge();

        if (document.getElementById('notificationPage').classList.contains('active')) {
          renderNotifications();
        }

        isFirstNotificationLoad = false;

        // ── B: child_added listener — fires ONLY for new notifications after initial load ──
        notificationListener = sessionOn(notificationsRef, 'child_added', (childSnapshot) => {
          if (isFirstNotificationLoad) return; // skip during initial load
          const n = { id: childSnapshot.key, ...childSnapshot.val() };

          // Skip if we already know this notification
          if (knownNotificationIds.has(n.id)) return;

          // Skip notifications older than session start (stale data)
          if (n.created_at && n.created_at < sessionStartTime - 3000) return;

          // This is a genuinely new notification!
          knownNotificationIds.add(n.id);
          userNotifications.unshift(n); // add to top
          updateNotificationBadge();

          if (document.getElementById('notificationPage').classList.contains('active')) {
            renderNotifications();
          }

          // 🔔 Fire real-time system push notification to phone
          const title = n.title || 'Top SMM';
          const body  = n.message || '';
          showSystemNotification(title, body, window._activeBrandLogo || TSM_DEFAULT_LOGO);
        });
      });
    }

