    // Login Form Submit
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('loginEmail').value.trim().toLowerCase();
      const password = document.getElementById('loginPassword').value;

      // ⚡ INSTANT FEEDBACK: lock the submit button immediately so the user
      // sees something happening right away and can't double-submit.
      const loginSubmitBtn = e.target.querySelector('button[type="submit"]');
      const loginBtnOriginalHTML = loginSubmitBtn ? loginSubmitBtn.innerHTML : '';
      if (loginSubmitBtn) {
        loginSubmitBtn.disabled = true;
        loginSubmitBtn.innerHTML = '⏳ Logging in...';
      }

      try {
        const authTimeout = new Promise((_,reject)=>setTimeout(()=>{const e=new Error('Authentication timed out. Check your connection and try again.');e.code='auth/timeout';reject(e);},20000));
        const login = await Promise.race([window.TSMRuntime.signInOrAdoptEmail(email, password), authTimeout]);
        const userCredential = login.credential;
        // Authentication is already successful here. Profile hydration/migration
        // runs independently so a rules/network error can never be misreported as
        // an incorrect password or throw the signed-in user back to the login form.
        playSound('success');
        showToast('Login successful! 🎉', 'success');
        (async()=>{
          try {
            const profileSnap=await database.ref(`users/${userCredential.user.uid}`).once('value');
            if (login.adopted || !profileSnap.exists()) {
              const adopted=await callFreeBackend('adoptProfile',{sourceProjectId:login.sourceProjectId,sourceUid:login.sourceUid});
              if(adopted.adopted)showToast('✅ Previous account data restored.', 'success');
            }
            await database.ref(`users/${userCredential.user.uid}/lastLogin`).set(Date.now()).catch(()=>{});
          } catch(profileError) {
            console.warn('Signed in; profile sync will retry in background:',profileError.message);
            showToast('Signed in. Some account data is still syncing…', 'success');
          }
        })();
      } catch (error) {
        playSound('error');
        if (error.code === 'auth/wrong-password' || error.code === 'auth/invalid-credential' || error.code === 'auth/user-not-found') {
          // Detect provider mismatch without exposing whether an unrelated email exists.
          try {
            const methods=await auth.fetchSignInMethodsForEmail(email);
            if(methods&&methods.includes('google.com')&&!methods.includes('password')) showToast('This account uses Google Sign-In. Please continue with Google.','error');
            else showToast('❌ Incorrect email or password!', 'error');
          } catch(e2){showToast('❌ Incorrect email or password!', 'error');}
        } else if (error.code === 'auth/invalid-email') {
          showToast('❌ Invalid email format!', 'error');
        } else if(error.code==='auth/network-request-failed'||error.code==='auth/timeout'){
          showToast('Connection timed out. Check internet and try again.','error');
        } else if(error.code==='auth/too-many-requests'){
          showToast('Too many attempts. Please wait a minute, then try again.','error');
        } else {
          showToast('❌ ' + (error.message || 'Login failed'), 'error');
        }
      } finally {
        if (loginSubmitBtn) {
          loginSubmitBtn.disabled = false;
          loginSubmitBtn.innerHTML = loginBtnOriginalHTML;
        }
      }
    });

    // Signup Form Submit
    document.getElementById('signupForm').addEventListener('submit', async (e) => {
