    // ══════════════════════════════════════════════════════════════════
    const DEFAULT_IMPORTANT_RULES = [
      { icon: '🚫', title: 'Do Not Place Multiple Orders', description: 'Please wait until your first order is completed, cancelled or partial before sending a new one.' },
