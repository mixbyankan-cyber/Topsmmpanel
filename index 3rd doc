      if (slot) slot.appendChild(holder);
      else panel.insertBefore(holder, panel.firstChild);
    }
    box.innerHTML = keys.map(k => {
      const f = TSMU.favs[k] || {}, m = (TSMU.pkgMeta || {})[k] || {};
      const rate = m.pricePerK != null ? TSMU.ratePlain(m.pricePerK, f.sid, f.pid) : '';
      return '<div class="tsmu-favcard" onclick="TSMU.loadFav(\'' + esc(k) + '\')">' +
        '<button class="tsmu-favx" onclick="TSMU.removeFav(\'' + esc(k) + '\',event)">×</button>' +
        '<div class="fn">' + esc(m.name || f.name || 'Package') + '</div>' +
        '<div class="fs">' + esc(m.serviceName || f.service || '') + '</div>' +
        (rate ? '<div class="fp">' + rate + '</div>' : '') + '</div>';
    }).join('');
  }
  TSMU.paintFavStrip = paintFavs;

  TSMU.loadFav = function (key) {
    const f = TSMU.favs[key]; if (!f) return;
    if (TSMU.wishOrder) return TSMU.wishOrder(key);      // full, waited, safe path
    if (!TSMU.setService(f.sid)) return TSMU.toast('That service is no longer available.', 'error');
    setTimeout(() => {
      const p = document.getElementById('packageSelect');
      if (p) { p.value = f.pid; try { loadPackageDetails(); } catch (e) { } }
      const q = document.getElementById('orderQuantity'); if (q) q.focus();
    }, 600);
  };

  /* ═════════ 4. RE-ORDER + INVOICE on order history ═════════ */
  /* the panel prints orderNumber (not orderId) in the table, so match on all of them */
  TSMU.orderRef = o => String((o && (o.orderNumber || o.orderId || o.shortId || o.id)) || '');
  TSMU.findOrder = key => TSMU.orders().find(o =>
    o.id === key || String(o.orderNumber) === String(key) || String(o.orderId) === String(key) || String(o.shortId) === String(key));
  /** Wait for a condition instead of guessing a delay - Firebase latency varies. */
  function waitFor(test, timeout, step) {
    return new Promise(resolve => {
      const t0 = Date.now(), iv = step || 80;
      (function tick() {
        let v = false; try { v = test(); } catch (e) { }
        if (v) return resolve(v);
        if (Date.now() - t0 > (timeout || 8000)) return resolve(false);
        setTimeout(tick, iv);
      })();
    });
  }
  TSMU.waitFor = waitFor;

  const hasOpt = (sel, val) => { const e = document.getElementById(sel); return !!e && Array.prototype.some.call(e.options, o => o.value === val); };

  /** Re-order: rebuild the ENTIRE form from a past order, not just the link. */
  TSMU.reorder = async function (orderId) {
    const o = TSMU.findOrder(orderId);
    if (!o) return TSMU.toast('Order not found.', 'error');
    if (!TSMU.allow('order')) return;
    if (!o.serviceId || !o.packageId)
      return TSMU.toast('This older order does not store which package was used, so it cannot be repeated automatically.', 'error');

    TSMU.toast('Loading your previous order…');
    try { navigateTo('dashboardPage'); } catch (e) { }
    try { if (window.switchOrderMode) switchOrderMode('single'); } catch (e) { }

    // 1. service  (TSMU.setService also repaints the VISIBLE custom dropdown -
    //    calling updateServiceDropdownDisplay() with no arguments used to wipe it)
    const svcReady = await waitFor(() => hasOpt('serviceSelect', o.serviceId) || !!(TSMU.G('allServices') || []).find(s => s.id === o.serviceId), 9000);
    if (!svcReady) return TSMU.toast('That service is no longer available.', 'error');
    if (!TSMU.setService(o.serviceId)) return TSMU.toast('That service is no longer available.', 'error');

    // 2. package - wait for the live list to arrive
    const pkgReady = await waitFor(() => hasOpt('packageSelect', o.packageId), 9000);
    if (!pkgReady) {
      TSMU.toast('That package is no longer offered. Please pick another one.', 'error');
      return;
    }
    const pSel = document.getElementById('packageSelect');
    pSel.value = o.packageId;
    try { pSel.dispatchEvent(new Event('change', { bubbles: true })); } catch (e) { }
    try { if (window.loadPackageDetails) loadPackageDetails(); } catch (e) { }

    // 3. wait for the package data, then fill quantity + link
    await waitFor(() => { const p = TSMU.pkg(); return p && (p.pricePerK != null || p.min != null); }, 6000);
    const q = document.getElementById('orderQuantity');
    const l = document.getElementById('orderLink');
    if (l) { l.value = o.link || ''; try { l.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) { } }
    if (q) {
      const p = TSMU.pkg() || {};
      let want = TSMU.num(o.quantity);
      const mn = TSMU.num(p.min), mx = TSMU.num(p.max), stp = TSMU.num(p.qtyStep);
      if (mn && want < mn) want = mn;
      if (mx && want > mx) want = mx;
      if (stp > 0 && want % stp !== 0) want = Math.max(mn || stp, Math.round(want / stp) * stp);
      q.value = want || '';
      try { q.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) { }
    }
    try { if (window.calculateTotal) calculateTotal(); } catch (e) { }
    setTimeout(() => { try { qtyChips(); qtyFeedback(); paintStar(); lowBalance(); } catch (e) { } }, 120);
    try { if (l) l.focus(); } catch (e) { }
    TSMU.toast('Previous order loaded — check the details and place it again.', 'success');
  };

  function decorateOrders() {
    const list = TSMU.orders() || [];
    if (!list.length) return;
    document.querySelectorAll('#ordersContainer tr, #refillOrdersContainer tr').forEach(tr => {
      if (tr.querySelector('.tsmu-reorder')) return;
      const txt = tr.textContent || '';
      const o = list.find(x => { const r = TSMU.orderRef(x); return r && txt.indexOf(r) >= 0; });
      if (!o) return;
      const cell = tr.lastElementChild || tr;
      const holder = document.createElement('div');
      holder.style.cssText = 'display:flex;gap:4px;flex-wrap:wrap;margin-top:5px';
      holder.innerHTML = '<button class="tsmu-reorder" onclick="TSMU.reorder(\'' + esc(o.id) + '\')">🔁 Re-order</button>' +
        '<button class="tsmu-inv" onclick="TSMU.invoice(\'' + esc(o.id) + '\')">🧾 Receipt</button>';
      cell.appendChild(holder);
    });
  }
  wrap('displayOrders', o => function () { const r = o.apply(this, arguments); setTimeout(decorateOrders, 550); return r; });
  wrap('displayRefillOrders', o => function () { const r = o.apply(this, arguments); setTimeout(decorateOrders, 550); return r; });

  /* ═════════ 5. INVOICE / RECEIPT ═════════ */
  TSMU.invoice = function (orderId) {
    const o = TSMU.findOrder(orderId);
    if (!o) return TSMU.toast('Order not found.', 'error');
    const brand = (document.getElementById('panelName') || {}).textContent || 'SMM Panel';
    const list = TSMU.num(o.listPricePerK, TSMU.num(o.pricePerK));
    const disc = TSMU.num(o.discountAmount);
    const rows = [
      ['Order ID', TSMU.orderRef(o)],
      ['Date', TSMU.dt(o.createdAt || o.timestamp)],
      ['Service', (o.serviceName || '') + (o.packageName ? ' — ' + o.packageName : '')],
      ['Link', o.link || '—'],
      ['Quantity', TSMU.int(o.quantity)],
      ['Rate', TSMU.num(o.pricePerK) <= 0 ? 'FREE' : TSMU.money(o.pricePerK) + ' per ' + TSMU.int(o.pricingQuantity || 1000)],
      ['Status', String(o.status || '').toUpperCase()]
    ];
    if (disc > 0) rows.splice(6, 0, ['List rate', TSMU.money(list) + ' per ' + TSMU.int(o.pricingQuantity || 1000)], ['Discount (' + (o.discountLabel || 'Reseller') + ')', '− ' + TSMU.money(disc)]);
    openSheet('Order Receipt', brand, rows, TSMU.num(o.amount) <= 0 ? 'FREE' : TSMU.money(o.amount), TSMU.orderRef(o));
  };
  TSMU.invoiceFund = function (id) {
    const f = (window._lastFundArray || []).find(x => x.id === id || String(x.requestNumber) === String(id) || String(x.requestId) === String(id));
    if (!f) return TSMU.toast('Deposit not found.', 'error');
    const brand = (document.getElementById('panelName') || {}).textContent || 'SMM Panel';
    const rows = [
      ['Receipt No.', f.requestNumber || f.id],
      ['Date', TSMU.dt(f.createdAt || f.timestamp)],
      ['Method', f.method || f.paymentMethod || '—'],
      ['Transaction ID', f.transactionId || '—'],
      ['Amount paid', TSMU.money(f.baseAmount != null ? f.baseAmount : f.amount)]
    ];
    if (TSMU.num(f.bonusAmount) > 0) rows.push(['Bonus (' + TSMU.num(f.bonusPercent) + '%)', '+ ' + TSMU.money(f.bonusAmount)]);
    if (TSMU.num(f.couponBonus) > 0) rows.push(['Coupon ' + (f.couponCode || ''), '+ ' + TSMU.money(f.couponBonus)]);
    rows.push(['Status', String(f.status || '').toUpperCase()]);
