    function toggleServiceDropdown(e) {
      if (e) e.stopPropagation();
      const wrapper = document.getElementById('customServiceDropdown');
      if (wrapper) wrapper.classList.toggle('open');
    }

    // Shared: syncs the CUSTOM visible service dropdown (icon + text + active
    // option highlight) — used both for a manual click AND programmatic
    // selection (package search, Services catalog "Order Now"), so the
    // visible dropdown never goes out of sync with the hidden native select.
    function updateServiceDropdownDisplay(serviceId, serviceName, logoHTML) {
      const iconSlot = document.getElementById('customServiceSelectedIcon');
      const textSlot = document.getElementById('customServiceSelectedText');
      if (iconSlot) iconSlot.innerHTML = logoHTML || '';
      if (textSlot) textSlot.textContent = serviceName || textOr(newOrderControl.servicePlaceholder,NEW_ORDER_DEFAULTS.servicePlaceholder);

      document.querySelectorAll('.custom-service-option').forEach(opt => {
        opt.classList.toggle('active', opt.dataset.value === serviceId);
      });

      const wrapper = document.getElementById('customServiceDropdown');
      if (wrapper) wrapper.classList.remove('open');
    }

    function selectCustomService(serviceId, serviceName, logoHTML) {
      // 1. Sync native hidden select
