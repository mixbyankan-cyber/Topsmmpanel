    .rules-agreement {
      background: rgba(0, 230, 118, 0.1);
      padding: 25px;
      border-radius: 14px;
      text-align: center;
      margin-top: 25px;
      border: 2px solid rgba(0, 230, 118, 0.3);
    }

    .agreement-text {
      font-size: 16px;
      font-weight: 600;
      color: var(--success);
      margin-bottom: 10px;
    }

    /* ✅ Real, professional agreement checkbox (no emoji) — a blank box the
       user clicks (or that auto-fills once they've scrolled through every
       rule) which then shows a permanent green tick. Cannot be un-checked
       once ticked — this is a one-time, permanent confirmation record. */
    .rules-agree-checkbox-wrap {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      user-select: none;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .rules-agree-checkbox {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      border: 2.5px solid var(--success);
      border-radius: 8px;
      background: var(--white);
      position: relative;
      transition: 0.2s;
    }

    .rules-agree-checkbox-wrap:hover .rules-agree-checkbox {
      box-shadow: 0 0 0 4px rgba(0, 230, 118, 0.15);
    }

    .rules-agree-checkbox.checked {
      background: var(--success);
    }

    .rules-agree-checkbox.checked::after {
      content: '';
      position: absolute;
      left: 9px;
      top: 4px;
      width: 8px;
      height: 15px;
      border: solid white;
      border-width: 0 3px 3px 0;
      transform: rotate(45deg);
    }

    .rules-agree-checkbox-wrap.locked {
      cursor: default;
    }

    #rulesAgreeStatusText {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .rules-agree-date {
      font-size: 12.5px;
      color: var(--text-gray);
      margin-top: 10px;
      font-weight: 500;
    }

    /* ✅ Signup form "I agree to Terms & Conditions" real checkbox row —
       same visual checkbox component as the Important Rules page, reused
       here for consistency (blank box → permanent green tick on click). */
    .signup-terms-row {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      user-select: none;
      padding: 4px 2px;
    }

    .signup-terms-row .rules-agree-checkbox {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .signup-terms-row .rules-agree-checkbox.checked::after {
      left: 7px;
      top: 3px;
      width: 6px;
      height: 12px;
    }

    .signup-terms-text {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    .signup-terms-link {
      color: var(--primary-color);
      font-weight: 700;
      text-decoration: underline;
    }

    .signup-terms-row.shake {
      animation: signupTermsShake 0.4s ease;
    }

    @keyframes signupTermsShake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }

    .rules-footer {
      background: rgba(255, 193, 7, 0.1);
      padding: 20px;
      border-radius: 12px;
      text-align: center;
      margin-top: 20px;
      border: 2px solid rgba(255, 193, 7, 0.3);
