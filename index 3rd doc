      transform: translateY(-5px) !important;
      box-shadow: 0 16px 36px rgba(14,165,233,0.16) !important;
      border-color: var(--primary-color) !important;
    }

    /* Auth card — extra depth */
    .auth-card {
      border-radius: 24px !important;
      box-shadow:
        0 8px 32px rgba(14,165,233,0.12),
        0 2px 8px rgba(0,0,0,0.08),
        0 0 0 1px rgba(14,165,233,0.1),
        inset 0 1px 0 rgba(255,255,255,1) !important;
    }

    /* Menu items in menu page */
    .order-form-card[onclick] {
      cursor: pointer;
    }
    .order-form-card[onclick]:hover {
      background: linear-gradient(135deg, #f0f9ff, #fff) !important;
    }

    /* Section title — underline bar animation */
    .section-title {
      position: relative;
      display: inline-block;
      padding-bottom: 8px !important;
      border-bottom: none !important;
    }
    .section-title::after {
      content: '';
      position: absolute;
      left: 0; bottom: 0;
      width: 40px; height: 3px;
      background: var(--gradient-primary);
      border-radius: 2px;
      transition: width 0.4s ease;
    }
    .container:hover .section-title::after { width: 100%; }

    /* Bottom nav items — active pill */
    .nav-item {
      position: relative;
      transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1) !important;
    }
    .nav-item.active {
      background: linear-gradient(135deg, var(--primary-color), var(--primary-light)) !important;
