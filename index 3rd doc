              <tr>
                <th style="width:40px;"><input type="checkbox" class="order-select-checkbox" id="orderSelectAllBox" onchange="toggleSelectAllOrders(this)"></th>
                <th>Order ID</th>
                <th>Date &amp; Time</th>
                <th>Link</th>
                <th>Service</th>
                <th>Package</th>
                <th>Quantity</th>
                <th class="order-progress-col">Delivery Progress</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              ${buildOrderTableRowsHTML(filteredOrders, true)}
            </tbody>
          </table>
        </div>
      `;
    }

    // 🔁 Shared row-template for both My Orders and the Refill page, so both
    // stay pixel-identical automatically instead of two copies drifting apart.
    // Inserts invisible word-break opportunities (<wbr>) after natural URL
    // delimiters (/ ? & = . _ -) so long links wrap at sensible points —
    // e.g. after each "/" — instead of raw break-all chopping mid-character,
    // which is what made the Link column look very tall and jagged.
    // Only used for the DISPLAYED text; href/title keep the untouched URL.
    function insertBreakHints(url) {
      if (!url) return '';
      return escapeHTML(url).replace(/([\/&=?_.\-])/g,'$1<wbr>');
    }

    function getOrderProgressHTML(order) {
      const firstValue = (...values) => values.find(v => v !== undefined && v !== null && v !== '');
      const asNumber = value => {
        if (value === undefined || value === null || value === '') return null;
        const n = Number(String(value).replace(/[,\s]/g, ''));
        return Number.isFinite(n) ? n : null;
      };
      const qty = asNumber(order.quantity) || 0;
      const start = asNumber(firstValue(order.startCount, order.start_count, order.initialCount, order.initial_count));
      let remains = asNumber(firstValue(order.remains, order.remaining, order.remainingCount, order.remaining_count));
      const explicitEnd = asNumber(firstValue(order.endCount, order.end_count, order.targetEnd, order.target_end));
      if (remains === null && String(order.status || '').toLowerCase() === 'completed') remains = 0;
      const targetEnd = explicitEnd !== null ? explicitEnd : (start !== null && qty > 0 ? start + qty : null);
      const delivered = remains !== null ? Math.max(0, qty - remains) : null;
      const pct = qty > 0 && delivered !== null ? Math.max(0, Math.min(100, Math.round(delivered / qty * 100))) : null;
      const fmtCount = value => value === null ? '—' : Math.round(value).toLocaleString('en-IN');
      const status = String(order.status || '').toLowerCase();
      const live = ['processing','in progress','in_progress'].includes(status);
      const done = status === 'completed';
      const cfg = window._orderProgressConfig || {};
      const startLabel = escapeHTML(cfg.startLabel || 'Start');
      const remainsLabel = escapeHTML(cfg.remainsLabel || 'Remains');
      const targetLabel = escapeHTML(cfg.targetLabel || 'Target End');
      const deliveredLabel = escapeHTML(cfg.deliveredLabel || 'Delivered');
      return `
        <div class="order-progress-cell ${done ? 'is-complete' : live ? 'is-live' : ''}">
          <div class="order-progress-grid">
            <div><span>${startLabel}</span><b>${fmtCount(start)}</b></div>
            <div><span>${remainsLabel}</span><b>${fmtCount(remains)}</b></div>
            ${cfg.showTarget === false ? '' : `<div><span>${targetLabel}</span><b>${fmtCount(targetEnd)}</b></div>`}
            ${cfg.showDelivered === false ? '' : `<div><span>${deliveredLabel}</span><b>${fmtCount(delivered)}</b></div>`}
          </div>
          ${cfg.showBar === false ? '' : `<div class="order-progress-track" role="progressbar" aria-label="Order delivery progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${pct === null ? 0 : pct}"><span style="width:${pct === null ? 0 : pct}%"></span></div><div class="order-progress-caption">${pct === null ? (cfg.waitingText || 'Waiting for delivery data') : pct + '% delivered'}</div>`}
        </div>`;
    }

    function buildOrderTableRowsHTML(orders, includeCheckbox) {
      return orders.map(order => {
        const shortId = formatShortId(order, 'orderNumber');
        const archiveTag = order._archived ? `<div style="font-size:9px;color:#7c3aed;font-weight:800;margin-top:4px;">📚 ${order._archiveLabel || 'Archive'}</div>` : '';
        const massTag = order.source==='mass'||order.massOrder ? `<div style="font-size:9px;color:#0891b2;font-weight:900;margin-top:4px;">📦 MASS</div>` : '';
        return `
                <tr>
                  ${includeCheckbox ? `<td><input type="checkbox" class="order-select-checkbox" data-order-id="${shortId}" onchange="toggleOrderSelection('${shortId}', this)"></td>` : ''}
                  <td>
                    <div class="cell-orderid-stack">
                      ${getRefillCellHTML(order)}
                      <span class="cell-mono">${shortId}</span>${massTag}${archiveTag}
                      ${getCancelCellHTML(order)}
                    </div>
                  </td>
                  <td>${new Date(order.createdAt).toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</td>
                  <td>
                    ${order.link
                      ? `<a href="${escapeAttr(safeExternalUrl(order.link))}" target="_blank" rel="noopener" class="cell-link" title="${escapeAttr(order.link)}">${insertBreakHints(order.link)}</a>`
                      : 'N/A'}
                  </td>
                  <td>${escapeHTML(order.serviceName||'N/A')}</td>
                  <td>${escapeHTML(order.packageName||'N/A')}</td>
                  <td>${(order.quantity || 0).toLocaleString('en-IN')}</td>
                  <td class="order-progress-col">${getOrderProgressHTML(order)}</td>
                  <td class="cell-amount">${fmt(order.amount || 0)}</td>
                  <td><span class="order-status-badge ${order.status}">${order.status}</span>${order.restoredFromRejected===true?'<div style="margin-top:5px;font-size:9px;font-weight:900;color:#166534;">↩️ RESTORED BY ADMIN</div>':''}</td>
                </tr>
              `;
      }).join('');
    }

    // Cancel toggle HTML for the Order ID cell — shown BELOW the Order ID,
    // only while the order is still pending.
    function getCancelCellHTML(order) {
      if (order._archived) return '';
      if (order.status !== 'pending') return '';
      if (order.cancelRequested) return `<div class="cancel-requested-tag">⏳ Cancel Requested</div>`;
      if (order.cancelable) return `<button type="button" class="btn-cancel-order" onclick="requestOrderCancel('${order.id}')">🚫 Cancel</button>`;
      return '';
    }

    // Refill toggle HTML for the Order ID cell — shown ABOVE the Order ID,
    // only once the order is completed and the package allows refill.
    function getRefillCellHTML(order) {
      if (order._archived) return '<div class="refill-approved-tag" style="color:#7c3aed;border-color:#7c3aed">📚 Archive</div>';
      if (!order.refillable || order.status !== 'completed') return '';
      if(order.refillStatus==='approved')return `<div class="refill-approved-tag">✅ Refill Approved</div>`;
      if(order.refillStatus==='pending')return `<div class="refill-requested-tag">📨 Request Sent</div>`;
      if(order.refillStatus==='rejected')return `<div class="refill-requested-tag" style="color:#b91c1c;border-color:#fca5a5">❌ Refill Rejected</div><button type="button" class="btn-refill-order" onclick="handleRefillClick('${order.id}')">🔄 Request Again</button>`;
      return `<button type="button" class="btn-refill-order" onclick="handleRefillClick('${order.id}')">🔄 Refill</button>`;
    }

    // ══════════════════════════════════════════════════════════════════
    // 🔄 REFILL PAGE — same order table as My Orders, filtered down to only
    // orders whose package is refill-enabled, plus an extra "Refill Success"
    // filter (any order that has had a refill submitted, pending or approved).
    // ══════════════════════════════════════════════════════════════════
    function filterRefillOrders(status, el) {
      const tabs = document.querySelectorAll('#refillPage .order-tab');
      tabs.forEach(tab => tab.classList.remove('active'));
      if (el) el.classList.add('active');
      displayRefillOrders(window._lastOrdersArray || [], status);
    }

    function searchRefillOrders() {
      const input = document.getElementById('refillSearchBox');
      const clearBtn = document.getElementById('refillSearchClearBtn');
      currentRefillSearchTerm = input.value.trim();
      if (clearBtn) clearBtn.style.display = currentRefillSearchTerm ? 'inline-flex' : 'none';

      const activeTab = document.querySelector('#refillPage .order-tab.active');
      const activeStatus = activeTab ? activeTab.getAttribute('data-tab') : 'all';
      displayRefillOrders(window._lastOrdersArray || [], activeStatus);
    }

    function clearRefillOrdersSearch() {
      const input = document.getElementById('refillSearchBox');
      if (input) input.value = '';
      currentRefillSearchTerm = '';
      const clearBtn = document.getElementById('refillSearchClearBtn');
      if (clearBtn) clearBtn.style.display = 'none';

      const activeTab = document.querySelector('#refillPage .order-tab.active');
      const activeStatus = activeTab ? activeTab.getAttribute('data-tab') : 'all';
      displayRefillOrders(window._lastOrdersArray || [], activeStatus);
    }

    function displayRefillOrders(orders, filter = 'all') {
      const container = document.getElementById('refillOrdersContainer');
      if (!container) return;

      // Base list: only orders placed from a refill-enabled package
      const refillEligibleOrders = (orders || []).filter(o => o.refillable);

      let filteredOrders;
      if (filter === 'all') {
        filteredOrders = refillEligibleOrders;
      } else if (filter === 'refillsuccess') {
        filteredOrders = refillEligibleOrders.filter(o=>['pending','approved','rejected'].includes(o.refillStatus));
      } else {
        filteredOrders = refillEligibleOrders.filter(o => o.status === filter);
      }

      if (currentRefillSearchTerm) {
        const term = currentRefillSearchTerm.toLowerCase();
        filteredOrders = filteredOrders.filter(o => {
          const shortId = formatShortId(o, 'orderNumber').toLowerCase();
          const link = (o.link || '').toLowerCase();
          return shortId.includes(term) || link.includes(term);
        });
      }

      if (filteredOrders.length === 0) {
        const noResultsFromSearch = currentRefillSearchTerm && refillEligibleOrders.length > 0;
        container.innerHTML = `
