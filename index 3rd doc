      if (!soundEnabled) return;
      
      // Debounce rapid plays
      const now = Date.now();
      if (now - lastSoundPlayTime < SOUND_DEBOUNCE_TIME) return;
      lastSoundPlayTime = now;

      try {
        // Preload on first play attempt
        if (!soundsPreloaded) {
          preloadSounds();
        }

        let audio = audioCache[soundType];
        
        // Fallback: create new audio if not cached
        if (!audio) {
          audio = new Audio(SOUND_URLS[soundType]);
          audio.volume = 0.4;
          audioCache[soundType] = audio;
        }

        // Reset and play
        audio.currentTime = 0;
        const playPromise = audio.play();

        if (playPromise !== undefined) {
          playPromise.catch(error => {
            // Handle autoplay restrictions (especially on mobile)
            console.log('Sound play blocked:', error.message);
