    function festivalPopupSignature(storageKey, cfg, version) {
      const raw = JSON.stringify({
        title: cfg.title || '', subtitle: cfg.subtitle || '', offer: cfg.offer || '',
        poster: cfg.poster || '', countTo: cfg.countTo || 0, version: version || ''
      });
      let hash = 2166136261;
      for (let i = 0; i < raw.length; i++) {
        hash ^= raw.charCodeAt(i);
        hash = Math.imul(hash, 16777619);
      }
      return new Date().toDateString() + '|' + storageKey + '|' + (hash >>> 0).toString(36);
    }

