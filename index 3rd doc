    .referral-info-list li:before {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--success);
      font-weight: bold;
    }

    .referral-history-card {
      background: var(--white);
      border-radius: 16px;
      padding: 25px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-md);
    }

    .referral-history-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--dark-text);
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .referral-history-item {
      background: var(--light-bg);
      border-radius: 10px;
      padding: 15px;
      margin-bottom: 10px;
      border-left: 4px solid var(--primary-color);
    }

    .referral-history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .referral-history-user {
      font-size: 14px;
      font-weight: 600;
      color: var(--dark-text);
    }

    .referral-history-commission {
      font-size: 14px;
      font-weight: bold;
      color: var(--success);
    }

    .referral-history-details {
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    .empty-referral-state {
      text-align: center;
      padding: 40px 20px;
    }

    .empty-referral-icon {
      font-size: 60px;
      margin-bottom: 15px;
      opacity: 0.5;
    }

    .empty-referral-text {
      font-size: 14px;
      color: var(--text-secondary);
    }

    /* ========== END REFERRAL STYLES ========== */

    /* Header */
    .header {
      background: var(--white);
      backdrop-filter: blur(10px);
      padding: 15px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 42px;
      z-index: 100;
      border-bottom: 1px solid var(--border-color);
    }

    .logo-section {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.2s;
      user-select: none;
    }

    .logo-section:hover {
      opacity: 0.85;
      transform: scale(1.03);
    }

    .logo-section:active {
      transform: scale(0.97);
    }

    .logo-section img {
      width: auto;
      height: var(--logoH, 56px);
      max-width: var(--logoMaxW, 230px);
      border-radius: 0;
      object-fit: contain;
      background: transparent;
      border: none;
      box-shadow: none;
      filter: drop-shadow(0 3px 8px rgba(99,102,241,.34)) drop-shadow(0 0 7px rgba(217,70,239,.10));
      animation: logoAura 3.2s ease-in-out infinite;
      transition: height .25s ease;
    }

    /* ✨ logo aura — premium breathing glow on the transparent PNG */
    @keyframes logoAura {
      0%, 100% { filter: drop-shadow(0 3px 8px rgba(99,102,241,.30)) drop-shadow(0 0 7px rgba(217,70,239,.10)); }
      50%      { filter: drop-shadow(0 5px 17px rgba(99,102,241,.62)) drop-shadow(0 0 22px rgba(217,70,239,.30)); }
    }

    .logo-text {
      position: relative;
      font-size: 21px;
      font-weight: 900;
      letter-spacing: 0.8px;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: linear-gradient(180deg, #ffffff 0%, #e0e7ff 26%, #a5b4fc 50%, #6366f1 76%, #4338ca 100%);
      background-size: 100% 220%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: brandSheen 6s ease-in-out infinite;
      white-space: nowrap;
    }

    /* 3D extruded depth layer behind the metallic face */
    .logo-text::before {
      content: attr(data-text);
      position: absolute;
      left: 0; top: 0;
      z-index: -1;
      color: transparent;
      -webkit-text-fill-color: transparent;
      text-shadow:
        0 1px 0 #3730a3, 0 2px 0 #312e81, 0 3px 0 #2a2766, 0 4px 0 #211d4e,
        0 6px 2px rgba(2,6,23,.30), 0 10px 16px rgba(49,46,129,.40);
    }

    /* travelling light-sheen across the letters */
    .logo-text::after {
      content: attr(data-text);
      position: absolute;
      left: 0; top: 0;
      z-index: 1;
      background: linear-gradient(115deg, transparent 32%, rgba(255,255,255,.92) 48%, transparent 60%);
      background-size: 260% 100%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: brandSweep 4.8s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes brandSheen { 0%, 100% { background-position: 50% 0%; } 50% { background-position: 50% 82%; } }
    @keyframes brandSweep { 0%, 52% { background-position: 135% 0; } 88%, 100% { background-position: -95% 0; } }

    @keyframes brandShine {
      0% { background-position: 0% 50%; }
      100% { background-position: 230% 50%; }
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .btn-logout {
      padding: 8px 16px;
      background: linear-gradient(135deg, #ef4444, #dc2626);
      border: none;
      border-radius: 8px;
      color: white;
      font-size: 12px;
      cursor: pointer;
      transition: 0.3s;
    }

    .btn-logout:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
    }

    /* 🔔 Notification Bell Icon */
    .notification-bell {
      position: relative;
      cursor: pointer;
      padding: 8px;
      background: var(--lighter-bg);
      border-radius: 50%;
      transition: all 0.3s ease;
    }

    .notification-bell:hover {
      background: #e0f2fe;
      transform: scale(1.1);
    }

    .notification-bell svg {
      width: 24px;
      height: 24px;
      fill: var(--primary-color);
    }

    .notification-badge {
      position: absolute;
      top: 2px;
      right: 2px;
      background: var(--error);
      color: white;
      font-size: 10px;
      font-weight: bold;
      min-width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(239, 68, 68, 0.5);
      animation: pulse-badge 2s infinite;
    }

    @keyframes pulse-badge {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    .notification-badge.hidden {
      display: none;
    }

    /* 💱 Currency Selector */
    .currency-selector {
      position: relative;
      user-select: none;
    }

    .currency-selector-btn {
      display: flex;
      align-items: center;
      gap: 4px;
      background: var(--lighter-bg);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 700;
      color: var(--primary-color);
      cursor: pointer;
      transition: 0.2s;
      white-space: nowrap;
    }

    .currency-selector-btn:hover {
      background: #e0f2fe;
    }

    .currency-selector-btn .cs-arrow {
      font-size: 9px;
      opacity: 0.7;
      transition: transform 0.2s;
    }

    .currency-selector.open .cs-arrow {
      transform: rotate(180deg);
    }

    .currency-dropdown-list {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      box-shadow: var(--shadow-xl);
      min-width: 190px;
      max-height: 320px;
      overflow-y: auto;
      z-index: 500;
      padding: 6px;
    }

    .currency-selector.open .currency-dropdown-list {
      display: block;
    }

    .currency-option {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 10px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      color: var(--text-primary);
      transition: 0.15s;
    }

    .currency-option:hover {
      background: var(--gradient-light);
    }

    .currency-option.selected {
      background: var(--gradient-light);
      font-weight: 700;
      color: var(--primary-color);
    }

    .currency-option .cs-flag {
      font-size: 17px;
      width: 22px;
      text-align: center;
    }

    .currency-option .cs-code {
      font-weight: 700;
      min-width: 40px;
    }

    .currency-option .cs-name {
      font-size: 11px;
      color: var(--text-gray);
      margin-left: auto;
    }

    .currency-note-box {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      background: var(--warning-light);
      border: 1px solid rgba(245, 158, 11, 0.35);
      border-radius: 10px;
      padding: 12px 14px;
      margin: 12px 0;
      font-size: 12.5px;
      color: #8a5a06;
      line-height: 1.5;
    }

    /* ══════════ 🔌 API PAGE ══════════ */
    .api-hero {
      background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
      border-radius: 20px;
      padding: 30px 24px;
      margin-bottom: 24px;
      color: #fff;
      text-align: center;
      box-shadow: 0 10px 30px rgba(14, 165, 233, 0.25);
    }
    .api-hero h1 { font-size: 24px; margin-bottom: 8px; }
    .api-hero p { font-size: 14px; opacity: 0.95; }

    .api-key-box {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #0f172a;
      color: #7ef7d0;
      border-radius: 12px;
      padding: 14px 16px;
      font-family: 'Courier New', monospace;
      font-size: 14px;
      word-break: break-all;
      flex-wrap: wrap;
    }
    .api-key-box .api-key-text { flex: 1; min-width: 180px; }
    .api-key-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .api-btn-small {
      padding: 8px 14px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      transition: 0.2s;
    }
    .api-btn-copy { background: var(--primary-color); color: #fff; }
    .api-btn-copy:hover { background: var(--primary-dark); }
    .api-btn-regen { background: var(--error); color: #fff; }
    .api-btn-regen:hover { background: #b91c1c; }

    .api-endpoint-box {
      background: var(--lighter-bg);
      border: 2px dashed var(--primary-color);
      border-radius: 12px;
      padding: 14px 16px;
      font-family: 'Courier New', monospace;
      font-size: 13px;
      color: var(--primary-dark);
      word-break: break-all;
      margin-top: 10px;
    }

    .api-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      margin-bottom: 15px;
      padding-bottom: 4px;
    }
    .api-tab {
      flex-shrink: 0;
      padding: 10px 16px;
      border-radius: 10px;
      background: var(--light-bg);
      color: var(--text-secondary);
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      border: 2px solid transparent;
      transition: 0.2s;
      white-space: nowrap;
    }
    .api-tab:hover { border-color: var(--primary-light); }
    .api-tab.active {
      background: var(--gradient-primary);
      color: #fff;
    }

    .api-code-block {
      background: #0f172a;
      color: #e2e8f0;
      border-radius: 12px;
      padding: 16px;
      font-family: 'Courier New', monospace;
      font-size: 12.5px;
      line-height: 1.7;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-word;
      position: relative;
    }
    .api-code-copy-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(255,255,255,0.1);
      color: #fff;
      border: none;
      padding: 5px 10px;
      border-radius: 6px;
      font-size: 11px;
      cursor: pointer;
    }
    .api-code-copy-btn:hover { background: rgba(255,255,255,0.2); }

    .api-param-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      margin: 10px 0;
    }
    .api-param-table th, .api-param-table td {
      padding: 8px 10px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
    }
    .api-param-table th { color: var(--primary-color); font-size: 12px; }
    .api-param-table code {
      background: var(--gradient-light);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 12px;
      color: var(--primary-dark);
