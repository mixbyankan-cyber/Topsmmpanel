    // Live-load the Admin-managed Rules page content (header + rule items),
    // seeding sensible defaults exactly once if nothing has been set yet.
    function loadImportantRulesContent() {
      database.ref('settings/importantRulesSeeded').once('value').catch(e=>{console.warn('importantRulesSeeded read blocked:',e.message);return null;}).then(seededSnap => { if(!seededSnap) return;
        if (!seededSnap.exists()) {
          const seedUpdates = {
            'settings/importantRules/header': {
              title: 'Rules & User Guidelines',
              subtitle: 'Please read carefully before placing any orders to avoid delays or cancellation.',
              footerNote: '💡 Please read this page regularly — rules may change over time'
            }
          };
          DEFAULT_IMPORTANT_RULES.forEach((r, i) => {
            const key = database.ref('settings/importantRules/items').push().key;
            seedUpdates[`settings/importantRules/items/${key}`] = { ...r, sortOrder: i };
          });
          seedUpdates['settings/importantRulesSeeded'] = true;
          database.ref().update(seedUpdates).catch(() => {});
        }
      });

      sessionOn(database.ref('settings/importantRules/header'), 'value', snap => {
