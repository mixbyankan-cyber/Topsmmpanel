/* ---------- 08-order-rules.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v29 USER · PART 8 — ORDER RULES ENFORCEMENT  (English only)
   Applies the panel-wide guard rails set in Admin > Order Rules.
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const DB = () => TSMU.db();
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };

  TSMU.orderRules = {};
  TSMU.onReady(function () {
    DB().ref('settings/orderRules').on('value', s => { TSMU.orderRules = s.val() || {}; }, () => { });
  });

  function midnight() { const d = new Date(); d.setHours(0, 0, 0, 0); return d.getTime(); }

  function blockPopup(title, message, cta) {
    let m = document.getElementById('tsmuRuleMask');
    if (!m) {
      m = document.createElement('div');
      m.id = 'tsmuRuleMask';
      m.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,.62);backdrop-filter:blur(3px);z-index:99992;display:flex;align-items:center;justify-content:center;padding:18px';
      m.onclick = e => { if (e.target === m) m.style.display = 'none'; };
      document.body.appendChild(m);
    }
    m.innerHTML = '<div style="background:var(--card-bg,#fff);border-radius:18px;max-width:390px;width:100%;padding:22px;text-align:center;box-shadow:0 22px 60px rgba(0,0,0,.32)">' +
      '<div style="font-size:50px;line-height:1;margin-bottom:11px">⏳</div>' +
      '<h3 style="font-size:17px;font-weight:800;color:#b45309;margin-bottom:9px">' + esc(title) + '</h3>' +
      '<p style="font-size:13.5px;line-height:1.7;color:var(--text-secondary,#475569);margin-bottom:15px">' + message + '</p>' +
      '<button class="tsmu-btn" style="width:100%" onclick="document.getElementById(\'tsmuRuleMask\').style.display=\'none\'">OK</button>' +
      (cta || '') + '</div>';
    m.style.display = 'flex';
    try { playSound('error'); } catch (e) { }
  }

  /** Returns null when the order may proceed, otherwise a reason object. */
  TSMU.checkOrderRules = function (cost, link) {
    const r = TSMU.orderRules || {};
    const uid = TSMU.uid();
    if (!uid) return Promise.resolve(null);

    const isFree = TSMU.num(cost) <= 0;
    const resellerOn = !!(TSMU.discount && TSMU.discount.enabled);
    const skipRate = r.resellerExempt === true && resellerOn;

    // value rules
    if (!(isFree && r.freeExempt !== false)) {
      if (TSMU.num(r.minValue) > 0 && TSMU.num(cost) < TSMU.num(r.minValue))
        return Promise.resolve({ t: 'Order Value Too Low', m: 'The minimum order value on this panel is <b>' + TSMU.money(r.minValue) + '</b>. Your order comes to ' + TSMU.money(cost) + '. Please increase the quantity.' });
      if (TSMU.num(r.maxValue) > 0 && TSMU.num(cost) > TSMU.num(r.maxValue))
        return Promise.resolve({ t: 'Order Value Too High', m: 'The maximum value for a single order is <b>' + TSMU.money(r.maxValue) + '</b>. Your order comes to ' + TSMU.money(cost) + '. Please split it into smaller orders.' });
    }

    const need = [];
    if (TSMU.num(r.newAccountHoldHours) > 0) need.push(DB().ref('users/' + uid + '/createdAt').once('value'));
    else need.push(Promise.resolve(null));
    if ((TSMU.num(r.cooldownSec) > 0 || TSMU.num(r.dailyCap) > 0 || TSMU.num(r.linkWindowMin) > 0) && !skipRate)
      need.push(DB().ref('users/' + uid + '/orders').limitToLast(60).once('value'));
    else need.push(Promise.resolve(null));

    return Promise.all(need).then(([cSnap, oSnap]) => {
      // new-account hold
      if (cSnap && cSnap.val()) {
        const age = Date.now() - TSMU.num(cSnap.val());
        const hold = TSMU.num(r.newAccountHoldHours) * 3600000;
        if (age < hold) {
          const left = Math.ceil((hold - age) / 60000);
          return { t: 'Account Not Ready Yet', m: 'New accounts can start ordering <b>' + TSMU.num(r.newAccountHoldHours) + ' hour(s)</b> after signup. Please try again in <b>' + (left > 60 ? Math.ceil(left / 60) + ' hour(s)' : left + ' minute(s)') + '</b>.' };
        }
      }
      if (!oSnap) return null;

      const orders = [];
      oSnap.forEach(c => { const v = c.val() || {}; orders.push({ at: TSMU.num(v.createdAt || v.timestamp), link: String(v.link || '').trim().toLowerCase().replace(/\/$/, ''), status: String(v.status || '').toLowerCase() }); });

      // cooldown
      if (TSMU.num(r.cooldownSec) > 0) {
        const last = orders.reduce((a, b) => Math.max(a, b.at), 0);
        const wait = TSMU.num(r.cooldownSec) * 1000 - (Date.now() - last);
        if (last && wait > 0)
          return { t: 'Please Wait a Moment', m: esc(r.message || 'Please wait a moment before placing another order.') + '<br><br>You can place your next order in <b>' + Math.ceil(wait / 1000) + ' second(s)</b>.' };
      }
      // daily cap
      if (TSMU.num(r.dailyCap) > 0) {
        const t0 = midnight();
        const today = orders.filter(o => o.at >= t0).length;
        if (today >= TSMU.num(r.dailyCap))
          return { t: 'Daily Order Limit Reached', m: 'You have placed <b>' + today + '</b> orders today and the daily limit is <b>' + TSMU.num(r.dailyCap) + '</b>. Your limit resets at midnight.' };
      }
      // same-link window
      if (TSMU.num(r.linkWindowMin) > 0 && link) {
        const norm = String(link).trim().toLowerCase().replace(/\/$/, '');
        const win = TSMU.num(r.linkWindowMin) * 60000;
        const hit = orders.find(o => o.link === norm && (Date.now() - o.at) < win && o.status !== 'cancelled' && o.status !== 'rejected');
        if (hit) {
          const left = Math.ceil((win - (Date.now() - hit.at)) / 60000);
          return { t: 'This Link Was Just Used', m: 'You already ordered for this link <b>' + Math.max(1, Math.round((Date.now() - hit.at) / 60000)) + ' minute(s) ago</b>. To protect your account, the same link can only be ordered again after <b>' + TSMU.num(r.linkWindowMin) + ' minutes</b>. Please wait about <b>' + left + ' more minute(s)</b>.' };
        }
      }
      return null;
    }).catch(() => null);
  };

  wrap('placeNewOrder', o => async function () {
    const totalTxt = (document.getElementById('totalCharge') || {}).textContent || '';
    const cost = /free/i.test(totalTxt) ? 0 : TSMU.num(totalTxt.replace(/[^\d.]/g, ''));
    const link = (document.getElementById('orderLink') || {}).value || '';
    const r = await TSMU.checkOrderRules(cost, link);
    if (r) { blockPopup(r.t, r.m); return; }
    return o.apply(this, arguments);
  });

  console.log('%c TSMU v29 order rules loaded ', 'background:#b45309;color:#fff;padding:2px 6px;border-radius:4px');
})();


