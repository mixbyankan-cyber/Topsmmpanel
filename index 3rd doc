    .id-popup-container.td-phase-ending .id-popup-small { color: #b9c2f0; }

    /* rakhi-coloured phase wipe */
    #fctWipe.td span:nth-child(1) { background: #4338ca !important; }
    #fctWipe.td span:nth-child(2) { background: #fcd34d !important; }
    #fctWipe.td span:nth-child(3) { background: #fff7d6 !important; }
  </style>

  <script>
  /* 🎓 TEACHER'S DAY CAMPAIGN ENGINE — mirrors IDT, chained after it. */
  const TD = {
    fest: null,                 // settings/festivalTeachers
    phase: 'off',               // coming | live | ending | off | standby
    _initialized: false,
    _popCountTo: null,
    _popCountLabel: '',

    // Built-in schedule for Raksha Bandhan 2026 (IST); Admin can override
    DEFAULT_LIVE_AT:   Date.parse('2026-09-05T00:00:00+05:30'),
    DEFAULT_ENDING_AT: Date.parse('2026-09-06T00:00:00+05:30'),
    DEFAULT_HARD_END:  Date.parse('2026-09-07T23:59:59+05:30'),

    _defaults: {
      // ── LIVE ──
      banner: '🎓 Happy Teacher\'s Day! 📚 The Scholars Sale is LIVE — up to 10% BONUS on every deposit + up to 25% OFF on all services. To the mentors who shape futures! 💛',
      popupTitle: '🎓 Happy Teacher\'s Day!',
      popupSubtitle: '<strong>Teacher\'s Day 2026</strong> — <em>honouring every mentor, live today only</em>',
      offer: '📘 <strong>The Scholars Sale is LIVE!</strong> Get up to <strong>10% BONUS</strong> on every deposit and up to <strong>25% OFF</strong> across all services. <em>A tribute to teachers — premium growth at festival prices.</em> 🎓',
      greetingTitle: 'Happy Teacher\'s Day! 🎓',
      greetingSub: '✨ <strong>Scholars Sale</strong> — 5th September Special ✨',
      poster: 'teachers-day-poster.png',
      // ── COMING ──
      comingBanner: '⏳ Mark the date — 5th September! Our Teacher\'s Day Scholars Sale is coming with up to 10% deposit BONUS + up to 25% OFF on all services! 📚',
      comingHeadline: '⏳ Scholars Sale — Coming Soon',
      comingSubline: 'This Teacher\'s Day, celebrate your mentors with our smartest rewards of the season. 🎓',
      comingTitle: '📚 A Lesson In Savings Is Coming!',
      comingSub: '<strong>Scholars Sale 2026</strong> — class begins <em>5th September</em> 🎓',
      comingOffer: '🎁 <strong>Sharpen your pencils!</strong> On 5th September we go LIVE with up to <strong>10% BONUS</strong> on every deposit and up to <strong>25% OFF</strong> on all services. <em>Our salute to every teacher.</em> 📖',
      comingPoster: 'teacher-coming-soon-poster.png',
      // ── ENDING ──
      endingBanner: '🔥 FINAL BELL! The Scholars Sale ends soon — last chance for up to 10% deposit BONUS + up to 25% OFF on all services! ⏰',
      endingHeadline: '🔥 Scholars Sale — Ending Soon',
      endingSubline: 'The final bell is about to ring — claim your bonus & discounts before the class is dismissed! ⏰',
      endingTitle: '🔥 Last Chance — Sale Ending!',
      endingSub: '<strong>Scholars Sale 2026</strong> — <em>final hours remaining</em> ⏰',
      endingOffer: '⚡ <strong>The final bell is ringing!</strong> Secure up to <strong>10% BONUS</strong> on deposits and up to <strong>25% OFF</strong> on all services before the sale ends. <em>Do not skip this class.</em> 🏃‍♂️💨',
      endingPoster: 'teacher-ending-soon-poster.png'
    },

    init() {
      database.ref('settings/festivalTeachers').on('value', snap => {
        TD.fest = snap.val() || {};
        console.log('🎓 settings/festivalTeachers LIVE update received · phase =', TD.computePhase(Date.now()));
        if (!TD._initialized) {
          TD._initialized = true;
          requestFestivalCampaignRender("Teacher's Day initialized");
          setTimeout(() => TD.maybeConfetti(), 120);
          return;
        }
        requestFestivalCampaignRender("Teacher's Day campaign changed");
      });
      setInterval(() => TD.tick(), 1000);
      // Rakhi confetti burst after login (once/day, LIVE phase only)
      auth.onAuthStateChanged(u => {
        if (u) setTimeout(() => TD.maybeConfetti(), 2200);
      });
    },

    liveAt()   { const v = parseInt((TD.fest||{}).liveAt);    return Number.isFinite(v) ? v : TD.DEFAULT_LIVE_AT; },
    endingAt() { const v = parseInt((TD.fest||{}).endingAt);  return Number.isFinite(v) ? v : TD.DEFAULT_ENDING_AT; },
    hardEndAt(){ const v = parseInt((TD.fest||{}).hardEndAt); return Number.isFinite(v) ? v : TD.DEFAULT_HARD_END; },

    computePhase(now) {
      if (!festivalCampaignIsSelected('teachers')) return 'off';
      const f = TD.fest || {};
      if (f.master === false || f.master === 'false') return 'off';
      const mode = f.mode || 'auto';
      if (mode !== 'auto') return (mode === 'off') ? 'off' : mode;
      if (now < TD.liveAt())    return 'coming';
      if (now < TD.endingAt())  return 'live';
      if (now < TD.hardEndAt()) return 'ending';
      return 'off';
    },

    // Independence-Day campaign always gets the stage first
    seniorActive() {
      try {
        return !!((window.IDT && IDT._initialized && IDT.computePhase(Date.now()) !== 'off')
               || (window.RB && RB._initialized && RB.computePhase(Date.now()) !== 'off'));
      } catch (e) { return false; }
    },

    isEnabled() { return TD.phase === 'live' && !TD.seniorActive(); },

    bannerOverride() {
      const p = TD.phase;
      if (p !== 'coming' && p !== 'live' && p !== 'ending') return null;
      if (TD.seniorActive()) return null;
      const f = TD.fest || {};
      if (p === 'live')   return ((f.live   || {}).bannerText) || TD._defaults.banner;
      if (p === 'coming') return ((f.coming || {}).banner)     || TD._defaults.comingBanner;
      return                     ((f.ending || {}).banner)     || TD._defaults.endingBanner;
    },

    tick() {
      if (!TD._initialized) return;
      const now = Date.now();
      const next = TD.computePhase(now);
      if (next !== TD.phase) {
        const celebrate = (next === 'live');
        TD.applyPhase(true);                       // rakhi-coloured wipe
        if (celebrate) setTimeout(() => TD.fireConfetti(4500), 950); // 🎉
        return;
      }
      // instantly stand down/up if the Independence-Day state flips mid-day
      if ((TD.phase === 'coming' || TD.phase === 'live' || TD.phase === 'ending') && TD.seniorActive()) {
        TD._rollback();
        TD.phase = 'standby';
      } else if (TD.phase === 'standby' && !TD.seniorActive()) {
        TD.applyPhase(false);
      }
      TD.updateClock(now);
    },

    _clearSkin() {
      document.body.classList.remove('td-coming', 'td-live', 'td-ending');
      const box = document.getElementById('idPopupContainer');
      if (box) box.classList.remove('td-phase-coming', 'td-phase-ending');
    },

    _rollback() {
      TD._clearSkin();
      const hero = document.getElementById('fctHero');
      if (hero && hero.dataset.phase && hero.dataset.phase.indexOf('td-') === 0) hero.style.display = 'none';
      const card = document.getElementById('idGreetingCard');
      if (card && !(window.IDT && IDT.isEnabled())) card.style.display = 'none';
      TD.closePopupIfOwner();
      if (typeof refreshTopBannerText === 'function') refreshTopBannerText();
    },

    closePopupIfOwner() {
      const overlay = document.getElementById('idPopupOverlay');
      if (overlay && overlay.dataset.owner === 'td' && window.IDT && IDT.closePopup) IDT.closePopup();
    },

    applyPhase(withWipe) {
      const next = TD.computePhase(Date.now());
      const run = () => {
        // Independence-Day campaign owns the stage → TD stands down
        if (next !== 'off' && TD.seniorActive()) {
          if (TD.phase === 'coming' || TD.phase === 'live' || TD.phase === 'ending') TD._rollback();
          TD.phase = 'standby';
          return;
        }
        TD.phase = next;
        TD._clearSkin();
        if (next === 'live')   document.body.classList.add('td-live');
        if (next === 'coming') document.body.classList.add('td-coming');
        if (next === 'ending') document.body.classList.add('td-ending');

        if (typeof refreshTopBannerText === 'function') refreshTopBannerText();

        // Dashboard greeting card — LIVE
        const card = document.getElementById('idGreetingCard');
        if (card) {
          if (next === 'live') { TD.fillGreeting(); card.style.display = 'block'; }
          else if (!(window.IDT && IDT.isEnabled()) && !(window.RB && RB.isEnabled())) card.style.display = 'none';
        }

        // Hero + flip clock — COMING / ENDING
        const hero = document.getElementById('fctHero');
        if (hero) {
          if (next === 'coming' || next === 'ending') {
            TD.renderHero(next);
            hero.style.display = 'block';
          } else if (!(window.IDT && (IDT.phase === 'coming' || IDT.phase === 'ending'))
                  && !(window.RB && (RB.phase === 'coming' || RB.phase === 'ending'))) {
            hero.style.display = 'none';
          }
        }

        if (next === 'off') TD.closePopupIfOwner();
        else TD.maybeShowPopup();

        TD.updateClock(Date.now());
        if (window.IDT && IDT.attachTilt) IDT.attachTilt(document.getElementById('idPopupContainer'), 4);
      };

      if (withWipe && TD._initialized && window.IDT && IDT.wipe) {
        const w = document.getElementById('fctWipe');
        if (w) w.classList.add('td');
        IDT.wipe(() => { try { run(); } finally { if (w) setTimeout(() => w.classList.remove('td'), 1100); } });
      } else run();
    },

    fillGreeting() {
      const L = (TD.fest || {}).live || {};
      const set = (id, v) => { const el = document.getElementById(id); if (el && v) el.innerHTML = v; };
      set('idGreetingTitle', L.greetingTitle || TD._defaults.greetingTitle);
      set('idGreetingSub',   L.greetingSub   || TD._defaults.greetingSub);
      set('idGreetingOffer', L.offerText     || TD._defaults.offer);
    },

    renderHero(phase) {
      const hero = document.getElementById('fctHero');
      if (!hero) return;
      if (hero.dataset.phase === 'td-' + phase && hero.dataset.built === '1') return;
      hero.dataset.phase = 'td-' + phase;
      hero.dataset.built = '1';
      hero.classList.remove('fct-hero-comin', 'fct-hero-endin');
      hero.classList.add(phase === 'coming' ? 'fct-hero-comin' : 'fct-hero-endin');

      const f = TD.fest || {};
      const c = f.coming || {}, e = f.ending || {};
      const isComing = (phase === 'coming');
      const icon = isComing ? TD.capSVG(100) : IDT.hourglassSVG(80);
      const headline = isComing ? (c.headline || TD._defaults.comingHeadline)
                                : (e.headline || TD._defaults.endingHeadline);
      const subline  = isComing ? (c.subline  || TD._defaults.comingSubline)
                                : (e.subline  || TD._defaults.endingSubline);
      const note = isComing ? "🎯 Scholars Sale goes LIVE on 5th September — Teacher's Day rewards for everyone!"
                            : "⚡ When the clock hits zero, every Teacher's Day bonus & offer ends!";

      let stars = '';
      if (isComing) {
        for (let i = 0; i < 16; i++) {
          const l = ((i * 61) % 94) + 3;
          const tp = ((i * 37) % 62) + 10;
          const sz = (i % 3) + 2;
          const dl = ((i % 7) * 0.35).toFixed(2);
          stars += '<span class="fct-star" style="left:' + l + '%; top:' + tp + '%; width:' + sz + 'px; height:' + sz + 'px; animation-delay:' + dl + 's;"></span>';
        }
      }

      const unit = (id, label) =>
        '<div class="fc-unit"><div class="fc-card" id="' + id + '" data-value="">' + IDT._fcCardHTML() + '</div><div class="fc-label">' + label + '</div></div>';

      hero.innerHTML =
        stars +
        '<div class="fct-hero-icon">' + icon + '</div>' +
        '<h2 class="fct-headline">' + headline + '</h2>' +
        '<p class="fct-subline">' + subline + '</p>' +
        '<div class="fc-row">' +
          unit('fcD', 'Days') + '<div class="fc-sep">:</div>' +
          unit('fcH', 'Hours') + '<div class="fc-sep">:</div>' +
          unit('fcM', 'Minutes') + '<div class="fc-sep">:</div>' +
          unit('fcS', 'Seconds') +
        '</div>' +
        '<div class="fct-target-note">' + note + '</div>';

      if (window.IDT && IDT.attachTilt) IDT.attachTilt(hero, 5);
      TD.updateClock(Date.now());
    },

    _parts(ms) {
      ms = Math.max(0, ms);
      const d = Math.floor(ms / 86400000); ms -= d * 86400000;
      const h = Math.floor(ms / 3600000);  ms -= h * 3600000;
      const m = Math.floor(ms / 60000);    ms -= m * 60000;
      const s = Math.floor(ms / 1000);
      return {
        d: String(d).padStart(2, '0'), h: String(h).padStart(2, '0'),
        m: String(m).padStart(2, '0'), s: String(s).padStart(2, '0')
      };
    },

    updateClock(now) {
      let target = null;
      if (TD.phase === 'coming') target = TD.liveAt();
      else if (TD.phase === 'ending') target = TD.hardEndAt();

      const hero = document.getElementById('fctHero');
      if (target && hero && hero.style.display !== 'none' && hero.dataset.phase && hero.dataset.phase.indexOf('td-') === 0) {
        const t = TD._parts(target - now);
        [['fcD', t.d], ['fcH', t.h], ['fcM', t.m], ['fcS', t.s]].forEach(([id, v]) => {
          const card = document.getElementById(id);
          if (card) IDT.flipCard(card, v);
        });
      }

      // popup countdown chip (only while the TD popup is open)
      const pc = document.getElementById('fctPopCount');
      const overlay = document.getElementById('idPopupOverlay');
      if (pc && overlay && overlay.style.display === 'flex' && overlay.dataset.owner === 'td' && TD._popCountTo && (TD.phase === 'coming' || TD.phase === 'ending')) {
        const t = TD._parts(TD._popCountTo - now);
        pc.textContent = (TD._popCountLabel || '⏳') + '   ' + t.d + 'd : ' + t.h + 'h : ' + t.m + 'm : ' + t.s + 's';
      }
    },

    maybeShowPopup() {
      const phase = TD.phase;
      if (phase !== 'coming' && phase !== 'live' && phase !== 'ending') return;
      if (TD.seniorActive()) return;
      const f = TD.fest || {};
      const L = f.live || {}, c = f.coming || {}, e = f.ending || {};

      let cfg = null;
      if (phase === 'live') {
        if (L.showPopup === false || L.showPopup === 'false') return;
        cfg = { key: 'td_pop_live', cls: '',
          title: L.popupTitle || TD._defaults.popupTitle,
          subtitle: L.popupSubtitle || TD._defaults.popupSubtitle,
          offer: L.offerText || TD._defaults.offer,
          poster: resolveCampaignImage(L, TD._defaults.poster),
          icon: TD.bookSVG(58), iconColor: '#4338ca' };
      } else if (phase === 'coming') {
        if (c.showPopup === false || c.showPopup === 'false') return;
        cfg = { key: 'td_pop_coming', cls: 'td-phase-coming',
          title: c.popupTitle || TD._defaults.comingTitle,
          subtitle: c.popupSub || TD._defaults.comingSub,
          offer: c.popupText || TD._defaults.comingOffer,
          poster: resolveCampaignImage(c, TD._defaults.comingPoster),
          icon: TD.capSVG(56), iconColor: '#4f46e5',
          countTo: TD.liveAt(), countLabel: '🎓 LIVE IN' };
      } else {
        if (e.showPopup === false || e.showPopup === 'false') return;
        cfg = { key: 'td_pop_ending', cls: 'td-phase-ending',
          title: e.popupTitle || TD._defaults.endingTitle,
          subtitle: e.popupSub || TD._defaults.endingSub,
          offer: e.popupText || TD._defaults.endingOffer,
          poster: resolveCampaignImage(e, TD._defaults.endingPoster),
          icon: IDT.hourglassSVG(52), iconColor: '#ffd166',
          countTo: TD.hardEndAt(), countLabel: '🔥 ENDS IN' };
      }

      let today;
      try {
        // day + content signature — if the admin edits the popup title or
        // poster, users see the fresh popup again even the same day (v8)
        today = festivalPopupSignature(cfg.key, cfg, ((TD.fest || {}).saveNonce || (TD.fest || {}).updatedAt));
        if (localStorage.getItem(cfg.key) === today) return;
      } catch (err) { return; }

      const overlay = document.getElementById('idPopupOverlay');
      if (!overlay) return;

      const box = document.getElementById('idPopupContainer');
      if (box) {
        box.classList.remove('fct-phase-coming', 'fct-phase-ending', 'td-phase-coming', 'td-phase-ending');
        if (cfg.cls) box.classList.add(cfg.cls);
      }

      const setText = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      const setHTML = (id, v) => { const el = document.getElementById(id); if (el) el.innerHTML = v; };
      setText('idPopupTitle',    cfg.title);
      setHTML('idPopupSubtitle', cfg.subtitle);
      setHTML('idPopupOffer',    cfg.offer);

      const pslot = document.getElementById('idPopupChakra');
      if (pslot) {
        pslot.innerHTML = cfg.icon;
        pslot.style.color = cfg.iconColor;
        pslot.style.display = 'flex';
        pslot.style.justifyContent = 'center';
      }

      const img = document.getElementById('idPosterImg');
      if (img) {
        if(cfg.poster){img.style.display='block';img.onerror=()=>{img.style.display='none';};if(img.getAttribute('src')!==cfg.poster)img.src=cfg.poster;}
        else{img.removeAttribute('src');img.style.display='none';}
      }

      // countdown chip driven by TD's own clock (silence IDT's writer)
      if (window.IDT) IDT._popCountTo = null;
      TD._popCountTo = cfg.countTo || null;
      TD._popCountLabel = cfg.countLabel || '';
      const pc = document.getElementById('fctPopCount');
      if (pc) pc.style.display = cfg.countTo ? 'block' : 'none';

      overlay.dataset.owner = 'td';
      overlay.style.display = 'flex';
      try { localStorage.setItem(cfg.key, today); } catch (err2) {}
    },

    maybeConfetti() {
      if (!TD.isEnabled()) return;
      let today;
      try {
        today = new Date().toDateString();
        if (localStorage.getItem('td_confetti_day') === today) return;
        localStorage.setItem('td_confetti_day', today);
      } catch (e) { return; }
      TD.fireConfetti(3600);
    },

    fireConfetti(durationMs) {
      if (document.getElementById('idConfettiCanvas') || document.getElementById('tdConfettiCanvas')) return;
      const canvas = document.createElement('canvas');
      canvas.id = 'tdConfettiCanvas';
      canvas.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:10001;';
      document.body.appendChild(canvas);
      const ctx = canvas.getContext('2d');
      const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
      resize();
      window.addEventListener('resize', resize);

      const colors = ['#4f46e5', '#f59e0b', '#fcd34d', '#fff7d6', '#a5b4fc', '#b45309'];
      const parts = [];
      const N = Math.min(170, Math.max(70, Math.floor(window.innerWidth / 5)));
      for (let i = 0; i < N; i++) {
        parts.push({
          x: Math.random() * canvas.width,
          y: -20 - Math.random() * canvas.height * 0.35,
          w: 6 + Math.random() * 6,
          h: 8 + Math.random() * 8,
          vx: -1 + Math.random() * 2,
          vy: 2 + Math.random() * 3.2,
          rot: Math.random() * Math.PI,
          vr: -0.12 + Math.random() * 0.24,
          color: colors[(Math.random() * colors.length) | 0],
          sway: Math.random() * Math.PI * 2
        });
      }
      const start = Date.now();
      (function loop() {
        const elapsed = Date.now() - start;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const fade = elapsed > durationMs ? Math.max(0, 1 - (elapsed - durationMs) / 800) : 1;
        parts.forEach(p => {
          p.sway += 0.05;
          p.x += p.vx + Math.sin(p.sway) * 0.7;
          p.y += p.vy;
          p.rot += p.vr;
          if (p.y > canvas.height + 30) { p.y = -20; p.x = Math.random() * canvas.width; }
          ctx.save();
          ctx.globalAlpha = fade;
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });
        if (elapsed < durationMs + 850) {
          requestAnimationFrame(loop);
        } else {
          window.removeEventListener('resize', resize);
          canvas.remove();
        }
      })();
    },

    // 🎓 Premium graduation cap — royal indigo mortarboard, golden tassel (inline SVG)
    capSVG(size) {
      const s = size || 64;
      return '<svg viewBox="0 0 120 92" width="' + s + '" height="' + Math.round(s * 0.76) + '" xmlns="http://www.w3.org/2000/svg">'
        + '<path d="M60 12 L114 34 L60 56 L6 34 Z" fill="#312e81" stroke="#fbbf24" stroke-width="3" stroke-linejoin="round"/>'
        + '<path d="M60 20 L99 34 L60 48 L21 34 Z" fill="#4f46e5" opacity=".9"/>'
        + '<path d="M38 49 v16 c0 9.5 44 9.5 44 0 v-16 l-22 9 z" fill="#1e1b4b" stroke="#f59e0b" stroke-width="2.5" stroke-linejoin="round"/>'
        + '<circle cx="60" cy="12" r="4.5" fill="#fbbf24" stroke="#b45309" stroke-width="1.5"/>'
        + '<path d="M60 12 C 86 14, 100 21, 106 33" stroke="#fbbf24" stroke-width="3" fill="none" stroke-linecap="round"/>'
        + '<path d="M106 33 v14" stroke="#fbbf24" stroke-width="3.5" stroke-linecap="round"/>'
        + '<path d="M106 47 l-5.5 13 h11 z" fill="#f59e0b" stroke="#b45309" stroke-width="1.5" stroke-linejoin="round"/>'
        + '</svg>';
    },

    // 📖 Premium open book — indigo cover, ivory pages, golden trim (inline SVG)
    bookSVG(size) {
      const s = size || 64;
      return '<svg viewBox="0 0 120 84" width="' + s + '" height="' + Math.round(s * 0.7) + '" xmlns="http://www.w3.org/2000/svg">'
        + '<path d="M60 19 C 46 9, 24 9, 10 15 v53 c14 -6, 36 -6, 50 4 c14 -10, 36 -10, 50 -4 v-53 c-14 -6, -36 -6, -50 4 z" fill="#312e81" stroke="#fbbf24" stroke-width="3" stroke-linejoin="round"/>'
        + '<path d="M60 23 C 48 14, 29 13.5, 16.5 18.5 v44.5 c12.5 -5, 31.5 -4.5, 43.5 4 z" fill="#fffbeb"/>'
        + '<path d="M60 23 C 72 14, 91 13.5, 103.5 18.5 v44.5 c-12.5 -5, -31.5 -4.5, -43.5 4 z" fill="#fff7d6"/>'
        + '<path d="M60 23 v44" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round"/>'
        + '<g stroke="#a5b4fc" stroke-width="2" stroke-linecap="round"><path d="M24 26.5 h24"/><path d="M24 34 h24"/><path d="M24 41.5 h20"/><path d="M72 26.5 h24"/><path d="M72 34 h24"/><path d="M76 41.5 h20"/></g>'
        + '</svg>';
    }
  };
  window.TD = TD;
  TD.init();
  </script>

  <!-- ════════════════════════════════════════════════════════════════════
