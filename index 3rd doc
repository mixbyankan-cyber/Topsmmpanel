    // ══════════════════════════════════════════════════════════════════
    // 💳 DYNAMIC PAYMENT METHODS ENGINE
    // Fully admin-managed — Add/Edit/Delete/Reorder any payment method
    // (UPI, Binance, PayPal, Crypto, etc.) from the Admin Panel, no code changes needed.
    // Data source: settings/paymentMethods/{methodId} = {
    //   name, icon, qrUrl, currencyCode, currencySymbol, minAmount,
    //   instructions, txnLabel, txnMinLength, enabled, sortOrder, isDefault
    // }
    // ══════════════════════════════════════════════════════════════════

    let paymentMethodsCache = [];
    let activePaymentMethodId = null;
    const _qrPreloadCache = {}; // methodId -> preloaded <img> element (for instant display)

    // Preload a QR image in the background so it's ready before the user even opens the tab
    function preloadPaymentQR(methodId, url) {
      if (!url || _qrPreloadCache[methodId]) return;
      const img = new Image();
      img.src = url;
      _qrPreloadCache[methodId] = img;
    }

    // Load all enabled payment methods (real-time) and render tabs + sections
    // The exact "previous default" UPI method — kept as the guaranteed starting method.
    // Uses a FIXED key ('default_upi') instead of push() so seeding is idempotent:
    // even if both user.html and admin.html try to seed at the same time, they write
    // to the same path with the same data — no duplicates, no race conditions.
    const DEFAULT_UPI_PAYMENT_METHOD = {
      name: 'UPI (India)',
      icon: '📱',
      qrUrl: 'qr-code.jpg',
      currencyCode: 'INR',
      currencySymbol: '₹',
      exchangeRateToINR: 1,
      minAmount: 1,
      instructions: 'PhonePe / PayTm / Gpay / FamPay [ All UPI Apps ]',
      txnLabel: 'UPI Transaction Number / UTR',
      txnMinLength: 12,
      sortOrder: 0,
      approvalMode: 'manual',
      bonusEnabled: false,
      bonusTiers: [],
      enabled: true
    };
    let _defaultPaymentSeedAttempted = false;
    let _paymentMethodsSeedResolved = false; // becomes true once we know seeding is done/skipped

    function loadPaymentMethods() {
      // Check the permanent "seeded" flag ONCE — this ensures the default UPI method
      // is created exactly one time, ever. If Admin later deletes it on purpose,
      // it will NOT be recreated automatically (proper, expected delete behavior).
      database.ref('settings/paymentMethodsSeeded').once('value').catch(e=>{console.warn('paymentMethodsSeeded read blocked:',e.message);return null;}).then(seededSnap => { if(!seededSnap) return;
        if (!seededSnap.exists() && !_defaultPaymentSeedAttempted) {
          _defaultPaymentSeedAttempted = true;
          database.ref('settings/paymentMethods/default_upi').set({
            ...DEFAULT_UPI_PAYMENT_METHOD,
            createdAt: Date.now()
          }).then(() => {
            database.ref('settings/paymentMethodsSeeded').set(true);
            _paymentMethodsSeedResolved = true;
          }).catch(() => {
            // If write fails (rules/offline), still stop showing "loading" state forever
            _paymentMethodsSeedResolved = true;
          });
        } else {
          _paymentMethodsSeedResolved = true;
        }
      });

      sessionOn(database.ref('settings/paymentMethods'), 'value', snapshot => {
        const data = snapshot.val() || {};

        paymentMethodsCache = Object.entries(data)
          .map(([id, m]) => ({ id, ...m }))
          .filter(m => m.enabled !== false)
          .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0));

        // Safety net: ONLY before the one-time seeding process has resolved (i.e. on a
        // brand-new database, for the split-second before the default UPI method is
        // written), show it client-side so the page never looks empty/broken.
        // Once seeding has resolved, an empty list means Admin intentionally deleted
        // everything — so we correctly show the "no payment methods" state instead.
        if (paymentMethodsCache.length === 0 && !_paymentMethodsSeedResolved) {
          paymentMethodsCache = [{ id: 'default_upi', ...DEFAULT_UPI_PAYMENT_METHOD }];
        }

        // Kick off preloading ALL QR images immediately in the background (parallel, non-blocking)
        // so switching tabs later shows the QR instantly with zero loading delay.
        /* v39 performance: do not preload every QR image; the selected method loads on demand. */

        // Keep current active method if valid; otherwise select the first one.
        // An intentionally empty Admin list is a supported state, not a crash.
        if (!paymentMethodsCache.length) {
          activePaymentMethodId = null;
          renderPaymentMethodTabs();
          const host=document.getElementById('fundMethodSectionsContainer');
          if(host)host.innerHTML='<div class="empty-state"><div class="empty-icon">💳</div><div class="empty-text">No payment methods available</div><div class="empty-subtext">Please contact Support or check back later.</div></div>';
          return;
        }
        if (!activePaymentMethodId || !paymentMethodsCache.find(m => m.id === activePaymentMethodId)) activePaymentMethodId = paymentMethodsCache[0].id;
        renderPaymentMethodTabs();
        renderActivePaymentMethodQR();
      });
    }

    // Render the payment method selector button (currently selected) + the dropdown list
    function renderPaymentMethodTabs() {
      const selectedIcon = document.getElementById('pmsSelectedIcon');
