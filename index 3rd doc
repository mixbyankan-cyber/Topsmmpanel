/* ---------- 12-ui-polish.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v36 USER · PART 12 — UI POLISH & ROOT FIXES
     1. THE service-selection bug: updateServiceDropdownDisplay() was being
        called with NO arguments by several code paths (re-order, wishlist,
        every services rebuild). With no arguments it printed the
        placeholder, so the package looked selected while the service field
        still said "-- Select Service --". It is now self-healing and there
        is one single safe entry point: TSMU.setService(serviceId).
     2. A fixed layout block at the top of the New Order card so the
        Social Network bar and the wishlist strip always sit in the right
        place, in the right order, above the search box.
     3. Smart search box: never auto-fills itself, one-tap total clear.
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };

  const CSS = `
  #tsmuOrderTop{margin:0 0 12px}
  #tsmuOrderTop:empty{display:none}
  #tsmuPfSlot:empty,#tsmuWishSlot:empty{display:none}
  .tsmu-srch{position:relative}
  .tsmu-srch-x{position:absolute;top:50%;right:10px;transform:translateY(-50%);width:24px;height:24px;border:0;border-radius:50%;
    background:var(--border-light,#f1f5f9);color:var(--text-gray,#64748b);font-size:13px;line-height:1;cursor:pointer;
    display:none;align-items:center;justify-content:center;font-family:inherit;padding:0;z-index:3}
  .tsmu-srch-x:hover{background:#fee2e2;color:#b91c1c}
  .tsmu-srch.has .tsmu-srch-x{display:flex}
  .tsmu-srch input{padding-right:38px!important}
  `;
  const st = document.createElement('style'); st.id = 'tsmuPolishStyles'; st.textContent = CSS; document.head.appendChild(st);

  /* ═══════════ 1. SERVICE SELECTION — ONE SAFE ENTRY POINT ═══════════ */
  function svcById(id) { return (TSMU.G('allServices') || []).find(s => s && s.id === id) || null; }
  function logoOf(svc) { try { return (svc && window.getServiceLogoHTML) ? (getServiceLogoHTML(svc.logo,svc.customLogoUrl) || '') : ''; } catch (e) { return ''; } }
  function placeholder() {
    try { return textOr(newOrderControl.servicePlaceholder, NEW_ORDER_DEFAULTS.servicePlaceholder); }
    catch (e) { return '-- Select Service --'; }
  }

  /** Repaint the visible custom dropdown from whatever the native select holds. */
  TSMU.paintServiceDisplay = function () {
    const sel = document.getElementById('serviceSelect');
    const id = sel ? sel.value : '';
    const svc = id ? svcById(id) : null;
    const icon = document.getElementById('customServiceSelectedIcon');
    const text = document.getElementById('customServiceSelectedText');
    if (icon) icon.innerHTML = svc ? logoOf(svc) : '';
    if (text) text.textContent = svc ? (svc.name || id) : placeholder();
    document.querySelectorAll('.custom-service-option').forEach(o => o.classList.toggle('active', o.dataset.value === id));
  };

  /* the panel's own painter loses everything when it is called with no
     arguments — make every call self-healing instead of destructive */
  wrap('updateServiceDropdownDisplay', orig => function (serviceId, serviceName, logoHTML) {
    if (serviceId === undefined || serviceId === null) {
      const sel = document.getElementById('serviceSelect');
      serviceId = sel ? sel.value : '';
    }
    if (serviceId && (serviceName === undefined || serviceName === null || serviceName === '')) {
      const svc = svcById(serviceId);
      if (svc) { serviceName = svc.name || serviceId; if (!logoHTML) logoHTML = logoOf(svc); }
    }
    if (!serviceId) { serviceName = placeholder(); logoHTML = ''; }
    return orig.call(this, serviceId, serviceName, logoHTML || '');
  });

  /**
   * Select a service exactly the way a human click does:
   * native select + visible dropdown + package list + platform filter.
   * Returns true when the service really exists in the list.
   */
  TSMU.setService = function (serviceId, opts) {
    opts = opts || {};
    const sel = document.getElementById('serviceSelect');
    if (!sel || !serviceId) return false;

    // a network filter must never hide the service we are switching to
    try { if (TSMU.pfClearForService) TSMU.pfClearForService(serviceId); } catch (e) { }

    const has = Array.prototype.some.call(sel.options, o => o.value === serviceId);
    if (!has) {
      const svc = svcById(serviceId);
      if (!svc) return false;
      const o = document.createElement('option');       // rebuilt list has not arrived yet
      o.value = serviceId; o.textContent = svc.name || serviceId;
      sel.appendChild(o);
    }
    sel.value = serviceId;
    TSMU.paintServiceDisplay();
    try { sel.dispatchEvent(new Event('change', { bubbles: true })); } catch (e) { }
    if (opts.loadPackages !== false) { try { if (window.loadPackages) loadPackages(); } catch (e) { } }
    // repaint again once the live rebuild settles
    setTimeout(TSMU.paintServiceDisplay, 120);
    setTimeout(TSMU.paintServiceDisplay, 500);
    return true;
  };

  /** Wait until a <select> really contains a value (Firebase latency varies). */
  TSMU.waitOption = function (selectId, value, timeout) {
    const test = () => { const e = document.getElementById(selectId); return !!e && Array.prototype.some.call(e.options, o => o.value === value); };
    return TSMU.waitFor ? TSMU.waitFor(test, timeout || 9000) : Promise.resolve(test());
  };

  /* every rebuild of the service list must repaint the visible field */
  ['displayServices', 'loadPackages', 'loadPackageDetails', 'resetOrderForm'].forEach(fn =>
    wrap(fn, orig => function () { const r = orig.apply(this, arguments); setTimeout(TSMU.paintServiceDisplay, 60); return r; }));

  /* ═══════════ 2. TOP BLOCK OF THE NEW ORDER CARD ═══════════ */
  /* Order (top → bottom):  network bar · wishlist strip · search box · form */
  function searchGroup() {
    const inp = document.getElementById('packageSearchInput');
    if (!inp) return null;
    return inp.closest('.input-group') || inp.parentNode;
  }
  TSMU.orderTopSlot = function (name) {
    let top = document.getElementById('tsmuOrderTop');
    if (!top) {
      const anchor = searchGroup();
      if (!anchor || !anchor.parentNode) return null;
      top = document.createElement('div'); top.id = 'tsmuOrderTop';
      top.innerHTML = '<div id="tsmuPfSlot"></div><div id="tsmuWishSlot"></div>';
      anchor.parentNode.insertBefore(top, anchor);
    }
    return document.getElementById(name === 'wish' ? 'tsmuWishSlot' : 'tsmuPfSlot');
  };

  /* ═══════════ 3. SMART SEARCH BOX ═══════════ */
  function mountSearch() {
    const inp = document.getElementById('packageSearchInput'); if (!inp) return;
    const grp = inp.closest('.input-group') || inp.parentNode;
    if (grp && !grp.classList.contains('tsmu-srch')) grp.classList.add('tsmu-srch');
    if (!document.getElementById('tsmuSrchClear')) {
      const b = document.createElement('button');
      b.type = 'button'; b.id = 'tsmuSrchClear'; b.className = 'tsmu-srch-x';
      b.title = 'Clear search'; b.textContent = '✕';
      b.onclick = function (e) { e.preventDefault(); e.stopPropagation(); TSMU.clearSearch(); };
      // keep it beside the input, not inside the results dropdown
      inp.insertAdjacentElement('afterend', b);
    }
    if (!inp._tsmuWired) {
      inp._tsmuWired = 1;
      inp.addEventListener('input', paintClear);
      inp.addEventListener('keydown', e => { if (e.key === 'Escape') TSMU.clearSearch(); });
    }
    paintClear();
  }
  function paintClear() {
    const inp = document.getElementById('packageSearchInput'); if (!inp) return;
    const grp = inp.closest('.input-group') || inp.parentNode;
    if (grp) grp.classList.toggle('has', String(inp.value || '').length > 0);
  }
  TSMU.searchClearPaint = paintClear;

  TSMU.clearSearch = function () {
    const inp = document.getElementById('packageSearchInput');
    if (inp) { inp.value = ''; }
    const dd = document.getElementById('packageSearchDropdown');
    if (dd) { dd.classList.remove('show'); dd.innerHTML = ''; }
    paintClear();
    if (inp) inp.focus();
  };

  /* choosing a result must leave the box empty and the list closed */
  wrap('selectPackageFromSearch', orig => function () {
    const r = orig.apply(this, arguments);
    setTimeout(() => {
      const inp = document.getElementById('packageSearchInput'); if (inp) inp.value = '';
      const dd = document.getElementById('packageSearchDropdown'); if (dd) dd.classList.remove('show');
      paintClear();
      TSMU.paintServiceDisplay();
    }, 40);
    return r;
  });

  /* ═══════════ 4. RUN SOMETHING AS SOON AS A USER IS SIGNED IN ═══════════
     The panel signs in progressively, so a listener attached at boot time
     would silently attach to nothing. */
  TSMU.whenUid = function (fn) {
    let done = '';
    const run = () => {
      const uid = TSMU.uid();
      if (!uid || uid === done) return !!done;
      done = uid;
      try { fn(uid); } catch (e) { console.warn('[TSMU whenUid]', e); }
      return true;
    };
    if (run()) return;
    const iv = setInterval(() => { if (run()) clearInterval(iv); }, 600);
    setTimeout(() => clearInterval(iv), 120000);
    try {
      const a = TSMU.authObj();
      if (a && a.onAuthStateChanged) a.onAuthStateChanged(() => setTimeout(run, 250));
    } catch (e) { }
  };

  TSMU.onReady(function () {
    TSMU.registerMount(function () { mountSearch(); TSMU.orderTopSlot('pf'); TSMU.paintServiceDisplay(); });
    setTimeout(() => { mountSearch(); TSMU.orderTopSlot('pf'); }, 900);
    setTimeout(() => { mountSearch(); TSMU.paintServiceDisplay(); }, 2200);
  });

  console.log('%c TSMU v36 ui polish loaded ', 'background:#0f172a;color:#fff;padding:2px 6px;border-radius:4px');
})();


/* ---------- 13-router.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v37 USER · PART 13 — REAL URL ROUTING
   Every page gets its own address:  yoursite.com/#add-funds, /#refer …
     • the address bar always matches the page you are on
     • browser Back / Forward work like a normal website
     • a link can be shared and opens straight on that page
     • the browser tab title changes with the page
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU;
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };

  /* page id  ->  url slug + tab title */
  const MAP = {
    authPage: ['login', 'Sign in'],
    dashboardPage: ['home', 'Dashboard'],
    ordersPage: ['orders', 'My Orders'],
    addFundPage: ['fund-add', 'Add Funds'],
    walletPage: ['wallet', 'Wallet Statement'],
    profilePage: ['profile', 'My Profile'],
    termsPage: ['terms', 'Terms & Conditions'],
    ticketsPage: ['support', 'Support & Tickets'],
    ticketConvoPage: ['ticket', 'Ticket'],
    menuPage: ['menu', 'Menu'],
    servicesPage: ['services', 'All Services'],
    refillPage: ['refill', 'Refill'],
    notificationPage: ['notifications', 'Notifications'],
    referralPage: ['refer', 'Refer & Earn'],
    rulesPage: ['rules', 'Important Rules'],
    buyPanelPage: ['buy-panel', 'Buy Own Panel'],
    apiPage: ['api', 'Reseller API'],
    wishlistPage: ['wishlist', 'My Wishlist'],
    feedbackPage: ['feedback', 'Feedback']
  };
  const SLUG = {};
  Object.keys(MAP).forEach(id => { SLUG[MAP[id][0]] = id; });

  TSMU.router = { map: MAP, slugs: SLUG, busy: false, ready: false };

  TSMU.routeAdd = function (pageId, slug, title) {      // other modules can register their page
    MAP[pageId] = [slug, title || slug];
    SLUG[slug] = pageId;
  };

  function brand() {
    try {
      const t = String(document.title || '').split('|')[0].split('—')[0].trim();
      return t || 'Top SMM';
    } catch (e) { return 'Top SMM'; }
  }
  const BRAND = brand();

  function setTitle(pageId) {
    const e = MAP[pageId];
    document.title = e ? (e[1] + ' — ' + BRAND) : BRAND;
  }

  function currentSlug() {
    return String(location.hash || '').replace(/^#\/?/, '').split('?')[0].trim().toLowerCase();
  }

  /** write the hash without re-triggering our own hashchange handler */
  function pushSlug(slug, replace) {
    if (!slug) return;
    const target = '#' + slug;
    if (location.hash === target) return;
    TSMU.router.busy = true;
    try {
      if (replace && history.replaceState) history.replaceState(null, '', target);
      else if (history.pushState) history.pushState(null, '', target);
      else location.hash = target;
    } catch (e) { location.hash = target; }
    setTimeout(() => { TSMU.router.busy = false; }, 30);
  }

  function loggedIn() {
    try { const a = TSMU.authObj(); return !!(a && a.currentUser); } catch (e) { return false; }
  }

  /* ── every navigation updates the address bar ── */
  wrap('navigateTo', orig => function (pageId) {
    const r = orig.apply(this, arguments);
    const e = MAP[pageId];
    if (e) { pushSlug(e[0], pageId === 'authPage'); setTitle(pageId); }
    return r;
  });

  /* ── Back / Forward and hand-typed addresses ── */
  function applyHash(firstTime) {
    if (TSMU.router.busy) return;
    const slug = currentSlug();
    const pageId = SLUG[slug];
    if (!pageId) return;
    const el = document.getElementById(pageId);
    if (el && el.classList.contains('active')) { setTitle(pageId); return; }
    if (pageId !== 'authPage' && !loggedIn()) return;          // protected pages need a session
    if (pageId === 'wishlistPage' && TSMU.openWishlist) { TSMU.openWishlist(); setTitle(pageId); return; }
    if (pageId === 'feedbackPage' && TSMU.openFeedback) { TSMU.openFeedback(); setTitle(pageId); return; }
    try { window.navigateTo(pageId); } catch (e) { }
    setTitle(pageId);
  }
  window.addEventListener('hashchange', () => applyHash(false));
  window.addEventListener('popstate', () => applyHash(false));

  /** open the page the address bar asks for, once the panel is ready */
  TSMU.routeApply = () => applyHash(true);

  TSMU.onReady(function () {
    // deep link: wait for the session, then jump to the requested page
    let tries = 0;
    const iv = setInterval(() => {
      tries++;
      const slug = currentSlug();
      if (slug && SLUG[slug] && (loggedIn() || SLUG[slug] === 'authPage')) { applyHash(true); clearInterval(iv); }
      if (tries > 40) clearInterval(iv);
    }, 400);

    // make sure the very first painted page also has its address
    setTimeout(() => {
      const active = document.querySelector('.page.active');
      if (active && MAP[active.id] && !currentSlug()) { pushSlug(MAP[active.id][0], true); setTitle(active.id); }
      TSMU.router.ready = true;
    }, 1500);
  });

  console.log('%c TSMU v37 router loaded ', 'background:#334155;color:#fff;padding:2px 6px;border-radius:4px');
})();


