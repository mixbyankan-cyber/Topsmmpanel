      if (mobile && mobile.length !== 10) {
        playSound('error'); // 🔊 Play error sound
        return showToast('❌ Mobile number must be 10 digits (or leave it blank)!', 'error');
      }

      // ✅ Mandatory Terms & Conditions agreement — cannot create an
      // account without ticking this box first (professional signup gate).
      if (!signupTermsAgreed) {
        playSound('error');
        showToast('⚠️ Please click the checkbox to agree to Terms & Conditions!', 'error');
        const termsRow = document.querySelector('#signupForm .signup-terms-row');
        if (termsRow) {
          termsRow.classList.remove('shake');
          void termsRow.offsetWidth; // restart animation if clicked repeatedly
          termsRow.classList.add('shake');
        }
        return;
      }

      // ⚡ INSTANT FEEDBACK: lock the submit button immediately
      const signupSubmitBtn = e.target.querySelector('button[type="submit"]');
      const signupBtnOriginalHTML = signupSubmitBtn ? signupSubmitBtn.innerHTML : '';
      if (signupSubmitBtn) {
        signupSubmitBtn.disabled = true;
        signupSubmitBtn.innerHTML = '⏳ Creating Account...';
      }

      try {
        const userCredential = await auth.createUserWithEmailAndPassword(email, password);
        const userId = userCredential.user.uid;

        // 🔢 Referral code generation is fully local/synchronous (no DB
        // round trip needed) — computed once and included directly in the
        // very first user record write below.
        const newUserCode = generateReferralCode(userId, email);

        const userData = {
          name: name,
          email: email,
          mobile: mobile,
          balance: 0,
          spent: 0,
          createdAt: Date.now(),
          loginMethod: 'Email',
          lastLogin: Date.now(),
          referral_code: newUserCode,
          referral_code_generated_at: Date.now(),
          // ✅ Permanently record Terms & Conditions agreement at the exact
          // moment the account is created — this is the same tick the user
          // made on the Signup form; it can never be un-ticked afterwards.
          termsAgreedAt: Date.now()
        };

        // ⚡ SPEED: update the Auth display name AND write both database
        // records (users + registered_users, via ONE multi-path update())
        // all in PARALLEL — cuts 4 sequential round trips down to 1.
        await Promise.all([
          userCredential.user.updateProfile({ displayName: name }),
          database.ref().update({
            [`users/${userId}`]: userData,
            [`registered_users/${userId}`]: userData,
            [`email_index/${LEGACY._emailKey(email)}`]: { uid: userId, email: (email || '').trim().toLowerCase() },
            [`referral_code_index/${newUserCode}`]: { uid: userId }
          })
        ]);

        // Handle referral code if provided during signup (shared helper —
        // also used by Google Sign-In). Fire-and-forget: never blocks the
        // success screen from showing instantly.
        if (referralCode) {
          processSignupReferralCode(userId, referralCode);
        }

        // 🔔 Send Welcome Notification + server/free-Worker email queue
        sendWelcomeNotification(userId, name);
        database.ref(`welcome_email_queue/${userId}`).set({ userId, createdAt:Date.now(), status:'pending' }).catch(()=>{});
        callFreeBackend('welcomeEmail', {}).catch(e => console.warn('Welcome email queued for retry:', e.message));

        playSound('success'); // 🔊 Play success sound
        showToast('Account created successfully! 🎉', 'success');
      } catch (error) {
        playSound('error'); // 🔊 Play error sound
        if (error.code === 'auth/email-already-in-use') {
          showToast('❌ Email already registered!', 'error');
        } else if (error.code === 'auth/weak-password') {
          showToast('❌ Password should be at least 6 characters!', 'error');
        } else if (error.code === 'auth/invalid-email') {
          showToast('❌ Invalid email format!', 'error');
        } else {
          showToast('❌ ' + error.message, 'error');
        }
      } finally {
        if (signupSubmitBtn) {
          signupSubmitBtn.disabled = false;
          signupSubmitBtn.innerHTML = signupBtnOriginalHTML;
        }
      }
    });

