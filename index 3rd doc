    .nav-item:hover:not(.active) {
      background: rgba(14,165,233,0.08) !important;
      transform: translateY(-1px) !important;
    }

    /* Buttons — 3D press effect */
    .btn-primary, .btn-action, .btn-submit-order {
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(14,165,233,0.3), 0 2px 4px rgba(0,0,0,0.08) !important;
    }
    .btn-primary::before, .btn-action::before, .btn-submit-order::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 60%; height: 100%;
      background: linear-gradient(to right, transparent, rgba(255,255,255,0.25), transparent);
      transform: skewX(-20deg);
      transition: left 0.5s ease;
    }
    .btn-primary:hover::before, .btn-action:hover::before, .btn-submit-order:hover::before { left: 150%; }
    .btn-primary:hover, .btn-action:hover, .btn-submit-order:hover {
      transform: translateY(-3px) !important;
      box-shadow: 0 8px 24px rgba(14,165,233,0.45), 0 2px 6px rgba(0,0,0,0.1) !important;
    }
    .btn-primary:active, .btn-action:active, .btn-submit-order:active {
      transform: translateY(1px) !important;
      box-shadow: 0 2px 8px rgba(14,165,233,0.2) !important;
    }

    /* Input focus — glow ring */
    .input-field:focus, .select-field:focus {
      box-shadow: 0 0 0 3px rgba(14,165,233,0.15), 0 2px 8px rgba(14,165,233,0.1) !important;
      border-color: var(--primary-color) !important;
      transform: translateY(-1px);
    }

    /* Stat value counter */
    .stat-value {
      font-size: 30px !important;
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 800 !important;
    }

    /* Page entrance animation */
    @keyframes cardEntrance {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .page.active .stat-card,
    .page.active .order-card,
    .page.active .order-form-card,
    .page.active .notification-item,
    .page.active .fund-card {
      animation: cardEntrance 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    .page.active .stat-card:nth-child(1)       { animation-delay: 0.05s; }
    .page.active .stat-card:nth-child(2)       { animation-delay: 0.10s; }
    .page.active .stat-card:nth-child(3)       { animation-delay: 0.15s; }
    .page.active .order-card:nth-child(1)      { animation-delay: 0.05s; }
    .page.active .order-card:nth-child(2)      { animation-delay: 0.10s; }
    .page.active .order-card:nth-child(3)      { animation-delay: 0.15s; }
    .page.active .order-card:nth-child(n+4)    { animation-delay: 0.20s; }
    .page.active .notification-item:nth-child(1){ animation-delay: 0.05s; }
    .page.active .notification-item:nth-child(2){ animation-delay: 0.10s; }
    .page.active .notification-item:nth-child(3){ animation-delay: 0.15s; }
    .page.active .notification-item:nth-child(n+4){ animation-delay: 0.20s; }

    /* WhatsApp float — 3D bounce */
    .whatsapp-float {
      animation: waFloat 3s ease-in-out infinite !important;
    }
    @keyframes waFloat {
      0%,100% { transform: scale(1) translateY(0); }
      50%      { transform: scale(1.06) translateY(-4px); }
    }
    .whatsapp-float:hover {
      animation: none !important;
      transform: scale(1.15) !important;
    }

    /* Welcome card gradient */
    .welcome-card {
      background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%) !important;
      border: 2px solid rgba(14,165,233,0.2) !important;
      border-radius: 20px !important;
      box-shadow:
        0 4px 20px rgba(14,165,233,0.1),
        inset 0 1px 0 rgba(255,255,255,1) !important;
    }

    /* Order status badges — 3D pill */
    .order-status-badge {
      border-radius: 20px !important;
      font-size: 11px !important;
      font-weight: 700 !important;
      letter-spacing: 0.3px !important;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08) !important;
    }

    /* Header glass depth */
    .header {
      box-shadow:
        0 1px 0 rgba(255,255,255,0.9),
        0 4px 20px rgba(14,165,233,0.08) !important;
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: var(--lighter-bg); border-radius: 5px; }
    ::-webkit-scrollbar-thumb { background: var(--primary-light); border-radius: 5px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--primary-color); }

  </style>

