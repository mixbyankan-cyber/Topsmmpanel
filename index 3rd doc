    // Google Sign In
    async function googleSignIn() {
      // Show loading state
      const loginBtn = document.getElementById('googleLoginBtn');
      const signupBtn = document.getElementById('googleSignupBtn');
      const loginText = document.getElementById('googleLoginText');
      const signupText = document.getElementById('googleSignupText');
      
      const originalLoginText = loginText ? loginText.textContent : '';
      const originalSignupText = signupText ? signupText.textContent : '';
      
      if (loginBtn) {
        loginBtn.disabled = true;
        if (loginText) loginText.textContent = 'Opening Google...';
      }
      if (signupBtn) {
        signupBtn.disabled = true;
        if (signupText) signupText.textContent = 'Opening Google...';
      }
      
      try {
        // Create Google Auth Provider
        const provider = new firebase.auth.GoogleAuthProvider();
        
        // Add scopes
        provider.addScope('https://www.googleapis.com/auth/userinfo.profile');
        provider.addScope('https://www.googleapis.com/auth/userinfo.email');
        
        // Set custom parameters
        provider.setCustomParameters({
          'prompt': 'select_account',
          'display': 'popup'
        });
        
        // Try popup first (preferred method)
        let result;
        try {
          if (loginText) loginText.textContent = 'Waiting for Google...';
          if (signupText) signupText.textContent = 'Waiting for Google...';
          
          result = await auth.signInWithPopup(provider);
        } catch (popupError) {
          // If popup fails, try redirect as fallback
          const canRedirect = ['auth/popup-blocked','auth/operation-not-supported-in-this-environment','auth/internal-error'].includes(popupError.code);
          if (canRedirect) {
            if (loginBtn) loginBtn.disabled = false;
            if (signupBtn) signupBtn.disabled = false;
            showToast('Opening secure Google sign-in…', 'success');
            await auth.signInWithRedirect(provider);
            return;
          }
          // Closing the chooser is an intentional cancel, not a credential error.
          throw popupError;
        }
        
        // Get user from result
        const user = result.user;
        
        if (!user) {
          throw new Error('No user data received from Google');
        }
        
        // Update loading text
        if (loginText) loginText.textContent = 'Setting up account...';
        if (signupText) signupText.textContent = 'Setting up account...';
        
        // Check if user exists in database
        const userRef = database.ref(`users/${user.uid}`);
        let snapshot = await userRef.once('value');
        if (!snapshot.exists()) {
          // 🗄️ Same email existed in the OLD project? Adopt that account
          // (balance, orders etc.) onto this new Google sign-in.
          try { const a=await callFreeBackend('adoptProfile',{}); if(a.adopted) snapshot=await userRef.once('value'); } catch(adoptErr){ console.log('Archive adopt:',adoptErr); }
        }
        
        if (!snapshot.exists()) {
          // New user - create account
          const userData = {
            name: cleanPersonName(user.displayName||'User'),
            email: getBestUserEmail(user, null),
            mobile: user.phoneNumber || '',
            balance: 0,
            spent: 0,
            createdAt: Date.now(),
            loginMethod: 'google',
            photoURL: user.photoURL || '',
            lastLogin: Date.now(),
            // ✅ Google Sign-In is a one-click OAuth flow with no signup form
            // step to show a checkbox in — so, exactly like the Important
            // Rules page's "auto" agreement behavior, Terms & Conditions
            // agreement is recorded automatically and permanently the
            // moment their account is created.
            termsAgreedAt: Date.now()
          };
          
          await userRef.set(userData);

          // Save to registered_users so admin panel can detect new user and send welcome email
          await database.ref(`registered_users/${user.uid}`).set(userData);
          database.ref('email_index/' + LEGACY._emailKey(userData.email)).set({ uid: user.uid, email: (userData.email || '').trim().toLowerCase() }).catch(() => {});

          // 🎁 Generate this new user's own referral code (same as manual signup flow)
          const newUserCode = generateReferralCode(user.uid, user.email);
          await userRef.update({
            referral_code: newUserCode,
            referral_code_generated_at: Date.now()
          });
          database.ref('referral_code_index/' + newUserCode).set({ uid: user.uid }).catch(() => {});

          // 🎁 Apply a pending referral code if the user arrived via a referral link
          // (?ref=CODE), captured earlier in sessionStorage by checkURLForReferralCode(),
          // OR one manually typed into the signup form's referral field (if visible).
          const pendingReferralCode = sessionStorage.getItem('pending_referral_code') ||
            (document.getElementById('signupReferralCode') ? document.getElementById('signupReferralCode').value.trim().toUpperCase() : '');
          if (pendingReferralCode) {
            await processSignupReferralCode(user.uid, pendingReferralCode);
            sessionStorage.removeItem('pending_referral_code');
          }

          // Send Welcome Notification + email queue
          try {
            sendWelcomeNotification(user.uid, user.displayName || 'User');
            database.ref(`welcome_email_queue/${user.uid}`).set({ userId:user.uid, createdAt:Date.now(), status:'pending' }).catch(()=>{});
            callFreeBackend('welcomeEmail', {}).catch(e => console.warn('Welcome email queued for retry:', e.message));
          } catch (notifError) {
            console.log('Notification error:', notifError);
          }
          
          playSound('success');
          showToast('🎉 Welcome! Account created successfully!', 'success');
        } else {
          // Existing user - update last login (and self-heal missing email/name/photo/loginMethod)
          const existingData = snapshot.val() || {};
          const loginUpdates = { lastLogin: Date.now() };
          const resolvedEmail = getBestUserEmail(user, existingData);
          if (!existingData.email && resolvedEmail) loginUpdates.email = resolvedEmail;
          if (!existingData.name && user.displayName) loginUpdates.name = user.displayName;
          if (!existingData.photoURL && user.photoURL) loginUpdates.photoURL = user.photoURL;
          if (!existingData.loginMethod) loginUpdates.loginMethod = 'google';
          await userRef.update(loginUpdates);
          // Keep the registered_users mirror in sync too (used by Admin Panel).
          await database.ref(`registered_users/${user.uid}`).update(loginUpdates).catch(()=>{});
          
          playSound('success');
          showToast('🎉 Welcome back!', 'success');
        }
        
      } catch (error) {
        console.error('Google Sign-In Error:', error);
        
        // Restore button states on error
        if (loginBtn) {
          loginBtn.disabled = false;
          if (loginText) loginText.textContent = originalLoginText;
        }
        if (signupBtn) {
          signupBtn.disabled = false;
          if (signupText) signupText.textContent = originalSignupText;
        }
        
        playSound('error');
        
        // Handle different error cases
        if (error.code === 'auth/popup-closed-by-user') {
          showToast('❌ Sign-in cancelled', 'error');
        } else if (error.code === 'auth/popup-blocked') {
          showToast('❌ Please allow popups and try again', 'error');
        } else if (error.code === 'auth/cancelled-popup-request') {
          // Silent - user opened multiple popups
          console.log('Multiple popup requests');
        } else if (error.code === 'auth/network-request-failed') {
          showToast('❌ Network error! Check your connection', 'error');
        } else if (error.code === 'auth/unauthorized-domain') {
          showToast('❌ Domain not authorized. Contact admin', 'error');
        } else if (error.code === 'auth/operation-not-allowed') {
          showToast('❌ Google sign-in not enabled. Contact admin', 'error');
        } else if (error.code === 'auth/account-exists-with-different-credential') {
          showToast('❌ Email already used with different login method', 'error');
        } else if (error.code === 'auth/invalid-credential') {
          showToast('❌ Invalid credentials. Please try again', 'error');
        } else {
          showToast('❌ Sign-in failed: ' + (error.message || 'Unknown error'), 'error');
        }
      } finally {
        // Always restore button states after delay
        setTimeout(() => {
          if (loginBtn) {
            loginBtn.disabled = false;
            if (loginText) loginText.textContent = originalLoginText;
          }
          if (signupBtn) {
            signupBtn.disabled = false;
            if (signupText) signupText.textContent = originalSignupText;
          }
        }, 1500);
      }
    }
    
