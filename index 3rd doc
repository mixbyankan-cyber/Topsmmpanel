      meta += '<span>📦 Min ' + TSMU.int(pkg.min || 0) + ' · Max ' + TSMU.int(pkg.max || 0) + '</span>';
      if (pkg.avgTime) meta += '<span>⏱️ ' + esc(pkg.avgTime) + '</span>';
      if (dropped) meta += '<span class="drop">📉 Price dropped from ₹' + then.toFixed(4) + '</span>';
      if (risen) meta += '<span class="up">📈 Price went up from ₹' + then.toFixed(4) + '</span>';
    } else {
      meta += '<span class="bad">⚠️ ' + esc(a.why) + '</span>';
    }

    return '<div class="tsmu-wl-card' + (!a.ok ? ' gone' : dropped ? ' drop' : '') + '">' +
      '<div class="tsmu-wl-top">' +
      '<div style="flex:1;min-width:0">' +
      '<div class="tsmu-wl-nm">' + esc(r.name || 'Package') + '</div>' +
      '<div class="tsmu-wl-sv">' + svcLogo + '<span>' + esc(r.service || 'Service') + '</span></div>' +
      '</div>' +
      '<button class="tsmu-wl-x" title="Remove" onclick="TSMU.wishRemove(\'' + esc(r.key) + '\',event)">🗑️</button>' +
      '</div>' +
      '<div class="tsmu-wl-meta">' + meta + '</div>' +
      (r.note ? '<div class="tsmu-wl-note">📝 ' + esc(r.note) + '</div>' : '') +
      '<div class="tsmu-wl-act">' +
      (a.ok ? '<button class="tsmu-btn" onclick="TSMU.wishOrder(\'' + esc(r.key) + '\')">🛒 Order Now</button>' : '') +
      '<button class="tsmu-btn sec" onclick="TSMU.wishNote(\'' + esc(r.key) + '\')">📝 ' + (r.note ? 'Edit note' : 'Add note') + '</button>' +
      '<span style="font-size:11px;color:var(--text-gray,#64748b);align-self:center">Saved ' + TSMU.dt(r.at) + '</span>' +
      '</div></div>';
  }

  function render() {
    const box = document.getElementById('tsmuWlList'); if (!box) return;
    const list = rows();
    const kp = document.getElementById('tsmuWlKpis');
    if (kp) {
      const all = Object.keys(W.items);
      const gone = all.filter(k => !available(k).ok).length;
      const drops = all.filter(k => {
        const a = available(k); if (!a.ok) return false;
        const t = TSMU.num(W.items[k].savedPrice, NaN);
        return Number.isFinite(t) && TSMU.num(a.pkg.pricePerK) < t;
      }).length;
      kp.innerHTML =
        '<div class="tsmu-wl-k"><div class="k-l">Saved packages</div><div class="k-v">' + all.length + '</div></div>' +
        '<div class="tsmu-wl-k"><div class="k-l">Price drops</div><div class="k-v" style="color:#10b981">' + drops + '</div></div>' +
        '<div class="tsmu-wl-k"><div class="k-l">Unavailable</div><div class="k-v" style="color:' + (gone ? '#ef4444' : 'inherit') + '">' + gone + '</div></div>';
