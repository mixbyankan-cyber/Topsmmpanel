    async function agreeToRules() {
      if (!currentUser || rulesAlreadyAgreed) return;
      rulesAlreadyAgreed = true; // set immediately so rapid double-triggers can't double-write
      try {
        await database.ref(`users/${currentUser.uid}/rulesAgreedAt`).set(Date.now());
