    function generateReferralCode(userId, userEmail) {
      if (!userEmail) {
        // Fallback if no email provided
        const userPart = userId.substring(0, 5).toUpperCase();
        const randomNum = Math.floor(100 + Math.random() * 900); // 3 digit number
        return `${userPart}${randomNum}`;
      }
      
      // Extract email local part (before @)
      const emailLocal = userEmail.split('@')[0];
      
      // Get first 5 characters from email, pad if needed
      let emailPart = emailLocal.substring(0, 5).toUpperCase();
      if (emailPart.length < 5) {
        emailPart = emailPart.padEnd(5, 'X'); // Pad with X if less than 5 chars
      }
      
      // Generate 3 random digits
      const randomNum = Math.floor(100 + Math.random() * 900); // 100-999
      
      return `${emailPart}${randomNum}`;
    }

