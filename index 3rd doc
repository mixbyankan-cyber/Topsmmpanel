    // Firebase Auth's `user.email` can sometimes be blank right after a
    // Google Sign-In (edge cases with provider linking / cached tokens),
    // even though the email is available on user.providerData. This helper
    // checks every possible source, in order of reliability, so email is
    // never blank anywhere in the app once it's known at all.
    // ══════════════════════════════════════════════════════════════════
    function getBestUserEmail(authUser, dbData) {
      if (authUser && authUser.email) return authUser.email;
      if (authUser && Array.isArray(authUser.providerData)) {
        const withEmail = authUser.providerData.find(p => p && p.email);
        if (withEmail) return withEmail.email;
      }
      if (dbData && dbData.email) return dbData.email;
      return '';
    }

    // ══════════════════════════════════════════════════════════════════
    // 🩹 SELF-HEALING PROFILE SYNC
    // Fixes accounts (mostly older Google Sign-In signups) where the
    // email/name field in the database is blank/missing even though
    // Firebase Auth actually has that data on the user's account.
    // Runs safely on every login — only fills in what's missing, never
    // overwrites data the user has already set.
    // ══════════════════════════════════════════════════════════════════
    async function syncUserProfileFromAuth(user) {
      if (!user) return;
      try {
        const userRef = database.ref(`users/${user.uid}`);
        const snapshot = await userRef.once('value');
        const data = snapshot.val() || {};

        const resolvedEmail = getBestUserEmail(user, data);

        const updates = {};
        if (!data.email && resolvedEmail) updates.email = resolvedEmail;
        if (!data.name && user.displayName) updates.name = user.displayName;
        if (!data.mobile && user.phoneNumber) updates.mobile = user.phoneNumber;
        if (!data.photoURL && user.photoURL) updates.photoURL = user.photoURL;
        // Detect Google sign-in from providerData so older Google accounts
        // get the correct "google" login method badge in the Admin Panel.
        if (!data.loginMethod && Array.isArray(user.providerData)) {
          if (user.providerData.some(p => p && p.providerId === 'google.com')) updates.loginMethod = 'google';
        }

        if (Object.keys(updates).length > 0) {
          await userRef.update(updates);
          // Keep registered_users mirror in sync too (used by Admin Panel's
          // welcome-email automation) so it never shows blank email either.
          await database.ref(`registered_users/${user.uid}`).update(updates).catch(() => {});
        }
        // 🪞 Always mirror the wallet into the lightweight registered_users
        // profile so the Admin user lists show a fresh balance/spent without
