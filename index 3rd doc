        if (typeof refreshTopBannerText === 'function') refreshTopBannerText();

        // Dashboard greeting card — LIVE
        const card = document.getElementById('idGreetingCard');
        if (card) {
          if (next === 'live') { RB.fillGreeting(); card.style.display = 'block'; }
          else if (!(window.IDT && IDT.isEnabled())) card.style.display = 'none';
        }

        // Hero + flip clock — COMING / ENDING
        const hero = document.getElementById('fctHero');
        if (hero) {
          if (next === 'coming' || next === 'ending') {
            RB.renderHero(next);
            hero.style.display = 'block';
          } else if (!(window.IDT && (IDT.phase === 'coming' || IDT.phase === 'ending'))) {
            hero.style.display = 'none';
          }
        }

        if (next === 'off') RB.closePopupIfOwner();
        else RB.maybeShowPopup();

        RB.updateClock(Date.now());
        if (window.IDT && IDT.attachTilt) IDT.attachTilt(document.getElementById('idPopupContainer'), 4);
      };

      if (withWipe && RB._initialized && window.IDT && IDT.wipe) {
        const w = document.getElementById('fctWipe');
        if (w) w.classList.add('rb');
        IDT.wipe(() => { try { run(); } finally { if (w) setTimeout(() => w.classList.remove('rb'), 1100); } });
      } else run();
    },

    fillGreeting() {
      const L = (RB.fest || {}).live || {};
      const set = (id, v) => { const el = document.getElementById(id); if (el && v) el.innerHTML = v; };
      set('idGreetingTitle', L.greetingTitle || RB._defaults.greetingTitle);
      set('idGreetingSub',   L.greetingSub   || RB._defaults.greetingSub);
      set('idGreetingOffer', L.offerText     || RB._defaults.offer);
    },

    renderHero(phase) {
      const hero = document.getElementById('fctHero');
      if (!hero) return;
      if (hero.dataset.phase === 'rb-' + phase && hero.dataset.built === '1') return;
      hero.dataset.phase = 'rb-' + phase;
      hero.dataset.built = '1';
      hero.classList.remove('fct-hero-comin', 'fct-hero-endin');
      hero.classList.add(phase === 'coming' ? 'fct-hero-comin' : 'fct-hero-endin');

      const f = RB.fest || {};
      const c = f.coming || {}, e = f.ending || {};
      const isComing = (phase === 'coming');
      const icon = isComing ? RB.rakhiSVG(100) : IDT.hourglassSVG(80);
      const headline = isComing ? (c.headline || RB._defaults.comingHeadline)
                                : (e.headline || RB._defaults.endingHeadline);
      const subline  = isComing ? (c.subline  || RB._defaults.comingSubline)
                                : (e.subline  || RB._defaults.endingSubline);
      const note = isComing ? "🎯 Scholars Sale goes LIVE on 5th September — Teacher's Day rewards for everyone!"
                            : "⚡ When the clock hits zero, every Teacher's Day bonus & offer ends!";

      let stars = '';
      if (isComing) {
        for (let i = 0; i < 16; i++) {
          const l = ((i * 61) % 94) + 3;
          const tp = ((i * 37) % 62) + 10;
          const sz = (i % 3) + 2;
          const dl = ((i % 7) * 0.35).toFixed(2);
          stars += '<span class="fct-star" style="left:' + l + '%; top:' + tp + '%; width:' + sz + 'px; height:' + sz + 'px; animation-delay:' + dl + 's;"></span>';
        }
      }

      const unit = (id, label) =>
        '<div class="fc-unit"><div class="fc-card" id="' + id + '" data-value="">' + IDT._fcCardHTML() + '</div><div class="fc-label">' + label + '</div></div>';

      hero.innerHTML =
        stars +
        '<div class="fct-hero-icon">' + icon + '</div>' +
        '<h2 class="fct-headline">' + headline + '</h2>' +
        '<p class="fct-subline">' + subline + '</p>' +
        '<div class="fc-row">' +
          unit('fcD', 'Days') + '<div class="fc-sep">:</div>' +
          unit('fcH', 'Hours') + '<div class="fc-sep">:</div>' +
          unit('fcM', 'Minutes') + '<div class="fc-sep">:</div>' +
          unit('fcS', 'Seconds') +
        '</div>' +
        '<div class="fct-target-note">' + note + '</div>';

      if (window.IDT && IDT.attachTilt) IDT.attachTilt(hero, 5);
      RB.updateClock(Date.now());
    },

    _parts(ms) {
      ms = Math.max(0, ms);
      const d = Math.floor(ms / 86400000); ms -= d * 86400000;
      const h = Math.floor(ms / 3600000);  ms -= h * 3600000;
      const m = Math.floor(ms / 60000);    ms -= m * 60000;
      const s = Math.floor(ms / 1000);
      return {
        d: String(d).padStart(2, '0'), h: String(h).padStart(2, '0'),
        m: String(m).padStart(2, '0'), s: String(s).padStart(2, '0')
      };
    },

    updateClock(now) {
      let target = null;
      if (RB.phase === 'coming') target = RB.liveAt();
      else if (RB.phase === 'ending') target = RB.hardEndAt();

      const hero = document.getElementById('fctHero');
      if (target && hero && hero.style.display !== 'none' && hero.dataset.phase && hero.dataset.phase.indexOf('rb-') === 0) {
        const t = RB._parts(target - now);
        [['fcD', t.d], ['fcH', t.h], ['fcM', t.m], ['fcS', t.s]].forEach(([id, v]) => {
          const card = document.getElementById(id);
          if (card) IDT.flipCard(card, v);
        });
      }

      // popup countdown chip (only while the RB popup is open)
      const pc = document.getElementById('fctPopCount');
      const overlay = document.getElementById('idPopupOverlay');
      if (pc && overlay && overlay.style.display === 'flex' && overlay.dataset.owner === 'rb' && RB._popCountTo && (RB.phase === 'coming' || RB.phase === 'ending')) {
        const t = RB._parts(RB._popCountTo - now);
        pc.textContent = (RB._popCountLabel || '⏳') + '   ' + t.d + 'd : ' + t.h + 'h : ' + t.m + 'm : ' + t.s + 's';
      }
    },

    maybeShowPopup() {
      const phase = RB.phase;
      if (phase !== 'coming' && phase !== 'live' && phase !== 'ending') return;
      if (RB.idtActive()) return;
      const f = RB.fest || {};
      const L = f.live || {}, c = f.coming || {}, e = f.ending || {};

      let cfg = null;
      if (phase === 'live') {
        if (L.showPopup === false || L.showPopup === 'false') return;
        cfg = { key: 'rb_pop_live', cls: '',
          title: L.popupTitle || RB._defaults.popupTitle,
          subtitle: L.popupSubtitle || RB._defaults.popupSubtitle,
          offer: L.offerText || RB._defaults.offer,
          poster: resolveCampaignImage(L, RB._defaults.poster),
          icon: RB.rakhiSVG(58), iconColor: '#b91c1c' };
      } else if (phase === 'coming') {
        if (c.showPopup === false || c.showPopup === 'false') return;
        cfg = { key: 'rb_pop_coming', cls: 'rb-phase-coming',
          title: c.popupTitle || RB._defaults.comingTitle,
          subtitle: c.popupSub || RB._defaults.comingSub,
          offer: c.popupText || RB._defaults.comingOffer,
          poster: resolveCampaignImage(c, RB._defaults.comingPoster),
          icon: RB.rakhiSVG(56), iconColor: '#dc2626',
          countTo: RB.liveAt(), countLabel: '🧵 LIVE IN' };
      } else {
        if (e.showPopup === false || e.showPopup === 'false') return;
        cfg = { key: 'rb_pop_ending', cls: 'rb-phase-ending',
          title: e.popupTitle || RB._defaults.endingTitle,
          subtitle: e.popupSub || RB._defaults.endingSub,
          offer: e.popupText || RB._defaults.endingOffer,
          poster: resolveCampaignImage(e, RB._defaults.endingPoster),
          icon: IDT.hourglassSVG(52), iconColor: '#ffd166',
          countTo: RB.hardEndAt(), countLabel: '🔥 ENDS IN' };
      }

      let today;
      try {
        // day + content signature — if the admin edits the popup title or
        // poster, users see the fresh popup again even the same day (v8)
        today = festivalPopupSignature(cfg.key, cfg, ((RB.fest || {}).saveNonce || (RB.fest || {}).updatedAt));
        if (localStorage.getItem(cfg.key) === today) return;
      } catch (err) { return; }

      const overlay = document.getElementById('idPopupOverlay');
      if (!overlay) return;

      const box = document.getElementById('idPopupContainer');
      if (box) {
        box.classList.remove('fct-phase-coming', 'fct-phase-ending', 'rb-phase-coming', 'rb-phase-ending');
        if (cfg.cls) box.classList.add(cfg.cls);
      }

      const setText = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      const setHTML = (id, v) => { const el = document.getElementById(id); if (el) el.innerHTML = v; };
      setText('idPopupTitle',    cfg.title);
      setHTML('idPopupSubtitle', cfg.subtitle);
      setHTML('idPopupOffer',    cfg.offer);

      const pslot = document.getElementById('idPopupChakra');
      if (pslot) {
        pslot.innerHTML = cfg.icon;
        pslot.style.color = cfg.iconColor;
        pslot.style.display = 'flex';
        pslot.style.justifyContent = 'center';
      }

      const img = document.getElementById('idPosterImg');
      if (img) {
        if(cfg.poster){img.style.display='block';img.onerror=()=>{img.style.display='none';};if(img.getAttribute('src')!==cfg.poster)img.src=cfg.poster;}
        else{img.removeAttribute('src');img.style.display='none';}
      }

      // countdown chip driven by RB's own clock (silence IDT's writer)
      if (window.IDT) IDT._popCountTo = null;
      RB._popCountTo = cfg.countTo || null;
      RB._popCountLabel = cfg.countLabel || '';
      const pc = document.getElementById('fctPopCount');
      if (pc) pc.style.display = cfg.countTo ? 'block' : 'none';

      overlay.dataset.owner = 'rb';
      overlay.style.display = 'flex';
      try { localStorage.setItem(cfg.key, today); } catch (err2) {}
    },

    maybeConfetti() {
      if (!RB.isEnabled()) return;
      let today;
      try {
        today = new Date().toDateString();
        if (localStorage.getItem('rb_confetti_day') === today) return;
        localStorage.setItem('rb_confetti_day', today);
      } catch (e) { return; }
      RB.fireConfetti(3600);
    },

    fireConfetti(durationMs) {
      if (document.getElementById('idConfettiCanvas') || document.getElementById('rbConfettiCanvas')) return;
      const canvas = document.createElement('canvas');
      canvas.id = 'rbConfettiCanvas';
      canvas.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:10001;';
      document.body.appendChild(canvas);
      const ctx = canvas.getContext('2d');
      const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
      resize();
      window.addEventListener('resize', resize);

      const colors = ['#dc2626', '#f59e0b', '#fcd34d', '#fff7d6', '#fb7185', '#b45309'];
      const parts = [];
      const N = Math.min(170, Math.max(70, Math.floor(window.innerWidth / 5)));
      for (let i = 0; i < N; i++) {
        parts.push({
          x: Math.random() * canvas.width,
          y: -20 - Math.random() * canvas.height * 0.35,
          w: 6 + Math.random() * 6,
          h: 8 + Math.random() * 8,
          vx: -1 + Math.random() * 2,
          vy: 2 + Math.random() * 3.2,
          rot: Math.random() * Math.PI,
          vr: -0.12 + Math.random() * 0.24,
          color: colors[(Math.random() * colors.length) | 0],
          sway: Math.random() * Math.PI * 2
        });
      }
      const start = Date.now();
      (function loop() {
        const elapsed = Date.now() - start;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const fade = elapsed > durationMs ? Math.max(0, 1 - (elapsed - durationMs) / 800) : 1;
        parts.forEach(p => {
          p.sway += 0.05;
          p.x += p.vx + Math.sin(p.sway) * 0.7;
          p.y += p.vy;
          p.rot += p.vr;
          if (p.y > canvas.height + 30) { p.y = -20; p.x = Math.random() * canvas.width; }
          ctx.save();
          ctx.globalAlpha = fade;
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });
        if (elapsed < durationMs + 850) {
          requestAnimationFrame(loop);
        } else {
          window.removeEventListener('resize', resize);
          canvas.remove();
        }
      })();
    },

    // 🧵 Hand-drawn rakhi medallion with mauli threads (inline SVG)
    rakhiSVG(size) {
      const s = size || 64;
      return '<svg viewBox="0 0 130 66" width="' + s + '" height="' + Math.round(s * 0.51) + '" xmlns="http://www.w3.org/2000/svg">'
        + '<path d="M0 30 C 16 24, 30 26, 46 31" stroke="#b91c1c" stroke-width="6" fill="none" stroke-linecap="round"/>'
        + '<path d="M84 31 C 100 26, 114 24, 130 30" stroke="#b91c1c" stroke-width="6" fill="none" stroke-linecap="round"/>'
        + '<path d="M0 37 C 16 31, 30 33, 46 36" stroke="#fbbf24" stroke-width="2" fill="none" stroke-linecap="round"/>'
        + '<path d="M84 36 C 100 33, 114 31, 130 37" stroke="#fbbf24" stroke-width="2" fill="none" stroke-linecap="round"/>'
        + '<circle cx="65" cy="33" r="21" fill="#f59e0b" stroke="#7f1d1d" stroke-width="2"/>'
        + '<circle cx="65" cy="33" r="13.5" fill="#b91c1c"/>'
        + '<g fill="#fbbf24"><circle cx="65" cy="20.5" r="2.2"/><circle cx="65" cy="45.5" r="2.2"/><circle cx="52.5" cy="33" r="2.2"/><circle cx="77.5" cy="33" r="2.2"/><circle cx="56.2" cy="24.2" r="1.9"/><circle cx="73.8" cy="24.2" r="1.9"/><circle cx="56.2" cy="41.8" r="1.9"/><circle cx="73.8" cy="41.8" r="1.9"/></g>'
        + '<circle cx="65" cy="33" r="6" fill="#fff7d6"/>'
        + '<circle cx="63.2" cy="31.2" r="2" fill="#ffffff" opacity=".85"/>'
        + '</svg>';
    }
  };
  window.RB = RB;
  RB.init();

  // ══════════════════════════════════════════════════════════════════════
  // 🔄 FESTIVAL LIVE-SYNC (v8) — admin change ⇒ every user screen, INSTANT.
  // Channel 1: admin saves write settings/festivalPing ⇒ we re-pull all
  //   three festival nodes and re-apply immediately (sub-second).
  // Channel 2: whenever the tab regains focus we refresh too, so a user
  //   coming back to the site always sees the admin's latest state.
  // Channel 3: a light 45-second safety poll (signature deduped — it only
  //   re-renders when something ACTUALLY changed, so no visual resets).
  // ══════════════════════════════════════════════════════════════════════
  (function festivalLiveSync() {
    let _pingT = null, _lastSig = null;
    async function _festRefreshAll(why) {
      try {
        const [f, r, it, td] = await Promise.all([
          database.ref('settings/festival').once('value'),
          database.ref('settings/festivalRakhi').once('value'),
          database.ref('settings/independenceTheme').once('value'),
          database.ref('settings/festivalTeachers').once('value')
        ]);
        const sig = JSON.stringify(f.val()) + '|' + JSON.stringify(r.val()) + '|' + JSON.stringify(it.val()) + '|' + JSON.stringify(td.val());
        if (sig === _lastSig) return;            // nothing new — zero redraw
        _lastSig = sig;
        if (window.IDT) { IDT.settings = it.val() || {}; IDT.fest = f.val() || {}; }
        if (window.RB)  { RB.fest = r.val() || {}; }
        if (window.TD)  { TD.fest = td.val() || {}; }
        requestFestivalCampaignRender('festival safety sync: ' + why);
        if (typeof restyleBannerMarquee === 'function') setTimeout(restyleBannerMarquee, 150);
        console.log('🎆🧵🎓 festival live-sync (' + why + ') ⇒ IDT=' + (window.IDT ? IDT.phase : '?') + ' · RB=' + (window.RB ? RB.phase : '?') + ' · TD=' + (window.TD ? TD.phase : '?'));
      } catch (e) { /* transient — live listeners keep us fresh anyway */ }
    }
    try {
      database.ref('settings/festivalPing').on('value', () => {
        clearTimeout(_pingT);
        _pingT = setTimeout(() => _festRefreshAll('admin ping'), 300);
      });
    } catch (e) {}
    // 🔔 Direct live listeners on every festival node — the moment the admin saves,
    // this screen reflects it instantly (no dependency on the ping node).
    ['festival', 'festivalRakhi', 'festivalTeachers'].forEach(function (node) {
      try {
        database.ref('settings/' + node).on('value', function () {
          clearTimeout(_pingT);
          _pingT = setTimeout(function () { _festRefreshAll('live node: ' + node); }, 250);
        });
      } catch (e) {}
    });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) _festRefreshAll('tab focus');
    });
    setInterval(() => _festRefreshAll('safety poll'), 45000);
    window._festRefreshAll = _festRefreshAll;
  })();
  </script>

