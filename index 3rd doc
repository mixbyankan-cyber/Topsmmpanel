  const st = document.createElement('style'); st.textContent = CSS; document.head.appendChild(st);

  /* ═════════ 1. QUANTITY RULES ═════════ */
  /** Single source of truth, also called from the patched placeNewOrder. */
  TSMU.checkQuantity = function (qty, pkg) {
    pkg = pkg || {};
    const min = TSMU.num(pkg.min), max = TSMU.num(pkg.max), step = TSMU.num(pkg.qtyStep);
    const q = Number(qty);
    if (!Number.isFinite(q)) return { ok: false, message: 'Please enter a valid quantity.' };
    if (q <= 0 && min > 0) return { ok: false, message: 'Quantity must be at least ' + TSMU.int(min) + '.' };
    if (min === max && min > 0 && q !== min)
      return { ok: false, message: 'This is a fixed-quantity package. The quantity must be exactly ' + TSMU.int(min) + '.' };
    if (q < min) return { ok: false, message: 'Minimum quantity for this package is ' + TSMU.int(min) + '. You entered ' + TSMU.int(q) + '.' };
    if (max > 0 && q > max) return { ok: false, message: 'Maximum quantity for this package is ' + TSMU.int(max) + '. You entered ' + TSMU.int(q) + '.' };
    if (step > 0 && q % step !== 0) {
      const lo = Math.max(min, Math.floor(q / step) * step), hi = Math.min(max || Infinity, Math.ceil(q / step) * step);
      return {
        ok: false,
        message: 'Quantity must be a multiple of ' + TSMU.int(step) + '. Try ' + TSMU.int(lo) +
          (hi !== lo && Number.isFinite(hi) ? ' or ' + TSMU.int(hi) : '') + '.'
      };
    }
    return { ok: true };
  };

  function qtyFeedback() {
    const inp = document.getElementById('orderQuantity'); if (!inp) return;
    let box = document.getElementById('tsmuQtyMsg');
    if (!box) { box = document.createElement('div'); box.id = 'tsmuQtyMsg'; box.className = 'tsmu-qerr'; inp.parentNode.appendChild(box); }
    const pkg = TSMU.G('selectedPackageData') || {};
    if (!pkg.min && !pkg.max) { box.className = 'tsmu-qerr'; return; }
    const raw = inp.value;
    if (raw === '') { box.className = 'tsmu-qerr'; return; }
    const r = TSMU.checkQuantity(N(raw), pkg);
    box.className = 'tsmu-qerr ' + (r.ok ? 'ok' : 'bad');
    box.textContent = r.ok ? '✓ Quantity accepted' : r.message;
  }

  /** 1 234 -> "1.2K", 1 000 000 -> "1M", 8 576 784 858 -> "8.58B" */
  function shortQty(v) {
    v = Math.round(Number(v) || 0);
    const f = (n, s) => {
      const x = v / n;
      const t = x >= 100 ? Math.round(x) : Math.round(x * 100) / 100;
      return String(t).replace(/\.0+$/, '') + s;
    };
    if (Math.abs(v) >= 1e9) return f(1e9, 'B');
    if (Math.abs(v) >= 1e6) return f(1e6, 'M');
    if (Math.abs(v) >= 1e3) return f(1e3, 'K');
    return String(v);
  }
  TSMU.shortQty = shortQty;

  function qtyChips() {
    const inp = document.getElementById('orderQuantity'); if (!inp) return;
    let box = document.getElementById('tsmuQtyChips');
    if (!box) { box = document.createElement('div'); box.id = 'tsmuQtyChips'; box.className = 'tsmu-qc'; inp.parentNode.insertBefore(box, inp.nextSibling); }
    const p = TSMU.G('selectedPackageData') || {};
    const min = TSMU.num(p.min), max = TSMU.num(p.max), step = TSMU.num(p.qtyStep);
    if (!min && !max) { box.innerHTML = ''; return; }

    const snap = v => {
      v = Math.min(max || v, Math.max(min, Math.round(v)));
      if (step > 0) { v = Math.round(v / step) * step; if (v < min) v = Math.ceil(min / step) * step; if (max && v > max) v = Math.floor(max / step) * step; }
      return v;
    };
    const set = v => { inp.value = v; inp.dispatchEvent(new Event('input', { bubbles: true })); try { calculateTotal(); } catch (e) { } qtyFeedback(); };
    window.__tsmuSetQty = set;
    window.__tsmuStepQty = d => { const cur = TSMU.num(inp.value) || min; set(snap(cur + d * step)); };

    const chip = (label, value, cls) =>
      '<button type="button" class="' + (cls || '') + '" title="' + esc(TSMU.int(value)) + '" onclick="__tsmuSetQty(' + value + ')">' + esc(label) + '</button>';

    if (min === max && min > 0) { box.innerHTML = chip('Fixed ' + shortQty(min), min, 'k'); return; }

    /* The ladder a real SMM panel shows: the quantities people actually buy.
       1K · 10K · 50K · 100K · 500K · 1M · 5M · 10M …                         */
    const PREF = [1e3, 1e4, 5e4, 1e5, 5e5, 1e6];              // what people really order
    const BIG = [5e6, 1e7, 5e7, 1e8, 5e8, 1e9];               // only when the range is huge
    const seen = {};
    const add = (arr, v) => { const sv = snap(v); if (sv > min && sv < max && !seen[sv]) { seen[sv] = 1; arr.push(sv); } };
    let mids = [];
    PREF.forEach(v => add(mids, v));
    if (mids.length < 3) BIG.forEach(v => add(mids, v));

    /* a short range (for example 100 – 10 000) gets its own rounded ladder */
    if (mids.length < 3) {
      const nice = v => {
        if (v <= 0) return v;
        const e = Math.pow(10, Math.floor(Math.log10(v)));
        const n = v / e;
        return Math.round((n < 1.5 ? 1 : n < 3.5 ? 2 : n < 7.5 ? 5 : 10) * e);
      };
      mids = [];
      [0.2, 0.4, 0.6, 0.8].forEach(f => add(mids, nice(min + (max - min) * f)));
    }
    mids.sort((a, b) => a - b);

    /* keep it clean: never more than 6 middle chips, evenly spread */
    if (mids.length > 6) {
      const picked = [];
      const gap = (mids.length - 1) / 5;
      for (let k = 0; k < 6; k++) picked.push(mids[Math.round(k * gap)]);
      mids = picked.filter((v, k, arr) => arr.indexOf(v) === k);
    }
    const picked = mids;

    let html = chip('Min ' + shortQty(min), min, 'k');
    picked.forEach(v => { html += chip(shortQty(v), v); });
    html += chip('Max ' + shortQty(max), max, 'k');
    if (step > 0) html += '<button type="button" class="s" onclick="__tsmuStepQty(-1)">−' + shortQty(step) + '</button>' +
      '<button type="button" class="s" onclick="__tsmuStepQty(1)">+' + shortQty(step) + '</button>';
    box.innerHTML = html;
  }

  wrap('updateNewOrderMinMax', o => function (min, max) {
    const r = o.apply(this, arguments);
    const el = document.getElementById('minMaxInfo');
    const p = TSMU.G('selectedPackageData') || {};
