    // Change Password
    async function changePassword(event) {
      event.preventDefault();
      
      if (!currentUser) {
        playSound('error');
        return showToast('Please login first!', 'error');
      }
      if (!ensureFeatureAllowed('profileUpdate', 'Password Change')) return;

      const oldPassword = document.getElementById('oldPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (!oldPassword || !newPassword || !confirmPassword) {
        playSound('error');
        return showToast('Please fill all fields!', 'error');
      }

      if (newPassword.length < 6) {
        playSound('error');
        return showToast('New password must be at least 6 characters!', 'error');
      }

      if (newPassword !== confirmPassword) {
        playSound('error');
        return showToast('New passwords do not match!', 'error');
      }

      try {
        const credential = firebase.auth.EmailAuthProvider.credential(
          auth.currentUser.email,
          oldPassword
        );
        await auth.currentUser.reauthenticateWithCredential(credential);
        await auth.currentUser.updatePassword(newPassword);
        
        // 🔔 Send Password Update Notification
        sendProfileUpdateNotification(currentUser.uid, 'password');
        
        playSound('success');
        showToast('Password changed successfully! 🔐', 'success');
        document.getElementById('passwordChangeForm').reset();
      } catch (error) {
        playSound('error');
        if (error.code === 'auth/wrong-password') {
          showToast('Old password is incorrect!', 'error');
        } else {
          showToast('Failed to change password. Try again!', 'error');
        }
      }
    }

