    // Active history stays live; read-only archive history is fetched securely
    // through the Worker and merged without copying it into the new project.
    let ownPendingOrdersCache=[];
    function configureOwnAutoProcessing(uid,orders){
      ownPendingOrdersCache=(orders||[]).filter(o=>o.status==='pending'&&o.autoProcessingEnabled===true&&Number(o.autoProcessingAt)>0);
      if(window._ownAutoProcessingTimer)return;
      window._ownAutoProcessingTimer=setInterval(()=>processOwnDueOrders(uid),1000);processOwnDueOrders(uid);
    }
    async function processOwnDueOrders(uid){
      const due=ownPendingOrdersCache.filter(o=>o.status==='pending'&&Number(o.autoProcessingAt)<=Date.now());
      for(const o of due){try{let won=false;const tx=await database.ref(`users/${uid}/orders/${o.id}/status`).transaction(s=>{if(s!=='pending')return;won=true;return'processing';});if(tx.committed&&won){o.status='processing';await database.ref(`orders_index/${o.id}`).update({status:'processing',processingAt:firebase.database.ServerValue.TIMESTAMP,autoProcessed:true});if(o.batchId)await database.ref(`adminPanel/massOrders/${o.batchId}/items/${o.id}`).update({status:'processing',processingAt:Date.now()});database.ref('stats/orderStatusCounts/pending').transaction(v=>Math.max(0,(Number(v)||0)-1)).catch(()=>{});database.ref('stats/orderStatusCounts/processing').transaction(v=>(Number(v)||0)+1).catch(()=>{});}}catch(e){console.warn('Own auto-processing:',e.message);}}
    }

    let archiveOrdersCache = [];
    let archiveFundsCache = [];
    async function loadArchiveHistory(type) {
      if (!window.TSMRuntime.archives.length) return [];
      try { const r = await callFreeBackend('getArchiveHistory', { type }); return r.records || []; }
      catch (e) { console.warn('Archive '+type+' unavailable:', e.message); return []; }
    }
    function loadUserOrders(uid) {
      loadArchiveHistory('orders').then(rows => { archiveOrdersCache = rows; if (window._activeOrdersCache) displayOrders([...window._activeOrdersCache, ...archiveOrdersCache].sort((a,b)=>(b.createdAt||0)-(a.createdAt||0))); });
      sessionOn(database.ref(`users/${uid}/orders`), 'value', snapshot => {
        const orders = snapshot.val() || {};
        window._activeOrdersCache = Object.entries(orders).map(([key, value]) => ({ id:key, ...value, _archived:false }));
        configureOwnAutoProcessing(uid,window._activeOrdersCache);
        displayOrders([...window._activeOrdersCache, ...archiveOrdersCache].sort((a,b)=>(b.createdAt||0)-(a.createdAt||0)));
      });
    }

    // ══════════════════════════════════════════════════════════════════
    // ✅ BULK ORDER-ID SELECTION (checkboxes + "Copy Order ID(s)")
    // Lets a user tick multiple orders and copy all their IDs at once,
    // e.g. to paste into a support chat: "order1, order2, order3"
    // ══════════════════════════════════════════════════════════════════
    let selectedOrderIds = new Set();

    function updateOrderBulkBar() {
      const bar = document.getElementById('orderBulkBar');
      const countEl = document.getElementById('orderBulkCount');
      if (!bar || !countEl) return;

      if (selectedOrderIds.size > 0) {
        bar.classList.add('active');
        countEl.textContent = `${selectedOrderIds.size} selected`;
      } else {
        bar.classList.remove('active');
      }
    }

    function toggleOrderSelection(orderId, checkboxEl) {
      if (checkboxEl.checked) {
        selectedOrderIds.add(orderId);
      } else {
        selectedOrderIds.delete(orderId);
        const selectAllBox = document.getElementById('orderSelectAllBox');
        if (selectAllBox) selectAllBox.checked = false;
      }
      updateOrderBulkBar();
    }

    function toggleSelectAllOrders(selectAllBox) {
      const checkboxes = document.querySelectorAll('#ordersContainer .order-select-checkbox[data-order-id]');
      checkboxes.forEach(cb => {
        cb.checked = selectAllBox.checked;
        if (selectAllBox.checked) {
          selectedOrderIds.add(cb.getAttribute('data-order-id'));
        } else {
          selectedOrderIds.delete(cb.getAttribute('data-order-id'));
        }
      });
      updateOrderBulkBar();
    }

    function clearOrderSelection() {
      selectedOrderIds.clear();
      document.querySelectorAll('#ordersContainer .order-select-checkbox').forEach(cb => cb.checked = false);
      updateOrderBulkBar();
    }

    // Copy all selected Order IDs as a comma-separated list, e.g. "195645, 208831, 349102"
    function copySelectedOrderIds() {
      if (selectedOrderIds.size === 0) {
        return showToast('Please select at least one order first!', 'error');
      }
      const idsText = Array.from(selectedOrderIds).join(', ');
      navigator.clipboard.writeText(idsText).then(() => {
        playSound('success');
        showToast(`✅ Copied ${selectedOrderIds.size} Order ID(s) to clipboard!`, 'success');
      }).catch(() => {
        fallbackCopyText(idsText);
        showToast(`✅ Copied ${selectedOrderIds.size} Order ID(s)!`, 'success');
      });
    }

    // Display Orders
    // Track current search text + status filter so both can combine together
    let currentOrderSearchTerm = '';
    let currentRefillSearchTerm = '';

    function displayOrders(orders, filter = 'all') {
      const container = document.getElementById('ordersContainer');

      // Cache for instant re-render on currency switch
      window._lastOrdersArray = orders;
      window._lastOrdersFilter = filter;

      // 🔄 Keep the Refill page in sync too, whichever of its own tabs is active
      if (document.getElementById('refillOrdersContainer')) {
        const refillActiveTab = document.querySelector('#refillPage .order-tab.active');
        displayRefillOrders(orders, refillActiveTab ? refillActiveTab.getAttribute('data-tab') : 'all');
      }

      let filteredOrders = filter === 'all' 
        ? orders 
        : orders.filter(o => o.status === filter);

      // 🔍 Apply search (Order ID or Link) on top of the status filter
      if (currentOrderSearchTerm) {
        const term = currentOrderSearchTerm.toLowerCase();
        filteredOrders = filteredOrders.filter(o => {
          const shortId = formatShortId(o, 'orderNumber').toLowerCase();
          const link = (o.link || '').toLowerCase();
          return shortId.includes(term) || link.includes(term);
        });
      }

      // Reset selection whenever the list is re-rendered (filter change, refresh, etc.)
      selectedOrderIds.clear();

      if (filteredOrders.length === 0) {
        const noResultsFromSearch = currentOrderSearchTerm && orders.length > 0;
        container.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon">${noResultsFromSearch ? '🔍' : '📦'}</div>
