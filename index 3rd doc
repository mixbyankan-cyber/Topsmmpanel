    function resolveCampaignImage(cfg, legacyDefault){
      cfg=cfg||{};
      if(cfg.posterConfigured===true)return validImageSource(cfg.posterUrl)||validImageSource(cfg.posterFile)||null;
      return validImageSource(cfg.posterUrl)||validImageSource(cfg.posterFile)||legacyDefault||null;
