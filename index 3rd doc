  function openSheet(title, brand, rows, total, ref) {
    let m = document.getElementById('tsmuInvoice');
    if (!m) {
      m = document.createElement('div'); m.id = 'tsmuInvoice';
      m.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,.65);z-index:99993;display:flex;align-items:center;justify-content:center;padding:16px;overflow-y:auto';
      m.onclick = e => { if (e.target === m) m.style.display = 'none'; };
      document.body.appendChild(m);
