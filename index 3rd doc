    // Convert a non-INR amount to INR using the admin-set currency rate
    // Convert a payment-method amount to INR using THAT METHOD's own admin-set
    // exchange rate (settings/paymentMethods/{id}/exchangeRateToINR) — this is
    // completely independent from the site-wide "Currency Settings" display
    // rates, so there is never any ambiguity about which rate is being used
    // for actual wallet crediting.
    function convertToINR(amount, method) {
      const numAmount = parseFloat(amount) || 0;
      if (!method || method.currencyCode === 'INR') return numAmount;
      const rate = parseFloat(method.exchangeRateToINR);
      if (!rate || rate <= 0) {
        console.warn(`⚠️ No valid exchange rate set for ${method.currencyCode} on method "${method.name}" — admin must set one in Payment Methods.`);
        return numAmount; // safe fallback: never silently multiply by a wrong/guessed rate
      }
      return numAmount * rate;
    }

    // ══════════════════════════════════════════════════════════════════
    // 🎁 BONUS TIER SYSTEM — Admin sets tiers per payment method, e.g.
    // "Amount ≥ 500 → 5% Bonus", "Amount ≥ 1000 → 7% Bonus", etc, in that
    // method's OWN currency. The user always gets the HIGHEST tier they
    // qualify for (never stacked). Works identically for Auto-Approve AND
    // Manual-Approval methods — for Manual, the bonus is credited at the
    // moment Admin approves the request (see Admin Panel logic).
    // ══════════════════════════════════════════════════════════════════
    function getBonusForAmount(method, originalAmount) {
      if (!method || !method.bonusEnabled || !Array.isArray(method.bonusTiers) || method.bonusTiers.length === 0) {
        return { percent: 0, tier: null };
      }
      const amt = parseFloat(originalAmount) || 0;
      // Pick the tier with the HIGHEST minAmount that the amount still qualifies for
      let bestTier = null;
      method.bonusTiers.forEach(t => {
        const min = parseFloat(t.minAmount) || 0;
        const pct = parseFloat(t.percent) || 0;
        if (amt >= min && pct > 0) {
          if (!bestTier || min > bestTier.minAmount) {
            bestTier = { minAmount: min, percent: pct };
          }
        }
      });
      return { percent: bestTier ? bestTier.percent : 0, tier: bestTier };
    }

    // Live "≈ ₹X.XX" preview while typing amount for the active payment method
    // Live "you'll get ₹X.XX" preview while typing the amount for the active
    // payment method. Uses ONLY that method's own admin-set exchange rate —
    // simple, unambiguous, and always matches what actually gets credited.
    // Also shows a full Base + Bonus = Total breakdown whenever this method
    // has an active Bonus Tier the entered amount qualifies for.
    function updateDynamicCurrencyPreview(methodId) {
      const method = paymentMethodsCache.find(m => m.id === methodId);
      const input = document.getElementById('dynamicFundAmount');
      const preview = document.getElementById('dynamicCurrencyPreview');
      if (!method || !input || !preview) return;

      const val = parseFloat(input.value);
      if (!val || val <= 0) {
        preview.style.display = 'none';
        return;
      }

      const baseINR = convertToINR(val, method);
      const bonus = getBonusForAmount(method, val);
      const bonusINR = bonus.percent > 0 ? (baseINR * bonus.percent / 100) : 0;
      const totalINR = baseINR + bonusINR;

      const symbol = method.currencySymbol || '';

      if (bonus.percent > 0) {
        preview.style.display = 'block';
        preview.innerHTML = `
          <div style="line-height: 1.6;">
            <div>💰 Base Amount: <strong>₹${baseINR.toFixed(2)}</strong></div>
            <div>🎁 Bonus (${bonus.percent}% for ${symbol}${bonus.tier.minAmount}+): <strong style="color:#db2777;">+ ₹${bonusINR.toFixed(2)}</strong></div>
            <div style="margin-top: 4px; padding-top: 4px; border-top: 1px dashed rgba(255,255,255,0.15);">✅ Total You Will Receive: <strong style="color:#22c55e; font-size: 15px;">₹${totalINR.toFixed(2)}</strong></div>
          </div>
        `;
        return;
      }

      if (method.currencyCode === 'INR') {
        // Same currency as the wallet, no bonus qualifies — nothing extra to show
        preview.style.display = 'none';
        return;
      }

      preview.style.display = 'block';
      preview.innerHTML = `✅ You will receive <strong>₹${totalINR.toFixed(2)}</strong> in your wallet`;
    }


    // Submit Fund Request for ANY payment method (UPI, Binance, or any future method)
    // AUTO APPROVE VERSION — mirrors original UPI flow, but fully dynamic.
    async function submitDynamicFundRequest(event, methodId) {
      event.preventDefault();

      if (!currentUser) {
        playSound('error');
        return showToast('Please login first!', 'error');
      }
      if (!ensureFeatureAllowed('addFund', 'Adding Funds')) return;

      const method = paymentMethodsCache.find(m => m.id === methodId);
      if (!method) {
        return showToast('Invalid payment method. Please refresh and try again.', 'error');
      }

      const transactionId = document.getElementById('dynamicTxnId').value.trim();
      const enteredAmount = parseFloat(document.getElementById('dynamicFundAmount').value);
      const currencyCode = method.currencyCode || 'INR';
      const txnMinLength = method.txnMinLength || 6;
      const minAmount = method.minAmount || 1;

      if (!transactionId || transactionId.length < txnMinLength) {
        playSound('error');
        return showToast(`Please enter a valid ${method.txnLabel || 'transaction ID'}!`, 'error');
      }

      if (!enteredAmount || enteredAmount < minAmount) {
        playSound('error');
        return showToast(`Minimum fund amount is ${method.currencySymbol || ''}${minAmount}`, 'error');
      }

      // ⚡ INSTANT FEEDBACK: lock the submit button immediately so a fast double-click
      // can never create two requests with the same UTR, and the user sees the
      // request is being processed right away instead of a long silent wait.
      const formEl = document.getElementById('dynamicFundForm');
      const submitBtn = formEl.querySelector('button[type="submit"]');
      const originalBtnHTML = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '⏳ Submitting...';
      }

      // Actual wallet-credit amount is always converted to ₹ (INR) using THIS
      // method's own admin-set exchange rate (never the display-currency rates).
      // If this method has an active Bonus Tier that the entered amount
      // qualifies for, the bonus is added on top — this happens for BOTH
      // Auto-Approve (credited instantly) and Manual-Approval (credited the
      // moment Admin approves the request) methods.
      const baseAmountINR = convertToINR(enteredAmount, method);
      const bonusInfo = getBonusForAmount(method, enteredAmount);
      const bonusAmountINR = bonusInfo.percent > 0 ? (baseAmountINR * bonusInfo.percent / 100) : 0;
      const amountINR = baseAmountINR + bonusAmountINR;

      try {
        // ⚡ SPEED: run every independent read in PARALLEL (instead of one-by-one)
        // — duplicate-ID checks, short-ID generation, and balance lookup all
        // happen at the same time, cutting total wait time dramatically.
        const [userRequestsSnapshot,requestNumber,balanceSnapshot] = await Promise.all([
          database.ref(`users/${currentUser.uid}/fundRequests`).orderByChild('transactionId').equalTo(transactionId).once('value'),
          generateUniqueFundRequestId(),
          database.ref(`users/${currentUser.uid}/balance`).once('value')
        ]);

        // ✅ CHECK FOR DUPLICATE TRANSACTION ID (same checks for every payment method)
        if (userRequestsSnapshot.exists()) {
          playSound('error');
          showToast('⚠️ This transaction ID has already been used! Please use a different transaction ID.', 'error');
          return;
        }

        // 💳 Whether this method auto-approves or requires manual admin review
        // (set per payment-method by Admin in the Payment Methods page)
        let isAutoApprove = method.approvalMode === 'auto'; // Admin controls this independently per payment method
        const autoDelayMs = (window.TSMU && TSMU.autoApproveDelayMs) ? TSMU.autoApproveDelayMs(method) : 0;
        const autoLater = isAutoApprove && autoDelayMs > 0;
        if (autoLater) isAutoApprove = false;   // credited automatically after the admin-set wait
        const requestStatus = isAutoApprove ? 'approved' : 'pending';
        const nowTs = Date.now();
        let newBalance = Number(balanceSnapshot.val()) || 0;

        // Atomic global UTR reservation prevents two users/tabs from using
        // the same transaction ID at the same moment.
        const utrKey = btoa(unescape(encodeURIComponent(transactionId.toLowerCase()))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
        let utrWon=false;
        const utrTx=await database.ref(`transaction_id_index/${utrKey}`).transaction(v=>{if(v)return;utrWon=true;return{uid:currentUser.uid,at:nowTs};});
        if(!utrTx.committed||!utrWon){showToast('⚠️ This transaction ID has already been used!','error');return;}

        const requestRef = database.ref(`users/${currentUser.uid}/fundRequests`).push();
        const adminRequestRef = database.ref('adminPanel/fundRequests').push();

        const requestData = {
          requestNumber: requestNumber,
          transactionId: transactionId,
          amount: amountINR,
          baseAmount: baseAmountINR,
          bonusAmount: bonusAmountINR,
          bonusPercent: bonusInfo.percent || 0,
          originalAmount: enteredAmount,
          originalCurrency: currencyCode,
          method: method.name,
          methodId: method.id,
          status: requestStatus,
          createdAt: nowTs
        };
        if (isAutoApprove) {
          requestData.approvedAt = nowTs;
          requestData.balanceCredited = true; // used later to know if a reject should deduct balance
        } else {
          requestData.balanceCredited = false;
        }
        if (autoLater) {
          requestData.autoApprove = true;
          requestData.autoApproveAt = nowTs + autoDelayMs;
          requestData.autoApproveDelayMs = autoDelayMs;
          requestData.adminKey = adminRequestRef.key;
        }

        const adminRequestData = {
          requestNumber: requestNumber,
          userId: currentUser.uid,
          userEmail: getBestUserEmail(auth.currentUser, null),
          userName: auth.currentUser.displayName || 'User',
          transactionId: transactionId,
          amount: amountINR,
          baseAmount: baseAmountINR,
          bonusAmount: bonusAmountINR,
          bonusPercent: bonusInfo.percent || 0,
          originalAmount: enteredAmount,
          originalCurrency: currencyCode,
          method: method.name,
          methodId: method.id,
          status: requestStatus,
          createdAt: nowTs,
          requestKey: requestRef.key
        };
        if (isAutoApprove) adminRequestData.approvedAt = nowTs;
        if (autoLater) { adminRequestData.autoApprove = true; adminRequestData.autoApproveAt = nowTs + autoDelayMs; adminRequestData.requestKey = requestRef.key; }

        // ⚡ SPEED: write EVERYTHING in a single multi-path update() — one network
        // round trip instead of 4-5 separate .set() calls run one after another.
        const multiPathUpdates = {
          [`users/${currentUser.uid}/fundRequests/${requestRef.key}`]: requestData,
          [`fund_id_index/${requestNumber}`]: { uid: currentUser.uid, requestKey: requestRef.key },
          [`adminPanel/fundRequests/${adminRequestRef.key}`]: adminRequestData
        };
        let autoBalanceCredited=false;
        try {
          if (isAutoApprove) {
            const balTx=await database.ref(`users/${currentUser.uid}/balance`).transaction(v=>(Number(v)||0)+amountINR);
            if(!balTx.committed)throw new Error('Atomic wallet credit failed');
            newBalance=Number(balTx.snapshot.val())||0;autoBalanceCredited=true;
          }
          await database.ref().update(multiPathUpdates);
        } catch(writeError) {
          if(autoBalanceCredited)await database.ref(`users/${currentUser.uid}/balance`).transaction(v=>(Number(v)||0)-amountINR).catch(()=>{});
          await database.ref(`transaction_id_index/${utrKey}`).remove().catch(()=>{});
          throw writeError;
        }
        if (isAutoApprove) database.ref('stats/fundsApproved').transaction(v => Math.round((v || 0) * 100 + Math.round(amountINR * 100)) / 100).catch(() => {});
        // 🪞 Keep the lightweight registered_users wallet fresh (Admin user list)
        mirrorMyWallet();

        // 🔔 Notifications are fire-and-forget (never block the user's success screen)
        if (isAutoApprove) {
          sendFundApprovedNotification(currentUser.uid, amountINR, newBalance);
        } else {
          createNotification(
            currentUser.uid,
            '⏳ Fund Request Submitted',
            `Your fund request of ${fmt(amountINR)} via ${method.name} is pending admin approval. We'll notify you once it's reviewed.`,
            'fund',
            { status: 'pending', icon: '⏳' }
          );
        }

        playSound('success');
        const bonusNote = bonusAmountINR > 0 ? ` (includes ${bonusInfo.percent}% bonus of ${fmt(bonusAmountINR)})` : '';
        if (isAutoApprove) {
          showToast(`✅ ${enteredAmount} ${currencyCode} received! ${fmt(amountINR)} added to your balance${bonusNote} 🎉`, 'success');
        } else {
          showToast(autoLater
            ? `⏳ Request submitted! ${fmt(amountINR)} will be credited automatically in ${(window.TSMU&&TSMU.humanDelay)?TSMU.humanDelay(autoDelayMs):'a few minutes'}${bonusNote}.`
            : `⏳ Request submitted! ${fmt(amountINR)} will be added once admin approves it${bonusNote}.`, 'success');
        }

        // ⚡ Reset the form INSTANTLY after success — clears the UTR/amount fields
        // so the same transaction ID can never be accidentally reused next time.
        formEl.reset();
        const preview = document.getElementById('dynamicCurrencyPreview');
        if (preview) preview.style.display = 'none';

      } catch (error) {
        console.error('Error:', error);
        playSound('error');
        showToast('Failed to submit request. Try again!', 'error');
      } finally {
        // Always re-enable the button, whether it succeeded, failed, or was blocked by a duplicate check
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnHTML;
        }
      }
    }


