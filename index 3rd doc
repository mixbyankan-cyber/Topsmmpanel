    <div id="fbWall" style="display:none"></div>`;

  function page() {
    if (document.getElementById('feedbackPage')) return;
    TSMU.makePage('feedbackPage', '💬 Feedback', PAGE, 'menuPage');
    if (TSMU.routeAdd) TSMU.routeAdd('feedbackPage', 'feedback', 'Feedback');
    paintForm();
  }

  TSMU.openFeedback = function () {
    page();
    try { window.navigateTo('feedbackPage'); } catch (e) { }
    setTimeout(() => { paintForm(); render(); }, 40);
  };

  TSMU.fbTab = function (t) {
    ['new', 'mine', 'wall'].forEach(x => {
      const b = document.getElementById('fbTab' + x.charAt(0).toUpperCase() + x.slice(1));
      const p = document.getElementById('fb' + x.charAt(0).toUpperCase() + x.slice(1));
      if (b) b.classList.toggle('on', x === t);
      if (p) p.style.display = x === t ? '' : 'none';
    });
    render();
  };

  TSMU.fbStar = function (n) {
    FB.rating = n;
    paintStars();
  };
  function paintStars() {
    const box = document.getElementById('fbStars'); if (!box) return;
    box.innerHTML = [1, 2, 3, 4, 5].map(n =>
      '<button type="button" class="' + (n <= FB.rating ? 'on' : '') + '" onclick="TSMU.fbStar(' + n + ')" aria-label="' + n + ' star">⭐</button>').join('');
    const l = document.getElementById('fbStarLabel');
    if (l) l.textContent = FB.rating ? STAR_LABEL[FB.rating] : '';
  }
  TSMU.fbCat = function (c) { FB.cat = FB.cat === c ? '' : c; paintCats(); };
  function paintCats() {
    const box = document.getElementById('fbCats'); if (!box) return;
    const cats = String(FB.cfg.categories || DEF.categories).split(',').map(x => x.trim()).filter(Boolean);
    box.innerHTML = cats.map(c =>
      '<button type="button" class="' + (FB.cat === c ? 'on' : '') + '" onclick="TSMU.fbCat(\'' + esc(c).replace(/'/g, "\\'") + '\')">' + esc(c) + '</button>').join('');
  }
  function paintForm() {
    const i = document.getElementById('fbIntro');
    if (i) i.textContent = FB.cfg.intro || DEF.intro;
    paintStars(); paintCats();
  }

  TSMU.fbSubmit = function () {
    const uid = TSMU.uid(); if (!uid) return TSMU.toast('Please sign in first.', 'error');
    if (FB.cfg.enabled === false) return TSMU.toast('Feedback is closed right now.', 'error');
    const msg = String((document.getElementById('fbMsg') || {}).value || '').trim();
    const min = TSMU.num(FB.cfg.minChars, DEF.minChars);
    if (FB.cfg.requireRating !== false && !FB.rating) return TSMU.toast('Please choose a star rating.', 'error');
    if (msg.length < min) return TSMU.toast('Please write at least ' + min + ' characters.', 'error');

    const btn = document.getElementById('fbSend');
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    const u = TSMU.authUser() || {};
    const prof = TSMU.G('currentUserData') || {};
    const name = String(prof.name || u.displayName || (u.email || '').split('@')[0] || 'User');
    const autoFrom = TSMU.num(FB.cfg.autoPublishFrom, 0);
    const wantsPublic = !!(document.getElementById('fbPublic') || {}).checked;
    const row = {
      uid: uid, name: name, email: u.email || '',
      rating: FB.rating, category: FB.cat || 'General',
      message: msg.slice(0, 1200),
      proof: String((document.getElementById('fbProof') || {}).value || '').trim().slice(0, 1000),
      proofPath: TSMU.feedbackProofPath || null,
      allowPublic: wantsPublic,
      published: !!(wantsPublic && autoFrom > 0 && FB.rating >= autoFrom),
      status: 'new', createdAt: Date.now(),
      verifiedOrder: !!(TSMU.orders && (TSMU.orders() || []).some(o => ['completed','processing'].includes(String(o.status || '').toLowerCase())))
    };
    DB().ref('feedback').push(row)
      .then(() => {
        FB.rating = 0; FB.cat = '';
        const m = document.getElementById('fbMsg'); if (m) m.value = '';
        const p = document.getElementById('fbProof'); if (p) p.value = '';
        TSMU.feedbackProofPath=''; if(TSMU.feedbackPaintProof)TSMU.feedbackPaintProof();
        paintForm();
        TSMU.toast(FB.cfg.thanks || DEF.thanks, 'success');
        TSMU.fbTab('mine');
      })
      .catch(e => TSMU.toast('Could not send: ' + e.message, 'error'))
      .then(() => { if (btn) { btn.disabled = false; btn.textContent = 'Send feedback'; } });
  };

  const stars = n => '★★★★★'.slice(0, TSMU.num(n)) + '☆☆☆☆☆'.slice(0, 5 - TSMU.num(n));
  const initial = s => String(s || 'U').trim().charAt(0).toUpperCase();
  const firstName = s => String(s || 'User').trim().split(/\s+/)[0];

  function card(f, mine) {
    const tag = f.status === 'replied' ? '<span class="tsmu-fb-tag t-green">Replied</span>'
      : f.status === 'read' ? '<span class="tsmu-fb-tag t-blue">Read</span>'
        : '<span class="tsmu-fb-tag t-amber">New</span>';
    return '<div class="tsmu-fb-card">' +
      '<div class="tsmu-fb-head"><div class="tsmu-fb-av">' + esc(initial(mine ? f.name : firstName(f.name))) + '</div>' +
      '<div><div class="tsmu-fb-nm">' + esc(mine ? 'You' : firstName(f.name)) + (f.verifiedOrder ? '<span class="verified-review">✓ Verified order</span>' : '') + '</div>' +
      '<div class="tsmu-fb-dt">' + TSMU.dt(f.createdAt) + (f.category ? ' · ' + esc(f.category) : '') + '</div></div>' +
      '<div class="tsmu-fb-rt">' + stars(f.rating) + '</div></div>' +
      '<div class="tsmu-fb-msg">' + esc(f.message || '') + '</div>' +
      (mine ? '<div style="margin-top:8px">' + tag + '</div>' : '') +
      (f.reply ? '<div class="tsmu-fb-reply"><b>Support team:</b> ' + esc(f.reply) + '</div>' : '') +
      '</div>';
  }

  function render() {
    const mineBox = document.getElementById('fbMine');
    if (mineBox && mineBox.style.display !== 'none') {
      if (!FB.mine.length) TSMU.empty(mineBox, '📄', 'You have not sent any feedback yet');
      else mineBox.innerHTML = FB.mine.slice().sort((a, b) => b.createdAt - a.createdAt).map(f => card(f, true)).join('');
    }
    const wallBox = document.getElementById('fbWall');
    if (wallBox && wallBox.style.display !== 'none') {
      if (FB.cfg.wallEnabled === false) { TSMU.empty(wallBox, '🌟', 'Reviews are not public right now'); return; }
      const list = FB.wall.slice().sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0) || b.createdAt - a.createdAt);
      if (!list.length) { TSMU.empty(wallBox, '🌟', 'No public reviews yet', 'Be the first to leave one.'); return; }
      const avg = list.reduce((a, f) => a + TSMU.num(f.rating), 0) / list.length;
      wallBox.innerHTML =
        '<div class="tsmu-fb-sum"><div><div class="big">' + (Math.round(avg * 10) / 10) + '</div>' +
        '<div style="font-size:11px;color:var(--text-gray,#64748b);font-weight:700">out of 5</div></div>' +
        '<div><div style="color:#f59e0b;font-size:15px;letter-spacing:2px">' + stars(Math.round(avg)) + '</div>' +
        '<div style="font-size:11.5px;color:var(--text-secondary,#475569);margin-top:3px">' + list.length + ' published review' + (list.length === 1 ? '' : 's') + '</div></div></div>' +
        list.map(f => card(f, false)).join('');
    }
  }

  function watch() {
    DB().ref('settings/feedback').on('value', s => {
      FB.cfg = Object.assign({}, DEF, s.val() || {});
      paintForm();
      const card2 = document.getElementById('tsmumc_feedback');
      if (card2) card2.style.display = FB.cfg.enabled === false ? 'none' : '';
    }, () => { });

    const attachMine = uid => {
      DB().ref('feedback').orderByChild('uid').equalTo(uid).on('value', s => {
        const v = s.val() || {};
        FB.mine = Object.keys(v).map(k => Object.assign({ id: k }, v[k])).filter(f => f.uid === uid);
        render();
      }, e => console.warn('[TSMU feedback mine]', e.message));
    };
    if (TSMU.whenUid) TSMU.whenUid(attachMine); else if (TSMU.uid()) attachMine(TSMU.uid());
    DB().ref('feedback').orderByChild('published').equalTo(true).on('value', s => {
      const v = s.val() || {};
      FB.wall = Object.keys(v).map(k => Object.assign({ id: k }, v[k])).filter(f => f.allowPublic !== false);
      render();
    }, e => console.warn('[TSMU feedback wall]', e.message));
  }

  TSMU.onReady(function () {
    page();
    watch();
    TSMU.registerMount(page);
    setTimeout(page, 1200);
  });

  console.log('%c TSMU v37 feedback centre loaded ', 'background:#db2777;color:#fff;padding:2px 6px;border-radius:4px');
})();


/* ---------- 15-polish-payments.js ---------- */
/* ══════════════════════════════════════════════════════════════════════
   v37 USER · PART 15 — POLISH & PAYMENTS
     1. Profile currency dropdown was being clipped by the card → it now
        floats above everything (fixed layer, follows the button).
     2. Social-network chips: icon + name only (no service count) and the
        name can no longer spill out of the box on a phone.
     3. Real payment brand icons (UPI, PhonePe, Paytm, GPay, …) everywhere
        the panel used to print an emoji.
     4. Delayed auto-approval of fund requests, exactly as the admin sets
        it per payment method (with a live countdown for the user).
     5. Admin-controlled welcome popup.
     6. Ticket submit stays on the Tickets page (no forced redirect).
   ══════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const TSMU = window.TSMU, esc = TSMU.esc;
  const DB = () => TSMU.db();
  const wrap = (n, f) => { if (typeof window[n] !== 'function') return false; window[n] = f(window[n]); return true; };
  const B = () => window.TSMBRANDS;

  const CSS = `
  .tsmu-pf-chip .pf-nm{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .currency-dropdown-list.tsmu-float{position:fixed!important;z-index:99999!important;max-height:min(320px,50vh);
    overflow-y:auto;box-shadow:0 22px 60px rgba(15,23,42,.28);display:block!important}
  .tsmu-pmicon{display:inline-flex;align-items:center;vertical-align:middle}
  .pmo-icon-wrap .topsmm-brand{width:26px;height:26px}
  .tsmu-auto{margin:10px 0 0;padding:10px 12px;border-radius:11px;background:rgba(14,165,233,.08);
    border-left:3px solid var(--primary-color,#0ea5e9);font-size:12px;line-height:1.55;color:var(--text-secondary,#475569)}
  .tsmu-auto b{color:var(--text-primary,#0f172a)}
  `;
  const st = document.createElement('style'); st.id = 'tsmuPolish37'; st.textContent = CSS; document.head.appendChild(st);

  /* ═══════ 1. CURRENCY DROPDOWN — never clipped again ═══════ */
  function floatCurrency() {
    document.querySelectorAll('.currency-selector').forEach(floatOne);
  }
  function floatOne(sel) {
    const list = sel.querySelector('.currency-dropdown-list');
    const btn = sel.querySelector('.currency-selector-btn');
    if (!sel || !list || !btn) return;
    if (!sel.classList.contains('open')) { list.classList.remove('tsmu-float'); list.style.cssText = list._base || ''; return; }
    if (!list._base) list._base = list.getAttribute('style') || '';
    const r = btn.getBoundingClientRect();
    const spaceBelow = window.innerHeight - r.bottom;
    const openUp = spaceBelow < 220 && r.top > spaceBelow;
    list.classList.add('tsmu-float');
    list.style.width = r.width + 'px';
    list.style.minWidth = r.width + 'px';
    list.style.left = r.left + 'px';
    list.style.right = 'auto';
    if (openUp) { list.style.top = 'auto'; list.style.bottom = (window.innerHeight - r.top + 6) + 'px'; }
    else { list.style.bottom = 'auto'; list.style.top = (r.bottom + 6) + 'px'; }
    list.style.display = 'block';
  }
  wrap('toggleCurrencyDropdown', orig => function () {
    const r = orig.apply(this, arguments);
    setTimeout(floatCurrency, 10);
    return r;
  });
  wrap('selectCurrency', orig => function () { const r = orig.apply(this, arguments); setTimeout(floatCurrency, 10); return r; });
  ['scroll', 'resize'].forEach(ev => window.addEventListener(ev, () => { try { floatCurrency(); } catch (e) { } }, true));
  document.addEventListener('click', () => setTimeout(floatCurrency, 20), true);

  /* ═══════ 2. NETWORK CHIPS: icon + name only ═══════ */
  function chipsIconNameOnly() {
    if (!TSMU.PF) return;
    TSMU.PF.cfg = TSMU.PF.cfg || {};
    TSMU.PF.cfg.showCounts = false;                 // the owner does not want the count
    document.querySelectorAll('#tsmuPfBarOrder .pf-ct, #tsmuPfBarCatalog .pf-ct').forEach(e => e.remove());
  }

  /* ═══════ 3. BRAND ICONS FOR PAYMENT METHODS ═══════ */
  TSMU.pmIcon = (m, size) => (B() ? B().html(m || {}, size || 26) : ((m && m.icon) || '💳'));

  function methodById(id) { return (TSMU.payMethods || []).find(m => m.id === id || m.name === id) || null; }

  function paintMethodIcons() {
    const list = TSMU.payMethods || [];
    if (!list.length || !B()) return;

    // the method picker cards (fund page)
    document.querySelectorAll('.pmo-icon-wrap').forEach(w => {
      const row = w.closest('[data-method-id],[onclick]');
      let m = null;
      const oc = row ? (row.getAttribute('onclick') || row.dataset.methodId || '') : '';
      const mm = /switchFundMethod\('([^']+)'/.exec(oc);
      if (mm) m = methodById(mm[1]);
      if (!m) {
        const nameEl = row ? row.querySelector('.pmo-name, .pmo-title') : null;
        if (nameEl) m = list.find(x => String(x.name).trim() === nameEl.textContent.trim());
      }
      if (!m) return;
      const html = TSMU.pmIcon(m, 28);
      if (w._h !== html) { w._h = html; w.innerHTML = html; }
    });

    // the selected-method icon + the "Scan & Pay via" heading
    const sel = document.getElementById('selectedMethodIcon') || document.querySelector('.selected-method-icon');
    const active = TSMU.activeMethod || null;
    if (sel && active) { const h = TSMU.pmIcon(active, 26); if (sel._h !== h) { sel._h = h; sel.innerHTML = h; } }
  }
  TSMU.paintMethodIcons = paintMethodIcons;

  ['displayPaymentMethods', 'renderPaymentMethodOptions', 'switchFundMethod', 'loadPaymentMethods', 'renderFundMethodUI']
    .forEach(fn => wrap(fn, orig => function () {
      const r = orig.apply(this, arguments);
      if (fn === 'switchFundMethod') { const id = arguments[0]; TSMU.activeMethod = methodById(id) || TSMU.activeMethod; }
      setTimeout(paintMethodIcons, 80);
      return r;
    }));

  /* ═══════ 4. DELAYED AUTO-APPROVAL ═══════ */
  TSMU.payMethods = TSMU.payMethods || [];
  TSMU.autoApproveDelayMs = function (method) {
    if (!method) return 0;
    const live = methodById(method.id || method.name) || method;
    if (String(live.approvalMode || 'auto') !== 'auto') return 0;
    const secs = TSMU.num(live.autoApproveDelaySec, NaN);
    if (Number.isFinite(secs) && secs > 0) return Math.round(secs * 1000);
    const mins = TSMU.num(live.autoApproveDelayMin, 0);
    return mins > 0 ? Math.round(mins * 60000) : 0;
  };
  TSMU.humanDelay = function (ms) {
    const s = Math.max(0, Math.round(TSMU.num(ms) / 1000));
    if (s < 60) return s + ' second' + (s === 1 ? '' : 's');
    const m = Math.round(s / 60);
    if (m < 60) return m + ' minute' + (m === 1 ? '' : 's');
    const h = Math.round(m / 6) / 10;
    return h + ' hour' + (h === 1 ? '' : 's');
  };

  /** credit a scheduled request exactly once (guarded by a status transaction) */
  function creditDue(key, req) {
    const uid = TSMU.uid(); if (!uid || !req) return;
    const amount = TSMU.num(req.amount);
    if (amount <= 0) return;
    const base = 'users/' + uid + '/fundRequests/' + key;
    DB().ref(base + '/status').transaction(v => (v === 'pending' ? 'approved' : undefined))
      .then(res => {
        if (!res.committed) return;                       // somebody else got there first
        return DB().ref('users/' + uid + '/balance').transaction(v => (TSMU.num(v) + amount))
          .then(bal => {
            const now = Date.now();
            const up = {};
            up[base + '/approvedAt'] = now;
            up[base + '/balanceCredited'] = true;
            up[base + '/autoApproved'] = true;
            if (req.adminKey) {
              up['adminPanel/fundRequests/' + req.adminKey + '/status'] = 'approved';
              up['adminPanel/fundRequests/' + req.adminKey + '/approvedAt'] = now;
              up['adminPanel/fundRequests/' + req.adminKey + '/autoApproved'] = true;
            }
            return DB().ref().update(up).then(() => {
              try { if (window.mirrorMyWallet) mirrorMyWallet(); } catch (e) { }
              try { if (window.sendFundApprovedNotification) sendFundApprovedNotification(uid, amount, TSMU.num(bal.snapshot.val())); } catch (e) { }
              TSMU.toast('✅ ' + TSMU.money(amount) + ' has been added to your balance.', 'success');
            });
          });
      }).catch(e => console.warn('[TSMU auto-approve]', e.message));
  }

  let autoTimer = null;
  function watchAutoApprovals() {
    if (TSMU.whenUid) return TSMU.whenUid(attachAuto);
    if (TSMU.uid()) attachAuto(TSMU.uid());
  }
  function attachAuto(uid) {
    DB().ref('users/' + uid + '/fundRequests').on('value', s => {
      TSMU.pendingAuto = [];
      const v = s.val() || {};
      Object.keys(v).forEach(k => {
        const r = v[k] || {};
        if (r.status === 'pending' && r.autoApprove && TSMU.num(r.autoApproveAt) > 0) TSMU.pendingAuto.push(Object.assign({ key: k }, r));
      });
      tick();
    }, () => { });
    if (!autoTimer) autoTimer = setInterval(tick, 1000);
  }
  function tick() {
    const now = Date.now();
    (TSMU.pendingAuto || []).forEach(r => { if (TSMU.num(r.autoApproveAt) <= now) creditDue(r.key, r); });
    paintCountdown();
  }
  function paintCountdown() {
    const host = document.querySelector('#addFundPage .container');
    let box = document.getElementById('tsmuAutoBox');
    const due = (TSMU.pendingAuto || []).filter(r => TSMU.num(r.autoApproveAt) > Date.now());
    if (!due.length || !host) { if (box) box.remove(); return; }
    if (!box) { box = document.createElement('div'); box.id = 'tsmuAutoBox'; box.className = 'tsmu-auto'; host.insertBefore(box, host.children[1] || null); }
    box.innerHTML = due.map(r => {
      const left = Math.max(0, TSMU.num(r.autoApproveAt) - Date.now());
      const s = Math.ceil(left / 1000), mm = Math.floor(s / 60), ss = s % 60;
      return '⏳ <b>' + TSMU.money(TSMU.num(r.amount)) + '</b> · ' + esc(r.method || 'Payment') +
        ' will be credited automatically in <b>' + (mm ? mm + 'm ' : '') + ss + 's</b>';
    }).join('<br>');
  }

  /* payment methods cache (also feeds the brand icons) */
  function watchMethods() {
    DB().ref('settings/paymentMethods').on('value', s => {
      const v = s.val() || {};
      TSMU.payMethods = Object.keys(v).map(k => Object.assign({ id: k }, v[k]));
      paintMethodIcons();
    }, () => { });
  }

  /* ═══════ 5. WELCOME POPUP — admin switch ═══════ */
  TSMU.popupCfg = { enabled: true, delayMs: 1000, once: false };
  TSMU.popupAllowed = function () {
    if (TSMU.popupCfg.enabled === false) return false;
    if (TSMU.popupCfg.once) {
      try {
        const k = 'tsmuPopupSeen';
        const last = Number(localStorage.getItem(k) || 0);
        const day = 864e5 * Math.max(1, TSMU.num(TSMU.popupCfg.onceDays, 1));
        if (Date.now() - last < day) return false;
        localStorage.setItem(k, String(Date.now()));
      } catch (e) { }
    }
    return true;
  };
  TSMU.popupDelayMs = () => Math.max(0, TSMU.num(TSMU.popupCfg.delayMs, 1000));
  wrap('showUpdatePopup', orig => function () {
    if (!TSMU.popupAllowed()) return;                 // admin switched it off
    return orig.apply(this, arguments);
  });

  function watchPopup() {
    DB().ref('settings/updatePopup').on('value', s => {
      TSMU.popupCfg = Object.assign({ enabled: true, delayMs: 1000, once: false, onceDays: 1 }, s.val() || {});
      if (TSMU.popupCfg.enabled === false) {
        const o = document.getElementById('updatePopupOverlay');
        if (o && o.style.display !== 'none') { try { closeUpdatePopup(); } catch (e) { o.style.display = 'none'; } }
      }
    }, () => { });
  }

  /* ═══════ 6. TICKETS: stay on the list, admin closes the ticket ═══════ */
  TSMU.afterTicketSubmit = function () {
    try { if (window.loadUserTickets) loadUserTickets(); } catch (e) { }
    try { window.navigateTo('ticketsPage'); } catch (e) { }
    const box = document.getElementById('ticketHistoryContainer') || document.querySelector('#ticketsPage .container');
    if (box) try { box.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) { }
  };
  /* belt and braces: if any old build still renders the button, hide it */
  function killUserClose() {
    document.querySelectorAll('[onclick*="closeTicketByUser"]').forEach(b => b.remove());
  }
  window.closeTicketByUser = function () {
    TSMU.toast('Only the support team can close a ticket. Reply here if you still need help.', 'error');
  };

  TSMU.onReady(function () {
    watchMethods(); watchAutoApprovals(); watchPopup();
    TSMU.registerMount(function () { chipsIconNameOnly(); paintMethodIcons(); killUserClose(); floatCurrency(); });
    setInterval(() => { chipsIconNameOnly(); killUserClose(); }, 2500);
    setTimeout(() => { chipsIconNameOnly(); paintMethodIcons(); }, 1500);
  });

  console.log('%c TSMU v37 polish + payments loaded ', 'background:#0369a1;color:#fff;padding:2px 6px;border-radius:4px');
})();

