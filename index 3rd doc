      display: none;
    }

    .page.active {
      display: block;
    }

    /* Loading */
    .loading {
      text-align: center;
      padding: 50px;
      font-size: 18px;
      color: var(--primary-color);
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      background: var(--white);
      border-radius: 16px;
      border: 2px dashed rgba(99, 102, 241, 0.3);
    }

    .empty-icon {
      font-size: 64px;
      margin-bottom: 20px;
      opacity: 0.6;
    }

    .empty-text {
      font-size: 18px;
      color: var(--text-primary);
      margin-bottom: 10px;
      font-weight: 600;
    }

    .empty-subtext {
      font-size: 14px;
      color: var(--text-gray);
      margin-bottom: 25px;
    }

    /* Toast */
    .toast {
      position: fixed;
      top: 55px;
      right: 20px;
      background: var(--white);
      border: 2px solid;
      border-radius: 12px;
      padding: 15px 20px;
      min-width: 250px;
      box-shadow: var(--shadow-xl);
      z-index: 10000;
      animation: slideIn 0.3s;
    }

    .toast.success {
      border-color: var(--success);
      color: var(--success);
      background: var(--success-light);
    }

    .toast.error {
      border-color: var(--error);
      color: var(--error);
      background: var(--error-light);
    }

    @keyframes slideIn {
      from {
        transform: translateX(400px);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    /* 🔔 NOTIFICATION PAGE STYLES */
    /* ═══════════════════════════════════════════════════
       🔔 NOTIFICATION PAGE — Fully Responsive
    ═══════════════════════════════════════════════════ */

    #notificationPage {
      display: none;
      flex-direction: column;
      min-height: 100vh;
      background: var(--light-bg);
      overflow-x: hidden;
    }
    #notificationPage.active {
      display: flex !important;
    }

    /* Sticky header */
    .notification-page-header {
      background: var(--white);
      padding: 14px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      border-bottom: 1px solid var(--border-color);
      width: 100%;
      position: relative;
      z-index: 10;
      flex-shrink: 0;
    }

    .back-button {
      background: var(--lighter-bg);
      border: 1px solid var(--border-color);
      color: var(--primary-color);
      font-size: 20px;
      width: 38px;
      height: 38px;
      min-width: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.25s;
      flex-shrink: 0;
    }
    .back-button:hover {
      background: #e0f2fe;
      transform: scale(1.08);
      box-shadow: 0 2px 8px rgba(14,165,233,0.2);
    }

    .notification-page-title {
      flex: 1;
      font-size: 18px;
      font-weight: 700;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mark-all-read-btn {
      padding: 7px 14px;
      background: var(--gradient-primary);
      border: none;
      border-radius: 8px;
      color: white;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s;
      white-space: nowrap;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(14,165,233,0.25);
    }
    .mark-all-read-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(14,165,233,0.4);
    }
    .mark-all-read-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    /* Notification list wrapper */
    .notification-list {
      flex: 1;
      padding: 16px;
      padding-top: 8px;
      width: 100%;
      max-width: 860px;
      margin: 0 auto;
      box-sizing: border-box;
    }

    /* Individual notification card */
    .notification-item {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 14px 16px;
      margin-bottom: 10px;
      cursor: pointer;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.2s;
      position: relative;
      overflow: hidden;
      width: 100%;
    }
    .notification-item.unread {
      border-color: var(--primary-color);
      background: rgba(14,165,233,0.04);
    }
    .notification-item.unread::before {
      content: '';
      position: absolute;
      left: 0; top: 12px; bottom: 12px;
      width: 4px;
      background: var(--gradient-primary);
      border-radius: 0 4px 4px 0;
    }
    .notification-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(14,165,233,0.12);
      border-color: var(--primary-color);
    }

    /* Inner layout: icon + content + badge */
    .notification-header {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      width: 100%;
    }

    .notification-icon {
      font-size: 22px;
      min-width: 42px;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: rgba(14,165,233,0.08);
      flex-shrink: 0;
    }

    .notification-content {
      flex: 1;
      min-width: 0; /* prevent overflow */
    }

    .notification-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 4px;
      line-height: 1.4;
      /* wrap long titles */
      word-break: break-word;
    }

    .notification-message {
      font-size: 13px;
      color: var(--text-gray);
      line-height: 1.5;
      margin-bottom: 6px;
      /* wrap long messages */
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .notification-time {
      font-size: 11px;
      color: var(--text-light);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* Type badge — top right */
    .notification-type-badge {
      padding: 3px 9px;
      border-radius: 10px;
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      flex-shrink: 0;
      align-self: flex-start;
      white-space: nowrap;
    }
    .notification-type-badge.welcome    { background: rgba(16,185,129,0.15);  color: var(--success); }
    .notification-type-badge.fund       { background: rgba(245,158,11,0.15);  color: var(--warning); }
    .notification-type-badge.order      { background: rgba(14,165,233,0.15);  color: var(--primary-color); }
    .notification-type-badge.security   { background: rgba(239,68,68,0.15);   color: var(--error); }
    .notification-type-badge.announcement{ background: rgba(124,77,255,0.15); color: #7c4dff; }
    .notification-type-badge.referral   { background: rgba(245,158,11,0.15);  color: var(--warning); }

    /* Empty state */
    .empty-notifications {
      text-align: center;
      padding: 60px 20px;
    }
    .empty-notifications-icon {
      font-size: 64px;
      margin-bottom: 16px;
      opacity: 0.25;
    }
    .empty-notifications-text {
      font-size: 15px;
      color: var(--text-gray);
    }

