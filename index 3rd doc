            <div class="empty-text">No tickets found</div>
            <div style="font-size: 13px; color: var(--text-gray); margin-top: 8px;">Create a new ticket above if you need help with anything.</div>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div class="data-scroll-hint">
          <span>↔️ Scroll sideways to see all columns</span>
          <span class="hint-arrow">➜</span>
        </div>
        <div class="data-scroll-wrap">
          <table class="data-scroll-table">
            <thead>
              <tr>
                <th>Ticket ID</th>
                <th>Subject</th>
                <th>Status</th>
                <th>Last Update</th>
              </tr>
            </thead>
            <tbody>
              ${filtered.map(t => `
                <tr style="cursor:${t._archived?'default':'pointer'};" ${t._archived?'':`onclick="openTicketConversation('${t.id}')"`}>
                  <td class="cell-mono">#${t.ticketNumber || t.id.substring(0,6).toUpperCase()}${t._archived?`<br><small style="color:#7c3aed">📚 ${t._archiveLabel||'Archive'} · read-only</small>`:''}</td>
                  <td>
                    <span class="ticket-subject-cell">
                      ${escapeHTML(getTicketSubjectLabel(t.subject))}
                      ${t.orderIds && t.orderIds.length > 0 ? `<span class="ticket-subject-count">${t.orderIds.length}</span>` : ''}
                      ${t.userHasUnread ? `<span class="ticket-unread-dot"></span>` : ''}
                    </span>
                  </td>
