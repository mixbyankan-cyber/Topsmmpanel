    /* Animated Scrolling Banner */
    .top-scrolling-banner {
      background: var(--gradient-primary);
      background-size: 200% 100%;
      animation: gradient-shift 3s ease infinite;
      color: white;
      overflow: hidden;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1001;
      padding: 10px 0;
      box-shadow: 0 2px 12px rgba(99, 102, 241, 0.3);
    }


    @keyframes gradient-shift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .banner-track {
      display: flex;
      width: fit-content;
      animation: scroll-left var(--bannerDur, 20s) linear infinite;
      will-change: transform;
    }

    /* Seamless marquee: the track holds 2 identical copies, so sliding by
       exactly 50% loops perfectly. The DURATION is computed by JS from the
       Admin-set speed (px/sec), so ANY text length scrolls at the exact
       same speed — long texts no longer fly past. */
    @keyframes scroll-left {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    .banner-content {
      white-space: nowrap;
      padding: 0 50px;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 30px;
    }

    .banner-content::after {
      content: "⭐";
      margin-left: 30px;
      font-size: 16px;
      animation: twinkle 1.5s infinite;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.8); }
    }

    .top-scrolling-banner:hover .banner-track {
      animation-play-state: paused;
    }

    /* 🎛️ Admin ON/OFF switch for the marquee — hides it everywhere instantly */
    body.no-banner .top-scrolling-banner { display: none !important; }
    body.no-banner { padding-top: 0 !important; }
    body.no-banner .header { top: 0 !important; }

