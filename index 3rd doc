    let activePanelSearchRef = null;
    let activePanelSearchCallback = null;
    function detachPanelSearchListener() {
      if (activePanelSearchRef && activePanelSearchCallback) {
        try { activePanelSearchRef.off('value', activePanelSearchCallback); } catch (e) {}
      }
      activePanelSearchRef = null;
      activePanelSearchCallback = null;
    }

    async function searchPanelOrder() {
      detachPanelSearchListener();
      const searchInput = document.getElementById('orderSearchInput').value.trim();
      const resultsContainer = document.getElementById('orderStatusResults');

      if (!searchInput) {
        // If empty, load user's orders
        loadMyPanelOrders();
        return;
      }

      resultsContainer.innerHTML = '<div class="loading">🔍 Searching...</div>';

      try {
        let orderFound = false;
        let orderData = null;
        let orderId = null;

        // Search exclusively inside this authenticated user's orders. Never
        // perform a direct read of a guessed global order key.
        const allOrdersSnapshot = await database.ref('panel_orders')
          .orderByChild('userId').equalTo(currentUser.uid).once('value');
        allOrdersSnapshot.forEach((childSnapshot) => {
          const order = childSnapshot.val() || {};
          if (childSnapshot.key === searchInput ||
              order.adminEmail === searchInput ||
              order.domainName === searchInput ||
              order.userEmail === searchInput ||
              order.orderId === searchInput) {
            orderFound = true;
            orderData = order;
            orderId = childSnapshot.key;
          }
        });

        if (orderFound && orderData) {
          // Setup real-time listener for this specific owned order
          activePanelSearchRef = database.ref('panel_orders/' + orderId);
          activePanelSearchCallback = sessionOn(activePanelSearchRef, 'value', (snapshot) => {
            if (!snapshot.exists()) {
              window._lastSearchedPanelOrder = null;
              resultsContainer.innerHTML = `
                <div class="empty-status">
                  <div class="empty-status-icon">❌</div>
                  <p>Order not found or has been removed</p>
                </div>
              `;
              return;
            }

            const order = snapshot.val();
            if (!order || order.userId !== currentUser.uid) {
              detachPanelSearchListener();
              resultsContainer.innerHTML = '<div class="empty-status"><div class="empty-status-icon">🔒</div><p>This order is not available for this account.</p></div>';
              return;
            }
            // Cache for instant re-render on currency switch
            window._lastSearchedPanelOrder = { id: orderId, data: order };
            renderPanelOrderStatusCard(orderId, order);
          });
        } else {
          resultsContainer.innerHTML = `
            <div class="empty-status">
              <div class="empty-status-icon">❌</div>
              <p>No order found with the provided details</p>
              <p style="font-size: 13px; color: var(--text-gray); margin-top: 10px;">Please check your Order ID, Email, or Domain Name and try again</p>
              <button class="btn-submit-order" onclick="loadMyPanelOrders(); document.getElementById('orderSearchInput').value = '';" style="margin-top: 15px; background: var(--text-secondary);">
                <span>🔙</span> Back to My Orders
              </button>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error searching order:', error);
        resultsContainer.innerHTML = `
          <div class="empty-status">
            <div class="empty-status-icon">⚠️</div>
            <p>Error searching order. Please try again.</p>
            <button class="btn-submit-order" onclick="loadMyPanelOrders(); document.getElementById('orderSearchInput').value = '';" style="margin-top: 15px; background: var(--text-secondary);">
              <span>🔙</span> Back to My Orders
            </button>
          </div>
        `;
      }
    }

