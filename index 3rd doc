      document.getElementById('totalCharge').innerHTML = (window.TSMU&&TSMU.totalText)?TSMU.totalText(total,{hasQty:quantity>0,freePackage:(Number(selectedPackageData&&selectedPackageData.pricePerK)||0)<=0}):formatCurrency(total, 4);
