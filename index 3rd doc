      // ── Campaign HERO (dashboard) renderer + 3D flip-clock engine ───
      renderHero(phase) {
        const hero = document.getElementById('fctHero');
        if (!hero) return;
        if (hero.dataset.phase === phase && hero.dataset.built === '1') return;
        hero.dataset.phase = phase;
        hero.dataset.built = '1';
        hero.classList.remove('fct-hero-comin', 'fct-hero-endin');
        hero.classList.add(phase === 'coming' ? 'fct-hero-comin' : 'fct-hero-endin');

        const c = (IDT.fest || {}).coming || {};
        const e = (IDT.fest || {}).ending || {};
        const isComing = (phase === 'coming');
        const icon = isComing ? IDT.flagSVG() : IDT.hourglassSVG(80);
        const headline = isComing ? (c.headline || IDT._defaults.comingHeadline)
                                  : (e.headline || IDT._defaults.endingHeadline);
        const subline  = isComing ? (c.subline  || IDT._defaults.comingSubline)
                                  : (e.subline  || IDT._defaults.endingSubline);
        const note = isComing ? '🎯 Festival goes LIVE on 15th August — get your wallet ready!'
                              : '⚡ Every bonus and offer ends the moment the clock hits zero!';

        let stars = '';
        if (isComing) {
          for (let i = 0; i < 16; i++) {
            const l = ((i * 61) % 94) + 3;
            const t = ((i * 37) % 62) + 10;
            const sz = (i % 3) + 2;
