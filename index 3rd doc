    // Place New Order
    async function placeNewOrder() {
      if (!currentUser) {
        playSound('error');
        return showToast('Please login first!', 'error');
      }
      if (!ensureFeatureAllowed('newOrder', 'Placing New Orders')) return;

      const serviceId = document.getElementById('serviceSelect').value;
      const packageId = document.getElementById('packageSelect').value;
      const link      = document.getElementById('orderLink').value.trim();
      const quantity  = Math.round(Number(String(document.getElementById('orderQuantity').value||'').replace(/[,\s_]/g,'')));

      if (!serviceId || !packageId) {
        playSound('error');
        return showToast('Please select service and package!', 'error');
      }

      if (!link) {
        playSound('error');
        return showToast('Please enter link!', 'error');
      }

      if (window.TSMU && TSMU.checkQuantity) { const _qv = TSMU.checkQuantity(quantity, selectedPackageData); if (!_qv.ok) { playSound('error'); return showToast(_qv.message, 'error'); } }
      else if (!Number.isFinite(quantity) || quantity < selectedPackageData.min || quantity > selectedPackageData.max) {
        playSound('error');
        return showToast(`Quantity must be between ${selectedPackageData.min} and ${selectedPackageData.max}`, 'error');
      }

      const pkgQuantity = selectedPackageData.quantity || 1000;
      let cost=Math.round(((quantity/pkgQuantity)*Number(selectedPackageData.pricePerK||0))*10000)/10000;

      // ⚡ INSTANT FEEDBACK: lock the submit button immediately so a fast
      // double-click can never create two orders, and the user sees the
      // order is being processed right away instead of a long silent wait.
      const placeBtn = document.getElementById('placeOrderBtn');
      const originalBtnHTML = placeBtn ? placeBtn.innerHTML : '';
      if (placeBtn) {
        placeBtn.disabled = true;
        placeBtn.innerHTML = '⏳ Placing Order...';
      }

      try {
        // ⚡ SPEED: run EVERY independent read in PARALLEL (instead of one
        // after another) — duplicate-order check, balance, spent, global
        // stats, and the short Order ID reservation all happen at the same
        // time, cutting total wait time dramatically (one network round
        // trip instead of 6+).
        const [ordersSnap,balanceSnapshot,spentSnapshot,statsSnapshot,orderNumber,autoProcessingSnap,livePackageSnap] = await Promise.all([
          database.ref(`users/${currentUser.uid}/orders`).once('value'),
          database.ref(`users/${currentUser.uid}/balance`).once('value'),
          database.ref(`users/${currentUser.uid}/spent`).once('value'),
          database.ref('stats/totalOrders').once('value'),
          generateUniqueOrderId(),
          database.ref('settings/autoOrderProcessing').once('value'),
          database.ref(`services/${serviceId}/packages/${packageId}`).once('value')
        ]);
        const livePkg=livePackageSnap.val()||{};
        if(!livePackageSnap.exists()||livePkg.enabled===false)throw new Error('Package is unavailable or disabled.');
        const liveMin=Number(livePkg.min)||0,liveMax=Number(livePkg.max)||0,liveUnit=Math.max(1,Number(livePkg.quantity)||1000),livePrice=Number(livePkg.pricePerK);
        if(!Number.isFinite(livePrice)||livePrice<0||quantity<liveMin||quantity>liveMax)throw new Error('Package price or quantity was changed by the admin. Please select the package again.');
        cost=Math.round(((quantity/liveUnit)*livePrice)*10000)/10000;
        if(!Number.isFinite(cost)||cost<0)throw new Error('Invalid package price.');if(window.TSMU&&TSMU.applyDiscountToCost)cost=TSMU.applyDiscountToCost(cost,serviceId,packageId,livePrice,quantity,liveUnit);

        // ══════════════════════════════════════════════════
        // 🚫 DUPLICATE ORDER CHECK
        // Same service + Same link = blocked until complete
        // ══════════════════════════════════════════════════
        let duplicateFound = false;
        let duplicateOrder = null;

        if (ordersSnap.exists()) {
          ordersSnap.forEach(child => {
            const o = child.val();
            const normalizedExisting = (o.link || '').trim().toLowerCase().replace(/\/$/, '');
            const normalizedNew      = link.toLowerCase().replace(/\/$/, '');
            const sameLink    = normalizedExisting === normalizedNew;
            const sameService = o.serviceId === serviceId;
            const notDone     = o.status !== 'completed' && o.status !== 'rejected' && o.status !== 'cancelled';

            if (sameLink && sameService && notDone) {
              duplicateFound = true;
              duplicateOrder = { id: child.key, ...o };
            }
          });
        }

        if (duplicateFound) {
          playSound('error');
          showDuplicateOrderModal(duplicateOrder, link, serviceId);
          return;
        }
        // ══════════════════════════════════════════════════

        // 💰 ATOMIC BALANCE DEDUCTION — uses a Firebase transaction() instead of
        // a plain read-then-write, so two near-simultaneous orders (two tabs,
        // two devices) can never both pass the balance check against the same
        // stale value. Firebase re-runs this function against the latest
        // server value on conflict, and aborts cleanly if funds are short.
        let insufficientBalance = false;
        const balanceTxResult = await database.ref(`users/${currentUser.uid}/balance`).transaction(currentBalance => {
          const bal = currentBalance || 0;
          insufficientBalance = bal < cost;
          if (insufficientBalance) return; // undefined return = abort transaction
          return bal - cost;
        });

        if (!balanceTxResult.committed) {
          playSound('error');
          showToast(insufficientBalance ? 'Insufficient balance! Please add funds.' : 'Could not place order, please try again!', 'error');
          return;
        }

        const spent = spentSnapshot.val() || 0;
        const stats = statsSnapshot.val() || { total: 0, pending: 0 };

        const serviceName = document.getElementById('serviceSelect').options[document.getElementById('serviceSelect').selectedIndex].text;
        const packageName = document.getElementById('packageSelect').options[document.getElementById('packageSelect').selectedIndex].text;
        const nowTs = Date.now();
        const autoCfg=autoProcessingSnap.val()||{};
        const autoEnabled=autoCfg.enabled===true;
        const autoDelayMs=Math.max(1000,Number(autoCfg.delayMs)||300000);

        const orderRef = database.ref(`users/${currentUser.uid}/orders`).push();
        const orderData = {
          orderNumber: orderNumber,
          serviceId: serviceId,
          packageId: packageId,
          serviceName: serviceName,
          packageName: packageName,
          link: link,
          quantity: quantity,
          amount:cost,pricePerK:livePrice,pricingQuantity:liveUnit,pricingVerifiedAt:nowTs,
          status: 'pending',
          source: 'single',
          cancelable: !!selectedPackageData.cancelable,
          refillable: !!selectedPackageData.refillable,
          createdAt: nowTs,
          autoProcessingEnabled: autoEnabled,
          autoProcessingAt: autoEnabled ? nowTs + autoDelayMs : null,
          autoProcessingDelayMs: autoEnabled ? autoDelayMs : null
        };

        // ⚡ SPEED: write the rest in a single multi-path update() — one
        // network round trip. Balance is already safely deducted above.
        //
        // 🚀 orders_index/{key} — a SMALL, flat, top-level mirror of just the
        // fields Admin's Orders list needs (not the full order object). This
        // is what lets Admin page through orders with .limitToLast() instead
        // of downloading every user's entire order history to find recent
        // ones. Keep this in sync any time order status changes elsewhere
        // (Admin's updateOrderStatus / rejectOrder / deleteOrder / cancel
        // approval all update BOTH this and the real record together).
        const multiPathUpdates = {
          [`users/${currentUser.uid}/orders/${orderRef.key}`]: orderData,
          [`order_id_index/${orderNumber}`]: { uid: currentUser.uid, orderKey: orderRef.key },
          [`orders_index/${orderRef.key}`]: {
            orderNumber: orderNumber,
            userId: currentUser.uid,
            userName: cleanPersonName((auth.currentUser && auth.currentUser.displayName) || 'User'),
            userEmail: getBestUserEmail(auth.currentUser, null),
            serviceName: serviceName,
            packageName: packageName,
            link: link,
            quantity: quantity,
            amount:cost,pricePerK:livePrice,pricingQuantity:liveUnit,serviceId:serviceId,packageId:packageId,
            status: 'pending',
            source: 'single',
            createdAt: nowTs,
            autoProcessingEnabled: autoEnabled,
            autoProcessingAt: autoEnabled ? nowTs + autoDelayMs : null
          },
          [`users/${currentUser.uid}/spent`]: spent + cost,
          [`stats/totalOrders/total`]: (stats.total || 0) + 1,
          [`stats/totalOrders/pending`]: (stats.pending || 0) + 1
        };

        try {
          await database.ref().update(multiPathUpdates);
          // 📊 Admin-Dashboard live counters (tiny nodes → instant stat cards)
          database.ref('stats/orderStatusCounts/pending').transaction(v => (v || 0) + 1).catch(() => {});
          database.ref('stats/revenueTotal').transaction(v => (v || 0) + cost).catch(() => {});
          // 🪞 Keep the lightweight per-user mirrors fresh (no full-tree read)
          bumpMyOrderStat(null, 'pending', 1);
          mirrorMyWallet();
        } catch (writeErr) {
          // Extremely rare: balance was deducted but the order write failed.
          // Refund immediately so the user never silently loses money.
          await database.ref(`users/${currentUser.uid}/balance`).transaction(b => (b || 0) + cost);
          throw writeErr;
        }

        // 🔔 Notifications + referral commission are fire-and-forget (never
        // block the instant success screen the user sees)
        sendOrderPlacedNotification(currentUser.uid, orderNumber, cost, serviceName);
        // Referral commission is credited only after COMPLETED status by
        // the server-side onOrderStatusForReferral Cloud Function.

        playSound('success');
        showToast('Order placed successfully! 🚀', 'success');

        // ✅ Show the instant, in-place Order Success Box — NO page
        // navigation, full order details, background data keeps refreshing
        // automatically (Orders page live-listener is always running).
        showOrderSuccessBox({
          orderNumber, serviceName, packageName, link, quantity,
          amount: cost, status: 'pending', createdAt: nowTs
        });

        // ⚡ Reset the entire order form INSTANTLY so it's ready for the next order
        resetOrderForm();

      } catch (error) {
        console.error('Order placement error:', error);
        playSound('error');
        showToast('Failed to place order: '+cleanPlainText(error.message||'Try again',180), 'error');
      } finally {
        if (placeBtn) {
          placeBtn.disabled = false;
          placeBtn.innerHTML = originalBtnHTML;
        }
      }
    }

