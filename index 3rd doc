    .api-section-panel { display: none; }
    .api-section-panel.active { display: block; }

    .api-stat-mini {
      background: var(--gradient-light);
      border-radius: 10px;
      padding: 12px;
      text-align: center;
    }
    .api-stat-mini .val { font-size: 20px; font-weight: 800; color: var(--primary-color); }
    .api-stat-mini .lbl { font-size: 11px; color: var(--text-gray); margin-top: 3px; }

    .currency-conversion-preview {
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 6px;
      font-weight: 600;
    }

    /* ✅ Instant Order Success Box (New Order page) — professional SMM-panel
       style green confirmation card shown immediately after order placement,
       with zero page navigation and full order details. */
    @keyframes orderSuccessSlideIn {
      from { opacity: 0; transform: translateY(-12px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes orderSuccessCheckPop {
      0%   { transform: scale(0); }
      60%  { transform: scale(1.15); }
      100% { transform: scale(1); }
    }
    .order-success-box {
      margin: 18px 0;
      background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
      border: 2px solid var(--success);
      border-radius: 16px;
      padding: 20px;
      position: relative;
      animation: orderSuccessSlideIn 0.4s cubic-bezier(0.34,1.56,0.64,1);
      box-shadow: 0 8px 24px rgba(16, 185, 129, 0.18);
    }
    .order-success-close-btn {
      position: absolute;
      top: 12px;
      right: 14px;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: rgba(255,255,255,0.7);
      border: 1px solid rgba(16,185,129,0.3);
      color: #047857;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.2s;
    }
    .order-success-close-btn:hover {
      background: #ffffff;
      transform: scale(1.1);
    }
    .order-success-timer-bar-wrap {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 4px;
      background: rgba(16,185,129,0.15);
      border-radius: 0 0 14px 14px;
      overflow: hidden;
