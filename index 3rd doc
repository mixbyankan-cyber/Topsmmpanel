    /* ══════════════════════════════════════════════════════════════════
       📊 UNIVERSAL HORIZONTAL DATA TABLE
       Used for Order History, Fund Request History, Referral Commission
       History, and My Panel Orders — professional SMM-site style:
       a real table that scrolls left-to-right, on EVERY screen size
       (mobile, tablet, desktop), instead of stacked boxes.
       ══════════════════════════════════════════════════════════════════ */
    .data-scroll-wrap {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 14px;
      border: 1px solid var(--border-color);
      position: relative;
      background-image:
        linear-gradient(to right, var(--card-bg) 30%, rgba(255,255,255,0)),
        linear-gradient(to right, rgba(255,255,255,0), var(--card-bg) 70%) 100% 0,
        linear-gradient(to right, rgba(0,0,0,0.08), rgba(0,0,0,0)),
        linear-gradient(to left, rgba(0,0,0,0.08), rgba(0,0,0,0)) 100% 0;
      background-repeat: no-repeat;
      background-color: var(--card-bg);
      background-size: 24px 100%, 24px 100%, 8px 100%, 8px 100%;
      background-attachment: local, local, scroll, scroll;
    }

    .data-scroll-table {
      width: 100%;
      min-width: 980px; /* wider now that we show more columns with fuller detail (Order ID, Date, Link, Service, Package, Qty, Amount, Status) */
      border-collapse: collapse;
      font-size: 13.5px;
    }

    .data-scroll-table thead th {
      position: sticky;
      top: 0;
      background: var(--gradient-light);
      color: var(--primary-dark);
      font-size: 11.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      text-align: center;
      padding: 18px 22px;
      white-space: nowrap;
      border-bottom: 2px solid var(--primary-color);
    }

    .data-scroll-table tbody td {
      padding: 20px 22px;
      border-bottom: 1px solid var(--border-light);
      color: var(--text-primary);
      white-space: nowrap;
      vertical-align: middle;
      text-align: center;
    }

    .data-scroll-table tbody tr {
      transition: background 0.15s;
    }

    .data-scroll-table tbody tr:nth-child(odd) {
      background: var(--zebra-odd, rgba(14, 165, 233, 0.035));
    }

    .data-scroll-table tbody tr:nth-child(even) {
      background: var(--zebra-even, rgba(124, 58, 237, 0.035));
    }

    .data-scroll-table tbody tr:hover {
      background: var(--gradient-light);
    }

    .data-scroll-table tbody tr:last-child td {
      border-bottom: none;
    }

    .data-scroll-table .cell-link {
      max-width: 380px;
      overflow: visible;
      text-overflow: unset;
      white-space: normal;
      word-break: normal;
      overflow-wrap: break-word;
      display: inline-block;
      vertical-align: middle;
      text-align: center;
      font-size: 12px;
      line-height: 1.5;
    }

    .data-scroll-table .cell-mono {
      font-family: 'Courier New', monospace;
      font-weight: 800;
      color: var(--primary-color);
      background: rgba(14, 165, 233, 0.1);
      padding: 4px 10px;
      border-radius: 6px;
      letter-spacing: 0.4px;
    }

    .data-scroll-table .cell-amount {
      font-weight: 800;
      color: var(--success);
    }

    /* ✅ Bulk order-selection checkboxes + "Copy Order ID(s)" action bar */
