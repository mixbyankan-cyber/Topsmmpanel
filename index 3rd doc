      .notification-list { padding: 10px 12px; }
      .notification-item { padding: 12px; margin-bottom: 8px; border-radius: 14px; }
      .notification-icon { width: 36px; height: 36px; min-width: 36px; font-size: 18px; border-radius: 10px; }
      .notification-title { font-size: 13px; }
      .notification-message { font-size: 12px; }
      .notification-time { font-size: 10px; }
      .notification-type-badge { display: none; } /* hide on very small screens */
      .empty-notifications { padding: 40px 16px; }
