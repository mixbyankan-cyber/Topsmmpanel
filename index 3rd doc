    // 🇮🇳 Dashboard confetti hook is called directly by navigateTo().
    // Keeping navigation in one function avoids wrapper/reassignment errors.

    // ══════════════════════════════════════════════════════════════════
    // 💱 MULTI-CURRENCY DISPLAY SYSTEM
    // All amounts are stored & calculated in INR (₹) in the database.
    // This engine only CONVERTS & FORMATS what the user *sees*.
    // Exchange rates are set manually by Admin (Admin Panel → Currency Settings)
    // and stored at: settings/currency/rates  → { USD: 83.5, EUR: 90.2, ... }
    // Rate meaning: "1 unit of that currency = X INR"
    // ══════════════════════════════════════════════════════════════════

    const CURRENCY_LIST = [
      { code: 'INR', symbol: '₹', flag: '🇮🇳', name: 'Indian Rupee',    locale: 'en-IN' },
      { code: 'USD', symbol: '$', flag: '🇺🇸', name: 'US Dollar',       locale: 'en-US' },
      { code: 'EUR', symbol: '€', flag: '🇪🇺', name: 'Euro',            locale: 'de-DE' },
      { code: 'GBP', symbol: '£', flag: '🇬🇧', name: 'British Pound',   locale: 'en-GB' },
      { code: 'AUD', symbol: 'A$', flag: '🇦🇺', name: 'Australian Dollar', locale: 'en-AU' },
      { code: 'CAD', symbol: 'C$', flag: '🇨🇦', name: 'Canadian Dollar', locale: 'en-CA' },
      { code: 'AED', symbol: 'AED', flag: '🇦🇪', name: 'UAE Dirham',    locale: 'en-AE' },
      { code: 'SGD', symbol: 'S$', flag: '🇸🇬', name: 'Singapore Dollar', locale: 'en-SG' },
      { code: 'BDT', symbol: 'Tk', flag: '🇧🇩', name: 'Bangladeshi Taka', locale: 'en-BD' },
      { code: 'PKR', symbol: '₨', flag: '🇵🇰', name: 'Pakistani Rupee', locale: 'ur-PK' }
    ];

    // rates[code] = how many INR is 1 unit of `code`. INR itself is always 1.
    // These are sensible fallback/default rates (approx, July 2026) used ONLY
    // until Admin sets/overrides the real rate from the Admin Panel.
    const DEFAULT_CURRENCY_RATES = {
      INR: 1,
      USD: 87.5,
      EUR: 94.5,
      GBP: 109.5,
      AUD: 57.5,
      CAD: 62.5,
      AED: 23.8,
      SGD: 65.5,
      BDT: 0.73,
      PKR: 0.31
    };
    let currencyRates = { ...DEFAULT_CURRENCY_RATES };
    let currencyRatesLoaded = false;
    let selectedCurrency = localStorage.getItem('topsmm_currency') || 'INR';

    function getCurrencyMeta(code) {
      return CURRENCY_LIST.find(c => c.code === code) || CURRENCY_LIST[0];
    }

    // Load exchange rates set by Admin (live updates if admin changes rate)
    function loadCurrencyRates() {
      database.ref('settings/currency/rates').on('value', snapshot => {
        const adminRates = snapshot.val() || {};
        // Merge: start from defaults, override with whatever admin has explicitly set
        currencyRates = { ...DEFAULT_CURRENCY_RATES };
        Object.keys(adminRates).forEach(code => {
          const val = parseFloat(adminRates[code]);
          if (val && val > 0) currencyRates[code] = val;
        });
        currencyRates.INR = 1;
        currencyRatesLoaded = true;
        refreshCurrencyDisplays();
      });
    }

    // Convert a raw INR amount into the user's selected currency (number)
    function convertFromINR(inrAmount) {
      const amount = parseFloat(inrAmount) || 0;
      if (selectedCurrency === 'INR') return amount;
      let rate = parseFloat(currencyRates[selectedCurrency]);
      if (!rate || rate <= 0) rate = DEFAULT_CURRENCY_RATES[selectedCurrency] || 1; // Fallback
      return amount / rate;
    }


    // Format a raw INR amount as a nicely formatted string in selected currency
    function formatCurrency(inrAmount, decimals = 2) {
      const meta = getCurrencyMeta(selectedCurrency);
      const converted = convertFromINR(inrAmount);
      let numberPart;
      try {
        numberPart = converted.toLocaleString(meta.locale, {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals
        });
      } catch (e) {
        numberPart = converted.toFixed(decimals);
      }
      return `${meta.symbol} ${numberPart}`;
    }

    // Short version used inside inline template strings (no leading space quirks)
    function fmt(inrAmount, decimals = 2) {
      return formatCurrency(inrAmount, decimals);
    }

    // For transactional/confirmation messages: always shows the real ₹ amount
    // (since actual billing/payment is INR), plus an approximate conversion
    // in the user's selected currency when it isn't INR — for clarity only.
    function fmtDual(inrAmount, decimals = 2) {
      const inrText = `₹${parseFloat(inrAmount || 0).toFixed(decimals)}`;
      if (selectedCurrency === 'INR') return inrText;
      return `${inrText} (≈ ${formatCurrency(inrAmount, decimals)})`;
    }

    // ── Currency Dropdown UI ──────────────────────────────────────────
    function buildCurrencyDropdownHTML() {
      return CURRENCY_LIST.map(c => `
        <div class="currency-option ${c.code === selectedCurrency ? 'selected' : ''}" onclick="selectCurrency('${c.code}')">
          <span class="cs-flag">${c.flag}</span>
          <span class="cs-code">${c.code}</span>
          <span class="cs-name">${c.name}</span>
        </div>
      `).join('');
    }

    function renderCurrencySelectorUI() {
      const meta = getCurrencyMeta(selectedCurrency);

      const flagEl = document.getElementById('currentCurrencyFlag');
      const codeEl = document.getElementById('currentCurrencyCode');
      if (flagEl) flagEl.textContent = meta.flag;
      if (codeEl) codeEl.textContent = meta.code;

      const flagElP = document.getElementById('currentCurrencyFlagProfile');
      const codeElP = document.getElementById('currentCurrencyCodeProfile');
      const nameElP = document.getElementById('currentCurrencyNameProfile');
      if (flagElP) flagElP.textContent = meta.flag;
      if (codeElP) codeElP.textContent = meta.code;
      if (nameElP) nameElP.textContent = meta.name;

      const list1 = document.getElementById('currencyDropdownList');
      const list2 = document.getElementById('currencyDropdownListProfile');
      const html = buildCurrencyDropdownHTML();
      if (list1) list1.innerHTML = html;
