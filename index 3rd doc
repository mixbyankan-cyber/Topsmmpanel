  /* ═════════ 3. FAVOURITES ═════════ */
  TSMU.favs = {};
  function watchFavs() {
    const uid = TSMU.uid(); if (!uid) return;
    DB().ref('users/' + uid + '/favourites').on('value', s => { TSMU.favs = s.val() || {}; paintFavs(); paintStar(); }, () => { });
