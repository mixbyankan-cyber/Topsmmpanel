    // 🎛️ FESTIVAL LIVE CONTROL COORDINATOR
    // Admin's last saved campaign owns the single shared festival stage.
    // This removes the old hard-coded priority conflict where one campaign
    // could hide another campaign's hero/popup immediately after a save.
    // ══════════════════════════════════════════════════════════════════
    window.FestivalCampaignControl = {
      explicit: false,
      key: null, // independence | rakhi | teachers | off
      updatedAt: 0,
      resolvedKey: null,
      renderTimer: null
    };

    function festivalCampaignIsSelected(key) {
      const ctl = window.FestivalCampaignControl;
      return !ctl.resolvedKey || ctl.resolvedKey === key;
    }

    function rawFestivalPhase(engine, now) {
      if (!engine) return 'off';
      const f = engine.fest || {};
      if (f.master === false || f.master === 'false') return 'off';
      const mode = f.mode || 'auto';
      if (mode !== 'auto') return mode === 'off' ? 'off' : mode;
      if (now < engine.liveAt()) return 'coming';
      if (now < engine.endingAt()) return 'live';
      if (now < engine.hardEndAt()) return 'ending';
      return 'off';
    }

    function requestFestivalCampaignRender(reason) {
      const ctl = window.FestivalCampaignControl;
      clearTimeout(ctl.renderTimer);
      ctl.renderTimer = setTimeout(() => {
        const engines = {
          independence: window.IDT,
          rakhi: window.RB,
          teachers: window.TD
        };

        // No new Firebase selector path is required. The most recently
        // saved of the three EXISTING campaign records owns the stage.
        // This also makes OFF authoritative: if the last-saved campaign is
        // OFF, an older Rakhi LIVE record cannot come back by itself.
        const keys = ['independence', 'rakhi', 'teachers'];
        let selected = null;
        let newestAt = -1;
        keys.forEach(k => {
          const engine = engines[k];
          if (!engine || !engine._initialized) return;
          const at = Number((engine.fest || {}).updatedAt) || 0;
          if (at > newestAt) { newestAt = at; selected = k; }
        });
        if (selected && rawFestivalPhase(engines[selected], Date.now()) === 'off') selected = null;
        ctl.resolvedKey = selected || 'off';

        // Clear non-selected engines first, then paint the selected one LAST.
        // The shared hero/greeting/popup can therefore never be hidden by a
        // late Firebase callback from another campaign.
        Object.keys(engines).forEach(k => {
          const engine = engines[k];
          if (engine && k !== selected) {
            try { engine.applyPhase(false); } catch (e) { console.warn('Festival clear failed:', k, e); }
          }
        });
        const active = engines[selected];
        if (active) {
          try { active.applyPhase(false); } catch (e) { console.warn('Festival render failed:', selected, e); }
        } else {
          if (typeof refreshTopBannerText === 'function') refreshTopBannerText();
        }
        console.log('🎛️ Festival render:', selected || 'off', '·', reason || 'live update');
      }, 35);
    }

