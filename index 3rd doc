            ${noResultsFromSearch
              ? `<button class="btn-action" onclick="clearMyOrdersSearch()" style="margin-top: 20px;">Clear Search</button>`
              : `<button class="btn-action" onclick="navigateTo('dashboardPage')" style="margin-top: 20px;">Place Your First Order</button>`}
          </div>
        `;
        return;
      }

      // 📊 Professional horizontal-scroll table — same layout on mobile & desktop
      // Columns (as requested): [select] Order ID → Date & Time → Link → Service →
      // Package → Quantity → Amount → Status
      container.innerHTML = `
        <div class="order-bulk-bar" id="orderBulkBar">
          <span class="order-bulk-count" id="orderBulkCount">0 selected</span>
          <button class="btn-copy-selected" onclick="copySelectedOrderIds()">📋 Copy Order ID(s)</button>
          <button class="btn-clear-selected" onclick="clearOrderSelection()">✖ Clear</button>
