      DB().ref('users/' + uid + '/favourites/' + key).set({ sid, pid, name: m.name || '', service: m.serviceName || '', at: Date.now() });
      TSMU.toast('⭐ Added to favourites', 'success');
    }
  };
  TSMU.removeFav = function (key, ev) { if (ev) ev.stopPropagation(); DB().ref('users/' + TSMU.uid() + '/favourites/' + key).remove(); };
  function paintStar() {
    /* v35: the wishlist module owns the save button — never build the old star */
    if (window.TSMU && TSMU.WISH) { if (TSMU.paintWishStars) TSMU.paintWishStars(); return; }
    const host = document.getElementById('packageSelect'); if (!host) return;
    let b = document.getElementById('tsmuFavStar');
    if (!b) {
      b = document.createElement('button');
      b.id = 'tsmuFavStar'; b.type = 'button'; b.className = 'tsmu-star';
