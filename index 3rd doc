    // ══════════════════════════════════════════════════════════════════
    const REFILL_WAIT_MS = 24 * 60 * 60 * 1000;

    function getRefillEligibility(order) {
      // Legacy orders completed before this feature existed have no
      // completedAt — treat them as already past the wait rather than
      // permanently blocking refill for them.
      const completedAt = order.completedAt || 0;
      const elapsed = Date.now() - completedAt;
      const remainingMs = Math.max(0, REFILL_WAIT_MS - elapsed);
      return { waitOver: remainingMs <= 0, remainingMs };
    }

    function handleRefillClick(orderId) {
      const order = (window._lastOrdersArray || []).find(o => o.id === orderId);
      if (!order) return;

      if (order.refillStatus === 'approved') {
        showToast('This order has already been refilled.', 'success');
        return;
      }
      if (order.refillStatus === 'pending') {
        showToast('Refill request already sent — under Admin review.', 'success');
        return;
      }

      const { waitOver, remainingMs } = getRefillEligibility(order);
      if (!waitOver) {
        showRefillCountdownPopup(remainingMs);
        return;
      }

      submitRefillRequest(order);
    }

    async function submitRefillRequest(order) {
