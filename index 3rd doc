      // Finds the OLD uid belonging to an email, without needing any
      // ".indexOn" on the servers:
      //   1) O(1) email_index lookup (written at every signup and built for
      //      ALL old users by the admin migration)
      //   2) indexed email queries (work once the rules get the indexes)
      //   3) bounded orderByKey page-scan of OLD users (orderByKey needs
      //      NO index) — the guaranteed last resort.
      async _findLegacyUidByEmail(email, newUid) {
        const emailLc = String(email || '').trim().toLowerCase();
        try {
          const k = this._emailKey(email);
          if (k) {
            const s = await database.ref('email_index/' + k).once('value');
            const rec = s.val();
            if (rec && rec.uid && rec.uid !== newUid) return rec.uid;
          }
      } catch (e) {}
      try {
        // 🩹 v25.2: active 'users' is no longer globally readable, so scan the
        // lightweight email_index (auth != null readable) instead of the old
        // orderByChild('email') query which now hits a permission error.
        const s2 = await database.ref('email_index').once('value');
        const v = s2.val() || {};
        for (const [key, rec] of Object.entries(v)) {
          if (rec && rec.uid && rec.uid !== newUid && String(rec.email || '').toLowerCase() === emailLc) return rec.uid;
        }
      } catch (e) {}
      try {
        const o = await databaseOld.ref('users').orderByChild('email').equalTo(email).limitToFirst(3).once('value');
          let hit = null;
          if (o.exists()) o.forEach(c => { if (c.key !== newUid && !hit) hit = c.key; });
          if (hit) return hit;
        } catch (e) {}
        try {
          let startKey = null, pages = 0;
          while (pages < 40) {
            const q = startKey ? databaseOld.ref('users').orderByKey().startAt(startKey).limitToFirst(31)
                               : databaseOld.ref('users').orderByKey().limitToFirst(31);
            const s2 = await q.once('value');
            const v = s2.val() || {};
            const keys = Object.keys(v).sort();
            if (!keys.length) break;
            for (const kk of keys) {
              const u = v[kk] || {};
              if (kk !== newUid && String(u.email || '').trim().toLowerCase() === emailLc) {
                try { database.ref('email_index/' + this._emailKey(email)).set({ uid: kk, email: emailLc }).catch(() => {}); } catch (e2) {}
                return kk;
              }
            }
            if (keys.length < 31) break;
            startKey = keys[keys.length - 1];
            pages++;
          }
        } catch (e) {}
        return null;
      },
      async adoptByEmail(user) {
        if (!user || !user.email) return false;
        const email = String(user.email).trim().toLowerCase();
        // Activation copies portable profiles into the new active shard before
        // Auth adoption, so search active first, then every read-only archive.
        const sources = [{ projectId: window.TSMRuntime.activeProjectId, database }]
          .concat(window.TSMRuntime.archiveDatabases().map(x => ({ projectId:x.project.id, database:x.database })));
        for (const src of sources) {
          try {
            let oldUid = null;
            // 🩹 v25.2: the ACTIVE project's 'users' is admin-only now, so use
            // the email_index there; archives keep their own indexed query.
            if (src.database === database) {
              const s2 = await database.ref('email_index').once('value');
              const v = s2.val() || {};
              for (const [key, rec] of Object.entries(v)) {
                if (rec && rec.uid && rec.uid !== user.uid && String(rec.email || '').toLowerCase() === email) { oldUid = rec.uid; break; }
              }
            } else {
              const snap = await src.database.ref('users').orderByChild('email').equalTo(email).limitToFirst(1).once('value');
              snap.forEach(c => { if (!oldUid) oldUid = c.key; });
            }
            if (!oldUid) continue;
            if (oldUid !== user.uid) await this.migrateAccount(oldUid, user.uid, src.projectId, src.database);
            database.ref('email_index/' + this._emailKey(email)).set({ uid:user.uid, email }).catch(() => {});
            return oldUid !== user.uid;
          } catch (e) {}
        }
        return false;
      },
      // 🔄 AFTER a legacy account has migrated, keep watching the OLD
      // database: anything new created there for THIS account (order,
      // fund request, transaction, support ticket) is copied into its
      // NEW location within seconds — automatically.
      watchMyOldData(currentUid) {
        if (!currentUid || window._myOldWatchUid) return;
        try {
          // Self-detaching listener — handles the race where the migrated
          // profile (with oldUid) lands a moment AFTER the panel opens.
          const flagRef = database.ref('users/' + currentUid + '/oldUid');
          const flagHandler = sessionOn(flagRef, 'value', s => {
            const oldUid = s.val() || null;
            if (!oldUid || oldUid === currentUid) return;
            window._myOldWatchUid = currentUid;
            flagRef.off('value', flagHandler);

            const copyItem = (sub, k, v) => {
              const p = 'users/' + currentUid + '/' + sub + '/' + k;
              database.ref(p).once('value').then(ns => {
                if (!ns.exists()) database.ref(p).set(v).catch(() => {});
              }).catch(() => {});
            };

            ['orders', 'fundRequests', 'transactions'].forEach(sub => {
              const ref = databaseOld.ref('users/' + oldUid + '/' + sub);
              sessionOn(ref, 'child_added',   cs => copyItem(sub, cs.key, cs.val()));
              sessionOn(ref, 'child_changed', cs => copyItem(sub, cs.key, cs.val()));
            });

            // Old-side tickets get re-homed onto the new user id
            sessionOn(databaseOld.ref('tickets').orderByChild('userId').equalTo(oldUid), 'child_added', ts => {
              database.ref('tickets/' + ts.key).once('value').then(ns => {
                if (!ns.exists()) {
                  database.ref('tickets/' + ts.key)
                    .set(Object.assign({}, ts.val(), { userId: currentUid }))
                    .catch(() => {});
                }
              }).catch(() => {});
            });

            console.log('🔄 legacy watch on for this account');
          });
        } catch (e) {}
      }
    };

    // 🗄️ One-time auto-sync (USER panel): only missing 'services' keys are
    // copied OLD ➜ NEW on first load so the order form is never empty.
    // ('settings' is synced by the ADMIN panel instead — that way the
    // settings node can later be write-protected with database rules.)
    function bootstrapLegacySync() {
      const syncNode = (node) => {
        database.ref('_legacySync/' + node).once('value').then(flagSnap => {
          if (flagSnap && flagSnap.val()) return;
          return Promise.all([
            database.ref(node).once('value'),
            databaseOld.ref(node).once('value')
          ]).then(results => {
            const nv = results[0].val() || {}, ov = results[1].val() || {};
            const upd = {}; let c = 0;
            Object.keys(ov).forEach(k => { if (!(k in nv)) { upd[node + '/' + k] = ov[k]; c++; } });
            upd['_legacySync/' + node] = Date.now();
            return database.ref().update(upd).catch(() => {});
          });
        }).catch(() => {});
      };
      syncNode('services');

      // 💳 Payment methods: DEEP, method-by-method copy — the deposit
      // page must show every payment method that existed in OLD, even
      // if NEW already holds some of its own. One-time, missing only.
      database.ref('_legacySync/paymentMethodsDeep').once('value').then(flagSnap => {
        if (flagSnap && flagSnap.val()) return;
        return Promise.all([
          database.ref('settings/paymentMethods').once('value'),
          databaseOld.ref('settings/paymentMethods').once('value')
        ]).then(results => {
          const nv = results[0].val() || {}, ov = results[1].val() || {};
          const upd = {};
          Object.keys(ov).forEach(k => { if (!(k in nv)) upd['settings/paymentMethods/' + k] = ov[k]; });
          upd['_legacySync/paymentMethodsDeep'] = Date.now();
          return database.ref().update(upd).catch(() => {});
        });
      }).catch(() => {});
