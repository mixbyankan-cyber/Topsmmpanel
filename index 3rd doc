    async function submitTicketReply(ticketId) {
      if (!currentUser) return;
      if (!ensureFeatureAllowed('tickets', 'Support Ticket Replies')) return;
      const editor = document.getElementById('ticketReplyEditor');
      const messageHtml = sanitizeTicketHTML(editor ? editor.innerHTML : '');
      const messageText = editor ? editor.textContent.trim() : '';

      if (!messageText) {
        playSound('error');
        return showToast('Please type a message!', 'error');
      }

      const btn = document.getElementById('ticketReplySubmitBtn');
      const originalHTML = btn ? btn.innerHTML : '';
      if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Sending...'; }

      try {
        const nowTs = Date.now();
        const msgRef = database.ref(`tickets/${ticketId}/messages`).push();

        await database.ref().update({
          [`tickets/${ticketId}/messages/${msgRef.key}`]: {
            sender: 'user',
            senderName: cleanPersonName((auth.currentUser && auth.currentUser.displayName) || 'User'),
            message: messageHtml,
            createdAt: nowTs
          },
          [`tickets/${ticketId}/status`]: 'open',
          [`tickets/${ticketId}/updatedAt`]: nowTs,
          [`tickets/${ticketId}/lastMessageAt`]: nowTs,
          [`tickets/${ticketId}/lastMessageBy`]: 'user',
          [`tickets/${ticketId}/lastMessagePreview`]: messageText.substring(0, 80),
          [`tickets/${ticketId}/adminHasUnread`]: true,
          [`tickets/${ticketId}/userHasUnread`]: false
        });

        if (editor) editor.innerHTML = '';
        playSound('success');
        showToast('✅ Reply sent!', 'success');
      } catch (error) {
        console.error('Error sending reply:', error);
        playSound('error');
        showToast('Failed to send reply. Try again!', 'error');
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = originalHTML; }
      }
    }

