        if (cnt) cnt.textContent = 'Auto-closing in ' + n + 's';
        if (overlay.dataset.timer) clearInterval(parseInt(overlay.dataset.timer));
        const timer = setInterval(() => {
          n--;
          if (cnt) cnt.textContent = 'Auto-closing in ' + n + 's';
          if (n <= 0) { clearInterval(timer); IDT.closePopup(); }
