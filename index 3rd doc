    .referral-stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-bottom: 20px;
    }

    .referral-stat-card {
      background: var(--white);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-color);
    }

    .referral-stat-icon {
      font-size: 32px;
      margin-bottom: 8px;
    }

    .referral-stat-value {
      font-size: 24px;
      font-weight: bold;
      color: var(--primary-color);
      margin-bottom: 5px;
    }

    .referral-stat-label {
      font-size: 12px;
      color: var(--text-secondary);
    }

    .referral-use-code-card {
      background: var(--white);
      border-radius: 16px;
      padding: 25px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-md);
      border: 2px solid var(--warning);
    }

    .referral-use-code-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--dark-text);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .referral-use-code-desc {
      font-size: 13px;
      color: var(--text-secondary);
      margin-bottom: 15px;
      line-height: 1.5;
    }

    .referral-input-group {
      display: flex;
      gap: 10px;
      align-items: flex-end;
    }

    .referral-input-wrapper {
