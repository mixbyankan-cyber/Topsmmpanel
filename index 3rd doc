  TSMU.wishHas = (sid, pid) => !!W.items[KEY(sid, pid)];

  TSMU.wishToggle = function (sid, pid, ev) {
    if (ev && ev.stopPropagation) ev.stopPropagation();
    const uid = TSMU.uid();
    if (!uid) return TSMU.toast('Please sign in first.', 'error');
    if (!sid || !pid) return TSMU.toast('Select a service and a package first.', 'error');
    const k = KEY(sid, pid);
    return W.items[k] ? TSMU.wishRemove(k) : TSMU.wishAdd(sid, pid);
  };

  TSMU.wishAdd = function (sid, pid, note) {
    const uid = TSMU.uid(); if (!uid) return;
    const k = KEY(sid, pid);
    const lp = livePkg(sid, pid), m = meta(sid, pid);
    const row = {
      sid: sid, pid: pid,
      name: (lp.pkg && lp.pkg.name) || m.name || 'Package',
      service: (lp.svc && lp.svc.name) || m.serviceName || '',
      price: TSMU.num(lp.pkg && lp.pkg.pricePerK, TSMU.num(m.pricePerK)),
      savedPrice: TSMU.num(lp.pkg && lp.pkg.pricePerK, TSMU.num(m.pricePerK)),
      note: String(note || ''),
      at: Date.now()
    };
    DB().ref('users/' + uid + '/favourites/' + k).set(row)
      .then(() => TSMU.toast('⭐ Saved to your wishlist', 'success'))
      .catch(e => TSMU.toast('Could not save: ' + e.message, 'error'));
    // admin mirror — never block the user if rules deny it
    const u = TSMU.authUser() || {};
    DB().ref('wishlist/' + k + '/' + uid).set({
      uid: uid, email: u.email || '', name: (TSMU.G('currentUserData') || {}).name || u.displayName || '',
      sid: sid, pid: pid, pkg: row.name, service: row.service, price: row.price, at: row.at
    }).catch(() => { });
    return true;
  };

  TSMU.wishRemove = function (k, ev) {
    if (ev && ev.stopPropagation) ev.stopPropagation();
    const uid = TSMU.uid(); if (!uid) return;
    DB().ref('users/' + uid + '/favourites/' + k).remove()
      .then(() => TSMU.toast('Removed from wishlist', 'success'))
      .catch(e => TSMU.toast('Could not remove: ' + e.message, 'error'));
    DB().ref('wishlist/' + k + '/' + uid).remove().catch(() => { });
  };

  TSMU.wishNote = function (k) {
    const it = W.items[k]; if (!it) return;
    const cur = it.note || '';
    const v = window.prompt('Add a short note for "' + (it.name || 'this package') + '"\n(for example: order after salary, needs 5k)', cur);
    if (v === null) return;
    DB().ref('users/' + TSMU.uid() + '/favourites/' + k + '/note').set(String(v).slice(0, 200))
      .then(() => TSMU.toast('Note saved', 'success')).catch(() => { });
  };

  TSMU.wishClearGone = function () {
    const gone = Object.keys(W.items).filter(k => !available(k).ok);
    if (!gone.length) return TSMU.toast('Nothing to clean — every saved package is still available.', 'success');
    gone.forEach(k => {
      DB().ref('users/' + TSMU.uid() + '/favourites/' + k).remove().catch(() => { });
      DB().ref('wishlist/' + k + '/' + TSMU.uid()).remove().catch(() => { });
    });
    TSMU.toast('Removed ' + gone.length + ' unavailable item' + (gone.length > 1 ? 's' : ''), 'success');
  };

  function available(k) {
    const it = W.items[k] || {};
    const lp = livePkg(it.sid, it.pid);
    if (!lp.svc) return { ok: false, why: 'This service was removed.' };
    if (lp.svc.enabled === false) return { ok: false, why: 'This service is temporarily turned off.' };
    if (!lp.pkg) return { ok: false, why: 'This package was removed.' };
    if (lp.pkg.enabled === false) return { ok: false, why: 'This package is temporarily unavailable.' };
    return { ok: true, pkg: lp.pkg, svc: lp.svc };
  }

  /* ─────────────── the page ─────────────── */
  const PAGE_HTML =
    '<div class="tsmu-wl-head" id="tsmuWlKpis"></div>' +
    '<div class="tsmu-wl-tools">' +
    '<input type="text" class="tsmu-in" id="tsmuWlSearch" placeholder="Search your wishlist…" oninput="TSMU.wishSearch(this.value)" autocomplete="off">' +
    '<select class="tsmu-in" id="tsmuWlSort" style="flex:0 0 auto;min-width:148px" onchange="TSMU.wishSort(this.value)">' +
    '<option value="recent">Recently saved</option>' +
    '<option value="network">Group by network</option>' +
    '<option value="price">Cheapest first</option>' +
    '<option value="pricedesc">Most expensive first</option>' +
    '<option value="name">Package name (A-Z)</option>' +
    '</select>' +
    '<button class="tsmu-btn sec" onclick="TSMU.wishClearGone()">🧹 Clean unavailable</button>' +
    '</div>' +
    '<div id="tsmuWlList"></div>';

  function ensurePage() {
    if (document.getElementById('wishlistPage')) return;
    TSMU.makePage('wishlistPage', '⭐ My Wishlist', PAGE_HTML, 'menuPage');
    TSMU.addMenuCard({
      id: 'wishlist', icon: '⭐', color: '#f59e0b', title: 'My Wishlist',
      desc: 'Every package you saved — check the live price and order in one tap',
      onclick: "navigateTo('wishlistPage')"
    });
    paintMenuBadge();
  }

  function visible() {
    const p = document.getElementById('wishlistPage');
    return !!p && p.classList.contains('active');
  }

  TSMU.wishSearch = function (v) { W.q = String(v || '').toLowerCase().trim(); render(); };
  TSMU.wishSort = function (v) { W.sort = v || 'recent'; render(); };

  function rows() {
    let list = Object.keys(W.items).map(k => Object.assign({ key: k }, W.items[k]));
    if (W.q) list = list.filter(r =>
      String(r.name || '').toLowerCase().indexOf(W.q) >= 0 ||
      String(r.service || '').toLowerCase().indexOf(W.q) >= 0 ||
      String(r.note || '').toLowerCase().indexOf(W.q) >= 0);
    const price = r => { const a = available(r.key); return a.ok ? TSMU.num(a.pkg.pricePerK) : TSMU.num(r.price); };
    if (W.sort === 'price') list.sort((a, b) => price(a) - price(b));
    else if (W.sort === 'pricedesc') list.sort((a, b) => price(b) - price(a));
    else if (W.sort === 'name') list.sort((a, b) => String(a.name || '').localeCompare(String(b.name || '')));
    else if (W.sort === 'network') list.sort((a, b) => String(a.service || '').localeCompare(String(b.service || '')) || String(a.name || '').localeCompare(String(b.name || '')));
    else list.sort((a, b) => TSMU.num(b.at) - TSMU.num(a.at));
    return list;
  }

  function rateText(r, pkg) {
    try { if (TSMU.rateText) return TSMU.rateText(pkg.pricePerK, r.sid, r.pid); } catch (e) { }
    return '₹' + TSMU.num(pkg.pricePerK).toFixed(4);
  }

  function cardHTML(r) {
    const a = available(r.key);
    const pkg = a.ok ? a.pkg : null;
    const now = pkg ? TSMU.num(pkg.pricePerK) : NaN;
    const then = TSMU.num(r.savedPrice, NaN);
    const dropped = Number.isFinite(now) && Number.isFinite(then) && now < then;
    const risen = Number.isFinite(now) && Number.isFinite(then) && now > then;
    const svcLogo = (a.ok && a.svc && window.getServiceLogoHTML) ? (window.getServiceLogoHTML(a.svc.logo,a.svc.customLogoUrl) || '') : '';

    let meta = '';
    if (pkg) {
      meta += '<span class="' + (now <= 0 ? 'free' : 'rate') + '">' +
