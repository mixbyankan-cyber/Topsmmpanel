            loadPaymentMethods();
          }
        }, 100);
      } else if (pageId === 'menuPage') {
        navItems[4].classList.add('active');
      } else if (pageId === 'apiPage') {
        initApiPage();
      } else if (pageId === 'termsPage') {
        // 🩹 Accessed normally from the logged-in Menu — always show the
        // agreement checkbox section (never left hidden from a previous
        // pre-login visit) and reset the "opened from signup" flag.
        _termsOpenedFromSignup = false;
