      if (!select) return;
      const methods = paymentMethodsCache || [];
      select.innerHTML = '<option value="">-- Select Payment Method --</option>' +
        methods.map(m => `<option value="${m.name}">${m.icon || '💳'} ${m.name}</option>`).join('');
