        // Extra safety: refill the authenticated email after the page renders.
        setTimeout(() => {
          const input = document.getElementById('adminEmail');
          const user = currentUser || auth.currentUser;
          if (!input || !user || input.value) return;
          const resolved = getBestUserEmail(user, null);
          if (resolved) input.value = resolved;
          else if (user.uid) database.ref(`users/${user.uid}/email`).once('value').then(s => {
            if (s.val() && !input.value) input.value = s.val();
          }).catch(() => {});
        }, 100);
