          [`users/${currentUser.uid}/orders/${order.id}/refillRequestedAt`]: Date.now(),
          [`orders_index/${order.id}/refillStatus`]: 'pending',
          [`orders_index/${order.id}/refillRequestedAt`]: Date.now()
        };
        if(order.batchId){refillUpdates[`adminPanel/massOrders/${order.batchId}/items/${order.id}/refillStatus`]='pending';refillUpdates[`adminPanel/massOrders/${order.batchId}/items/${order.id}/refillRequestedAt`]=Date.now();}
        refillUpdates[`refill_requests/${order.id}`]={orderId:order.id,orderNumber:order.orderNumber||'',userId:currentUser.uid,userName:cleanPersonName(auth.currentUser?.displayName||'User'),userEmail:getBestUserEmail(auth.currentUser,null),serviceId:order.serviceId||'',packageId:order.packageId||'',serviceName:cleanPlainText(order.serviceName||'',160),packageName:cleanPlainText(order.packageName||'',220),amount:Number(order.amount)||0,completedAt:Number(order.completedAt)||0,requestedAt:Date.now(),status:'pending',source:order.source||'single',massOrder:order.massOrder===true,batchId:order.batchId||null};
        await database.ref().update(refillUpdates);
