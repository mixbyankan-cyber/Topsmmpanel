    // ── Ticket Conversation Page ──
    function openTicketConversation(ticketId) {
      currentOpenTicketId = ticketId;
      navigateTo('ticketConvoPage');
      loadTicketConversation(ticketId);
    }

    function detachTicketConvoListeners() {
      if (ticketConvoListeners.header) {
        database.ref(`tickets/${ticketConvoListeners.ticketId}`).off('value', ticketConvoListeners.header);
      }
      if (ticketConvoListeners.messages) {
        database.ref(`tickets/${ticketConvoListeners.ticketId}/messages`).off('value', ticketConvoListeners.messages);
      }
      ticketConvoListeners = { header: null, messages: null };
    }

    function loadTicketConversation(ticketId) {
      detachTicketConvoListeners();

      const headerListener = database.ref(`tickets/${ticketId}`).on('value', snap => {
        const ticket = snap.val();
        if (!ticket) return;
        renderTicketConvoHeader({ id: ticketId, ...ticket });
        renderTicketReplyArea({ id: ticketId, ...ticket });

        // Mark as read by the user the moment they view it
        if (ticket.userHasUnread) {
          database.ref(`tickets/${ticketId}/userHasUnread`).set(false).catch(() => {});
        }
      });

      const messagesListener = database.ref(`tickets/${ticketId}/messages`).orderByChild('createdAt').on('value', snap => {
        const data = snap.val() || {};
        const messages = Object.values(data).sort((a, b) => a.createdAt - b.createdAt);
        renderTicketConvoThread(messages);
      });

      ticketConvoListeners = { header: headerListener, messages: messagesListener, ticketId: ticketId };
    }

    function renderTicketConvoHeader(ticket) {
      const container = document.getElementById('ticketConvoHeader');
      if (!container) return;

      // Show whichever meta fields actually exist on this ticket record —
      // robust even if Admin later renames/deletes the Subject that was
      // originally selected (the data itself never changes).
      let metaLines = '';
      if (ticket.requestType || (ticket.orderIds && ticket.orderIds.length > 0)) {
        metaLines += `<div><strong>Request:</strong> ${escapeHTML(ticket.requestType||'N/A')}</div><div><strong>Order ID(s):</strong> ${escapeHTML((ticket.orderIds||[]).join(', ')||'N/A')}</div>`;
      }
      if (ticket.paymentMethod) {
        metaLines += `<div><strong>Payment Method:</strong> ${escapeHTML(ticket.paymentMethod)}</div>`;
      }

      container.innerHTML = `
        <div class="ticket-convo-header-top">
          <div>
            <div class="ticket-convo-subject">${escapeHTML(getTicketSubjectLabel(ticket.subject))}</div>
          </div>
          <div style="text-align:right;">
            <div class="ticket-convo-id">#${escapeHTML(ticket.ticketNumber)}</div>
            <span class="ticket-status-badge ticket-status-${escapeAttr(ticket.status)}">${escapeHTML(TICKET_STATUS_LABELS[ticket.status]||ticket.status)}</span>
          </div>
        </div>
        ${metaLines ? `<div class="ticket-convo-meta-box">${metaLines}</div>` : ''}
      `;
    }

    function renderTicketConvoThread(messages) {
      const container = document.getElementById('ticketConvoThread');
      if (!container) return;

      container.innerHTML = messages.map(m => {
        const isUser = m.sender === 'user';
        const timeStr = new Date(m.createdAt).toLocaleString('en-IN', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
        return `
          <div class="ticket-msg-row ${isUser ? 'from-user' : 'from-admin'}">
            <div class="ticket-msg-avatar">${isUser ? '🙂' : '👨‍💼'}</div>
            <div class="ticket-msg-bubble-wrap">
              <div class="ticket-msg-sender">${isUser ? escapeHTML(m.senderName || 'You') : 'Support Team'}</div>
              <div class="ticket-msg-bubble">${sanitizeTicketHTML(m.message)}</div>
              <div class="ticket-msg-time">${timeStr}</div>
            </div>
          </div>
        `;
      }).join('');

      // Scroll to the latest message
      setTimeout(() => container.scrollIntoView({ behavior: 'smooth', block: 'end' }), 100);
    }

    function renderTicketReplyArea(ticket) {
      const container = document.getElementById('ticketConvoReplyArea');
      if (!container) return;

      if (ticket.status === 'closed') {
        container.innerHTML = `
          <div class="ticket-closed-notice">
            🔒 This ticket has been closed by the Support Team.
            <div style="margin-top:8px;font-size:12px;opacity:.82;">If you still need help, please create a new support ticket.</div>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div class="ticket-reply-box">
          <div class="ticket-editor-wrap">
            <div class="ticket-editor-toolbar">
