    // ── Rich text editor toolbar commands ──
    function ticketEditorCmd(cmd) {
      const editor = document.getElementById('ticketMessageEditor');
      if (editor) editor.focus();
      document.execCommand(cmd, false, null);
    }

    // ── Load Admin-configured Request Types (with default seed) ──
    function loadTicketRequestTypes() {
      database.ref('settings/ticketRequestTypesSeeded').once('value').catch(e=>{console.warn('ticketRequestTypesSeeded read blocked:',e.message);return null;}).then(seededSnap => { if(!seededSnap) return;
        if (!seededSnap.exists()) {
          const seedUpdates = {};
          DEFAULT_TICKET_REQUEST_TYPES.forEach((label, i) => {
            const key = database.ref('settings/ticketRequestTypes').push().key;
            seedUpdates[`settings/ticketRequestTypes/${key}`] = { label, sortOrder: i };
          });
          seedUpdates['settings/ticketRequestTypesSeeded'] = true;
          database.ref().update(seedUpdates).catch(() => {});
        }
      });

      sessionOn(database.ref('settings/ticketRequestTypes'), 'value', snap => {
        const data = snap.val() || {};
        ticketRequestTypesCache = Object.values(data)
          .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0))
          .map(r => r.label);
        if (ticketRequestTypesCache.length === 0) ticketRequestTypesCache = DEFAULT_TICKET_REQUEST_TYPES;
        if (getTicketSubjectBehavior(selectedTicketSubject) === 'order') renderTicketRequestButtons();
      });
    }

    // ── Ticket System enable/disable (hides Menu entry point when off) ──
    function loadTicketSystemEnabledState() {
      sessionOn(database.ref('settings/ticketSystem/enabled'), 'value', snap => {
        const enabled = snap.val() !== false;
        const menuCards = document.querySelectorAll('[onclick*="navigateTo(\'ticketsPage\')"]');
        menuCards.forEach(card => { card.style.display = enabled ? '' : 'none'; });
      });
    }

    // ── Generate a unique 6-digit Ticket ID (same pattern as Orders/Funds) ──
    function generateUniqueTicketId() {
      return reserveUniqueNumericId('ticket_id_index', 'ticket');
    }

    // ── Submit a brand-new Ticket ──
    async function submitNewTicket() {
      if (!currentUser) {
        playSound('error');
        return showToast('Please login first!', 'error');
      }
      if (!ensureFeatureAllowed('tickets', 'Support Tickets')) return;

      // 🩹 Commit any Order ID the user finished typing but never pressed
      // Enter/comma for — so it's never silently lost right before submit.
      commitTicketOrderIdTyped();

      if (!selectedTicketSubject) {
        playSound('error');
        return showToast('Please select a Subject!', 'error');
      }

      if (getTicketSubjectBehavior(selectedTicketSubject) === 'order' && !selectedTicketRequestType) {
        playSound('error');
        return showToast('Please select a Request type!', 'error');
      }

      const paymentMethodEl = document.getElementById('ticketPaymentMethod');
      if (getTicketSubjectBehavior(selectedTicketSubject) === 'payment' && (!paymentMethodEl || !paymentMethodEl.value)) {
        playSound('error');
        return showToast('Please select a Payment Method!', 'error');
      }

      const editor = document.getElementById('ticketMessageEditor');
      const messageHtml = sanitizeTicketHTML(editor ? editor.innerHTML : '');
      const messageText = editor ? editor.textContent.trim() : '';

      // ✅ Message becomes OPTIONAL only when Subject = Order AND at least
      // one Order ID has been provided — the Request Type (Refill/Cancel/
      // Speed Up/etc.) + Order ID(s) already tell Admin everything needed,
      // so forcing extra typed text in that specific case is unnecessary
      // friction. Every other case (Payment/Account/Other, or Order without
      // any Order ID yet) still requires a message as before.
      const messageIsOptional = getTicketSubjectBehavior(selectedTicketSubject) === 'order' && selectedTicketOrderIds.length > 0;

      if (!messageText && !messageIsOptional) {
        playSound('error');
        return showToast('Please enter your message!', 'error');
      }

      const submitBtn = document.getElementById('ticketSubmitBtn');
      const originalBtnHTML = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '⏳ Submitting...';
      }

      try {
        const ticketNumber = await generateUniqueTicketId();
        const nowTs = Date.now();
        const ticketRef = database.ref('tickets').push();
        const msgRef = ticketRef.child('messages').push();

        // ✅ If the user left the message blank (allowed when Subject=Order
        // with at least one Order ID already provided), store a clear
        // placeholder instead of an empty string — so Admin's conversation
        // view never shows a confusing blank chat bubble.
        const finalMessageHtml = messageHtml || '<em>(No message provided — see Request/Order ID details above)</em>';

        const messageData = {
          sender: 'user',
          senderName: cleanPersonName((auth.currentUser && auth.currentUser.displayName) || 'User'),
          message: finalMessageHtml,
          createdAt: nowTs
        };

        const ticketData = {
          ticketNumber: ticketNumber,
          userId: currentUser.uid,
          userName: cleanPersonName((auth.currentUser && auth.currentUser.displayName) || 'User'),
          userEmail: getBestUserEmail(auth.currentUser, null),
          subject: selectedTicketSubject,
          orderIds: getTicketSubjectBehavior(selectedTicketSubject) === 'order' ? selectedTicketOrderIds : [],
          requestType: getTicketSubjectBehavior(selectedTicketSubject) === 'order' ? selectedTicketRequestType : null,
          paymentMethod: getTicketSubjectBehavior(selectedTicketSubject) === 'payment' ? paymentMethodEl.value : null,
          status: 'open',
          createdAt: nowTs,
          updatedAt: nowTs,
          lastMessageAt: nowTs,
          lastMessageBy: 'user',
          lastMessagePreview: messageText ? messageText.substring(0, 80) : `Request: ${selectedTicketRequestType || 'N/A'}`,
          userHasUnread: false,
          adminHasUnread: true,
          // 🩹 CRITICAL FIX: the first message is embedded directly INSIDE
          // ticketData (as messages/{msgKey}) instead of being written as a
          // SEPARATE sibling path in the same multi-path update() below.
          // Firebase Realtime Database REJECTS (and throws, causing the
          // entire submit to silently fail every time) any multi-path
          // update where one path is an ANCESTOR of another — and
          // `tickets/{id}` is an ancestor of `tickets/{id}/messages/{msgKey}`.
          // This was the root cause of "ticket submit always fails".
          messages: {
            [msgRef.key]: messageData
          }
        };

        await database.ref().update({
          [`tickets/${ticketRef.key}`]: ticketData,
          [`ticket_id_index/${ticketNumber}`]: { ticketId: ticketRef.key }
        });

        playSound('success');
        showToast(`🎫 Ticket #${ticketNumber} submitted successfully!`, 'success');

        // Reset form
        selectedTicketSubject = null;
        selectedTicketRequestType = null;
        selectedTicketOrderIds = [];
        renderTicketSubjectButtons();
        document.getElementById('ticketOrderFields').style.display = 'none';
        document.getElementById('ticketPaymentFields').style.display = 'none';
        renderTicketOrderIdChips();
        updateTicketMessageOptionalUI();
        if (editor) editor.innerHTML = '';

        // v38: never force-open the conversation after submission.
        // Refresh the list in place; opening the ticket remains an explicit user action.
        if (window.TSMU) TSMU.ticketJustSubmittedAt = Date.now();
        loadUserTickets();
        navigateTo('ticketsPage');
        setTimeout(() => {
          const history = document.getElementById('ticketsHistoryContainer');
          if (history) history.scrollIntoView({ behavior:'smooth', block:'start' });
        }, 120);

      } catch (error) {
        console.error('Error submitting ticket:', error);
        playSound('error');
        showToast('Failed to submit ticket. Try again!', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnHTML;
        }
      }
    }

    // ── Load & live-display the current user's own Ticket History ──
    let archiveTicketsCache = [];
    function loadUserTickets() {
      if (!currentUser) return;
      loadArchiveHistory('tickets').then(rows=>{archiveTicketsCache=rows.map(x=>({...x,userHasUnread:false}));if(window._activeTicketsCache){allMyTicketsArray=[...window._activeTicketsCache,...archiveTicketsCache].sort((a,b)=>(b.lastMessageAt||b.updatedAt||0)-(a.lastMessageAt||a.updatedAt||0));displayTicketsHistory(allMyTicketsArray);}});
      sessionOn(database.ref('tickets').orderByChild('userId').equalTo(currentUser.uid), 'value', snap => {
        const data = snap.val() || {};
        window._activeTicketsCache = Object.entries(data).map(([id,x])=>({id,...x,_archived:false}));
        allMyTicketsArray=[...window._activeTicketsCache,...archiveTicketsCache].sort((a,b)=>(b.lastMessageAt||b.updatedAt||0)-(a.lastMessageAt||a.updatedAt||0));
        displayTicketsHistory(allMyTicketsArray);
        updateMenuTicketBadge();
      });
    }

    function updateMenuTicketBadge() {
      const badge = document.getElementById('menuTicketBadge');
      if (!badge) return;
      const unreadCount = allMyTicketsArray.filter(t => t.userHasUnread).length;
      if (unreadCount > 0) {
        badge.textContent = unreadCount;
        badge.style.display = 'inline-block';
      } else {
        badge.style.display = 'none';
      }
    }

        const TICKET_STATUS_LABELS = { open: '🟡 Open', answered: '🔵 Answered', closed: '🟢 Closed' };

